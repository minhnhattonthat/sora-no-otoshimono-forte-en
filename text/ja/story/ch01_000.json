{"file": "_Data/Script/Other/Story/Chapter01/000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ニンフ、お新香、取ってくれ。"},
{"id": 1, "kind": "msg", "spk": "ニンフ", "ja": "うん。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "イカロス、おかわり。"},
{"id": 3, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "ふぅ～。"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "（平和だな～。平和が一番だな、うん）"},
{"id": 6, "kind": "msg", "spk": "そはら", "ja": "トモちゃん、おはよう。\n学校、行こうよ。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "学校～？\n……いいや、今日はパス。"},
{"id": 8, "kind": "msg", "spk": "そはら", "ja": "パ、パス！？\nふざけないでよ、トモちゃん！"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "いやー。だって、せっかく\n服が飛んでった騒ぎも収まったんだし。\nもう少しぐらい平和を味わいたいだろ。"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "騒ぎの間は休校状態だったわけだし、\n１日くらい休んでもたいして\n変わんない気がするし。"},
{"id": 11, "kind": "msg", "spk": "そはら", "ja": "な、なに言ってるの、トモちゃん！？\n先生に怒られちゃうよ？"},
{"id": 12, "kind": "msg", "spk": "ニンフ", "ja": "なら、トモキ。\n私と家で昼ドラ見てる？"},
{"id": 13, "kind": "msg", "spk": "そはら", "ja": "ええっ！？\nちょっと、ニンフさんまで！"},
{"id": 14, "kind": "msg", "spk": "そはら", "ja": "イカロスさん！　イカロスさんは\nちゃんと学校行くよね？"},
{"id": 15, "kind": "msg", "spk": "イカロス", "ja": "え……？　……はい。"},
{"id": 16, "kind": "msg", "spk": "ニンフ", "ja": "アルファーは真面目よねぇ。\n私たちエンジェロイドは泳げないんだし\n今日は行っても仕方ないと思うけど。"},
{"id": 17, "kind": "msg", "spk": "そはら", "ja": "え？　泳ぐって……。"},
{"id": 18, "kind": "msg", "spk": "そはら", "ja": "あっ！　そういえば、今日の体育、\nプールだっけ！？"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "……っ！？"},
{"id": 20, "kind": "msg", "spk": "ニンフ", "ja": "前に先生がそう言ってたじゃない。\nそはら、忘れてたの？"},
{"id": 21, "kind": "msg", "spk": "そはら", "ja": "き、昨日までは覚えてたんだよ？\nただ、今朝はちょっと\nうっかりしちゃったっていうか……"},
{"id": 22, "kind": "msg", "spk": "ニンフ", "ja": "はいはい、とにかく水着\n持ってきた方がいいんじゃないの？"},
{"id": 23, "kind": "msg", "spk": "ニンフ", "ja": "スキャンしたところ、\nカバンの中にも入ってないみたいだし。"},
{"id": 24, "kind": "msg", "spk": "そはら", "ja": "ニンフさん！？\n女の子のカバンをスキャンとか\nしちゃだめだよ！？"},
{"id": 25, "kind": "msg", "spk": "ニンフ", "ja": "え？　別に見られて困るようなもん\n入ってないじゃない。"},
{"id": 26, "kind": "msg", "spk": "ニンフ", "ja": "なんで入ってるのか\nよくわからないものはあったけど。\nトモキの写真とか……"},
{"id": 27, "kind": "msg", "spk": "そはら", "ja": "ニ、ニンフさんっ！！"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "とにかく、待っててやるから\n急いで水着、取ってこいよ。\n早くしないと遅刻だぞ。"},
{"id": 29, "kind": "msg", "spk": "そはら", "ja": "う、うん！"},
{"id": 30, "kind": "msg", "spk": "そはら", "ja": "……って、\nトモちゃん学校行くつもりなの？\nだって、さっき……。"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "行くに決まってるだろ？\nさっきのアレは冗談だって。"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "学生の本分は勉強だからな！\nああ、早く授業が受けたくって\nワクワクするぜ！"},
{"id": 33, "kind": "msg", "spk": "ニンフ", "ja": "え～～？\n……トモキ、なんか\n嘘っぽいんだけど。"},
{"id": 34, "kind": "msg", "spk": "そはら", "ja": "トモちゃん、やっと真面目に\nなってくれたんだ……。"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "ほらほら、そはら\n早く！"},
{"id": 36, "kind": "msg", "spk": "そはら", "ja": "う、うん！　ちょっと待っててね！"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "そうか……\n……女子の体育は、プールか。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "……ふぅ。"},
{"id": 39, "kind": "msg", "spk": "ニンフ", "ja": "（また遠いところを見るような\n　目をして……）"},
{"id": 40, "kind": "msg", "spk": "イカロス", "ja": "（マスター……\n　なにを考えているのでしょうか？）"},
{"id": 41, "kind": "msg", "spk": "イカロス", "ja": "（……わからないけど、\n　マスターのことだから、\n　きっと素晴らしいこと……）"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "………………フッ。"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "（あ～、女子とプール、入りて～）"},
{"id": 44, "kind": "msg", "spk": "イカロス", "ja": "マスター、なにかご用でしょうか？"},
{"id": 45, "kind": "msg", "spk": "ニンフ", "ja": "なによ、昼休みに校舎裏なんかへ\n呼び出して。"},
{"id": 46, "kind": "msg", "spk": "ニンフ", "ja": "今日は早めに、お昼を食べて\nおきたいんだけど。"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "ああ、知ってるよ。\n次の時間はプールなんだよな。"},
{"id": 48, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "だからこそ、わざわざ\n来てもらったんだ。"},
{"id": 50, "kind": "msg", "spk": "ニンフ", "ja": "……また、なんかバカなこと\n考えてるわけ？"},
{"id": 51, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "ふっふっふっ、\nイカロス、アレを使うぞ！"},
{"id": 53, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 54, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "………………"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "いや、イカロス……\n今の意味、わかってて返事したか！？"},
{"id": 57, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "じゃあ、出せ、アレを出せ！"},
{"id": 59, "kind": "msg", "spk": "ニンフ", "ja": "ちょっと、トモキ、\nアレってなによ？"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "女子がプールなんだぞ！？\nそうきたら、アレを使うしか\nないじゃないか！"},
{"id": 61, "kind": "msg", "spk": "ニンフ", "ja": "プールで使うもの……使うもの……\n浮き輪とか？"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "それが必要なのは、\n泳げないニンフだけだろ？"},
{"id": 63, "kind": "msg", "spk": "イカロス", "ja": "ナマコ……"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "それ、プールじゃなくて、海だろ！？\n使うものでもないし、\nいろいろ間違ってる。"},
{"id": 65, "kind": "msg", "spk": "イカロス", "ja": "はい……。"},
{"id": 66, "kind": "msg", "spk": "智樹", "ja": "女子がプールで使うアレといったら\n量子変換器だよ！！\n俺たちの夢のアイテムじゃないか！"},
{"id": 67, "kind": "msg", "spk": "ニンフ", "ja": "俺たちの夢って……単に変身できるって\nだけのつまんないアイテムじゃない。\n動作もちょっと不安定だし。"},
{"id": 68, "kind": "msg", "spk": "ニンフ", "ja": "前に使ったときも、\n悲惨な目に遭ってたじゃない。\n……いいかげん懲りたら？"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "フッ……できる男は過去を\n振り返らないものさ。\n成功だけを信じて突き進む！"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "さあ、イカロス！"},
{"id": 71, "kind": "msg", "spk": "イカロス", "ja": "これ……ですか？"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "おおおお……！！\nこいつを使えば、俺は……"},
{"id": 73, "kind": "msg", "spk": "智樹", "ja": "よし、イカロス、\nさっそくやってくれ！"},
{"id": 74, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 75, "kind": "msg", "spk": "ニンフ", "ja": "ねぇ……\nもしかして、\n私、関係ないんじゃないの？"},
{"id": 76, "kind": "msg", "spk": "智樹", "ja": "ん？　ああ、そうか。\nニンフ、もう教室に戻っていいぞ。"},
{"id": 77, "kind": "msg", "spk": "ニンフ", "ja": "むっ……役立たずみたいに言われると\n腹立たしいわね。"},
{"id": 78, "kind": "msg", "spk": "ニンフ", "ja": "ちょっとアルファー、\nそれの操作、私にやらせなさいよ。"},
{"id": 79, "kind": "msg", "spk": "イカロス", "ja": "でも……"},
{"id": 80, "kind": "msg", "spk": "ニンフ", "ja": "機器の操作は、\n私の方が上手いでしょ。"},
{"id": 81, "kind": "choice", "spk": "", "ja": "イカロスにやってもらう"},
{"id": 82, "kind": "choice", "spk": "", "ja": "ニンフにやってもらう"},
{"id": 83, "kind": "choice", "spk": "", "ja": "自分でやる"},
{"id": 84, "kind": "msg", "spk": "智樹", "ja": "イカロスがやってくれよ。"},
{"id": 85, "kind": "msg", "spk": "ニンフ", "ja": "えーっ！？\n私の方が絶対に上手いのに！"},
{"id": 86, "kind": "msg", "spk": "イカロス", "ja": "……よろしいのですか、マスター？"},
{"id": 87, "kind": "msg", "spk": "智樹", "ja": "そりゃ、イカロスの\n持ってきたものなんだし、当然だろ。"},
{"id": 88, "kind": "msg", "spk": "智樹", "ja": "イカロスが、ニンフに任せたいなら\n話は別だけどさ。"},
{"id": 89, "kind": "msg", "spk": "イカロス", "ja": "……私がやります。\nマスターの御命令ですから。"},
{"id": 90, "kind": "msg", "spk": "ニンフ", "ja": "はいはい、わかったわよ。\nちょっと暇つぶしになるかと\n思っただけじゃない。"},
{"id": 91, "kind": "msg", "spk": "ニンフ", "ja": "べつに無理にやりたいとは\n言わないわよ。"},
{"id": 92, "kind": "msg", "spk": "智樹", "ja": "んじゃ、やってくれよ、\nイカロス。"},
{"id": 93, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 94, "kind": "msg", "spk": "イカロス", "ja": "量子変換を開始……します。"},
{"id": 95, "kind": "msg", "spk": "トモ子", "ja": "きゃる～～～ん！\nトモ子で～す！"},
{"id": 96, "kind": "msg", "spk": "イカロス", "ja": "量子変換率１００％稼働。\n変化安定オールグリーン……"},
{"id": 97, "kind": "msg", "spk": "イカロス", "ja": "モニターの上では、\n正常です。"},
{"id": 98, "kind": "msg", "spk": "イカロス", "ja": "いかがですか……\nマスター？"},
{"id": 99, "kind": "msg", "spk": "智樹", "ja": "得意だって言うなら\nニンフにやってもらうか。"},
{"id": 100, "kind": "msg", "spk": "ニンフ", "ja": "やった！\nトモキも適材適所ってものが\nわかってるじゃない。"},
{"id": 101, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 102, "kind": "msg", "spk": "イカロス", "ja": "……ニンフ、マスターをお願い……。"},
{"id": 103, "kind": "msg", "spk": "ニンフ", "ja": "それじゃ、やるわよ。"},
{"id": 104, "kind": "msg", "spk": "智樹", "ja": "おう！"},
{"id": 105, "kind": "msg", "spk": "ニンフ", "ja": "量子変換、開始！"},
{"id": 106, "kind": "msg", "spk": "トモ子", "ja": "きゃる～～～ん！\nトモ子で～す！"},
{"id": 107, "kind": "msg", "spk": "ニンフ", "ja": "量子変換率１００％稼働。\n変化安定オールグリーン……っと。\nこれでいいわよね。"},
{"id": 108, "kind": "msg", "spk": "智樹", "ja": "別にどっちでもいいけど……\nそうだ、いっそのこと自分でやるか！\nぽちっ、と。"},
{"id": 109, "kind": "msg", "spk": "ニンフ", "ja": "あ、ばか！"},
{"id": 110, "kind": "msg", "spk": "イカロス", "ja": "マスター！？"},
{"id": 111, "kind": "msg", "spk": "智樹", "ja": "おおお～、湯気……俺は……湯気……\n胸の先っちょや腰のあたりに\nただよいがちな、白い湯気……"},
{"id": 112, "kind": "msg", "spk": "智樹", "ja": "ふわふわ～\nもくもく～\nそよ風に散らされて……"},
{"id": 113, "kind": "msg", "spk": "智樹", "ja": "って！？　やばい……消える！\n俺が空気にまじって……消え……"},
{"id": 114, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}ＢＡＤ　ＥＮＤ"},
{"id": 115, "kind": "msg", "spk": "ニンフ", "ja": "なにやってるのよ、ばか！\n拡散率が一定値を超えたら、\n元に戻せなくなるところよ！？"},
{"id": 116, "kind": "msg", "spk": "イカロス", "ja": "おろおろおろ……"},
{"id": 117, "kind": "msg", "spk": "智樹", "ja": "うお～、死にかけた！"},
{"id": 118, "kind": "msg", "spk": "ニンフ", "ja": "簡単に見えるけど、\n色々と設定があるんだから、\n私たちに任せなさいよね。"},
{"id": 119, "kind": "msg", "spk": "智樹", "ja": "あ、ああ、わかったよ。\nじゃあ、頼む。"},
{"id": 120, "kind": "msg", "spk": "ニンフ", "ja": "うん。\nそれじゃ、やるわよ。"},
{"id": 121, "kind": "msg", "spk": "イカロス", "ja": "おろおろおろ……"},
{"id": 122, "kind": "msg", "spk": "ニンフ", "ja": "量子変換、開始！"},
{"id": 123, "kind": "msg", "spk": "トモ子", "ja": "きゃる～～～ん！\nトモ子で～す！"},
{"id": 124, "kind": "msg", "spk": "ニンフ", "ja": "量子変換率１００％稼働。\n変化安定オールグリーン。\nこんなもんかしらね。"},
{"id": 125, "kind": "msg", "spk": "トモ子", "ja": "うふふ♪\nトモ子、女の子になっちゃった～！"},
{"id": 126, "kind": "msg", "spk": "トモ子", "ja": "この姿になるのって、ひさしぶり～☆"},
{"id": 127, "kind": "msg", "spk": "トモ子", "ja": "どう？　どう？\nうまく女の子に\nなれちゃってる～？"},
{"id": 128, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 129, "kind": "msg", "spk": "ニンフ", "ja": "変身そのものは完璧だけど……\nなに、その変な言葉遣い？"},
{"id": 130, "kind": "msg", "spk": "トモ子", "ja": "わかってないな～。こーゆードジっ娘\nラブリンな感じが男の子のハートを\nズッキュン狙い撃ちなんだから～。"},
{"id": 131, "kind": "msg", "spk": "ニンフ", "ja": "……なに言ってるのか、\n全然意味がわかんないんだけど。"},
{"id": 132, "kind": "msg", "spk": "トモ子", "ja": "あ～、でもホント\nどこから見ても女の子で、\nトモ子、ドキドキしちゃう～。"},
{"id": 133, "kind": "msg", "spk": "トモ子", "ja": "ぺたぺた……さわさわ……"},
{"id": 134, "kind": "msg", "spk": "ニンフ", "ja": "自分の体なんか触って、\nなにやってるのよ？"},
{"id": 135, "kind": "msg", "spk": "トモ子", "ja": "だって～、ちゃんと変身できてるか、\n確かめなきゃ～。"},
{"id": 136, "kind": "msg", "spk": "トモ子", "ja": "きゃんΩ　女の子の体って、\nドキドキしちゃう～☆"},
{"id": 137, "kind": "msg", "spk": "ニンフ", "ja": "ヘ、ヘンタイ！\nバカじゃないの！？\n自分の体なのに、ドキドキとか！"},
{"id": 138, "kind": "msg", "spk": "トモ子", "ja": "冗～談！　ジョ・ウ・ダ・ン・よ～？\nんっふっふーΩ"},
{"id": 139, "kind": "msg", "spk": "ニンフ", "ja": "むー……"},
{"id": 140, "kind": "msg", "spk": "ニンフ", "ja": "私たちは、ご飯食べたいから、\nもう戻るわよ？"},
{"id": 141, "kind": "msg", "spk": "トモ子", "ja": "うん。まったね～Ω"},
{"id": 142, "kind": "msg", "spk": "イカロス", "ja": "マスター……\nあの……"},
{"id": 143, "kind": "msg", "spk": "ニンフ", "ja": "ほら、行くわよ、アルファー。\nあんた食べるの遅いんだから、\n早くしなさいよね。"},
{"id": 144, "kind": "msg", "spk": "イカロス", "ja": "…………うん。"},
{"id": 145, "kind": "msg", "spk": "トモ子", "ja": "んふふふ……\nうふふふふ……"},
{"id": 146, "kind": "choice", "spk": "", "ja": "変身できてるか確かめる"},
{"id": 147, "kind": "choice", "spk": "", "ja": "きっと大丈夫"},
{"id": 148, "kind": "msg", "spk": "トモ子", "ja": "ここも、ここも……\nちゃんと変身できてるかな～？"},
{"id": 149, "kind": "msg", "spk": "トモ子", "ja": "触って、ちゃ～んと\n確かめておかないとね～。\nきゃはっ☆"},
{"id": 150, "kind": "msg", "spk": "トモ子", "ja": "ふぅ～。\n堪能した～。"},
{"id": 151, "kind": "msg", "spk": "トモ子", "ja": "トモ子ったら、どこもかしこも\n隅々までカンペキに\n女の子しちゃってる～！"},
{"id": 152, "kind": "msg", "spk": "トモ子", "ja": "どこもかしこも！！\nどこもかしこも！！"},
{"id": 153, "kind": "msg", "spk": "トモ子", "ja": "ま……別に大丈夫かな～。\n初めてってわけでもないし～。"},
{"id": 154, "kind": "msg", "spk": "トモ子", "ja": "それよりも、他にやりたいこと\nいっぱいあるし……\nうひょひょひょひょひょ！"},
{"id": 155, "kind": "msg", "spk": "トモ子", "ja": "あっ、いっけな～い！\nトモ子、女の子らしくしなくっちゃ。\nきゃる～ん☆"},
{"id": 156, "kind": "msg", "spk": "トモ子", "ja": "じゃあ、さっそく、\n女子とプールに入っちゃおっ！"},
{"id": 157, "kind": "msg", "spk": "トモ子", "ja": "うふ、うふふふ……\nうへへへへ……"},
{"id": 158, "kind": "msg", "spk": "トモ子", "ja": "ハッ！？"},
{"id": 159, "kind": "msg", "spk": "トモ子", "ja": "し、しまった！\n重大なことを……"},
{"id": 160, "kind": "msg", "spk": "トモ子", "ja": "み……\n水着がないじゃない～～～！？"},
{"id": 161, "kind": "msg", "spk": "イカロス", "ja": "お困りですか……マスター？"},
{"id": 162, "kind": "msg", "spk": "トモ子", "ja": "うおっと！？"},
{"id": 163, "kind": "msg", "spk": "トモ子", "ja": "イカロス、昼飯食べに行ったんじゃ！？"},
{"id": 164, "kind": "msg", "spk": "イカロス", "ja": "はい……ですが……\nマスターが困っていると\n感じたので。"},
{"id": 165, "kind": "msg", "spk": "トモ子", "ja": "おお、そうか！\nでかした！"},
{"id": 166, "kind": "msg", "spk": "トモ子", "ja": "じゃなくって……\nトモ子、うれぴ～♪"},
{"id": 167, "kind": "msg", "spk": "トモ子", "ja": "イカロスさん、ありがとう～！\nトモ子、水着に着替えたいの～☆"},
{"id": 168, "kind": "msg", "spk": "イカロス", "ja": "はい……衣服の量子を\n水着に変換します。"},
{"id": 169, "kind": "msg", "spk": "トモ子", "ja": "あっ、待って！"},
{"id": 170, "kind": "msg", "spk": "トモ子", "ja": "今、ここで水着になると、\nプールまでその格好で行くことに\nなるでしょ？"},
{"id": 171, "kind": "msg", "spk": "トモ子", "ja": "トモ子、校内を水着で歩く\n変な人になっちゃう～Ω"},
{"id": 172, "kind": "msg", "spk": "トモ子", "ja": "それに、更衣室にも行きたいし～。\n量子変換器で、水着を出しちゃって\nほしいなぁ～☆"},
{"id": 173, "kind": "msg", "spk": "イカロス", "ja": "……すみません、マスター。"},
{"id": 174, "kind": "msg", "spk": "イカロス", "ja": "量子変換器は、\n姿を変えることはできても、\n増やすことはできません。"},
{"id": 175, "kind": "msg", "spk": "イカロス", "ja": "ですから……水着を新しく出すことは\nできません。"},
{"id": 176, "kind": "msg", "spk": "トモ子", "ja": "えっ！？"},
{"id": 177, "kind": "msg", "spk": "トモ子", "ja": "それじゃあ、着替えができない……？\nつまり……"},
{"id": 178, "kind": "msg", "spk": "トモ子", "ja": "女子とプールに入れない！？\n更衣室にも！？"},
{"id": 179, "kind": "msg", "spk": "トモ子", "ja": "そ、そんな……\nここまでやったのに……"},
{"id": 180, "kind": "msg", "spk": "トモ子", "ja": "ううん！\nあきらめちゃダメよ！\nトモ子、ふぁいとっ！"},
{"id": 181, "kind": "msg", "spk": "トモ子", "ja": "こういうときは、あの人に\n相談してみるのが一番だよねっ！"},
{"id": 182, "kind": "msg", "spk": "イカロス", "ja": "あの人……"},
{"id": 183, "kind": "msg", "spk": "トモ子", "ja": "えっへへ～、トモ子で～っす！"},
{"id": 184, "kind": "msg", "spk": "守形", "ja": "…………なにをしている、智樹？"},
{"id": 185, "kind": "msg", "spk": "トモ子", "ja": "や～ん、トモ子って呼んで、\nおに～いちゃん☆"},
{"id": 186, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 187, "kind": "msg", "spk": "守形", "ja": "フロの覗きなら、\nもう手伝うつもりはないぞ？"},
{"id": 188, "kind": "msg", "spk": "トモ子", "ja": "あ～ん、違うの～。\n今日はね、プールなの♪"},
{"id": 189, "kind": "msg", "spk": "トモ子", "ja": "でも、トモ子、水着持ってくるの、\n忘れちゃって～。\n守形先輩に相談しにきたの～。"},
{"id": 190, "kind": "msg", "spk": "守形", "ja": "ふむ……俺の水着を期待しているなら\n残念だが、持っていないぞ。"},
{"id": 191, "kind": "msg", "spk": "トモ子", "ja": "誰が期待するかーっ！\n男の水着を借りて穿くとか\nなんの罰ゲームだよ、それっ！"},
{"id": 192, "kind": "msg", "spk": "トモ子", "ja": "あ、いけない。言葉、言葉っと……。"},
{"id": 193, "kind": "msg", "spk": "トモ子", "ja": "ていうか～、そもそもこの体に\n男の水着とかマニアックすぎるしー。"},
{"id": 194, "kind": "msg", "spk": "守形", "ja": "しかし、女子の水着など\nなおさら持っていないぞ。"},
{"id": 195, "kind": "msg", "spk": "守形", "ja": "着せ替え人形のための水着なら\nないこともないが。"},
{"id": 196, "kind": "msg", "spk": "トモ子", "ja": "人形の水着じゃ、\nトモ子、入らないってば～。"},
{"id": 197, "kind": "msg", "spk": "守形", "ja": "智樹が小さくなれば、\n入るんじゃないか？"},
{"id": 198, "kind": "msg", "spk": "トモ子", "ja": "水着が入っても\nプールに入れなかったら\n意味ないでしょ～！？"},
{"id": 199, "kind": "msg", "spk": "守形", "ja": "ふむ……\nそれもそうだな。"},
{"id": 200, "kind": "msg", "spk": "守形", "ja": "つまり、人形用のプールを用意しろ\nと言うわけか。\n智樹の家のフロでは、どうだ？"},
{"id": 201, "kind": "msg", "spk": "トモ子", "ja": "なんで、わざわざ人形サイズになって、\n自分の家のフロに入らなきゃ\nいけないんだ！？"},
{"id": 202, "kind": "msg", "spk": "トモ子", "ja": "会話、全然噛み合ってな～い。\nトモ子が入りたいのは、\n女子と一緒にプールなの～！！"},
{"id": 203, "kind": "choice", "spk": "", "ja": "守形先輩なら何とかしてくれる"},
{"id": 204, "kind": "choice", "spk": "", "ja": "無駄足だったかな？"},
{"id": 205, "kind": "choice", "spk": "", "ja": "やっぱりイカロスに頼る"},
{"id": 206, "kind": "msg", "spk": "トモ子", "ja": "守形先輩なら、\nなんとかしてくれるよねっ。\nトモ子、信じてる！"},
{"id": 207, "kind": "msg", "spk": "守形", "ja": "ふむ……"},
{"id": 208, "kind": "msg", "spk": "トモ子", "ja": "あ～あ……\n守形先輩のところに来たの、\n無駄足だったっぽ～い。"},
{"id": 209, "kind": "msg", "spk": "守形", "ja": "そもそも、なぜ女子の水着が\n必要なのに、俺のところへ？"},
{"id": 210, "kind": "msg", "spk": "トモ子", "ja": "だって、守形先輩なら\nなんとかしてくれるかと\n思ったんだもん。"},
{"id": 211, "kind": "msg", "spk": "守形", "ja": "そうか……"},
{"id": 212, "kind": "msg", "spk": "トモ子", "ja": "なんか～、イカロスさんの方が\n頼りになるみたい～。"},
{"id": 213, "kind": "msg", "spk": "イカロス", "ja": "……マスターの\n御命令であれば。"},
{"id": 214, "kind": "msg", "spk": "イカロス", "ja": "このカードで水着を……"},
{"id": 215, "kind": "msg", "spk": "トモ子", "ja": "待った～～～！"},
{"id": 216, "kind": "msg", "spk": "トモ子", "ja": "それで学校じゅうの水着を\n集めるなんて言うんじゃ\nないだろうな！？"},
{"id": 217, "kind": "msg", "spk": "イカロス", "ja": "……です。"},
{"id": 218, "kind": "msg", "spk": "トモ子", "ja": "そんなことしたら、\n大変なことになるだろ！？"},
{"id": 219, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 220, "kind": "msg", "spk": "トモ子", "ja": "はい……じゃない！\nみんなの水着を集めちゃったら、\nプールが中止になっちゃうじゃないか！"},
{"id": 221, "kind": "msg", "spk": "守形", "ja": "問題はそこではないと思うが……"},
{"id": 222, "kind": "msg", "spk": "守形", "ja": "そういえば、美香子が前に\n言っていたことがある……"},
{"id": 223, "kind": "msg", "spk": "守形", "ja": "生徒会では、忘れ物をした生徒のために\nいくつか備品を用意しているらしい。"},
{"id": 224, "kind": "msg", "spk": "守形", "ja": "卒業生が置いていったものを\n保管しているわけだが……"},
{"id": 225, "kind": "msg", "spk": "守形", "ja": "傘やジャージなどがある、と\n言っていた。"},
{"id": 226, "kind": "msg", "spk": "トモ子", "ja": "ジャージまで！？\nそ、それなら……"},
{"id": 227, "kind": "msg", "spk": "守形", "ja": "うむ。"},
{"id": 228, "kind": "msg", "spk": "トモ子", "ja": "スクール水着があっても、\nおかしくないってことだよね～！"},
{"id": 229, "kind": "msg", "spk": "トモ子", "ja": "トモ子、生徒会室に行ってみるっ！\nあはっ！"},
{"id": 230, "kind": "msg", "spk": "守形", "ja": "しかし、智樹……"},
{"id": 231, "kind": "msg", "spk": "トモ子", "ja": "行こっ、イカロスさん！"},
{"id": 232, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。\nそれでは、守形先輩、失礼します。"},
{"id": 233, "kind": "msg", "spk": "トモ子", "ja": "守形先輩、あざーっす！"},
{"id": 234, "kind": "msg", "spk": "守形", "ja": "………………"},
{"id": 235, "kind": "msg", "spk": "守形", "ja": "……女子の姿になっていても、\nそれでは見つかるぞ、智樹。"},
{"id": 236, "kind": "msg", "spk": "トモ子", "ja": "おっじゃっまっ、しま～すっ！"},
{"id": 237, "kind": "msg", "spk": "トモ子", "ja": "あれ～？"},
{"id": 238, "kind": "msg", "spk": "イカロス", "ja": "……マスター、\n誰も居ないようです。"},
{"id": 239, "kind": "msg", "spk": "トモ子", "ja": "うーん、会長がいないと、\n水着が借りられないのに～。"},
{"id": 240, "kind": "msg", "spk": "トモ子", "ja": "ハッ！"},
{"id": 241, "kind": "msg", "spk": "トモ子", "ja": "そもそも……会長はトモ子が\n智樹の変身した姿だって\n知ってるんだから……"},
{"id": 242, "kind": "msg", "spk": "トモ子", "ja": "ふつうに頼んでも\n貸してくれっこないじゃん！？"},
{"id": 243, "kind": "msg", "spk": "トモ子", "ja": "むしろ、いつものように、\nボコボコにされるかも……"},
{"id": 244, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 245, "kind": "msg", "spk": "トモ子", "ja": "それに、そはらだってこの姿\n俺だって知ってるんじゃねえの！？\n授業出たら、即バレるし！"},
{"id": 246, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 247, "kind": "msg", "spk": "トモ子", "ja": "気付いてたなら、言ってくれよ、\nイカロス！？"},
{"id": 248, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 249, "kind": "msg", "spk": "トモ子", "ja": "トモ子、ショック～～！"},
{"id": 250, "kind": "msg", "spk": "トモ子", "ja": "女の子になっても、\n女子と一緒にプールに\n入れないなんて！"},
{"id": 251, "kind": "msg", "spk": "トモ子", "ja": "いやいや……\nあきらめたら、\nそこでＢＡＤ　ＥＮＤだよね☆"},
{"id": 252, "kind": "msg", "spk": "トモ子", "ja": "この量子変換器、石けんにまで\n変身できるくらいなんだから……"},
{"id": 253, "kind": "msg", "spk": "トモ子", "ja": "イカロスさ～ん、もうちょっと\nこう、見た目変えらんない？"},
{"id": 254, "kind": "msg", "spk": "イカロス", "ja": "見た目ですか……\n髪を……"},
{"id": 255, "kind": "msg", "spk": "トモ子", "ja": "あっ、それ、い～かも～！\n髪型を変えるだけでも、ずいぶん\nイメージって変わるし～。"},
{"id": 256, "kind": "msg", "spk": "イカロス", "ja": "髪を……なくしますか？"},
{"id": 257, "kind": "msg", "spk": "トモ子", "ja": "イヤーーー！？\nなんで、ちょっぴりイメチェンが\nハゲになっちゃうの～！？"},
{"id": 258, "kind": "msg", "spk": "トモ子", "ja": "ちょっとでいいの！　ちょっとで！"},
{"id": 259, "kind": "msg", "spk": "イカロス", "ja": "そこまで細かい調整だと、\nうまくできるかわかりませんが……"},
{"id": 260, "kind": "msg", "spk": "イカロス", "ja": "……やってみます。"},
{"id": 261, "kind": "msg", "spk": "トモ子", "ja": "きら～ん☆"},
{"id": 262, "kind": "msg", "spk": "トモ子", "ja": "って……変わった？\n変わってる？"},
{"id": 263, "kind": "msg", "spk": "イカロス", "ja": "……はい。"},
{"id": 264, "kind": "msg", "spk": "トモ子", "ja": "あ、ホントだ。髪、長～い！\nこれなら、そはらだって、\nそうそう気付かないよねっ？"},
{"id": 265, "kind": "msg", "spk": "トモ子", "ja": "体育は隣のクラスと合同だから、\n見慣れない人がいても、さほど\n気にしないだろうし～☆"},
{"id": 266, "kind": "msg", "spk": "トモ子", "ja": "……って、それにしても、\n会長、来ないな～。"},
{"id": 267, "kind": "msg", "spk": "トモ子", "ja": "はぁ……トモ子、\n待ちくたびれちゃったぁ。"},
{"id": 268, "kind": "msg", "spk": "イカロス", "ja": "マスター……ここに……"},
{"id": 269, "kind": "msg", "spk": "トモ子", "ja": "どれどれ？\nあれぇ、このロッカー\n『貸し出し用』ってことは……"},
{"id": 270, "kind": "msg", "spk": "トモ子", "ja": "ここに、忘れ物した生徒に\n貸し出す備品があるってこと？"},
{"id": 271, "kind": "msg", "spk": "イカロス", "ja": "はい……そのようです。"},
{"id": 272, "kind": "msg", "spk": "トモ子", "ja": "じゃあ、このロッカーの中に\n水着が！　女子の水着！"},
{"id": 273, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ガタガタ！"},
{"id": 274, "kind": "msg", "spk": "トモ子", "ja": "あ、あれ……？　開かない？"},
{"id": 275, "kind": "msg", "spk": "トモ子", "ja": "なんか引っかかってるのかなぁ？\nあ、鍵がかかってるのかも？"},
{"id": 276, "kind": "msg", "spk": "トモ子", "ja": "や～ん、このロッカー開かな～い。\nトモ子、困っちゃう！"},
{"id": 277, "kind": "msg", "spk": "イカロス", "ja": "マスターが……お困りに……"},
{"id": 278, "kind": "msg", "spk": "イカロス", "ja": "わかりました。\n……排除します。"},
{"id": 279, "kind": "msg", "spk": "トモ子", "ja": "えっ！？"},
{"id": 280, "kind": "msg", "spk": "イカロス", "ja": "……はぁぁぁッ！"},
{"id": 281, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ドガンッ！"},
{"id": 282, "kind": "msg", "spk": "トモ子", "ja": "うわっ！？"},
{"id": 283, "kind": "msg", "spk": "トモ子", "ja": "お、お前……\nどうすんだよ、ロッカーのドア\n壊しちゃって！？"},
{"id": 284, "kind": "msg", "spk": "イカロス", "ja": "マスターが困っていたので……"},
{"id": 285, "kind": "msg", "spk": "トモ子", "ja": "今のほうが、余計に困ってるよ！\nなんでもかんでも排除するな！"},
{"id": 286, "kind": "msg", "spk": "トモ子", "ja": "……じゃなくって、\nなんでもかんでも排除したら、\nダメだぞ～☆"},
{"id": 287, "kind": "msg", "spk": "イカロス", "ja": "……はい、マスター。"},
{"id": 288, "kind": "msg", "spk": "トモ子", "ja": "まあ、やっちゃったもんは\nしょうがないよね……\n中、見てみようっと。"},
{"id": 289, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}ガサゴソ……"},
{"id": 290, "kind": "msg", "spk": "トモ子", "ja": "ん～。筆記用具に、傘に……\nあ、ほんとにジャージまである。"},
{"id": 291, "kind": "msg", "spk": "トモ子", "ja": "ん～、ん～。"},
{"id": 292, "kind": "msg", "spk": "イカロス", "ja": "水着は、ありませんね。"},
{"id": 293, "kind": "msg", "spk": "トモ子", "ja": "そうね～。\n水着はないみたい。"},
{"id": 294, "kind": "msg", "spk": "トモ子", "ja": "まあ、ジャージはあっても\n体操着や靴下はないし……"},
{"id": 295, "kind": "msg", "spk": "トモ子", "ja": "さすがに肌に触れるものは\n貸し出してないってことみたい～。"},
{"id": 296, "kind": "msg", "spk": "イカロス", "ja": "索敵モード……\n水着を、スキャンします……"},
{"id": 297, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ピピピ……"},
{"id": 298, "kind": "msg", "spk": "イカロス", "ja": "……発見しました。\n至近距離に１点。"},
{"id": 299, "kind": "msg", "spk": "トモ子", "ja": "えっ！？\n水着、あるの！？"},
{"id": 300, "kind": "msg", "spk": "イカロス", "ja": "はい、マスター。\nこの……机の下に……"},
{"id": 301, "kind": "msg", "spk": "トモ子", "ja": "会長の席の下って……"},
{"id": 302, "kind": "msg", "spk": "トモ子", "ja": "そ、それは！？\n会長のじゃない！？"},
{"id": 303, "kind": "msg", "spk": "イカロス", "ja": "はい……\n会長さんの水着と思われます。"},
{"id": 304, "kind": "msg", "spk": "トモ子", "ja": "………………"},
{"id": 305, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 306, "kind": "msg", "spk": "トモ子", "ja": "………………"},
{"id": 307, "kind": "choice", "spk": "", "ja": "ちょっとくらい、いいよね"},
{"id": 308, "kind": "choice", "spk": "", "ja": "そういうのはよくないよね"},
{"id": 309, "kind": "choice", "spk": "", "ja": "むしろ大オッケー"},
{"id": 310, "kind": "msg", "spk": "トモ子", "ja": "えへへ……"},
{"id": 311, "kind": "msg", "spk": "トモ子", "ja": "ちょっとくらい借りたって、\n平気だよね～？\nあとで、ちゃんと返すんだし～。"},
{"id": 312, "kind": "msg", "spk": "イカロス", "ja": "わかりました。\nちょっと借りても、\nあとで返せばいい……"},
{"id": 313, "kind": "msg", "spk": "トモ子", "ja": "うっ。"},
{"id": 314, "kind": "msg", "spk": "イカロス", "ja": "どうしましたか、マスター？"},
{"id": 315, "kind": "msg", "spk": "トモ子", "ja": "い、いや、ダメだぞ、イカロス。\n人のものを壊したり、\n無断で借りたりしちゃ。"},
{"id": 316, "kind": "msg", "spk": "トモ子", "ja": "……ま、そういうのって、\nやっぱダメだよね～。"},
{"id": 317, "kind": "msg", "spk": "イカロス", "ja": "いけないこと……ですか？"},
{"id": 318, "kind": "msg", "spk": "トモ子", "ja": "うん、人のものを壊したり、\n無断で借りたりしちゃダメだよ☆\nトモ子のお願いΩ"},
{"id": 319, "kind": "msg", "spk": "トモ子", "ja": "ふおおおぉぉぉ～、くんくん、\nすーはー！"},
{"id": 320, "kind": "msg", "spk": "イカロス", "ja": "……あの、マスター？"},
{"id": 321, "kind": "msg", "spk": "トモ子", "ja": "たまんないわぁ……はぁ、はぁ……"},
{"id": 322, "kind": "msg", "spk": "トモ子", "ja": "会長の水着、むしろアリ！\n大オッケーーー！"},
{"id": 323, "kind": "msg", "spk": "トモ子", "ja": "別に、ただちょっと着るだけだしー。\nあとで返せば、全然問題ないしー。"},
{"id": 324, "kind": "msg", "spk": "イカロス", "ja": "わかりました。\nちょっと借りても、\nあとで返せばいい……"},
{"id": 325, "kind": "msg", "spk": "トモ子", "ja": "うっ。"},
{"id": 326, "kind": "msg", "spk": "イカロス", "ja": "どうしましたか、マスター？"},
{"id": 327, "kind": "msg", "spk": "トモ子", "ja": "い、いや、ダメダメ！\n人のものを壊したり、無断で借りたり\nしたらいけないんだって！"},
{"id": 328, "kind": "msg", "spk": "美香子", "ja": "その通りよ～。\n立派だわ、桜井くん～。"},
{"id": 329, "kind": "msg", "spk": "トモ子", "ja": "えへへ、それほどでも～。\nトモ子ったら、照れちゃう～。"},
{"id": 330, "kind": "msg", "spk": "トモ子", "ja": "って……\nえ………………\nかい、ちょ、お……"},
{"id": 331, "kind": "msg", "spk": "美香子", "ja": "本当に立派な言葉だと思うわ～。"},
{"id": 332, "kind": "msg", "spk": "トモ子", "ja": "ひいいいぃぃぃ～～～！？"},
{"id": 333, "kind": "msg", "spk": "美香子", "ja": "ロッカーが壊れてたり……"},
{"id": 334, "kind": "msg", "spk": "トモ子", "ja": "ちょっ……\nどこから取り出したんですか、\nその日本刀！？"},
{"id": 335, "kind": "msg", "spk": "", "ja": "　\n{1F}{0D}ビシュ！　ザシュ！　ジュバババ！"},
{"id": 336, "kind": "msg", "spk": "美香子", "ja": "会長の水着をつかんだりしてなければ、\nほんと立派な言葉よ～。"},
{"id": 337, "kind": "msg", "spk": "トモ子", "ja": "今度は拳銃～～～！？"},
{"id": 338, "kind": "msg", "spk": "", "ja": "　\n{1F}{10}バキューン！　バキューン！"},
{"id": 339, "kind": "msg", "spk": "美香子", "ja": "おしおきよ～。おしおきだわ～。\n極刑ね～。"},
{"id": 340, "kind": "msg", "spk": "トモ子", "ja": "ぐわわわ～！？\n逃げるぞ、イカロス！！"},
{"id": 341, "kind": "msg", "spk": "イカロス", "ja": "……はい。"},
{"id": 342, "kind": "msg", "spk": "美香子", "ja": "爆殺よ～！"},
{"id": 343, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}チュドーン！！"},
{"id": 344, "kind": "msg", "spk": "トモ子", "ja": "う……ううぅ……"},
{"id": 345, "kind": "msg", "spk": "イカロス", "ja": "ご無事ですか、マスター？"},
{"id": 346, "kind": "msg", "spk": "トモ子", "ja": "ああ……\n酷い目に遭ったなー。"},
{"id": 347, "kind": "msg", "spk": "トモ子", "ja": "うぅ……\nもう時間がない。"},
{"id": 348, "kind": "msg", "spk": "トモ子", "ja": "昼休みが、終わる……\nチャイムが鳴って、\n女子がプールに入って……"},
{"id": 349, "kind": "msg", "spk": "トモ子", "ja": "俺は……ただ見ていることも\nできないなんて……"},
{"id": 350, "kind": "msg", "spk": "トモ子", "ja": "スクール水着……\nスクール水着さえあれば……！"},
{"id": 351, "kind": "msg", "spk": "イカロス", "ja": "マスター……\nこれを使ってください。"},
{"id": 352, "kind": "msg", "spk": "トモ子", "ja": "えっ！？\nそのスクール水着は！？"},
{"id": 353, "kind": "msg", "spk": "イカロス", "ja": "私のです。\nこれがあれば、マスターは、\n喜びますか？"},
{"id": 354, "kind": "msg", "spk": "トモ子", "ja": "そりゃ、俺は嬉しいさ！\nけど……イカロスは……？"},
{"id": 355, "kind": "msg", "spk": "トモ子", "ja": "おまえが、プールに\n入れなくなっちゃうじゃないか！\n女子とプールに……"},
{"id": 356, "kind": "msg", "spk": "イカロス", "ja": "私は水に浮かびませんから、\n誰とプールに入っても\n沈んでいるだけです。"},
{"id": 357, "kind": "msg", "spk": "イカロス", "ja": "プールに入るなら……\n私はマスターと一緒がいいです。"},
{"id": 358, "kind": "msg", "spk": "トモ子", "ja": "うう……\nいいのか、イカロス？"},
{"id": 359, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 360, "kind": "msg", "spk": "トモ子", "ja": "くうっ……\nおまえ、いいやつだな！"},
{"id": 361, "kind": "msg", "spk": "トモ子", "ja": "うっふっふ～♪\nとうとう来ちゃった～！"},
{"id": 362, "kind": "msg", "spk": "トモ子", "ja": "女・子・更・衣・室！！"},
{"id": 363, "kind": "msg", "spk": "イカロス", "ja": "はい。"},
{"id": 364, "kind": "msg", "spk": "トモ子", "ja": "えへへ……えへへ……"},
{"id": 365, "kind": "msg", "spk": "トモ子", "ja": "って……なんで\nほとんど人がいないの～？"},
{"id": 366, "kind": "msg", "spk": "ニンフ", "ja": "……ああ、結局来たんだ、トモキ。"},
{"id": 367, "kind": "msg", "spk": "トモ子", "ja": "お、ニンフか。"},
{"id": 368, "kind": "msg", "spk": "ニンフ", "ja": "なんか雰囲気が変わってたから、\n一瞬、わからなかったけど……。"},
{"id": 369, "kind": "msg", "spk": "トモ子", "ja": "あはっ、イメチェンしたのΩ\nで、みんなはどうしたの～？"},
{"id": 370, "kind": "msg", "spk": "トモ子", "ja": "着替え中の、\nあられもない姿の女子は\nどこどこ～？"},
{"id": 371, "kind": "msg", "spk": "ニンフ", "ja": "ほとんどの子は、もう着替えて\nプールの方に行っちゃってるわよ。"},
{"id": 372, "kind": "msg", "spk": "トモ子", "ja": "え……ええ～～～っ！？"},
{"id": 373, "kind": "msg", "spk": "ニンフ", "ja": "そろそろ着替えないと、チャイムまでに\nプールサイドに集合できないでしょ。"},
{"id": 374, "kind": "msg", "spk": "トモ子", "ja": "くっ……\n一緒に着替えたかった……"},
{"id": 375, "kind": "msg", "spk": "トモ子", "ja": "発育具合を確かめ合ったり、\n触りっこをしたり、\n親睦を深めるスキンシップを……！"},
{"id": 376, "kind": "msg", "spk": "トモ子", "ja": "……でも、それはプール\n出たあとでもアリだし～。\nまずはプールだよね、うん☆"},
{"id": 377, "kind": "msg", "spk": "トモ子", "ja": "あれ？　ニンフさんは、なんで\nまだ着替えてないの～？"},
{"id": 378, "kind": "msg", "spk": "ニンフ", "ja": "アルファーが遅いから\n待ってたんだけど……。"},
{"id": 379, "kind": "msg", "spk": "ニンフ", "ja": "あれ、アルファー。\n水着はどうしたの？"},
{"id": 380, "kind": "msg", "spk": "イカロス", "ja": "私の水着は、\nマスターが使います。"},
{"id": 381, "kind": "msg", "spk": "ニンフ", "ja": "……なにやってんのよ、アンタ。"},
{"id": 382, "kind": "msg", "spk": "トモ子", "ja": "えっへへ～。\nイカロスさんの水着、\n借りちゃった～☆"},
{"id": 383, "kind": "msg", "spk": "ニンフ", "ja": "借りちゃった～☆じゃないでしょ！？"},
{"id": 384, "kind": "msg", "spk": "トモ子", "ja": "だって、トモ子\n水着持ってないんだもん。"},
{"id": 385, "kind": "msg", "spk": "イカロス", "ja": "私には、元々不要なものですし……\nマスターが喜んでくださるのでしたら。"},
{"id": 386, "kind": "msg", "spk": "ニンフ", "ja": "確かにエンジェロイドは泳げないけど、\nそういう問題じゃ……ああ、もう\n突っ込むのも疲れるわ。"},
{"id": 387, "kind": "msg", "spk": "そはら", "ja": "あ、イカロスさん、いた！"},
{"id": 388, "kind": "msg", "spk": "イカロス", "ja": "そはらさん……\nどうかしましたか？"},
{"id": 389, "kind": "msg", "spk": "そはら", "ja": "更衣室にも来ないし、\n教室にもいないから、\n捜しちゃったよ～。"},
{"id": 390, "kind": "msg", "spk": "ニンフ", "ja": "ああ、そはらも来ないなと\n思ってたけど……\nアルファー捜しに行ってたんだ。"},
{"id": 391, "kind": "msg", "spk": "そはら", "ja": "えへへ……\nつい気になっちゃって。"},
{"id": 392, "kind": "msg", "spk": "そはら", "ja": "あれ？　そっちの子……。"},
{"id": 393, "kind": "msg", "spk": "そはら", "ja": "…………。"},
{"id": 394, "kind": "msg", "spk": "トモ子", "ja": "（お、落ち着け、俺！\n　大丈夫、大丈夫！　外見も変えたし、\n　堂々と振舞うんだ！）"},
{"id": 395, "kind": "msg", "spk": "トモ子", "ja": "いや～ん、急がないと遅刻しちゃう～。\n早く着替えましょっΩ"},
{"id": 396, "kind": "msg", "spk": "そはら", "ja": "……あなたって\nどっかで見たことがあるような……？\n隣のクラスの子かな？"},
{"id": 397, "kind": "msg", "spk": "トモ子", "ja": "そ、そうなの～。"},
{"id": 398, "kind": "msg", "spk": "トモ子", "ja": "（よしっ！　セーフ！）"},
{"id": 399, "kind": "msg", "spk": "そはら", "ja": "…………なんて言うとでも思った？"},
{"id": 400, "kind": "msg", "spk": "トモ子", "ja": "ビクッ！？"},
{"id": 401, "kind": "msg", "spk": "ニンフ", "ja": "……あーあ、やっぱりそうなるわよね。"},
{"id": 402, "kind": "msg", "spk": "トモ子", "ja": "えっ！？　えっ！？　えっ！？"},
{"id": 403, "kind": "msg", "spk": "そはら", "ja": "トモちゃん……\nここ女子更衣室だよね？"},
{"id": 404, "kind": "msg", "spk": "トモ子", "ja": "は、はい……"},
{"id": 405, "kind": "msg", "spk": "そはら", "ja": "女子の水着持って……\nそんな格好して……\nなにやってるの？"},
{"id": 406, "kind": "msg", "spk": "トモ子", "ja": "え……いや……\n女子とプールに入りたくて……"},
{"id": 407, "kind": "msg", "spk": "トモ子", "ja": "てへっ☆"},
{"id": 408, "kind": "msg", "spk": "そはら", "ja": "トモちゃんの、バカ～～～～～！！！"},
{"id": 409, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}ぐしゃあっ！"},
{"id": 410, "kind": "msg", "spk": "智樹", "ja": "うぇ……うぇ……"},
{"id": 411, "kind": "msg", "spk": "智樹", "ja": "ボコられたうえに、\nプールにも入れなくて……"},
{"id": 412, "kind": "msg", "spk": "イカロス", "ja": "マスターが……泣いています。"},
{"id": 413, "kind": "msg", "spk": "ニンフ", "ja": "……ま、あれは気付くわよね。"},
{"id": 414, "kind": "msg", "spk": "智樹", "ja": "どうして、俺だってわかったんだ？"},
{"id": 415, "kind": "msg", "spk": "智樹", "ja": "体育は隣のクラスと合同だから、\n見慣れない顔がいても、\nそこまで気にならないと思ったのに！"},
{"id": 416, "kind": "msg", "spk": "智樹", "ja": "見た目だって、\nちゃんと変わってたよな！？"},
{"id": 417, "kind": "msg", "spk": "ニンフ", "ja": "まぁ、雰囲気は違ってたかもね。\n私だって、すぐにはわかんなかったし。"},
{"id": 418, "kind": "msg", "spk": "智樹", "ja": "じゃあ、どうしてわかったんだ！？\n野生の勘か！？"},
{"id": 419, "kind": "msg", "spk": "ニンフ", "ja": "だって……アルファーがそんなに\nそばに付き添ってるなんて、\nトモキに決まってるじゃない。"},
{"id": 420, "kind": "msg", "spk": "イカロス", "ja": "はい……私は、マスターの\nエンジェロイドですから……。\nいつもそばにいます。"},
{"id": 421, "kind": "msg", "spk": "智樹", "ja": "あ……"},
{"id": 422, "kind": "msg", "spk": "智樹", "ja": "そのせいかあぁぁ～～～！！"}
]}
