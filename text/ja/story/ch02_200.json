{"file": "_Data/Script/Other/Story/Chapter02/200.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "……さて、そろそろ\nそはらの警戒も解けた頃だよな。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "シールが貼ってある可能性は\nあいつが一番高いわけだし、\nいいかげんチェックしに行かないとな。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "さーて、どこに行ったかなぁ。\nどうせその辺の河原に\nいるとは思うが……。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "ま、適当に捜してみるか。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "お、いたいた、そはら。\nそれに、イカロスも一緒か。"},
{"id": 5, "kind": "msg", "spk": "イカロス", "ja": "マスター……？"},
{"id": 6, "kind": "msg", "spk": "そはら", "ja": "トモちゃん？\nどうしたの？"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "（お、どうやらもう怒っては\n　いないみたいだな。よしよし）"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "いや、ちょっと暇だったからさ。\n２人はなにしてるんだ？"},
{"id": 9, "kind": "msg", "spk": "そはら", "ja": "イカロスさんと、おしゃべりしてたの。"},
{"id": 10, "kind": "msg", "spk": "イカロス", "ja": "はい、おしゃべりを……\nあと、スイカをなでていました。"},
{"id": 11, "kind": "msg", "spk": "そはら", "ja": "そういえば、イカロスさん\nずっとスイカなでてたよね。"},
{"id": 12, "kind": "msg", "spk": "そはら", "ja": "……というか、ほとんど私だけが\nおしゃべりしてて、イカロスさんは\nスイカをなでてたような。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "お前ってホント、\nスイカ好きだよなぁ……。"},
{"id": 14, "kind": "msg", "spk": "イカロス", "ja": "はい。好き……です。"},
{"id": 15, "kind": "msg", "spk": "イカロス", "ja": "こけしも好き……です。"},
{"id": 16, "kind": "msg", "spk": "イカロス", "ja": "あと……ひよこ、も。"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "……考えてみると、統一性が\n全然ないっていうか……\n変なもんばっか好きになるよな。"},
{"id": 18, "kind": "msg", "spk": "イカロス", "ja": "あの……マスターの\nお気に召しませんでしたか？"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "あ、いや、別にそういうことじゃ\nないんだ。なにを好きになろうと\nイカロスの自由だし。"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "ところで、おしゃべりって\nなに話してたんだ？\nエロトークか？"},
{"id": 21, "kind": "msg", "spk": "そはら", "ja": "トモちゃんじゃないんだから……"},
{"id": 22, "kind": "msg", "spk": "そはら", "ja": "べつに、たいした話はしてないよね。\nねー、イカロスさん？"},
{"id": 23, "kind": "msg", "spk": "イカロス", "ja": "はい……そはらさんは……\nいろいろ、お話してくださいました。"},
{"id": 24, "kind": "msg", "spk": "イカロス", "ja": "マスターの朝の様子とか。\nマスターの昼の様子とか。\nマスターの夜の様子とか。"},
{"id": 25, "kind": "msg", "spk": "イカロス", "ja": "最近のマスターの好き嫌いとか。\nマスターと行った海の話とか。\nマスターが購入されたエッチな本とか。"},
{"id": 26, "kind": "msg", "spk": "イカロス", "ja": "マスターとそはらさんが\n幼い頃に山奥で迷子になって\nその時そはらさんが……"},
{"id": 27, "kind": "msg", "spk": "そはら", "ja": "キャアアァァーーー！！！"},
{"id": 28, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ばしゅっ！"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "ふごっ！？"},
{"id": 30, "kind": "msg", "spk": "そはら", "ja": "イ、イ、イカロスさん！？\nそういう話はトモちゃんには\n言わないで！！"},
{"id": 31, "kind": "msg", "spk": "イカロス", "ja": "……はい。わかりました。\nマスターには言いません。"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "いや、なんで今\nチョップされたんだよ、俺……？"},
{"id": 33, "kind": "msg", "spk": "そはら", "ja": "ト、トモちゃんが悪いんだよっ！"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "なんでだ！？"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "（わけがわからん。\n　もうさっさと本題に入ろう）"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "（２人とも、まだ調べてないわけだが。\n　さて、どっちから調べようか……？）"},
{"id": 37, "kind": "choice", "spk": "", "ja": "イカロスを調べる"},
{"id": 38, "kind": "choice", "spk": "", "ja": "そはらを調べる"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "（そはらはさっき失敗してるからな。\n　イカロスの方が調べやすそうだ）"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "なぁ、イカロス、\nちょっと来てもらえるか？"},
{"id": 41, "kind": "msg", "spk": "イカロス", "ja": "はい、マスター……"},
{"id": 42, "kind": "msg", "spk": "そはら", "ja": "え？　ちょっと、トモちゃん。\nイカロスさんとどこ行くの？"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "ん～。まぁ、その辺だよ。\n散歩みたいなもんだ。イカロスは\n連れてっても構わないな？"},
{"id": 44, "kind": "msg", "spk": "そはら", "ja": "……う、うん。\n行ってらっしゃい。"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "おう。\nんじゃイカロス、行くぞ。"},
{"id": 46, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 47, "kind": "msg", "spk": "そはら", "ja": "………………"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "（この辺でいいかな）"},
{"id": 49, "kind": "msg", "spk": "イカロス", "ja": "マスター……\nご用件はなんでしょうか？"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "ん。おお……"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "（さて、なんて言おうか……\n　カードのことは秘密だしなぁ）"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "（……でも、イカロスなら\n　触らせろって言えば\n　素直に触らせてくれそうだよな）"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "あー、その、イカロス。"},
{"id": 54, "kind": "msg", "spk": "イカロス", "ja": "はい。"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "ちょっと体を触ってもいいか？"},
{"id": 56, "kind": "msg", "spk": "イカロス", "ja": "……え。\nなぜ、ですか？"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "うーん、その……"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "触りたいから……じゃ、ダメか？"},
{"id": 59, "kind": "msg", "spk": "イカロス", "ja": "マスターが……私の体に\n触れたい……のですか？"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "あ、ああ。"},
{"id": 61, "kind": "msg", "spk": "イカロス", "ja": "……わかりました。\n勿論、私はマスターが望むとおりに。\nですが……その……"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "なんだ？"},
{"id": 63, "kind": "msg", "spk": "イカロス", "ja": "……私はエンジェロイドです。\n人間とは、少し違うかも……"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "な、なんだそんなことか。\nぜんぜん気にしないって。"},
{"id": 65, "kind": "msg", "spk": "イカロス", "ja": "……はい。"},
{"id": 66, "kind": "msg", "spk": "イカロス", "ja": "では……どうぞ。"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "おお～、さすがイカロス。\n話が早くて助かるぜ。"},
{"id": 68, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}{16}{17}トクン。"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "（……あれ？）"},
{"id": 70, "kind": "msg", "spk": "", "ja": "　\n{1F}{15}トクン。トクン。"},
{"id": 71, "kind": "msg", "spk": "智樹", "ja": "（あれ……なんで俺こんなに\n　ドキドキしてんだ？）"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "（素直に触らせてくれて、\n　なんの危険もないってのに、\n　妙に緊張しちゃってるな……）"},
{"id": 73, "kind": "msg", "spk": "智樹", "ja": "（ていうか、そはらとか\n　クラスの女子とか触るとき、\n　こんな緊張したことあったっけか？）"},
{"id": 74, "kind": "msg", "spk": "イカロス", "ja": "……マスター？"},
{"id": 75, "kind": "msg", "spk": "智樹", "ja": "いや、なんでもない。なんでもない。"},
{"id": 76, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 77, "kind": "msg", "spk": "智樹", "ja": "（よくわからんが、緊張してる\n　場合じゃないぞ。とっとと体を\n　こすってシールを確かめないと）"},
{"id": 78, "kind": "msg", "spk": "智樹", "ja": "よ、よーし。\nそれじゃ、触るぞ。いいか？"},
{"id": 79, "kind": "msg", "spk": "イカロス", "ja": "……あ。"},
{"id": 80, "kind": "msg", "spk": "智樹", "ja": "ん？　どうしたイカロス？"},
{"id": 81, "kind": "msg", "spk": "イカロス", "ja": "……いえ、後ろに……"},
{"id": 82, "kind": "msg", "spk": "智樹", "ja": "後ろ？"},
{"id": 83, "kind": "msg", "spk": "そはら", "ja": "………………"},
{"id": 84, "kind": "msg", "spk": "智樹", "ja": "そ、そはら！？"},
{"id": 85, "kind": "msg", "spk": "そはら", "ja": "……トモちゃん、\nなにやってるの？"},
{"id": 86, "kind": "msg", "spk": "智樹", "ja": "い、いや……これは……"},
{"id": 87, "kind": "msg", "spk": "そはら", "ja": "いつも、そんなふうに、\nイカロスさんに、エッチな命令\nしてるの？"},
{"id": 88, "kind": "msg", "spk": "智樹", "ja": "いや、今日は、特別に！\nこれには事情が……"},
{"id": 89, "kind": "msg", "spk": "智樹", "ja": "（ダメだ！　言えない！\n　会長が、どこで聞いてるか\n　わかったもんじゃねえ！）"},
{"id": 90, "kind": "msg", "spk": "そはら", "ja": "トモちゃんの……バカーーーー！！！"},
{"id": 91, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ずぎゃっ！"},
{"id": 92, "kind": "msg", "spk": "智樹", "ja": "ヴァギャア！！"},
{"id": 93, "kind": "msg", "spk": "そはら", "ja": "まったくもう！\nトモちゃんはいつもエッチなんだから！"},
{"id": 94, "kind": "msg", "spk": "智樹", "ja": "うぐ、まだ頭いてぇ……"},
{"id": 95, "kind": "msg", "spk": "そはら", "ja": "自業自得だよ！"},
{"id": 96, "kind": "msg", "spk": "智樹", "ja": "（クッソー、\n　俺にだって事情があんだよ）"},
{"id": 97, "kind": "msg", "spk": "智樹", "ja": "（やっぱり可能性は\n　そはらの方が高いしなぁ……）"},
{"id": 98, "kind": "msg", "spk": "智樹", "ja": "そはら、ちょっといいか？"},
{"id": 99, "kind": "msg", "spk": "そはら", "ja": "ん？　なに、トモちゃん。"},
{"id": 100, "kind": "msg", "spk": "智樹", "ja": "話したいことがあるんだけど、\n少し向こう行かないか？"},
{"id": 101, "kind": "msg", "spk": "そはら", "ja": "わ、私に用事？"},
{"id": 102, "kind": "msg", "spk": "智樹", "ja": "ああ。"},
{"id": 103, "kind": "msg", "spk": "そはら", "ja": "……やだ。"},
{"id": 104, "kind": "msg", "spk": "智樹", "ja": "へ？"},
{"id": 105, "kind": "msg", "spk": "そはら", "ja": "トモちゃん、さっきから\nなんか変なんだもん。\nまたエッチなこと考えてるでしょ。"},
{"id": 106, "kind": "msg", "spk": "智樹", "ja": "（ギクッ！）"},
{"id": 107, "kind": "msg", "spk": "そはら", "ja": "……トモちゃん、\n今、ギクッてしなかった？"},
{"id": 108, "kind": "msg", "spk": "智樹", "ja": "ハハハ……\nな、なに言ってるんだよ、\nそんなわけないだろ？"},
{"id": 109, "kind": "msg", "spk": "そはら", "ja": "……そう？\nじゃあ、話ってなに？\nここで話してよ。"},
{"id": 110, "kind": "msg", "spk": "智樹", "ja": "え？　そ、それは……"},
{"id": 111, "kind": "msg", "spk": "そはら", "ja": "それは？"},
{"id": 112, "kind": "msg", "spk": "智樹", "ja": "……"},
{"id": 113, "kind": "msg", "spk": "そはら", "ja": "……"},
{"id": 114, "kind": "msg", "spk": "智樹", "ja": "（ヤ、ヤバい！　なにか適当なこと\n　言ってごまかさねば！\n　て、適当なこと、適当なこと……）"},
{"id": 115, "kind": "msg", "spk": "智樹", "ja": "…………そはら\nまた太ったんじゃないか？"},
{"id": 116, "kind": "msg", "spk": "そはら", "ja": "………………"},
{"id": 117, "kind": "msg", "spk": "智樹", "ja": "（しまったーーーーっ！！）"},
{"id": 118, "kind": "msg", "spk": "そはら", "ja": "トモちゃんの、\nバカーーー！！"},
{"id": 119, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ずぎゃっ！"},
{"id": 120, "kind": "msg", "spk": "智樹", "ja": "グハァッ！！"},
{"id": 121, "kind": "msg", "spk": "智樹", "ja": "やれやれ……\nこりゃ、しばらく、\nそはらには近づけないな。"},
{"id": 122, "kind": "msg", "spk": "智樹", "ja": "最も可能性の高いそはらが\n調べられないとなると、\nかなりまずいような気が……。"},
{"id": 123, "kind": "msg", "spk": "智樹", "ja": "いや……しかし考えてみれば、\nそはらにシールを貼るなんて\nひねりのないこと、会長がするか？"},
{"id": 124, "kind": "msg", "spk": "智樹", "ja": "会長の性格的には、裏をかいて\nきそうだし、そはら以外を調べた方が\n正解なのかも……。"},
{"id": 125, "kind": "msg", "spk": "守形", "ja": "おや、智樹じゃないか。"},
{"id": 126, "kind": "msg", "spk": "智樹", "ja": "あれ、守形先輩？\nそれにアストレアも……。"},
{"id": 127, "kind": "msg", "spk": "守形", "ja": "今日は朝から、\nなんだか忙しそうに歩き回ってるな。\nどうかしたのか？"},
{"id": 128, "kind": "msg", "spk": "智樹", "ja": "え？　い、いえ、別に……\nそれより、先輩たちは\n何してるんスか？"},
{"id": 129, "kind": "msg", "spk": "守形", "ja": "アストレアが魚を釣ってきたので\n焼いているところだ。"},
{"id": 130, "kind": "msg", "spk": "智樹", "ja": "ええっ？　魚って……\n長靴だったんじゃないですか？"},
{"id": 131, "kind": "msg", "spk": "守形", "ja": "そうだが、たまたま\nその中に１匹隠れていてな。"},
{"id": 132, "kind": "msg", "spk": "アストレア", "ja": "どう、すごいでしょう！"},
{"id": 133, "kind": "msg", "spk": "智樹", "ja": "いや、全然すごくないから。\nどう見ても、ただの偶然じゃん。"},
{"id": 134, "kind": "msg", "spk": "守形", "ja": "まぁ、捕れたのは事実だから、\nいいだろう。"},
{"id": 135, "kind": "msg", "spk": "アストレア", "ja": "えへへ。\nスガタさん、まだですか？"},
{"id": 136, "kind": "msg", "spk": "守形", "ja": "まだ火が通ってない。\nもう少し待て。"},
{"id": 137, "kind": "msg", "spk": "アストレア", "ja": "うー、早く焼けないかな～？"},
{"id": 138, "kind": "msg", "spk": "智樹", "ja": "（そうだ、いい機会だから\n　アストレアのやつを調べておくか）"},
{"id": 139, "kind": "msg", "spk": "智樹", "ja": "（もしそはらでないとすれば、\n　バカでうかつなこいつは\n　最も貼り付けやすいだろうしな）"},
{"id": 140, "kind": "msg", "spk": "智樹", "ja": "（けど、イカロスじゃあるまいし、\n　ただ触らせろと言っても無理だし。\n　さて、なんと言うかな）"},
{"id": 141, "kind": "msg", "spk": "智樹", "ja": "よし……アストレア、\n鬼ごっこしないか？"},
{"id": 142, "kind": "msg", "spk": "アストレア", "ja": "やだ。"},
{"id": 143, "kind": "msg", "spk": "智樹", "ja": "即答かよ！"},
{"id": 144, "kind": "msg", "spk": "アストレア", "ja": "だって、２人で鬼ごっこなんて\nつまんないじゃない。\n今は魚がいつ焼けるか気になるし。"},
{"id": 145, "kind": "msg", "spk": "智樹", "ja": "ぐぐぐ……じゃあ、これならどうだ！\n名付けて、人体７不思議\n暗号探しゲ～～～ムッ！"},
{"id": 146, "kind": "msg", "spk": "アストレア", "ja": "まっだかな？　まっだかな～？\nって、なにそれ？"},
{"id": 147, "kind": "msg", "spk": "守形", "ja": "俺も聞いたことがないな。"},
{"id": 148, "kind": "msg", "spk": "智樹", "ja": "そりゃそうですよ。\nこれは最先端のゲームですからね。"},
{"id": 149, "kind": "msg", "spk": "アストレア", "ja": "最先端！？\n……って、なに？"},
{"id": 150, "kind": "msg", "spk": "守形", "ja": "簡単に言えば、最も進んでる……\nまぁ新しいものだと考えれば\n間違いないだろうな。"},
{"id": 151, "kind": "msg", "spk": "智樹", "ja": "（フッ……なにしろ、\n　俺が今考えたばっかだからな！\n　最新であることは間違いないぜ！）"},
{"id": 152, "kind": "msg", "spk": "智樹", "ja": "ルールは、お互い自分の体に\n７文字の文を書く。"},
{"id": 153, "kind": "msg", "spk": "智樹", "ja": "そして、先に相手の書いた\n文字を読んだ方の勝ちな。"},
{"id": 154, "kind": "msg", "spk": "アストレア", "ja": "へぇー、なんだか面白そう……。"},
{"id": 155, "kind": "msg", "spk": "アストレア", "ja": "う……で、でも魚が焼けるのは\n気になるし……"},
{"id": 156, "kind": "msg", "spk": "智樹", "ja": "フッ……そうか、\nやっぱり逃げるんだな。"},
{"id": 157, "kind": "msg", "spk": "アストレア", "ja": "なっ？"},
{"id": 158, "kind": "msg", "spk": "智樹", "ja": "まぁ、当然か。シナプス最高の\n近接戦闘用とかなんとか言っても\n所詮はただのヴァカだしな！"},
{"id": 159, "kind": "msg", "spk": "智樹", "ja": "このハイセンスで\n高度でテクニシャンなゲームで\n勝つ自信がないんだなぁ～。"},
{"id": 160, "kind": "msg", "spk": "智樹", "ja": "まぁいいや。\n不戦敗はかわいそうだから引き分けに\nしておいてやってもいいぞ～。ワハハ！"},
{"id": 161, "kind": "msg", "spk": "アストレア", "ja": "なに言ってるのよ！\n負けはアンタの方に決まってるでしょ！"},
{"id": 162, "kind": "msg", "spk": "アストレア", "ja": "その７なんとかゲームってのに勝って、\n今度こそ私の優秀さを\n証明してやるんだから！"},
{"id": 163, "kind": "msg", "spk": "智樹", "ja": "ゲーム名を数字しか覚えられない時点で\nお前のバカは確定してるだろ。バーカ！"},
{"id": 164, "kind": "msg", "spk": "アストレア", "ja": "絶対、アンタなんかには\n負けないんだからね！\nバーカ、バーカ！"},
{"id": 165, "kind": "msg", "spk": "守形", "ja": "……魚は俺が責任をもって、\nいい具合に焼いておこう。"},
{"id": 166, "kind": "msg", "spk": "智樹", "ja": "……フッ、アストレア、\n準備はいいか？"},
{"id": 167, "kind": "msg", "spk": "アストレア", "ja": "とっくにできてるわよ！"},
{"id": 168, "kind": "msg", "spk": "守形", "ja": "では、俺が審判を\n務めさせてもらう。"},
{"id": 169, "kind": "msg", "spk": "守形", "ja": "制限時間は３分としよう。\nその頃には、魚が焼けるからな。"},
{"id": 170, "kind": "msg", "spk": "守形", "ja": "では、用意{16}{15}"},
{"id": 171, "kind": "msg", "spk": "智樹", "ja": "……！"},
{"id": 172, "kind": "msg", "spk": "アストレア", "ja": "……！"},
{"id": 173, "kind": "msg", "spk": "守形", "ja": "開始！"},
{"id": 174, "kind": "msg", "spk": "アストレア", "ja": "やぁあああー！！"},
{"id": 175, "kind": "msg", "spk": "智樹", "ja": "ぬおっ！？\n危ねっ！"},
{"id": 176, "kind": "msg", "spk": "智樹", "ja": "（あやうく、捕まるところだった……\n　さすがに速ぇな！）"},
{"id": 177, "kind": "msg", "spk": "アストレア", "ja": "よくかわしたわね。\nほめてあげる。"},
{"id": 178, "kind": "msg", "spk": "智樹", "ja": "へっへっへっ、もっと本気を\n出していいんだぜ？"},
{"id": 179, "kind": "msg", "spk": "アストレア", "ja": "あらっ、そう！"},
{"id": 180, "kind": "msg", "spk": "アストレア", "ja": "なら、この一撃で\n終わらせてあげるわ！"},
{"id": 181, "kind": "msg", "spk": "智樹", "ja": "んなっ！？\n……消えた！？"},
{"id": 182, "kind": "msg", "spk": "アストレア", "ja": "掴まえた！"},
{"id": 183, "kind": "msg", "spk": "智樹", "ja": "のわっ！？"},
{"id": 184, "kind": "msg", "spk": "智樹", "ja": "クソッ……！"},
{"id": 185, "kind": "msg", "spk": "アストレア", "ja": "へへーん。シナプス最高のスピードを\n誇る私にアンタがついてこれるはず\nないでしょ！"},
{"id": 186, "kind": "msg", "spk": "アストレア", "ja": "さぁ、覚悟！"},
{"id": 187, "kind": "msg", "spk": "智樹", "ja": "（{16}{17}フッ、甘いなアストレア）"},
{"id": 188, "kind": "msg", "spk": "アストレア", "ja": "さーて、どうせ背中とかに\n書いてあるんでしょ……\nあれ？　ない？"},
{"id": 189, "kind": "msg", "spk": "アストレア", "ja": "じゃあお腹？\n……ない？\nえ、じゃあ……？"},
{"id": 190, "kind": "msg", "spk": "智樹", "ja": "どーした、アストレア？\n俺の服は……まだ残ってるぜ？"},
{"id": 191, "kind": "msg", "spk": "アストレア", "ja": "ま、まさか……！"},
{"id": 192, "kind": "msg", "spk": "智樹", "ja": "そーさ！\n俺が文字を隠したのは……\nズボンの中だ！"},
{"id": 193, "kind": "msg", "spk": "アストレア", "ja": "なぁあああ～～～！？"},
{"id": 194, "kind": "msg", "spk": "智樹", "ja": "隙アリ～！！"},
{"id": 195, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}むにょんっ"},
{"id": 196, "kind": "msg", "spk": "アストレア", "ja": "キャアーーーッ！？"},
{"id": 197, "kind": "msg", "spk": "智樹", "ja": "うっひょっひょっひょ！\nたまりませんなぁ！"},
{"id": 198, "kind": "msg", "spk": "アストレア", "ja": "バカ！　なにしてんのよ！\n反則、反則～！"},
{"id": 199, "kind": "msg", "spk": "守形", "ja": "いや、残念ながら、どこを触ると\n反則というルールはないぞ。"},
{"id": 200, "kind": "msg", "spk": "智樹", "ja": "ダァーハッハッハ！\nこうやって相手のペースを乱すのも\n立派な心理戦だ！"},
{"id": 201, "kind": "msg", "spk": "智樹", "ja": "ほ～れ、ほ～れ！"},
{"id": 202, "kind": "msg", "spk": "", "ja": "　\n{1F}{10}むにょんっむにょむにょんっ"},
{"id": 203, "kind": "msg", "spk": "智樹", "ja": "ほうほう、結構な\nたわわっぷりで。"},
{"id": 204, "kind": "msg", "spk": "アストレア", "ja": "きゃあああ～～～！！"},
{"id": 205, "kind": "msg", "spk": "智樹", "ja": "うはははっ。\nあっ、それ！　それ！"},
{"id": 206, "kind": "msg", "spk": "智樹", "ja": "さーて、どこにあるかな～？"},
{"id": 207, "kind": "msg", "spk": "智樹", "ja": "（文字なんかどうでもいいから、\n　シールを探さないとな！）"},
{"id": 208, "kind": "msg", "spk": "アストレア", "ja": "いやぁー！"},
{"id": 209, "kind": "msg", "spk": "智樹", "ja": "ぬはー、サイコー！"},
{"id": 210, "kind": "msg", "spk": "アストレア", "ja": "くっ、この……調子に乗るなー！"},
{"id": 211, "kind": "msg", "spk": "", "ja": "　\n{1F}{1A}ズルッ"},
{"id": 212, "kind": "msg", "spk": "智樹", "ja": "あふん！"},
{"id": 213, "kind": "msg", "spk": "智樹", "ja": "（こ、こいつ……\n　俺のズボンを下ろしやがった！？）"},
{"id": 214, "kind": "msg", "spk": "アストレア", "ja": "こ、これくらい、恥ずかしくなんか\nないんだから！\n今すぐ読み上げてやるー！"},
{"id": 215, "kind": "msg", "spk": "アストレア", "ja": "さーて、アンタの書いた文字は……\nなっ！？"},
{"id": 216, "kind": "msg", "spk": "智樹", "ja": "さー、どうした！\n読んでくれるんだろ？\n早く読め！"},
{"id": 217, "kind": "msg", "spk": "アストレア", "ja": "う、うぅぅ～～～……"},
{"id": 218, "kind": "msg", "spk": "アストレア", "ja": "漢字が読めない！"},
{"id": 219, "kind": "msg", "spk": "智樹", "ja": "ウヒヒヒ、再び隙アリ～！"},
{"id": 220, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}むにょんっ"},
{"id": 221, "kind": "msg", "spk": "アストレア", "ja": "きゃあああああ～～～～～～！！"},
{"id": 222, "kind": "msg", "spk": "そはら", "ja": "……なにやってるの、トモちゃん？"},
{"id": 223, "kind": "msg", "spk": "智樹", "ja": "びくぅ！！！"},
{"id": 224, "kind": "msg", "spk": "そはら", "ja": "……アストレアさん、\n嫌がってるよね？"},
{"id": 225, "kind": "msg", "spk": "智樹", "ja": "こ、これは最先端のゲームなんだよ。\nそのゲームで、お互いのプライドを\nかけた真剣勝負を……"},
{"id": 226, "kind": "msg", "spk": "そはら", "ja": "どうせ、トモちゃんが\n勝手に考えたゲームなんでしょ？"},
{"id": 227, "kind": "msg", "spk": "智樹", "ja": "うおっ、み、見抜かれてるっ！？"},
{"id": 228, "kind": "msg", "spk": "そはら", "ja": "おまけに、ズボンまで下ろして……"},
{"id": 229, "kind": "msg", "spk": "智樹", "ja": "い、いや！　これを下ろしたのは\nアストレアだから！\nこれはホント！"},
{"id": 230, "kind": "msg", "spk": "そはら", "ja": "信じられるわけ……ないでしょっ！！"},
{"id": 231, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}ぐしゃあっ！"},
{"id": 232, "kind": "msg", "spk": "智樹", "ja": "はうおっ！！"},
{"id": 233, "kind": "msg", "spk": "智樹", "ja": "あぐあぐ…………"},
{"id": 234, "kind": "msg", "spk": "イカロス", "ja": "マスター……大丈夫ですか？"},
{"id": 235, "kind": "msg", "spk": "そはら", "ja": "イカロスさん、甘やかしちゃ\nダメだよ！"},
{"id": 236, "kind": "msg", "spk": "守形", "ja": "息をしていないようだが……"},
{"id": 237, "kind": "msg", "spk": "そはら", "ja": "いいんです！"},
{"id": 238, "kind": "msg", "spk": "守形", "ja": "……そういえば、見月とイカロスは\nどうしてここに戻ってきたんだ？"},
{"id": 239, "kind": "msg", "spk": "そはら", "ja": "え？　どうしてって言われても、\n別に用事があったわけじゃ……"},
{"id": 240, "kind": "msg", "spk": "そはら", "ja": "ただ、あまり遠くまで行ってると、\n帰る時間に間に合わないなとは\n思いましたけど……。"},
{"id": 241, "kind": "msg", "spk": "守形", "ja": "うむ、普通はそうなるな。"},
{"id": 242, "kind": "msg", "spk": "そはら", "ja": "あの、先輩。\nどうかしたんですか？"},
{"id": 243, "kind": "msg", "spk": "守形", "ja": "気にするほどのことでは\nないかもしれんが……さっきから\nニンフの姿が見えない。"},
{"id": 244, "kind": "msg", "spk": "智樹", "ja": "ニンフ？　そう言えば……\n俺が最後に会ったのって\nいつだったっけ……？"},
{"id": 245, "kind": "msg", "spk": "守形", "ja": "俺は、朝食が終わってからは\n見ていない。"},
{"id": 246, "kind": "msg", "spk": "そはら", "ja": "私も、朝食以降は見てないかな……。"},
{"id": 247, "kind": "msg", "spk": "アストレア", "ja": "私、ずっと川のほうにいましたけど、\n見てませんよ。"},
{"id": 248, "kind": "msg", "spk": "イカロス", "ja": "私も……見ていません。"},
{"id": 249, "kind": "msg", "spk": "イカロス", "ja": "……少々お待ちください。"},
{"id": 250, "kind": "msg", "spk": "イカロス", "ja": "広域レーダー展開……"},
{"id": 251, "kind": "msg", "spk": "イカロス", "ja": "……\n…………レーダーに反応なし。"},
{"id": 252, "kind": "msg", "spk": "イカロス", "ja": "ステルス機能を使っているのかも\nしれません。"},
{"id": 253, "kind": "msg", "spk": "守形", "ja": "ふむ……まぁ、ニンフも\nエンジェロイドだ。\n心配はないとは思うが……"},
{"id": 254, "kind": "msg", "spk": "守形", "ja": "帰りの時間もあるしな。\n居場所の確認くらいはしておいた方が\nいいかもしれん。"},
{"id": 255, "kind": "msg", "spk": "そはら", "ja": "そういえば、会長の姿も\n見当たらないけど……"},
{"id": 256, "kind": "msg", "spk": "守形", "ja": "美香子なら、まぁ、大丈夫だろう。\n緊急連絡手段も\n持っているようだしな。"},
{"id": 257, "kind": "msg", "spk": "智樹", "ja": "俺は今朝から、\nもう何度も見てますしね……。"},
{"id": 258, "kind": "msg", "spk": "智樹", "ja": "（ていうか、今も俺の監視を\n　してるかもしれないし！）"},
{"id": 259, "kind": "msg", "spk": "智樹", "ja": "まぁ、会長はともかく、\nニンフのやつは捜しに行った方が\nいいのかなぁ。"},
{"id": 260, "kind": "msg", "spk": "そはら", "ja": "そうだね。みんなで手分けすれば、\nすぐ見つかるんじゃない？"},
{"id": 261, "kind": "msg", "spk": "アストレア", "ja": "がんばります！"},
{"id": 262, "kind": "msg", "spk": "守形", "ja": "待て……\n捜しに行って、自分たちの方が\n遭難してしまっては意味がない。"},
{"id": 263, "kind": "msg", "spk": "守形", "ja": "智樹はイカロスと、\n見月はアストレアと。\nそれぞれペアを組んで行くといい。"},
{"id": 264, "kind": "msg", "spk": "守形", "ja": "エンジェロイドがいれば、\n空を飛んで戻ってこられるだろう。"},
{"id": 265, "kind": "msg", "spk": "そはら", "ja": "守形先輩は……？"},
{"id": 266, "kind": "msg", "spk": "守形", "ja": "俺は１人で大丈夫だ。"},
{"id": 267, "kind": "msg", "spk": "守形", "ja": "１時間ほど捜したら見つからなくても、\nここへ集合すること。いいな？"},
{"id": 268, "kind": "name", "spk": "そはら", "ja": "智樹＆そはら"},
{"id": 269, "kind": "msg", "spk": "智樹＆そはら", "ja": "わかりました。"},
{"id": 270, "kind": "msg", "spk": "智樹", "ja": "ったく、ニンフのやつ。\nどこ行ったんだ～？"},
{"id": 271, "kind": "msg", "spk": "イカロス", "ja": "……すみません。\nニンフのステルス機能は、\n私のレーダーより高性能ですので。"},
{"id": 272, "kind": "msg", "spk": "智樹", "ja": "いや、別にイカロスに文句言ってる\nわけじゃないんだけどな……"},
{"id": 273, "kind": "msg", "spk": "智樹", "ja": "まー、せっかくみんなで来てるんだから\n周りに迷惑かけんなって話だよ。"},
{"id": 274, "kind": "msg", "spk": "イカロス", "ja": "……はい。"},
{"id": 275, "kind": "msg", "spk": "智樹", "ja": "ん？　そういやイカロス。\nスイカは？"},
{"id": 276, "kind": "msg", "spk": "イカロス", "ja": "……置いてきました。\n川の水が涼しそうだったので。"},
{"id": 277, "kind": "msg", "spk": "智樹", "ja": "そっか。"},
{"id": 278, "kind": "msg", "spk": "智樹", "ja": "（……気になるのかな？\n　たまに後ろを振り返ってるよな）"},
{"id": 279, "kind": "msg", "spk": "智樹", "ja": "（まぁ、山の動物に食われちまう\n　かもしれないし……\n　気になるのは当たり前か）"},
{"id": 280, "kind": "msg", "spk": "智樹", "ja": "…………"},
{"id": 281, "kind": "msg", "spk": "イカロス", "ja": "…………"},
{"id": 282, "kind": "msg", "spk": "智樹", "ja": "（黙っててもつまんないし……\n　なんかイカロスとしゃべるか……）"},
{"id": 283, "kind": "choice", "spk": "", "ja": "イカロスのことを話題にする"},
{"id": 284, "kind": "choice", "spk": "", "ja": "ニンフのことを話題にする"},
{"id": 285, "kind": "choice", "spk": "", "ja": "エッチなことを話題にする"},
{"id": 286, "kind": "msg", "spk": "智樹", "ja": "イカロスって、スイカが好きだよな。\nじゃあ、メロンは？"},
{"id": 287, "kind": "msg", "spk": "イカロス", "ja": "メロン……ですか？"},
{"id": 288, "kind": "msg", "spk": "智樹", "ja": "ほら、スイカとメロンって似てるだろ？"},
{"id": 289, "kind": "msg", "spk": "智樹", "ja": "そんだけスイカ好きなら\nどうなのかなーって？"},
{"id": 290, "kind": "msg", "spk": "イカロス", "ja": "どう……でしょうか？\nメロンはあまり触れたことが\nありませんので……"},
{"id": 291, "kind": "msg", "spk": "智樹", "ja": "そうか～。こんどはメロンも\n買ってみるといいかもな。"},
{"id": 292, "kind": "msg", "spk": "智樹", "ja": "みんなでメロンも\n食べてみようぜ。\n楽しみだな！"},
{"id": 293, "kind": "msg", "spk": "イカロス", "ja": "……はい。\n楽しみです……。"},
{"id": 294, "kind": "msg", "spk": "智樹", "ja": "ニンフってさー、昼ドラが好きだよな。"},
{"id": 295, "kind": "msg", "spk": "イカロス", "ja": "はい……そのようです。"},
{"id": 296, "kind": "msg", "spk": "智樹", "ja": "昼ドラって、おもしろいのかなー？"},
{"id": 297, "kind": "msg", "spk": "イカロス", "ja": "……私は、よく分かりませんが。"},
{"id": 298, "kind": "msg", "spk": "イカロス", "ja": "ニンフはいつも見ているから、\n面白いのだと思います。"},
{"id": 299, "kind": "msg", "spk": "智樹", "ja": "それもそうだな。\n今度、一緒に見てみようかな。"},
{"id": 300, "kind": "msg", "spk": "智樹", "ja": "こういう暑い季節は、\n町行く人がみんな薄着でいいよなー。"},
{"id": 301, "kind": "msg", "spk": "イカロス", "ja": "いい……なにが、ですか？"},
{"id": 302, "kind": "msg", "spk": "智樹", "ja": "そりゃ薄着だと\n体のラインが出やすいだろ！"},
{"id": 303, "kind": "msg", "spk": "智樹", "ja": "それに、生地が薄いと色々透けるし！\n肌とか！　ブラひもとか！"},
{"id": 304, "kind": "msg", "spk": "イカロス", "ja": "……透けると、\nマスターは嬉しいのですか？"},
{"id": 305, "kind": "msg", "spk": "智樹", "ja": "そりゃもう！　それに、半袖の子が\n吊り革につかまったりしてるとき、\n脇の辺りから……"},
{"id": 306, "kind": "msg", "spk": "イカロス", "ja": "…………"},
{"id": 307, "kind": "msg", "spk": "智樹", "ja": "…………"},
{"id": 308, "kind": "msg", "spk": "智樹", "ja": "（ダ、ダメだ！\n　イカロス相手にこんな話題で、\n　会話になるわけないじゃん！）"},
{"id": 309, "kind": "msg", "spk": "智樹", "ja": "（ていうか、イカロスじゃなくても\n　常識で考えて、こんな話題に\n　乗ってくる女はいねーーっ！！）"},
{"id": 310, "kind": "msg", "spk": "智樹", "ja": "（だが！　彼女いない歴＝年齢の俺が、\n　女性と話すときの気の利いた話題など\n　知ってるわけないぜ！）"},
{"id": 311, "kind": "msg", "spk": "智樹", "ja": "（…………はぁ）"},
{"id": 312, "kind": "msg", "spk": "智樹", "ja": "……しかし、ニンフのやつ\n見つからないなぁ……どこ行ったんだ？"},
{"id": 313, "kind": "msg", "spk": "イカロス", "ja": "…………"},
{"id": 314, "kind": "msg", "spk": "智樹", "ja": "ん？　どうした、イカロス？\n急に黙って。"},
{"id": 315, "kind": "msg", "spk": "イカロス", "ja": "いえ、マスター。\n気のせいかもしれませんが……\nなにか聞こえるような。"},
{"id": 316, "kind": "msg", "spk": "智樹", "ja": "え？　聞こえるって？"},
{"id": 317, "kind": "msg", "spk": "ニンフ", "ja": "……あれ？\nトモキにアルファーじゃないの。"},
{"id": 318, "kind": "msg", "spk": "智樹", "ja": "うわっ！？　ど、どこにいたんだよ！\n急に現れて！"},
{"id": 319, "kind": "msg", "spk": "ニンフ", "ja": "さっきからずっとここにいたわよ。\nトモキたちが来たから、\nステルス切っただけで。"},
{"id": 320, "kind": "msg", "spk": "ニンフ", "ja": "ていうか、静かにしてよ、トモキ。\nこんなとこまでなにしに来たの？"},
{"id": 321, "kind": "msg", "spk": "智樹", "ja": "戻ってこないから心配で\n捜しにきたんじゃねえか……\nじきに帰る時間だぞ？"},
{"id": 322, "kind": "msg", "spk": "ニンフ", "ja": "え……？\n私を……捜しに？"},
{"id": 323, "kind": "msg", "spk": "智樹", "ja": "いなくなったら捜しに行くのが\n当たり前だろ。\nイカロス、時間は？"},
{"id": 324, "kind": "msg", "spk": "イカロス", "ja": "はい……\n集合の時間まで、\nあと１５分３２秒です。"},
{"id": 325, "kind": "msg", "spk": "智樹", "ja": "そっか。\nよし、じゃあ、先輩たちも\n待ってるから飛んで帰るか。"},
{"id": 326, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 327, "kind": "msg", "spk": "ニンフ", "ja": "あっ、待って……"},
{"id": 328, "kind": "msg", "spk": "智樹", "ja": "ん？　どうした？"},
{"id": 329, "kind": "msg", "spk": "ニンフ", "ja": "雛鳥が……"},
{"id": 330, "kind": "msg", "spk": "智樹", "ja": "雛鳥？"},
{"id": 331, "kind": "msg", "spk": "ニンフ", "ja": "そう、あそこの枝の巣。"},
{"id": 332, "kind": "msg", "spk": "", "ja": "　\n{1F}{14}ぴぃーっ　ぴぃーっ"},
{"id": 333, "kind": "msg", "spk": "智樹", "ja": "えーと……ああ、鳥の巣があるな。\n鳴き声はあそこからか。"},
{"id": 334, "kind": "msg", "spk": "智樹", "ja": "で、あれがどうかしたのか？"},
{"id": 335, "kind": "msg", "spk": "ニンフ", "ja": "さっきまで親鳥がいたんだけど\n急にいなくなっちゃったきり、\n帰ってこないの……"},
{"id": 336, "kind": "msg", "spk": "ニンフ", "ja": "それであの子、巣から飛ぼうとして……\n失敗して落ちそうになって……\n助けたから、ケガはなかったんだけど。"},
{"id": 337, "kind": "msg", "spk": "ニンフ", "ja": "また落ちないかなって心配で……\n親鳥、帰ってこないし……"},
{"id": 338, "kind": "msg", "spk": "智樹", "ja": "あー、なるほど。\nそれでずっと気になって\n見てたわけか。"},
{"id": 339, "kind": "msg", "spk": "智樹", "ja": "……じゃあ、もしかして\nステルスで隠れてたのも\n雛鳥を驚かせないためか？"},
{"id": 340, "kind": "msg", "spk": "ニンフ", "ja": "……うん。"},
{"id": 341, "kind": "msg", "spk": "智樹", "ja": "そっか……。\nでも、大丈夫だよ、ニンフ。\nあの雛鳥は今から大人になるんだ。"},
{"id": 342, "kind": "msg", "spk": "ニンフ", "ja": "今から……大人に？"},
{"id": 343, "kind": "msg", "spk": "智樹", "ja": "雛鳥ってのは、\nまず親鳥の飛び方を見て\n覚えるんだ。"},
{"id": 344, "kind": "msg", "spk": "智樹", "ja": "それで、時期が来たら\n親鳥は巣を離れる。"},
{"id": 345, "kind": "msg", "spk": "智樹", "ja": "お腹を空かせた雛鳥が\n自力で飛ぶように仕向けるのさ。"},
{"id": 346, "kind": "msg", "spk": "ニンフ", "ja": "でも、もし雛鳥が飛べなかったら\nどうするの？"},
{"id": 347, "kind": "msg", "spk": "ニンフ", "ja": "さっきだってケガしそうだったのに……\n無責任じゃない？"},
{"id": 348, "kind": "msg", "spk": "智樹", "ja": "そりゃ、ケガしたらマズイけどさ……\n結局、飛べない鳥は生きていけないから\nここで頑張るしかないだろ。"},
{"id": 349, "kind": "msg", "spk": "智樹", "ja": "なにより……\nあの雛鳥だって、空を飛びたいと\n思ってるんじゃないのか？"},
{"id": 350, "kind": "msg", "spk": "ニンフ", "ja": "あ……"},
{"id": 351, "kind": "msg", "spk": "智樹", "ja": "せっかく羽があるんだし、\n自分の力で飛びたいはずだろ？"},
{"id": 352, "kind": "msg", "spk": "ニンフ", "ja": "……うん。\nそうでしょうね。"},
{"id": 353, "kind": "msg", "spk": "", "ja": "　\n{1F}{14}ピィーッ　ピィーッ"},
{"id": 354, "kind": "name", "spk": "ニンフ", "ja": "智樹＆ニンフ"},
{"id": 355, "kind": "msg", "spk": "智樹＆ニンフ", "ja": "あっ……"},
{"id": 356, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ばささっ"},
{"id": 357, "kind": "msg", "spk": "ニンフ", "ja": "飛んだ……！"},
{"id": 358, "kind": "msg", "spk": "智樹", "ja": "ほらな。"},
{"id": 359, "kind": "msg", "spk": "智樹", "ja": "そんじゃ、戻るか。"},
{"id": 360, "kind": "msg", "spk": "ニンフ", "ja": "……うん。"},
{"id": 361, "kind": "msg", "spk": "智樹", "ja": "じゃあ、イカロス、\n俺を運んでくれよ。"},
{"id": 362, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 363, "kind": "msg", "spk": "ニンフ", "ja": "あ……待って、アルファー！"},
{"id": 364, "kind": "msg", "spk": "イカロス", "ja": "なに……ニンフ？"},
{"id": 365, "kind": "msg", "spk": "ニンフ", "ja": "えーと……\nわ、私がトモキを運ぶわ。"},
{"id": 366, "kind": "msg", "spk": "智樹", "ja": "え？　なんでだよ？"},
{"id": 367, "kind": "msg", "spk": "ニンフ", "ja": "私だって、ちゃんと羽があるんだから、\n大丈夫よ！"},
{"id": 368, "kind": "msg", "spk": "ニンフ", "ja": "今、鳥のこと教えてもらったから……\nまぁ、ほんのお礼よ。"},
{"id": 369, "kind": "msg", "spk": "智樹", "ja": "そうか？\n別にお礼されるほどのことじゃ\nないんだけど……ま、いいか。"},
{"id": 370, "kind": "msg", "spk": "智樹", "ja": "イカロス、先に行って\n先輩たちに、ニンフを見つけたって、\n伝えてくれよ。"},
{"id": 371, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 372, "kind": "msg", "spk": "イカロス", "ja": "では……先に行っています。"},
{"id": 373, "kind": "msg", "spk": "智樹", "ja": "おう。また、後でなー！"},
{"id": 374, "kind": "msg", "spk": "智樹", "ja": "おし、じゃあ、俺たちも……\nあ、いや、待てよ！？"},
{"id": 375, "kind": "msg", "spk": "ニンフ", "ja": "ん？\nどうしたのよ、トモキ？"},
{"id": 376, "kind": "msg", "spk": "智樹", "ja": "（今、俺とニンフの\n　２人っきりだよな……？）"},
{"id": 377, "kind": "msg", "spk": "智樹", "ja": "（シールのことを調べる\n　チャンスじゃないか？）"},
{"id": 378, "kind": "msg", "spk": "智樹", "ja": "ニンフ……\nあー、その……\nあ、あぁー！　虫！　虫ついてるぞ！"},
{"id": 379, "kind": "msg", "spk": "ニンフ", "ja": "虫？　そんなの感じないけど。\nレーダーにも、反応は……"},
{"id": 380, "kind": "msg", "spk": "智樹", "ja": "いーから！\n取ってやるから、こっち来いよ。"},
{"id": 381, "kind": "msg", "spk": "ニンフ", "ja": "…………？"},
{"id": 382, "kind": "msg", "spk": "智樹", "ja": "ほ、ほら！　早く早く！"},
{"id": 383, "kind": "msg", "spk": "ニンフ", "ja": "……はぁ。どういうつもりかは\nよくわからないけど……。"},
{"id": 384, "kind": "msg", "spk": "ニンフ", "ja": "でも、トモキがそうしたいって\n言うんなら……\nまぁ、さっきのお礼もあるし……。"},
{"id": 385, "kind": "msg", "spk": "ニンフ", "ja": "ほら、これでいい？\n……早くその虫とやらを\n取ってよね。"},
{"id": 386, "kind": "msg", "spk": "智樹", "ja": "おう、任せとけ！"},
{"id": 387, "kind": "msg", "spk": "智樹", "ja": "（ふぅ、今度は自然に騙せたな！\n　さあ……調べるぜー！）"},
{"id": 388, "kind": "msg", "spk": "智樹", "ja": "（ふぃ～、ごちそうさまでした！\n　じゃないや……調べ尽くしたぜ！）"},
{"id": 389, "kind": "msg", "spk": "智樹", "ja": "（にしても、ニンフにもシールは\n　貼ってないみたいだな）"},
{"id": 390, "kind": "msg", "spk": "智樹", "ja": "ニンフ、もういいぞ。\n虫、取れたから。"},
{"id": 391, "kind": "msg", "spk": "ニンフ", "ja": "はぁ、はぁ……んぅ。"},
{"id": 392, "kind": "msg", "spk": "智樹", "ja": "ニンフ？\nお、おい、転ぶぞ！？　大丈夫か？"},
{"id": 393, "kind": "msg", "spk": "ニンフ", "ja": "ダメ……力、入んない。"},
{"id": 394, "kind": "msg", "spk": "智樹", "ja": "なにぃー！？"},
{"id": 395, "kind": "msg", "spk": "ニンフ", "ja": "だって……トモキが\nあんなに、体こするから……\nなんか、変な感じで……"},
{"id": 396, "kind": "msg", "spk": "智樹", "ja": "しまった……\nなんだかやりすぎたか？"},
{"id": 397, "kind": "msg", "spk": "智樹", "ja": "で、でも、それじゃあ\nどうやって山を下りるんだよ？"},
{"id": 398, "kind": "msg", "spk": "ニンフ", "ja": "ムリ……飛べない。"},
{"id": 399, "kind": "msg", "spk": "智樹", "ja": "マジかよ！？\nううむ……ほら、つかまれよ。"},
{"id": 400, "kind": "msg", "spk": "ニンフ", "ja": "……え？"},
{"id": 401, "kind": "msg", "spk": "智樹", "ja": "ちゃんと歩けないんだろ？\nほら、早く。"},
{"id": 402, "kind": "msg", "spk": "ニンフ", "ja": "う、うん…………。"},
{"id": 403, "kind": "msg", "spk": "智樹", "ja": "ふぅ……意外にキャンプ、遠いなぁ。"},
{"id": 404, "kind": "msg", "spk": "ニンフ", "ja": "ごめんね……トモキ。"},
{"id": 405, "kind": "msg", "spk": "智樹", "ja": "いや、俺も悪かったし。\n気にすんなって。"},
{"id": 406, "kind": "msg", "spk": "ニンフ", "ja": "次は、ちゃんと飛ぶから。"},
{"id": 407, "kind": "msg", "spk": "智樹", "ja": "ああ、そうだな。"},
{"id": 408, "kind": "msg", "spk": "ニンフ", "ja": "地上の空は広いもの……。\nきっと、どこまでだって、飛べる……"},
{"id": 409, "kind": "msg", "spk": "智樹", "ja": "……え？　今、なんて？"},
{"id": 410, "kind": "msg", "spk": "ニンフ", "ja": "ううん、なんでもない。\n……一緒に飛ぼうね、トモキ。"}
]}
