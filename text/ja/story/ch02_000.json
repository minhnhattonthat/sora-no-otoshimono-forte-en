{"file": "_Data/Script/Other/Story/Chapter02/000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ほいせっ……と。\n追加の薪集めしゅーりょー。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "そはらー、こんなもんでいいかー？"},
{"id": 2, "kind": "msg", "spk": "そはら", "ja": "うん。それだけあれば十分だよ、\nトモちゃん。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "あー、やれやれ……。\nなんで１泊２日のキャンプで、\n２度も薪拾いに行かにゃならんのかね。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "これというのも、\nイカロスのやつがなぁ……。"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "キャンプと言えば、\nやっぱキャンプファイアーだよなぁ。\nやぐらを組んで、と……。"},
{"id": 6, "kind": "msg", "spk": "イカロス", "ja": "……あの、マスター。\nキャンプファイアーとはなんですか？"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "そっか、イカロスは知らないのか。\nこうやって、薪を組んで\n燃やすんだよ。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "みんなで火を囲むと、\nなんか楽しくなってくるんだよな。"},
{"id": 9, "kind": "msg", "spk": "イカロス", "ja": "楽しい……。"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "ああ、イカロスもきっと\n楽しいと思うぞ。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "そろそろ火を……あれ？\nマッチはどこにやったっけ……。"},
{"id": 12, "kind": "msg", "spk": "イカロス", "ja": "マスター、私が……。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "お、サンキュー、イカロス\n……って、なんかお前\n目の色変わってないか？"},
{"id": 14, "kind": "msg", "spk": "イカロス", "ja": "超々高熱体圧縮対艦砲……発射。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "　\n{1F}{13}ドッゴーーーォン！！"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "う、うおおおっ！？"},
{"id": 17, "kind": "msg", "spk": "イカロス", "ja": "……マスター。薪を燃やしました。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "燃やしすぎだっ！\n塵になってるじゃねーかっ！"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "あいつはいつになったら\n常識ってもんを身につけるんだ……。"},
{"id": 20, "kind": "msg", "spk": "そはら", "ja": "しかたないよ。イカロスさん、\n地上の生活に慣れてないんだもん。"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "あいつが来て、\nもうどんだけ経ってるんだよ。\nいいかげんに慣れろっての。"},
{"id": 22, "kind": "msg", "spk": "そはら", "ja": "イカロスさんにキャンプファイアー\n見せようとしたのも、そのためだよね。\n優しいよね、トモちゃん。"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "べ、別にそんなんじゃないっての。\nキャンプと言えば、やっぱ\nキャンプファイアーだろっ！？"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "まーキャンプつっても、場所は\n守形先輩ん家のある河原だけどな。"},
{"id": 25, "kind": "msg", "spk": "そはら", "ja": "そう考えると、これって守形先輩の家に\nお泊り会に来たみたいだね。"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "うげっ。やめてくれ、そういうの。\nなにが悲しくて先輩ん家に\n泊まらなくちゃならんのだ。"},
{"id": 27, "kind": "msg", "spk": "そはら", "ja": "え？　私はお友達の家に\nお泊まりするのって楽しいけどなぁ。"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "あの変態は、お友達なんて\n素敵なカテゴリーに入ってない！"},
{"id": 29, "kind": "msg", "spk": "そはら", "ja": "もう、トモちゃんったら……。"},
{"id": 30, "kind": "msg", "spk": "そはら", "ja": "それじゃトモちゃん、\nどんな人の家なら泊まりたいの？"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "そうだな～……"},
{"id": 32, "kind": "choice", "spk": "", "ja": "そはらの家"},
{"id": 33, "kind": "choice", "spk": "", "ja": "会長の家"},
{"id": 34, "kind": "choice", "spk": "", "ja": "綺麗なお姉さんの家"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "やっぱそはらの家かな。"},
{"id": 36, "kind": "msg", "spk": "そはら", "ja": "ふーんだ。\nどうせ私の部屋を色々あさって\nイタズラしたいってだけでしょ。"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "……そうか、そはら。\nお前が俺をどう思ってるか、\nよーくわかったよ……"},
{"id": 38, "kind": "msg", "spk": "そはら", "ja": "え……だ、だってトモちゃん、\nうち来るといつもタンスを\nあさったりするし、だから……"},
{"id": 39, "kind": "msg", "spk": "そはら", "ja": "でも、もしトモちゃんが\nそういうこと絶対しないって言うなら、\nそれなら、私……"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "もちろんするに決まってるじゃないか！\nお前の思った通りだ、そはら！"},
{"id": 41, "kind": "msg", "spk": "そはら", "ja": "……トモちゃんっ！"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "ふっ、けどな、今の俺はそれだけじゃ\nすまさないぜ……？"},
{"id": 43, "kind": "msg", "spk": "そはら", "ja": "え……？"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "やるんなら徹底的にだ。"},
{"id": 45, "kind": "msg", "spk": "そはら", "ja": "てっ……徹底的って！？"},
{"id": 46, "kind": "msg", "spk": "そはら", "ja": "そ、それってどこまで……"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "決まってるだろ。\n俺たち、もう小学生じゃないんだぜ？"},
{"id": 48, "kind": "msg", "spk": "そはら", "ja": "え、ええぇぇえええええ！"},
{"id": 49, "kind": "msg", "spk": "そはら", "ja": "た、確かに私たち小学生じゃないし……\n都会の子なら、このくらいの歳で\nもうフツーだって聞くけど、でも……。"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "おお、わかるかそはら。\n俺の気持ちが！"},
{"id": 51, "kind": "msg", "spk": "そはら", "ja": "で、でも、トモちゃん！\n私まだ、心の準備が……"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "いいから！　さあ、そはら！"},
{"id": 53, "kind": "msg", "spk": "そはら", "ja": "は、はい！　トモちゃん！"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "俺にスリーサイズ測らせてくれ！"},
{"id": 55, "kind": "msg", "spk": "そはら", "ja": "…………え？"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "服の上から相手のスリーサイズを\n想像するのは確かに楽しい。"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "でもな！　そんなのが許されるのは\n小学生までだ！"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "俺たちはもうそんなガキじゃないんだ。\nここはもう１歩、大人の階段を\n上らなきゃダメだろう！"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "こう自分の手でさぁ～おっぱいの弾力\n測ったり、抱きついてウエストを\n測ったり、やってみたいよな～。"},
{"id": 60, "kind": "msg", "spk": "そはら", "ja": "…………。"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "じゃあ、そはら！\n早速、測らせてくれ！"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "あっ、もちろん服脱いでくれよ！\nヨロシク！"},
{"id": 63, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}ぐしゃあっ！"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "やっぱ会長ん家かな。"},
{"id": 65, "kind": "msg", "spk": "そはら", "ja": "会長の家？　どうして？"},
{"id": 66, "kind": "msg", "spk": "智樹", "ja": "ほら、ちょっと危ないけど\nなんだかんだ言ってセレブだから、\n超豪華じゃん。メシもうまかったし。"},
{"id": 67, "kind": "msg", "spk": "そはら", "ja": "うん、まぁ確かにご飯、\nおいしかったよね～。"},
{"id": 68, "kind": "msg", "spk": "智樹", "ja": "それにお手伝いのお姉さんたちも\nメッチャクチャ美人だったしさー。"},
{"id": 69, "kind": "msg", "spk": "そはら", "ja": "…………。"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "あっ！　そういや和服の帯をくるくるー\nって、まだやらせてもらってねーや！"},
{"id": 71, "kind": "msg", "spk": "そはら", "ja": "…………。"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "今度絶対やらせてもらおう！\nできれば会長にも和服着せて、\n『あ～れ～』ってやりた……"},
{"id": 73, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}ぐしゃあっ！"},
{"id": 74, "kind": "msg", "spk": "智樹", "ja": "やっぱ綺麗なお姉さんの家だよな～。\nそれもひとりやふたりじゃなくて、\n９人１０人、２０人、うへへへぇ～。"},
{"id": 75, "kind": "msg", "spk": "そはら", "ja": "…………"},
{"id": 76, "kind": "msg", "spk": "智樹", "ja": "みんなで一緒にお風呂入ったり～、\nみんなで一緒に着替えたり～、\nみんなで一緒に揉み揉みしたり～。"},
{"id": 77, "kind": "msg", "spk": "そはら", "ja": "…………"},
{"id": 78, "kind": "msg", "spk": "智樹", "ja": "そんで夜は当然……うぇっへっへっへ。\nん？　そはら、なんでそんなに\n腕を高く上げて……"},
{"id": 79, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}ぐしゃあっ！"},
{"id": 80, "kind": "msg", "spk": "そはら", "ja": "トモちゃんの変態！"},
{"id": 81, "kind": "msg", "spk": "智樹", "ja": "オオォ、頭がたんこぶツリーみたいに。"},
{"id": 82, "kind": "msg", "spk": "そはら", "ja": "次は手加減しないからね。"},
{"id": 83, "kind": "msg", "spk": "智樹", "ja": "これで手加減してるのかよ！？\nこの殺人チョップ女がっ！"},
{"id": 84, "kind": "msg", "spk": "そはら", "ja": "もう……せっかくキャンプ\n楽しかったのに、トモちゃんが\n変なこと言うから！"},
{"id": 85, "kind": "msg", "spk": "智樹", "ja": "変なこと言ったのはお前だろ？\nせっかくのキャンプを\nお泊まり会とか言うから。"},
{"id": 86, "kind": "msg", "spk": "智樹", "ja": "実質がどうあれ、やっぱお泊まりと\nキャンプじゃ違うんだよ、\n男のロマン的に！"},
{"id": 87, "kind": "msg", "spk": "智樹", "ja": "ただのカレーなのに、\nキャンプで食うとなると\nやけにうまかったりするしな。"},
{"id": 88, "kind": "msg", "spk": "そはら", "ja": "あ、それはわかる。\n味はいつも家で食べてるのと\n同じはずなのにねー。"},
{"id": 89, "kind": "msg", "spk": "そはら", "ja": "寝る前にやった花火も、\nいつもより楽しかったし。"},
{"id": 90, "kind": "msg", "spk": "智樹", "ja": "……まぁ、あれはあれで、\nまたひどい騒ぎになったけどな。"},
{"id": 91, "kind": "msg", "spk": "ニンフ", "ja": "……へぇ、これが花火なんだ。\nダウナーって変わったこと\nするのねー。"},
{"id": 92, "kind": "msg", "spk": "ニンフ", "ja": "でも……綺麗だし、面白そう。"},
{"id": 93, "kind": "msg", "spk": "そはら", "ja": "でしょ？\n私、花火って大好きなんだ。"},
{"id": 94, "kind": "msg", "spk": "美香子", "ja": "会長も花火は好きよ～。\n情緒があって。"},
{"id": 95, "kind": "msg", "spk": "そはら", "ja": "ですよね！"},
{"id": 96, "kind": "msg", "spk": "美香子", "ja": "一瞬だけ派手に光って、散っていく……\n鉄砲玉の生き様そのもので、いいわ～。"},
{"id": 97, "kind": "msg", "spk": "そはら", "ja": "……あの、それはちょっと。"},
{"id": 98, "kind": "msg", "spk": "イカロス", "ja": "…………。"},
{"id": 99, "kind": "msg", "spk": "そはら", "ja": "イカロスさん！　イカロスさんは\n綺麗だと思うよね。普通に！"},
{"id": 100, "kind": "msg", "spk": "イカロス", "ja": "綺麗……というのは、\nあまりよくはわかりませんが……。"},
{"id": 101, "kind": "msg", "spk": "イカロス", "ja": "私は、これ……いいと思います。"},
{"id": 102, "kind": "msg", "spk": "アストレア", "ja": "私もっ！　私も好きです、花火っ！"},
{"id": 103, "kind": "msg", "spk": "アストレア", "ja": "きらきらしてて、\nなんだかおいしそうですっ！"},
{"id": 104, "kind": "msg", "spk": "守形", "ja": "残念だが……花火は食べても\n苦いと思うぞ。"},
{"id": 105, "kind": "msg", "spk": "そはら", "ja": "そうじゃなくて……\nそもそも食べちゃダメって\n言うべきだと思うんですけど……。"},
{"id": 106, "kind": "msg", "spk": "ニンフ", "ja": "ねぇ、ところでトモキは\nどこに行ったの？"},
{"id": 107, "kind": "msg", "spk": "そはら", "ja": "え？　トモちゃん？"},
{"id": 108, "kind": "msg", "spk": "そはら", "ja": "……あっ！　そうだ、みんな\n気をつけて！"},
{"id": 109, "kind": "msg", "spk": "ニンフ", "ja": "えっ！？　な、なによ？"},
{"id": 110, "kind": "msg", "spk": "そはら", "ja": "トモちゃんって、私が静かに\n花火をしてるといっつも……"},
{"id": 111, "kind": "msg", "spk": "智樹", "ja": "うはははは！\nネズミ花火攻撃を食らえっ！"},
{"id": 112, "kind": "msg", "spk": "ニンフ", "ja": "きゃっ！　な、なにっ！？"},
{"id": 113, "kind": "msg", "spk": "そはら", "ja": "もうっ！　トモちゃんったら！"},
{"id": 114, "kind": "msg", "spk": "そはら", "ja": "イカロスさんは大丈夫！？"},
{"id": 115, "kind": "msg", "spk": "イカロス", "ja": "平気です。\n全てアルテミスで撃墜可能です。"},
{"id": 116, "kind": "msg", "spk": "そはら", "ja": "そ、そんな怖いもの撃っちゃダメ！"},
{"id": 117, "kind": "msg", "spk": "アストレア", "ja": "な、なんなんですか、この攻撃っ！\nこうなったら～～～！"},
{"id": 118, "kind": "msg", "spk": "そはら", "ja": "アストレアさんも、そんな剣\n抜いちゃダメ～～～！"},
{"id": 119, "kind": "msg", "spk": "アストレア", "ja": "あ……わわっ！？"},
{"id": 120, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}どっぼーん！"},
{"id": 121, "kind": "msg", "spk": "アストレア", "ja": "川に落ちちゃいました～。\nううっ、びしょ濡れ……\n冷たいです～。へくしゅん！"},
{"id": 122, "kind": "msg", "spk": "ニンフ", "ja": "もう～、デルタったら……。\nほら、タオル！　風邪ひくわよ！？"},
{"id": 123, "kind": "msg", "spk": "智樹", "ja": "ホント、あれはひどい騒ぎだった……。"},
{"id": 124, "kind": "msg", "spk": "そはら", "ja": "……ほとんどトモちゃんの\nせいじゃない。"},
{"id": 125, "kind": "msg", "spk": "そはら", "ja": "大丈夫かなぁ、アストレアさん。\nエンジェロイドも風邪は引くって\n聞いたし。"},
{"id": 126, "kind": "msg", "spk": "智樹", "ja": "大丈夫だって。\nエンジェロイドとか以前に、\nそもそもヴァカは風邪を引かないから。"},
{"id": 127, "kind": "msg", "spk": "アストレア", "ja": "あー！\nまた私のことバカにしてたでしょー！？"},
{"id": 128, "kind": "msg", "spk": "智樹", "ja": "ん？　アストレアか。\nそれと……"},
{"id": 129, "kind": "choice", "spk": "", "ja": "イカロスも一緒か"},
{"id": 130, "kind": "choice", "spk": "", "ja": "ニンフも一緒か"},
{"id": 131, "kind": "msg", "spk": "智樹", "ja": "イカロスも一緒か。\n荷物の片づけ終わったのか？"},
{"id": 132, "kind": "msg", "spk": "イカロス", "ja": "……はい。マスター。"},
{"id": 133, "kind": "msg", "spk": "智樹", "ja": "そっか。ご苦労さん。\n昼には家に帰るからなー。準備は\nちゃっちゃとやっとかねーと。"},
{"id": 134, "kind": "msg", "spk": "イカロス", "ja": "はい……。"},
{"id": 135, "kind": "msg", "spk": "智樹", "ja": "アストレア、\nお前もちゃんと手伝ったのか？"},
{"id": 136, "kind": "msg", "spk": "アストレア", "ja": "言われなくても、ちゃんと\n残ったお菓子は全部平らげたわよ！\nえっへん！"},
{"id": 137, "kind": "msg", "spk": "智樹", "ja": "……なんでそれで威張れるんだ、\nお前は。"},
{"id": 138, "kind": "msg", "spk": "智樹", "ja": "あ、そういえばそはら、\n守形先輩はどこだ？\n薪、持ってかねーといけないからな。"},
{"id": 139, "kind": "msg", "spk": "そはら", "ja": "テントの向こう側で朝ご飯の用意\nしてくれてるよ。"},
{"id": 140, "kind": "msg", "spk": "そはら", "ja": "私、今やることないし、\n手伝ってくるね。"},
{"id": 141, "kind": "msg", "spk": "そはら", "ja": "よーし！\n今日こそ目玉焼きを成功させるぞー。"},
{"id": 142, "kind": "msg", "spk": "智樹", "ja": "なぬっ？　目玉焼き！？"},
{"id": 143, "kind": "msg", "spk": "そはら", "ja": "じゃあ、トモちゃん、薪お願いね。"},
{"id": 144, "kind": "msg", "spk": "智樹", "ja": "（うーん。言っちゃ悪いけど、\n　そはらの目玉焼きって\n　まずいんだよな）"},
{"id": 145, "kind": "msg", "spk": "智樹", "ja": "（仕方ない。俺も一緒に手伝って\n　そはらを止めるか）"},
{"id": 146, "kind": "msg", "spk": "智樹", "ja": "じゃ、俺も行くから、\nイカロスたちはしばらく\nその辺で遊んでていいぞ。"},
{"id": 147, "kind": "msg", "spk": "イカロス", "ja": "遊ぶ……？"},
{"id": 148, "kind": "msg", "spk": "智樹", "ja": "そーだよ。川とかで好きに遊んでこい。\nけどそのヴァカみたいにびしょ濡れに\nなるなよ。"},
{"id": 149, "kind": "msg", "spk": "アストレア", "ja": "またバカって言ったー！"},
{"id": 150, "kind": "msg", "spk": "イカロス", "ja": "…………。"},
{"id": 151, "kind": "msg", "spk": "智樹", "ja": "どうした？　イカロス。"},
{"id": 152, "kind": "msg", "spk": "イカロス", "ja": "マスター。\n遊ぶとはいったいなんですか？"},
{"id": 153, "kind": "msg", "spk": "智樹", "ja": "はぁ？\n……ん～、具体的にって言われると\n説明しづらいけど。"},
{"id": 154, "kind": "msg", "spk": "智樹", "ja": "まぁ要するにお前の好きなことやれば\nいいんだよ。"},
{"id": 155, "kind": "msg", "spk": "イカロス", "ja": "私の……好きなこと？"},
{"id": 156, "kind": "msg", "spk": "智樹", "ja": "そうさ。お前が楽しいと思うことを\nすればいいんだ。"},
{"id": 157, "kind": "msg", "spk": "イカロス", "ja": "では、マスターのお傍に。"},
{"id": 158, "kind": "msg", "spk": "智樹", "ja": "俺はこれから守形先輩に薪届けて、\nついでにそはらを止めなくちゃ\nならないんだよ。"},
{"id": 159, "kind": "msg", "spk": "智樹", "ja": "だから、イカロスが自分で\n自分のしたいこと探してみろ。"},
{"id": 160, "kind": "msg", "spk": "イカロス", "ja": "……\n…………\n………………"},
{"id": 161, "kind": "msg", "spk": "イカロス", "ja": "……………………\nでは、マスターの言う通り\n川へ行ってきます。"},
{"id": 162, "kind": "msg", "spk": "智樹", "ja": "いや、だから俺の言った通り\nとかじゃなくてな……"},
{"id": 163, "kind": "msg", "spk": "イカロス", "ja": "……スイカが暑そうだったので、\n川で冷やしています。"},
{"id": 164, "kind": "msg", "spk": "イカロス", "ja": "……頭がちょっと出てるので、\n水をかけてあげようと思います。"},
{"id": 165, "kind": "msg", "spk": "智樹", "ja": "……そっか。なら、たくさんかけて\nあげないとな。"},
{"id": 166, "kind": "msg", "spk": "イカロス", "ja": "はい……\nありがとうございます。マスター。"},
{"id": 167, "kind": "msg", "spk": "智樹", "ja": "ニンフも一緒か。\n荷物の片づけ終わったのか？"},
{"id": 168, "kind": "msg", "spk": "ニンフ", "ja": "アルファーが全部やったわ。"},
{"id": 169, "kind": "msg", "spk": "智樹", "ja": "全部？　お前らもちょっとは\n手伝ってやれよ。"},
{"id": 170, "kind": "msg", "spk": "ニンフ", "ja": "仕方ないでしょ。\n私はスガタの手伝いをしてたんだし。"},
{"id": 171, "kind": "msg", "spk": "アストレア", "ja": "私は、残ったお菓子を\n全部平らげましたっ！\nえっへん！"},
{"id": 172, "kind": "msg", "spk": "智樹", "ja": "……なんでそれで威張れるんだ、\nお前は。"},
{"id": 173, "kind": "msg", "spk": "智樹", "ja": "ま、いいや。\nそれで、イカロスは？"},
{"id": 174, "kind": "msg", "spk": "ニンフ", "ja": "スイカが暑そうだから\n川で冷やしてくるって。"},
{"id": 175, "kind": "msg", "spk": "智樹", "ja": "なんじゃそりゃ？\nどうでもいいけど昼には帰るからな。\nイカロスにもちゃんと言っといてくれ。"},
{"id": 176, "kind": "msg", "spk": "ニンフ", "ja": "それはわかったけど……。"},
{"id": 177, "kind": "msg", "spk": "ニンフ", "ja": "……ねぇ、トモキ。"},
{"id": 178, "kind": "msg", "spk": "智樹", "ja": "ん？\nどうしたニンフ？"},
{"id": 179, "kind": "msg", "spk": "ニンフ", "ja": "キャンプって、どうしてわざわざ外で\n寝泊りするの？\n家にいた方が快適じゃない。"},
{"id": 180, "kind": "msg", "spk": "アストレア", "ja": "はい！　私は毎日キャンプしてますよ。\nニンフ先輩！"},
{"id": 181, "kind": "msg", "spk": "ニンフ", "ja": "デルタは黙ってて。\nねぇ、トモキ、どうして？"},
{"id": 182, "kind": "msg", "spk": "智樹", "ja": "どうしてってそりゃお前。みんなで\nカレー食ったり花火したり\n着替え覗いたり……"},
{"id": 183, "kind": "msg", "spk": "そはら", "ja": "トモちゃん……覗いたの？"},
{"id": 184, "kind": "msg", "spk": "智樹", "ja": "ギクッ。\nハハハ、まさかそんな……"},
{"id": 185, "kind": "msg", "spk": "そはら", "ja": "ト～モ～ちゃ～ん。"},
{"id": 186, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}どがっ！"},
{"id": 187, "kind": "msg", "spk": "そはら", "ja": "まったくもう！　トモちゃんは\nエッチなんだから！"},
{"id": 188, "kind": "msg", "spk": "智樹", "ja": "ウゴゴ……"},
{"id": 189, "kind": "msg", "spk": "そはら", "ja": "私、守形先輩のお手伝いしてくる！"},
{"id": 190, "kind": "msg", "spk": "そはら", "ja": "さーて、\n今日こそ目玉焼き成功させるぞー！"},
{"id": 191, "kind": "msg", "spk": "智樹", "ja": "ん？　目玉焼きって……。"},
{"id": 192, "kind": "msg", "spk": "智樹", "ja": "（そはらの目玉焼き……\n　あれ、壊滅的に\n　まずいんだよなぁ……）"},
{"id": 193, "kind": "msg", "spk": "智樹", "ja": "……しゃーない。\n俺も準備手伝ってくるか。"},
{"id": 194, "kind": "msg", "spk": "ニンフ", "ja": "あ、ちょっとトモキ！\nまだ話、終わってないわよ？"},
{"id": 195, "kind": "msg", "spk": "ニンフ", "ja": "カレーも花火も、家でできるじゃない。\n結局、なんでキャンプなんかするの？"},
{"id": 196, "kind": "msg", "spk": "智樹", "ja": "うーん……まぁ、確かに家でも\nできることだよな。"},
{"id": 197, "kind": "msg", "spk": "ニンフ", "ja": "でしょ？"},
{"id": 198, "kind": "msg", "spk": "智樹", "ja": "でもさ……じゃあニンフはキャンプ、\n楽しくなかったか？"},
{"id": 199, "kind": "msg", "spk": "ニンフ", "ja": "楽しく……？"},
{"id": 200, "kind": "msg", "spk": "智樹", "ja": "いつもとは違う場所で、\nみんなと一緒にメシ食ったり、\n花火したり……。"},
{"id": 201, "kind": "msg", "spk": "智樹", "ja": "そういうの、俺は楽しかったし。\nニンフも楽しそうに見えたぞ。"},
{"id": 202, "kind": "msg", "spk": "ニンフ", "ja": "…………。"},
{"id": 203, "kind": "msg", "spk": "ニンフ", "ja": "……うん。楽しかったかも……。"},
{"id": 204, "kind": "msg", "spk": "智樹", "ja": "なら、それでいいんじゃないか？"},
{"id": 205, "kind": "msg", "spk": "智樹", "ja": "っと、早く薪持ってくか。\nじゃあ、ニンフたちはメシまで\nその辺で遊んでろよ。"},
{"id": 206, "kind": "msg", "spk": "ニンフ", "ja": "うん……。"},
{"id": 207, "kind": "msg", "spk": "智樹", "ja": "守形先輩ー。薪、持ってきました。"},
{"id": 208, "kind": "msg", "spk": "智樹", "ja": "ところで、そはらは……"},
{"id": 209, "kind": "msg", "spk": "そはら", "ja": "………………ううっ。"},
{"id": 210, "kind": "msg", "spk": "智樹", "ja": "（やれやれ、やっぱり目玉焼きは\n　炭になってたか……）"},
{"id": 211, "kind": "msg", "spk": "守形", "ja": "智樹、そっちの鍋はもう使わないから、\n川で洗ってきてくれ。"},
{"id": 212, "kind": "msg", "spk": "智樹", "ja": "うぃ～ス。"},
{"id": 213, "kind": "msg", "spk": "美香子", "ja": "桜井く～ん。"},
{"id": 214, "kind": "msg", "spk": "智樹", "ja": "ん？"},
{"id": 215, "kind": "msg", "spk": "美香子", "ja": "桜井く～ん。こっちよ～。"},
{"id": 216, "kind": "msg", "spk": "智樹", "ja": "会長……？"},
{"id": 217, "kind": "msg", "spk": "智樹", "ja": "（なんだろ？\n　会長が木の陰から手招きして……\n　行った方がいいのか？）"},
{"id": 218, "kind": "choice", "spk": "", "ja": "行く"},
{"id": 219, "kind": "choice", "spk": "", "ja": "行かない"},
{"id": 220, "kind": "msg", "spk": "智樹", "ja": "会長、なんか用ですか？"},
{"id": 221, "kind": "msg", "spk": "美香子", "ja": "そうよ～。\n気づいてくれてよかったわ～。"},
{"id": 222, "kind": "msg", "spk": "美香子", "ja": "もし桜井くんが気づかなかったら、\nプランＤを発動するところだったわ～。"},
{"id": 223, "kind": "msg", "spk": "智樹", "ja": "なんですか、そのプランＤって。"},
{"id": 224, "kind": "msg", "spk": "美香子", "ja": "もちろんＤはＤｅａｔｈのＤよ～。"},
{"id": 225, "kind": "msg", "spk": "智樹", "ja": "殺す気かよ！！"},
{"id": 226, "kind": "msg", "spk": "智樹", "ja": "（やめとこう。\n　俺のトラブルセンサーがビンビンだ。\n　近づかない方がよさそうだな）"},
{"id": 227, "kind": "msg", "spk": "美香子", "ja": "桜井くーん？"},
{"id": 228, "kind": "msg", "spk": "美香子", "ja": "あらあら～、無視？\n会長、困っちゃうわ～。"},
{"id": 229, "kind": "msg", "spk": "美香子", "ja": "仕方ないわね～。"},
{"id": 230, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}バキューン！"},
{"id": 231, "kind": "msg", "spk": "智樹", "ja": "ぬおっ！？\nな、鍋に穴が……！"},
{"id": 232, "kind": "msg", "spk": "智樹", "ja": "銃弾ーーー！？"},
{"id": 233, "kind": "msg", "spk": "智樹", "ja": "会長、なにすんですか！？"},
{"id": 234, "kind": "msg", "spk": "美香子", "ja": "鳴かぬなら～。\n鳴かせてみせよ～。\nアサルトライフル～（字余り）。"},
{"id": 235, "kind": "msg", "spk": "智樹", "ja": "殺す気、満々じゃねえか！！"},
{"id": 236, "kind": "msg", "spk": "美香子", "ja": "うふふふ～。"},
{"id": 237, "kind": "msg", "spk": "智樹", "ja": "……で、俺になんの用ですか？"},
{"id": 238, "kind": "msg", "spk": "美香子", "ja": "あら～、なんだか不機嫌ね～。"},
{"id": 239, "kind": "msg", "spk": "智樹", "ja": "わけわかんないうちに殺されかけりゃ、\n誰だって不機嫌になるわ！"},
{"id": 240, "kind": "msg", "spk": "美香子", "ja": "そうなの、ごめんなさいね～。"},
{"id": 241, "kind": "msg", "spk": "智樹", "ja": "まぁ、今度から気をつけてくれれば……"},
{"id": 242, "kind": "msg", "spk": "美香子", "ja": "今度は不機嫌になる前に\n確実に息の根を止めるわ～。"},
{"id": 243, "kind": "msg", "spk": "智樹", "ja": "殺人予告じゃないスか！！\nあんたはヒットマンかなにかか！？"},
{"id": 244, "kind": "msg", "spk": "美香子", "ja": "違うわよ～。や～ね～。"},
{"id": 245, "kind": "msg", "spk": "美香子", "ja": "ヒットマンは、お仕事でしょ？\n依頼がなければ動かないわ。"},
{"id": 246, "kind": "msg", "spk": "美香子", "ja": "会長、依頼なんてなくても、\n桜井くんをヤッちゃうから～。"},
{"id": 247, "kind": "msg", "spk": "智樹", "ja": "そのほうが悪いだろ！？"},
{"id": 248, "kind": "msg", "spk": "美香子", "ja": "殺人予告ね～。悪くないわ～。\nこれが守形くんの言うロマン？\n今度、本当に出してみようかしら～。"},
{"id": 249, "kind": "msg", "spk": "智樹", "ja": "マジでやめてくださいよ。"},
{"id": 250, "kind": "msg", "spk": "美香子", "ja": "そ～お？\n残念だわ～。"},
{"id": 251, "kind": "msg", "spk": "美香子", "ja": "ところで……\n桜井くん家の番地って\nいくつだったかしら～？"},
{"id": 252, "kind": "msg", "spk": "智樹", "ja": "出す気だろ、アンタ！　絶対！"},
{"id": 253, "kind": "msg", "spk": "智樹", "ja": "ああもう……用事がないなら\n俺、戻りますよ？"},
{"id": 254, "kind": "msg", "spk": "美香子", "ja": "あら～、用事なら\nちゃんとあるわよ～。"},
{"id": 255, "kind": "msg", "spk": "美香子", "ja": "実は会長、イカロスちゃんのカードを\n見つけちゃったのよ～。"},
{"id": 256, "kind": "msg", "spk": "智樹", "ja": "えぇ！？\nどこで見つけたんスか？"},
{"id": 257, "kind": "msg", "spk": "美香子", "ja": "昨日、寝る前に桜井くん避けの\n地雷をセットしたあとにね～。"},
{"id": 258, "kind": "msg", "spk": "智樹", "ja": "地雷！？"},
{"id": 259, "kind": "msg", "spk": "智樹", "ja": "（あ、危ね～。昨日ははしゃぎすぎて、\n　ぶっ倒れるように寝たからなー）"},
{"id": 260, "kind": "msg", "spk": "美香子", "ja": "今朝は桜井くんのローストチキンが\n見られると思ってたのに……\n会長がっかりだわ～。"},
{"id": 261, "kind": "msg", "spk": "美香子", "ja": "そうだ、今からでも桜井くんに\n踏んでもらおうかしら～？"},
{"id": 262, "kind": "msg", "spk": "智樹", "ja": "踏むかっ！！"},
{"id": 263, "kind": "msg", "spk": "美香子", "ja": "まぁ、それは置いといて～。"},
{"id": 264, "kind": "msg", "spk": "美香子", "ja": "そのとき、荷物の中に見覚えのない\nシールが入ってたのよ～。"},
{"id": 265, "kind": "msg", "spk": "智樹", "ja": "シール？"},
{"id": 266, "kind": "msg", "spk": "美香子", "ja": "白くて、１０円玉くらいの\n丸いシールだったわ～。"},
{"id": 267, "kind": "msg", "spk": "美香子", "ja": "それが不思議なシールでね。\n手の平に載せてみたら、\nパッと消えちゃったのよ～。"},
{"id": 268, "kind": "msg", "spk": "智樹", "ja": "え？　消えたって……？"},
{"id": 269, "kind": "msg", "spk": "美香子", "ja": "本当に消えたんじゃなくて、\n透明になってただけなんだけど～。"},
{"id": 270, "kind": "msg", "spk": "美香子", "ja": "それで、おかしいと思って\n守形くんに相談に行ったのよね～。"},
{"id": 271, "kind": "msg", "spk": "守形", "ja": "うむ……なるほどな。"},
{"id": 272, "kind": "msg", "spk": "美香子", "ja": "英くん。\nなにかわかった～？"},
{"id": 273, "kind": "msg", "spk": "守形", "ja": "これは現代の人類の科学力を\nはるかに超える代物だ。"},
{"id": 274, "kind": "msg", "spk": "守形", "ja": "イカロスのカードが紛失している現状を\n踏まえれば、十中八九このシールは\nカードが原因と思って間違いない。"},
{"id": 275, "kind": "msg", "spk": "守形", "ja": "誰の願いでこうなったのか……\nそこまではわからないがな。"},
{"id": 276, "kind": "msg", "spk": "美香子", "ja": "このシール、\n透明になるだけなのかしら～？"},
{"id": 277, "kind": "msg", "spk": "守形", "ja": "ああ。人肌に触れると透明になるが、\nこすると元に戻る。\n機能はそれだけのようだ。"},
{"id": 278, "kind": "msg", "spk": "守形", "ja": "どんな意味があるのか不明だが……\nなんにしても、早めにイカロスに\n返しておいてやれ。"},
{"id": 279, "kind": "msg", "spk": "美香子", "ja": "わかったわ～。"},
{"id": 280, "kind": "msg", "spk": "守形", "ja": "じゃあ、俺はもう寝るぞ。"},
{"id": 281, "kind": "msg", "spk": "美香子", "ja": "……\n…………"},
{"id": 282, "kind": "msg", "spk": "美香子", "ja": "おやすみなさい、\n英くん……。"},
{"id": 283, "kind": "msg", "spk": "美香子", "ja": "……と、いうわけなのよ～。"},
{"id": 284, "kind": "msg", "spk": "智樹", "ja": "へぇー。\nカードがシールに……"},
{"id": 285, "kind": "msg", "spk": "智樹", "ja": "まぁ、わかりましたよ。\nそのシールは会長が\n持ってるんですよね？"},
{"id": 286, "kind": "msg", "spk": "智樹", "ja": "俺がイカロスに渡しておきますよ。"},
{"id": 287, "kind": "msg", "spk": "美香子", "ja": "……うふふふ～。"},
{"id": 288, "kind": "msg", "spk": "智樹", "ja": "うっ……！？"},
{"id": 289, "kind": "msg", "spk": "智樹", "ja": "（なっ、なぜか嫌な予感が……）"},
{"id": 290, "kind": "msg", "spk": "美香子", "ja": "……ねぇ、桜井くん。\nキャンプには、おもしろイベントが\n必要よね～？"},
{"id": 291, "kind": "msg", "spk": "智樹", "ja": "え？　いや、別にいらないんじゃ……"},
{"id": 292, "kind": "msg", "spk": "美香子", "ja": "会長、桜井くんの丸焼きが\n見られなくてちょっと不満なのよね～。\nというわけで……"},
{"id": 293, "kind": "msg", "spk": "美香子", "ja": "パーンパカパーン。\n第１回、宝探しゲーム。\nはじまりよ～。"},
{"id": 294, "kind": "msg", "spk": "智樹", "ja": "（うわっ、絶対ヤバそうなニオイが\n　プンプンする！！）"},
{"id": 295, "kind": "msg", "spk": "美香子", "ja": "ルールは簡単。\n昨夜のうちに誰かの体に貼ったシールを\n桜井くんが探し出せればオーケー。"},
{"id": 296, "kind": "msg", "spk": "美香子", "ja": "シールは、こすれば元に戻るわ～。\nでも小さいから、体中こすらないと\nいけないわね～。"},
{"id": 297, "kind": "msg", "spk": "智樹", "ja": "……そんなの、相手に貼られたかどうか\n聞けば一発じゃないスか。"},
{"id": 298, "kind": "msg", "spk": "美香子", "ja": "もちろん、聞くのは禁止よ～。"},
{"id": 299, "kind": "msg", "spk": "美香子", "ja": "それと、カードを探してることを\n教えるのも禁止ね～。\n面白くないもの～。"},
{"id": 300, "kind": "msg", "spk": "美香子", "ja": "ルールを破ったらペナルティがあるから\n遺書を用意しておいたほうがいいわ～。"},
{"id": 301, "kind": "msg", "spk": "智樹", "ja": "遺書が必要なペナルティって\n厳しすぎるだろ！"},
{"id": 302, "kind": "msg", "spk": "智樹", "ja": "てゆーか、やりませんよ、そんなの！\n誰がやるか！"},
{"id": 303, "kind": "msg", "spk": "美香子", "ja": "あらあら……"},
{"id": 304, "kind": "msg", "spk": "美香子", "ja": "そうなの……残念ね。\n早速、ペナルティ適用だわ～。"},
{"id": 305, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ジャキッ！"},
{"id": 306, "kind": "msg", "spk": "智樹", "ja": "待てぇー！\nいや、待って、待ってください！\n銃をこっち向けるのやめて！"},
{"id": 307, "kind": "msg", "spk": "美香子", "ja": "桜井くんが「はい」か「イエス」って\n言ってくれないと、会長、悲しくて指に\n力が入っちゃうわね。"},
{"id": 308, "kind": "msg", "spk": "智樹", "ja": "わかった！　わかりました！\n宝探しに参加しますから！"},
{"id": 309, "kind": "msg", "spk": "美香子", "ja": "喜んで？"},
{"id": 310, "kind": "msg", "spk": "智樹", "ja": "喜んで参加します！"},
{"id": 311, "kind": "msg", "spk": "美香子", "ja": "制限時間はキャンプが終わるまでよ～。\n桜井くんが地べたを這いつくばって\n頑張る様を期待してるわ～。"},
{"id": 312, "kind": "msg", "spk": "智樹", "ja": "はぁ～。\nなんで俺が宝探しなんか……"},
{"id": 313, "kind": "msg", "spk": "智樹", "ja": "でも無視したら今度こそ\n蜂の巣にされるかもなー。"},
{"id": 314, "kind": "msg", "spk": "智樹", "ja": "……制限時間はキャンプが終わるまで\nだから、だいたい昼頃までか。\n……まぁ、テキトーにやるかぁ。"},
{"id": 315, "kind": "msg", "spk": "智樹", "ja": "……貼ったのは昨日の夜。\n問題は、誰に貼ったかだよな……"},
{"id": 316, "kind": "msg", "spk": "智樹", "ja": "ん？　待てよ？\n会長のことだから裏をかいて、\n実は俺の体に貼ってある……とか？"},
{"id": 317, "kind": "msg", "spk": "智樹", "ja": "……普通にあり得るな！\nだってあの会長だし。"},
{"id": 318, "kind": "msg", "spk": "智樹", "ja": "えーと、貼ると透明になって、\nこすると戻るんだっけ？"},
{"id": 319, "kind": "msg", "spk": "智樹", "ja": "ん……っと……"},
{"id": 320, "kind": "msg", "spk": "智樹", "ja": "腕とか足はいいけど、服の下は\nこすりにくいな。"},
{"id": 321, "kind": "msg", "spk": "智樹", "ja": "よし、脱ぐか！"},
{"id": 322, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}すぱぽぽーん！"},
{"id": 323, "kind": "msg", "spk": "智樹", "ja": "……フゥ。"},
{"id": 324, "kind": "msg", "spk": "智樹", "ja": "いやー爽快爽快。\n全裸になると、なんか気分が\nたかぶってくるぜ！"},
{"id": 325, "kind": "msg", "spk": "智樹", "ja": "おっと、早くシールを探さないとな！"},
{"id": 326, "kind": "msg", "spk": "", "ja": "　\n{1F}{0E}さすさすさすさすさすふにふにっ"},
{"id": 327, "kind": "msg", "spk": "智樹", "ja": "うーん、こすってみても\nなにも変化がないなぁ。"},
{"id": 328, "kind": "msg", "spk": "智樹", "ja": "もっと強くこすってみるか！？"},
{"id": 329, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}コスコスコスコスコス！"},
{"id": 330, "kind": "msg", "spk": "智樹", "ja": "やっぱり、ないな～。"},
{"id": 331, "kind": "msg", "spk": "智樹", "ja": "っと……さすがに、\n背中は自分じゃ見れねーや。\n誰かいないかなー。"},
{"id": 332, "kind": "msg", "spk": "智樹", "ja": "おっ、あれは……"},
{"id": 333, "kind": "choice", "spk": "", "ja": "イカロスを呼ぶ"},
{"id": 334, "kind": "choice", "spk": "", "ja": "ニンフを呼ぶ"},
{"id": 335, "kind": "choice", "spk": "", "ja": "アストレアを呼ぶ"},
{"id": 336, "kind": "msg", "spk": "智樹", "ja": "おーい、イカロスー！"},
{"id": 337, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 338, "kind": "msg", "spk": "智樹", "ja": "スイカに水をかけてたのか？"},
{"id": 339, "kind": "msg", "spk": "イカロス", "ja": "はい。\n気持ちよさそうだったので、\nなでていました。"},
{"id": 340, "kind": "msg", "spk": "智樹", "ja": "そうか、よかったな。"},
{"id": 341, "kind": "msg", "spk": "イカロス", "ja": "はい……あの、マスター。"},
{"id": 342, "kind": "msg", "spk": "イカロス", "ja": "マスターは、どうして服を\n着ていないのですか？"},
{"id": 343, "kind": "msg", "spk": "智樹", "ja": "あー、そうだった！\n実はカー……"},
{"id": 344, "kind": "msg", "spk": "智樹", "ja": "（……おっと、\n　カードを探してるって言ったら\n　ペナルティなんだよな……）"},
{"id": 345, "kind": "msg", "spk": "智樹", "ja": "……えーと。ちょっと俺の背中を\nこすってみてくれないか？"},
{"id": 346, "kind": "msg", "spk": "イカロス", "ja": "わかりました。"},
{"id": 347, "kind": "msg", "spk": "智樹", "ja": "頼むぞ。"},
{"id": 348, "kind": "msg", "spk": "", "ja": "　\n{1F}{11}キュッキュッキュッキュッ"},
{"id": 349, "kind": "msg", "spk": "智樹", "ja": "（……なーんか、\n　自分でこするのと違って\n　こそばゆいな）"},
{"id": 350, "kind": "msg", "spk": "智樹", "ja": "（イカロスの手の平、\n　やわらかいんだな～）"},
{"id": 351, "kind": "msg", "spk": "智樹", "ja": "（おぅ……これは、なかなか……\n　気持ちよくなってきた）"},
{"id": 352, "kind": "msg", "spk": "", "ja": "　\n{1F}{11}キュッキュッキュッキュッ"},
{"id": 353, "kind": "msg", "spk": "", "ja": "　\n{1F}{11}キュッキュッキュッキュッ"},
{"id": 354, "kind": "msg", "spk": "", "ja": "　\n{1F}{13}キュッキュッキュ……"},
{"id": 355, "kind": "msg", "spk": "イカロス", "ja": "……ぁ。"},
{"id": 356, "kind": "msg", "spk": "智樹", "ja": "ん？　どうしたイカロス？"},
{"id": 357, "kind": "msg", "spk": "イカロス", "ja": "あの、少し動力炉が熱く……"},
{"id": 358, "kind": "msg", "spk": "イカロス", "ja": "……いえ、なんでもありません。"},
{"id": 359, "kind": "msg", "spk": "智樹", "ja": "そうか？　なんでもないならいいけど。"},
{"id": 360, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 361, "kind": "msg", "spk": "", "ja": "　\n{1F}{11}キュッキュッキュッキュッ"},
{"id": 362, "kind": "msg", "spk": "智樹", "ja": "イカロス、俺の背中に\nなにか貼ってあったりするか？"},
{"id": 363, "kind": "msg", "spk": "イカロス", "ja": "……いえ。ありません、マスター。"},
{"id": 364, "kind": "msg", "spk": "智樹", "ja": "そうか……\nよし、もういいぞ、イカロス。\nありがとな。"},
{"id": 365, "kind": "msg", "spk": "イカロス", "ja": "え…………はい。"},
{"id": 366, "kind": "msg", "spk": "智樹", "ja": "（ん？　なんかイカロス、\n　残念そうな……\n　まぁ、気のせいだよなぁ）"},
{"id": 367, "kind": "msg", "spk": "智樹", "ja": "おーい、ニンフー。\nこっち、こっち！"},
{"id": 368, "kind": "msg", "spk": "ニンフ", "ja": "ん？　トモキ……なんか用……"},
{"id": 369, "kind": "msg", "spk": "ニンフ", "ja": "キャアアア～～～！？\nなんて格好してるのよ、アンタは！"},
{"id": 370, "kind": "msg", "spk": "智樹", "ja": "格好って……全裸だよ、全裸。\n人間は誰しも裸で生まれてくる。\n裸こそヒューマンスタンダードなんだ。"},
{"id": 371, "kind": "msg", "spk": "智樹", "ja": "だから人ってのはもっと裸に誇りを\n持つべきだろ？\n特におっぱい大きい女の子は！"},
{"id": 372, "kind": "msg", "spk": "智樹", "ja": "あ、そういう意味では\nニンフはあんまり関係が……"},
{"id": 373, "kind": "msg", "spk": "ニンフ", "ja": "いーから、服を着ろー！！"},
{"id": 374, "kind": "msg", "spk": "智樹", "ja": "仕方ないなー……"},
{"id": 375, "kind": "msg", "spk": "智樹", "ja": "ほれ、もーいーぞ。"},
{"id": 376, "kind": "msg", "spk": "ニンフ", "ja": "まったく……って！？\nパンツしかはいてないじゃない！！"},
{"id": 377, "kind": "msg", "spk": "智樹", "ja": "ちょっと頼みがあるんだよ。\n服を着てたらできないことなんだ。"},
{"id": 378, "kind": "msg", "spk": "ニンフ", "ja": "な、なによ、服を着てたらダメな\n頼みって……？"},
{"id": 379, "kind": "msg", "spk": "ニンフ", "ja": "……ヘンタイなことじゃ\nないでしょうね？"},
{"id": 380, "kind": "msg", "spk": "智樹", "ja": "そんなことじゃねえって。\n手の平で背中をこすって欲しいんだ。"},
{"id": 381, "kind": "msg", "spk": "ニンフ", "ja": "背中を？"},
{"id": 382, "kind": "msg", "spk": "智樹", "ja": "そうそう。ゴシゴシーって頼むぜ。"},
{"id": 383, "kind": "msg", "spk": "ニンフ", "ja": "ふーん……\nダウナーって、妙な習慣があるのね。\nまぁ、いいけど……"},
{"id": 384, "kind": "msg", "spk": "智樹", "ja": "おう、頼むな！"},
{"id": 385, "kind": "msg", "spk": "", "ja": "　\n{1F}{11}キュッキュッキュッキュッ"},
{"id": 386, "kind": "msg", "spk": "智樹", "ja": "おおぅ……"},
{"id": 387, "kind": "msg", "spk": "ニンフ", "ja": "なによ？\nどうかしたの？"},
{"id": 388, "kind": "msg", "spk": "智樹", "ja": "いや、なんでもない。\n続けてくれ。"},
{"id": 389, "kind": "msg", "spk": "ニンフ", "ja": "ん？"},
{"id": 390, "kind": "msg", "spk": "", "ja": "　\n{1F}{11}キュッキュッキュッキュッ"},
{"id": 391, "kind": "msg", "spk": "智樹", "ja": "（やっべぇ～。なんかこれ\n　けっこう気持ちいい）"},
{"id": 392, "kind": "msg", "spk": "智樹", "ja": "（ニンフの手、ちっちゃいなー。\n　すげ～スベスベしてるし……）"},
{"id": 393, "kind": "msg", "spk": "ニンフ", "ja": "これ、なんの意味があるの？"},
{"id": 394, "kind": "msg", "spk": "智樹", "ja": "ああ、いや……\n俺の背中に何か貼ってあったり\nしないか？"},
{"id": 395, "kind": "msg", "spk": "ニンフ", "ja": "ないわね。"},
{"id": 396, "kind": "msg", "spk": "智樹", "ja": "そ、そうか。\n……でも、もうちょっとだけ\n続けてくれ。"},
{"id": 397, "kind": "msg", "spk": "ニンフ", "ja": "いいけど……"},
{"id": 398, "kind": "msg", "spk": "", "ja": "　\n{1F}{11}キュッキュッキュッキュッ"},
{"id": 399, "kind": "msg", "spk": "智樹", "ja": "（おおぅ。\n　おおおぅふぅぅぅぅ）"},
{"id": 400, "kind": "msg", "spk": "智樹", "ja": "（これは、まずいっ。\n　クセになりそうだ）"},
{"id": 401, "kind": "msg", "spk": "智樹", "ja": "（ていうか、ホント……）"},
{"id": 402, "kind": "msg", "spk": "智樹", "ja": "ニンフの手は気持ちいいなぁ。"},
{"id": 403, "kind": "msg", "spk": "ニンフ", "ja": "なっ！？"},
{"id": 404, "kind": "msg", "spk": "智樹", "ja": "あっ……つい。"},
{"id": 405, "kind": "msg", "spk": "ニンフ", "ja": "…………。"},
{"id": 406, "kind": "msg", "spk": "智樹", "ja": "…………。"},
{"id": 407, "kind": "msg", "spk": "ニンフ", "ja": "……私の手、気持ちいいの？"},
{"id": 408, "kind": "msg", "spk": "智樹", "ja": "あ、えっと、まぁ……"},
{"id": 409, "kind": "msg", "spk": "ニンフ", "ja": "私の手が気持ちいいから……\n背中をこすらせたの？"},
{"id": 410, "kind": "msg", "spk": "智樹", "ja": "い、いや、そういうわけじゃ……。\n実はこれは、イカロスのカードが……"},
{"id": 411, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}バシュン！！"},
{"id": 412, "kind": "msg", "spk": "智樹", "ja": "（銃声～～～！？）"},
{"id": 413, "kind": "msg", "spk": "ニンフ", "ja": "ん？\n銃器の音がしたような……？"},
{"id": 414, "kind": "msg", "spk": "智樹", "ja": "ヒィィィィィ！"},
{"id": 415, "kind": "msg", "spk": "ニンフ", "ja": "え？　ちょっと、トモキ……！？"},
{"id": 416, "kind": "msg", "spk": "智樹", "ja": "ギャア～～～！！\n言ってない！\n俺は言ってないぞーーー！！"},
{"id": 417, "kind": "msg", "spk": "智樹", "ja": "おーい、アストレア。"},
{"id": 418, "kind": "msg", "spk": "アストレア", "ja": "ご飯！？　ご飯できましたか！？\nって、なーんだアンタか……"},
{"id": 419, "kind": "msg", "spk": "アストレア", "ja": "……って、キャアアア！？\nな、なんで裸なのよ！？"},
{"id": 420, "kind": "msg", "spk": "智樹", "ja": "騒がしいやつだなー。"},
{"id": 421, "kind": "msg", "spk": "アストレア", "ja": "だ、誰のせいよっ！\n早く服着てよ！"},
{"id": 422, "kind": "msg", "spk": "智樹", "ja": "それはできん！"},
{"id": 423, "kind": "msg", "spk": "アストレア", "ja": "な、なに威張ってんのよ！"},
{"id": 424, "kind": "msg", "spk": "智樹", "ja": "裸には裸の理由があるんだよ！\nそれより、俺の背中をこすってくれ！"},
{"id": 425, "kind": "msg", "spk": "アストレア", "ja": "え……せ、背中を？　なんで？"},
{"id": 426, "kind": "msg", "spk": "智樹", "ja": "とにかく、必要なんだよ！\nこすってくれたら、服を着てやるから！"},
{"id": 427, "kind": "msg", "spk": "アストレア", "ja": "こ、こすったら、着るのね？\nじゃあ……"},
{"id": 428, "kind": "msg", "spk": "", "ja": "　\n{1F}{0F}ゴシゴシゴシゴシゴシゴシ！！"},
{"id": 429, "kind": "msg", "spk": "智樹", "ja": "アッツッツッツッツッ！\nせ、背中が焼ける！"},
{"id": 430, "kind": "msg", "spk": "アストレア", "ja": "こ、これでいいの？"},
{"id": 431, "kind": "msg", "spk": "智樹", "ja": "よくないわっ！\nめちゃくちゃ痛いだろうが！？"},
{"id": 432, "kind": "msg", "spk": "アストレア", "ja": "こすれって言ったから\nこすったんじゃない！"},
{"id": 433, "kind": "msg", "spk": "智樹", "ja": "背中の皮がむけるかと思っただろ！"},
{"id": 434, "kind": "msg", "spk": "アストレア", "ja": "そんなの知らないわよ、バーカ！"},
{"id": 435, "kind": "msg", "spk": "智樹", "ja": "むぐぐぐ……"},
{"id": 436, "kind": "msg", "spk": "智樹", "ja": "まぁ、いい。\n俺の背中になにか貼ってなかったか？"},
{"id": 437, "kind": "msg", "spk": "アストレア", "ja": "なにか？\n虫とか？"},
{"id": 438, "kind": "msg", "spk": "智樹", "ja": "なんで虫なんだよ！？\nその、シ……"},
{"id": 439, "kind": "msg", "spk": "智樹", "ja": "（いや、シールまで言ったらＮＧか？）"},
{"id": 440, "kind": "msg", "spk": "智樹", "ja": "とにかく、なにかあったか？"},
{"id": 441, "kind": "msg", "spk": "アストレア", "ja": "わかんない。貼ってあるようなものは、\nなにもなかったと思うけど？"},
{"id": 442, "kind": "msg", "spk": "智樹", "ja": "（うーん。どうやら会長がシールを\n　貼ったのは、俺の体じゃなかった\n　みたいだな）"},
{"id": 443, "kind": "msg", "spk": "智樹", "ja": "ありがとな。\nアストレア。"},
{"id": 444, "kind": "msg", "spk": "アストレア", "ja": "え？　……う、うん。"},
{"id": 445, "kind": "msg", "spk": "智樹", "ja": "う～ん、シールは俺以外の誰かに\n貼られてるみたいだな。"},
{"id": 446, "kind": "msg", "spk": "智樹", "ja": "どうやって見つけりゃいいんだ？"},
{"id": 447, "kind": "msg", "spk": "守形", "ja": "智樹、朝食ができたぞ。"},
{"id": 448, "kind": "msg", "spk": "智樹", "ja": "あ、わかりました。"},
{"id": 449, "kind": "msg", "spk": "智樹", "ja": "（……とりあえず、飯を食ってから\n　考えるか）"}
]}
