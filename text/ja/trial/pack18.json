{"file": "_Data/Script/Trial/PackScript18.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "ほう、そこに目をつけたか。"},
{"id": 1, "kind": "msg", "spk": "", "ja": "構わん。続けてみろ。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "手加減は無用だぞ。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "美香子が世話をかけるな……。"},
{"id": 4, "kind": "msg", "spk": "", "ja": "見月に見られたら\n大変なことになるな……。"},
{"id": 5, "kind": "msg", "spk": "", "ja": "エンジェロイドたちに\n見つかるのは少々まずいな。"},
{"id": 6, "kind": "msg", "spk": "", "ja": "どうした？　遠慮をするな。"},
{"id": 7, "kind": "msg", "spk": "", "ja": "この軟膏は自前でな。\n実によく効くんだ。"},
{"id": 8, "kind": "msg", "spk": "", "ja": "ああ、いいぞ。\n疲労が消えていくようだ。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "美香子め……\n厄介なことを……。"},
{"id": 10, "kind": "msg", "spk": "", "ja": "何事も経験だ。そう思えば\n悪くはない。"},
{"id": 11, "kind": "msg", "spk": "", "ja": "お前も毎日大変だな。"},
{"id": 12, "kind": "msg", "spk": "", "ja": "ふふ、お前のことは\n信頼しているさ。"},
{"id": 13, "kind": "msg", "spk": "", "ja": "やはり髪の長さは\nこれくらいがいいな。"},
{"id": 14, "kind": "msg", "spk": "", "ja": "さすがに髪に塗るのはどうかと\n思うが……まあいい。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "髪を伸ばさないのか、だと？\n……考えておこう。"},
{"id": 16, "kind": "msg", "spk": "", "ja": "男の顔などを見つめて\n楽しいか？"},
{"id": 17, "kind": "msg", "spk": "", "ja": "そんなにジッと見ないで\nくれないか。"},
{"id": 18, "kind": "msg", "spk": "", "ja": "お前意外に\nキレイな手をしているな。"},
{"id": 19, "kind": "msg", "spk": "", "ja": "おい、ちょっと手を\n見せてもらえるか……ふむ。"},
{"id": 20, "kind": "msg", "spk": "", "ja": "指紋をつけないのであれば構わん。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "お前もメガネをかけてみるか？\n案外似合うかもしれんぞ。"},
{"id": 22, "kind": "msg", "spk": "", "ja": "メガネの起源は、１３世紀の\n西欧だと言われている。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "そんなに俺のメガネが\n気になるのか？"},
{"id": 24, "kind": "msg", "spk": "", "ja": "おいおい、取るんじゃないぞ。"},
{"id": 25, "kind": "msg", "spk": "", "ja": "少しくすぐったいな。"},
{"id": 26, "kind": "msg", "spk": "", "ja": "ああ、耳は敏感な部位だ。\n慎重に頼む。"},
{"id": 27, "kind": "msg", "spk": "", "ja": "耳をそのようにするのか。\nふむ……。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "外から虫の音が聞こえる。\n……風流だな。"},
{"id": 29, "kind": "msg", "spk": "", "ja": "勢いあまって\n指を入れないでくれよ。"},
{"id": 30, "kind": "msg", "spk": "", "ja": "む、すまん。\n少し指をなめてしまったな。"},
{"id": 31, "kind": "msg", "spk": "", "ja": "口周りに塗るのか……\n斬新だな。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "うむ、こんなところに\n塗って効果があるのか？"},
{"id": 33, "kind": "msg", "spk": "", "ja": "おい、あまりシワにしてくれるなよ？\n俺の一張羅なんだからな。"},
{"id": 34, "kind": "msg", "spk": "", "ja": "服など最低限のものが\nあればいい。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "この服装が一番\nしっくりくるな。"},
{"id": 36, "kind": "msg", "spk": "", "ja": "他に服はないのか、だと？\nおかしなことを聞く奴だ。"},
{"id": 37, "kind": "msg", "spk": "", "ja": "お前も普段から身だしなみには\n気をつけろよ。"},
{"id": 38, "kind": "msg", "spk": "", "ja": "おい、そんなに珍しい\nネクタイでもないぞ。"},
{"id": 39, "kind": "msg", "spk": "", "ja": "そういえばお前、ネクタイは\nちゃんと締めろよ？"},
{"id": 40, "kind": "msg", "spk": "", "ja": "ネクタイの発祥は、諸説あるが\n１７世紀までさかのぼるらしいな。"},
{"id": 41, "kind": "msg", "spk": "", "ja": "すまんが少し力を弱めてくれるか？\n……ああ、それでいい。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "ネクタイは男のたしなみと\nいえよう。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "塗りすぎじゃないか？"},
{"id": 44, "kind": "msg", "spk": "", "ja": "やれやれ……。"},
{"id": 45, "kind": "msg", "spk": "", "ja": "少し気分が悪くなってきたな。"},
{"id": 46, "kind": "msg", "spk": "", "ja": "さすがにそこには\n塗る必要はないだろう。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "お前は真面目にやっているのか？"},
{"id": 48, "kind": "msg", "spk": "", "ja": "……やるからには全力でやれ。"},
{"id": 49, "kind": "msg", "spk": "", "ja": "すまんが、少し\n離れてくれると助かる。"},
{"id": 50, "kind": "msg", "spk": "", "ja": "いいかげんにしろ。"},
{"id": 51, "kind": "msg", "spk": "", "ja": "失笑ものだな。"},
{"id": 52, "kind": "msg", "spk": "", "ja": "どうしようもない奴だな……。"},
{"id": 53, "kind": "msg", "spk": "", "ja": "む……吐き気が……。"},
{"id": 54, "kind": "msg", "spk": "", "ja": "くだらん……。"},
{"id": 55, "kind": "msg", "spk": "守形", "ja": "仕方がない。\nまあ、ひととおり塗ってみろ。"},
{"id": 56, "kind": "msg", "spk": "", "ja": "おい、よけろ。お前の後ろに……。"},
{"id": 57, "kind": "msg", "spk": "", "ja": "おい、よけろ。お前の後ろに……。"},
{"id": 58, "kind": "msg", "spk": "", "ja": "猛毒種の蜂だ。\n刺されなくて運がよかったな。"},
{"id": 59, "kind": "msg", "spk": "", "ja": "蛇だ。咬まれていたら\n３秒であの世行きだったな。"},
{"id": 60, "kind": "msg", "spk": "", "ja": "蜂に刺されたか……\nまあすぐに死ぬことはないだろう。"},
{"id": 61, "kind": "msg", "spk": "", "ja": "蛇に咬まれたか……。\nこれは後で適切な治療が必要だぞ。"},
{"id": 62, "kind": "msg", "spk": "", "ja": "どうした？\n軟膏を塗るんだろう？"},
{"id": 63, "kind": "msg", "spk": "", "ja": "急いだほうがいいぞ。"},
{"id": 64, "kind": "msg", "spk": "", "ja": "おい、そろそろ\nいいんじゃないのか？"},
{"id": 65, "kind": "msg", "spk": "", "ja": "悪いがもう離れてくれないか。\n暑苦しくて適わん。"},
{"id": 66, "kind": "msg", "spk": "守形", "ja": "どうだ。目的は達成できたか。"}
]}
