{"file": "_Data/Script/Trial/PackScript13.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "んん……。\nトモちゃん……。"},
{"id": 1, "kind": "msg", "spk": "", "ja": "あ……うう……、\nな、何ともないんだからぁ！"},
{"id": 2, "kind": "msg", "spk": "", "ja": "えへへ……。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "トモちゃん……。"},
{"id": 4, "kind": "msg", "spk": "", "ja": "もうお弁当作ってきて\nあげないよ～！"},
{"id": 5, "kind": "msg", "spk": "", "ja": "頑張って、トモちゃん。"},
{"id": 6, "kind": "msg", "spk": "", "ja": "くすぐったいよぉ……。"},
{"id": 7, "kind": "msg", "spk": "", "ja": "こんなふうになっちゃうのは……\n今だけ……なんだから！"},
{"id": 8, "kind": "msg", "spk": "", "ja": "ふふふ……！　くすぐったいよ。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "な、なんだか照れちゃうな。"},
{"id": 10, "kind": "msg", "spk": "", "ja": "やっ……！　そんな強く……！"},
{"id": 11, "kind": "msg", "spk": "", "ja": "えへへ……なんだか照れちゃうな。"},
{"id": 12, "kind": "msg", "spk": "", "ja": "トモちゃあん……。"},
{"id": 13, "kind": "msg", "spk": "", "ja": "昔っからトモちゃんは\nエッチなんだからぁ……！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "ほかの子には……\nこんなことしちゃダメだよ？"},
{"id": 15, "kind": "msg", "spk": "", "ja": "そ、それ以上……されたら\n……ああん！"},
{"id": 16, "kind": "msg", "spk": "", "ja": "トモちゃんのバカぁ！"},
{"id": 17, "kind": "msg", "spk": "", "ja": "あんまり長髪だと泳ぐのに\n邪魔になるかな？"},
{"id": 18, "kind": "msg", "spk": "", "ja": "トモちゃんは髪の長いほうが好み？"},
{"id": 19, "kind": "msg", "spk": "", "ja": "私も早く泳げるようになりたいよ！"},
{"id": 20, "kind": "msg", "spk": "", "ja": "海水は髪の毛によくないんだよね。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "あとでシャワーを浴びないと。"},
{"id": 22, "kind": "msg", "spk": "", "ja": "顔をつけるのは\n平気なんだけどなぁ……。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "もっと水に慣れないとね。"},
{"id": 24, "kind": "msg", "spk": "", "ja": "日焼けしちゃったかなぁ……。"},
{"id": 25, "kind": "msg", "spk": "", "ja": "お肌の手入れもしっかりしないとね。"},
{"id": 26, "kind": "msg", "spk": "", "ja": "今はお肌のケアよりも\n泳ぎのコツを教えて欲しいな？"},
{"id": 27, "kind": "msg", "spk": "", "ja": "泳ぐときって、\n目を閉じてたほうがいいのかな？"},
{"id": 28, "kind": "msg", "spk": "", "ja": "へぇ、水に慣れるまでは\n目を閉じてた方がいいんだね。"},
{"id": 29, "kind": "msg", "spk": "", "ja": "あ、あんまり見られると\n恥ずかしいよ……。"},
{"id": 30, "kind": "msg", "spk": "", "ja": "いつになく真剣な眼差しだね……。"},
{"id": 31, "kind": "msg", "spk": "", "ja": "トモちゃんの目、本気だね。\n私も頑張るよ！"},
{"id": 32, "kind": "msg", "spk": "", "ja": "もう……そんな耳元で\n囁くなんて……。"},
{"id": 33, "kind": "msg", "spk": "", "ja": "アドバイスしてくれるの？"},
{"id": 34, "kind": "msg", "spk": "", "ja": "きゃっ！　トモちゃん……\nだ、ダメだってば！"},
{"id": 35, "kind": "msg", "spk": "", "ja": "ちょっと！\n耳は特訓に関係ないよ！"},
{"id": 36, "kind": "msg", "spk": "", "ja": "息継ぎも大事だよね。"},
{"id": 37, "kind": "msg", "spk": "", "ja": "トモちゃん……息継ぎの練習\n付き合ってくれるかな？"},
{"id": 38, "kind": "msg", "spk": "", "ja": "トモちゃん！　か、顔近いよ！"},
{"id": 39, "kind": "msg", "spk": "", "ja": "あ、あんまり見られると\n恥ずかしいよ……。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "リボンが気になるの？"},
{"id": 41, "kind": "msg", "spk": "", "ja": "ほどいた方が泳ぎやすいのかなぁ。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "リボンが泳ぎに関係してくるの？"},
{"id": 43, "kind": "msg", "spk": "", "ja": "そ、そんなことより\n泳ぎを教えてほしいな。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "似合ってるって？　えへへ……。"},
{"id": 45, "kind": "msg", "spk": "", "ja": "会長が用意してくれた水着……\nど、どうかな？"},
{"id": 46, "kind": "msg", "spk": "", "ja": "これがフォームの確認なんだね。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "この辺がよくなかったんだね。\nうん、気をつけるよ。"},
{"id": 48, "kind": "msg", "spk": "", "ja": "む～……。"},
{"id": 49, "kind": "msg", "spk": "", "ja": "あ、ちょっとやめてよ……！"},
{"id": 50, "kind": "msg", "spk": "", "ja": "ううう～……！"},
{"id": 51, "kind": "msg", "spk": "", "ja": "トモちゃんのバカ！"},
{"id": 52, "kind": "msg", "spk": "", "ja": "昔っからトモちゃんは\nエッチなんだから！"},
{"id": 53, "kind": "msg", "spk": "", "ja": "トモちゃんのエッチ！"},
{"id": 54, "kind": "msg", "spk": "", "ja": "ねえ……そんな事して、\n何が楽しいの？"},
{"id": 55, "kind": "msg", "spk": "", "ja": "す、少し落ち着こ？　ね？"},
{"id": 56, "kind": "msg", "spk": "", "ja": "いいかげんに……しなさい！"},
{"id": 57, "kind": "msg", "spk": "", "ja": "私は幼なじみとして\n恥ずかしいよ……。"},
{"id": 58, "kind": "msg", "spk": "", "ja": "あんまり調子にのっちゃダメだよ！\nトモちゃん。"},
{"id": 59, "kind": "msg", "spk": "", "ja": "ねえ……ちょっと\n酷いんじゃないかな……。"},
{"id": 60, "kind": "msg", "spk": "", "ja": "後でチョップ決定なんだから！"},
{"id": 61, "kind": "msg", "spk": "", "ja": "トモちゃん……目が怖いよ……。"},
{"id": 62, "kind": "msg", "spk": "", "ja": "ふざけすぎだよトモちゃん！"},
{"id": 63, "kind": "msg", "spk": "", "ja": "ト～モ～ちゃ～ん……？"},
{"id": 64, "kind": "msg", "spk": "", "ja": "それ以上したら……\nわかってるよね？　トモちゃん。"},
{"id": 65, "kind": "msg", "spk": "そはら", "ja": "トモちゃん、変なこと\n考えたらダメだからね！"},
{"id": 66, "kind": "msg", "spk": "", "ja": "トモちゃん……こんなことで\n泳げるようになるの！？"},
{"id": 67, "kind": "msg", "spk": "", "ja": "調子にのりすぎだよぉ～！\nトモちゃん！"},
{"id": 68, "kind": "msg", "spk": "", "ja": "そ、そんなぁ～！\nトモちゃんに遅れをとるなんて……。"},
{"id": 69, "kind": "msg", "spk": "", "ja": "え！？　嘘！？\nトモちゃんに……防がれた……？"},
{"id": 70, "kind": "msg", "spk": "", "ja": "わ、私もうガマンできないの！\n死んでトモちゃん！"},
{"id": 71, "kind": "msg", "spk": "", "ja": "わ、私もうガマンできないの！\n死んでトモちゃん！"},
{"id": 72, "kind": "msg", "spk": "", "ja": "早く教えてよー、トモちゃん。"},
{"id": 73, "kind": "msg", "spk": "", "ja": "変なこと考えてないよね……。"},
{"id": 74, "kind": "msg", "spk": "", "ja": "水泳に一番必要なのって\nどこなのかなぁ～……。"},
{"id": 75, "kind": "msg", "spk": "", "ja": "私は、ただ水泳を教えて\nもらいたかっただけなのに……。"},
{"id": 76, "kind": "msg", "spk": "そはら", "ja": "ありがとうトモちゃん。\n少し泳げるような気がしてきたよ。"}
]}
