{"file": "_Data/Script/Trial/PackScript03.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "マスターも……うれしいのですか？"},
{"id": 1, "kind": "msg", "spk": "", "ja": "大丈夫……です。異常……ありません。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "お望みとあれば……。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "マスター、なんなりと\nご命令して下さい……。"},
{"id": 4, "kind": "msg", "spk": "", "ja": "これが……うれしいという\nことなんでしょうか。"},
{"id": 5, "kind": "msg", "spk": "", "ja": "（にやり）"},
{"id": 6, "kind": "msg", "spk": "", "ja": "エンジェロイドの身体に……\n興味がおありですか……？"},
{"id": 7, "kind": "msg", "spk": "", "ja": "マスターが楽しいと、私も嬉しいです。"},
{"id": 8, "kind": "msg", "spk": "", "ja": "体温……わずかに上昇……。\n活動に支障は……ありません。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "マスターと一緒だとなんだか\nぽかぽかします。"},
{"id": 10, "kind": "msg", "spk": "", "ja": "動力炉が……痛いです……。"},
{"id": 11, "kind": "msg", "spk": "", "ja": "この……感覚は……何でしょう……。"},
{"id": 12, "kind": "msg", "spk": "", "ja": "他にご命令は……。"},
{"id": 13, "kind": "msg", "spk": "", "ja": "（そわそわ……）"},
{"id": 14, "kind": "msg", "spk": "", "ja": "脈拍が……乱れています……。\n活動に支障は……ありません。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "（おろおろ……）"},
{"id": 16, "kind": "msg", "spk": "", "ja": "マスターの手……暖かい……。"},
{"id": 17, "kind": "msg", "spk": "", "ja": "マスターのような人には……\nはじめて、会いました。"},
{"id": 18, "kind": "msg", "spk": "", "ja": "あなたが楽しめることをなんなりと……\nマイ・マスター。"},
{"id": 19, "kind": "msg", "spk": "", "ja": "マスター……もっと私と一緒に……。"},
{"id": 20, "kind": "msg", "spk": "", "ja": "脈拍が……乱れています……。\n活動に支障は……ありません。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "あの日……最初に出会ったのが\nマスターで良かったです。"},
{"id": 22, "kind": "msg", "spk": "", "ja": "私は……大好きなマスターを守ります。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "どうでしょう？\n何か違いはありましたでしょうか？"},
{"id": 24, "kind": "msg", "spk": "", "ja": "マスターに触られると\nとても……安心します……。"},
{"id": 25, "kind": "msg", "spk": "", "ja": "においを嗅ぐと\nなにかわかるのですか？"},
{"id": 26, "kind": "msg", "spk": "", "ja": "なでた感触はどうですか？"},
{"id": 27, "kind": "msg", "spk": "", "ja": "ふわふわして……\n心地いいです。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "あ……\nもう終わりなのですか……？"},
{"id": 29, "kind": "msg", "spk": "", "ja": "見た目に違いはありますか？"},
{"id": 30, "kind": "msg", "spk": "", "ja": "あの……\nもっとそうしてほしいです……。"},
{"id": 31, "kind": "msg", "spk": "", "ja": "マスターの手が……\n私に……。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "どうですか？\nいつもと何か違うでしょうか？"},
{"id": 33, "kind": "msg", "spk": "", "ja": "マスターにそうされると\nぽかぽかしてきます……。"},
{"id": 34, "kind": "msg", "spk": "", "ja": "あの……\n表情に違いがありましたか？"},
{"id": 35, "kind": "msg", "spk": "", "ja": "はい。\nなんでしょう、マスター？"},
{"id": 36, "kind": "msg", "spk": "", "ja": "あの……そんなに顔を\n近づけられると……。"},
{"id": 37, "kind": "msg", "spk": "", "ja": "もうすこし、マスターのお顔を\n見ていてよろしいですか？"},
{"id": 38, "kind": "msg", "spk": "", "ja": "もっと……じっくり\n見てください……。"},
{"id": 39, "kind": "msg", "spk": "", "ja": "なぜでしょう……。\n顔が熱くなってきました……。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "マスター……\nそんなに触られてしまうとちょっと……"},
{"id": 41, "kind": "msg", "spk": "", "ja": "どうですか、\n感触はいかがでしょうか？"},
{"id": 42, "kind": "msg", "spk": "", "ja": "あ……\nマスターの指が……。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "笑顔は……こう……\n……にやり。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "ん……口の中……どうでしたか？"},
{"id": 45, "kind": "msg", "spk": "", "ja": "見られていると思うと\n変な感じです……。"},
{"id": 46, "kind": "msg", "spk": "", "ja": "耳ばかり触られると、\nちょっと困ります。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "息をかけられると\nむずむずします……。"},
{"id": 48, "kind": "msg", "spk": "", "ja": "んん……そんなに引っ張られると\nその……困り……ます。"},
{"id": 49, "kind": "msg", "spk": "", "ja": "どこかおかしかったですか？"},
{"id": 50, "kind": "msg", "spk": "", "ja": "あの……服は\n同じ物なのですが……？"},
{"id": 51, "kind": "msg", "spk": "", "ja": "脱いだほうが\n調べやすいでしょうか？"},
{"id": 52, "kind": "msg", "spk": "", "ja": "ん……\n肌とこすれてくすぐったいです……。"},
{"id": 53, "kind": "msg", "spk": "", "ja": "制服、汚れていましたか？\n気付きませんでした……。"},
{"id": 54, "kind": "msg", "spk": "", "ja": "服ごしでもマスターの手……\nあたたかいです。"},
{"id": 55, "kind": "msg", "spk": "", "ja": "リボンは似合ってるでしょうか？"},
{"id": 56, "kind": "msg", "spk": "", "ja": "違いが見つかったのですか？"},
{"id": 57, "kind": "msg", "spk": "", "ja": "リボンの結び方？\nなにか……違いますか？"},
{"id": 58, "kind": "msg", "spk": "", "ja": "そんなに引っ張ってしまうと\n絡まってしまいます……。"},
{"id": 59, "kind": "msg", "spk": "", "ja": "羽に変なところが\nありましたか？"},
{"id": 60, "kind": "msg", "spk": "", "ja": "大きくしたほうが、\n調べやすいでしょうか？"},
{"id": 61, "kind": "msg", "spk": "", "ja": "ふさふさ……ですか。\nあの……ありがとうございます。"},
{"id": 62, "kind": "msg", "spk": "", "ja": "なでられると\nなんだかうれしいです……。"},
{"id": 63, "kind": "msg", "spk": "", "ja": "エンジェロイドの……\nマスターとの絆です。"},
{"id": 64, "kind": "msg", "spk": "", "ja": "金属ですから\nひんやりしていると思いますが……。"},
{"id": 65, "kind": "msg", "spk": "", "ja": "マスターとのつながりを感じます……。"},
{"id": 66, "kind": "msg", "spk": "", "ja": "どうです？\nなにかわかりましたか？"},
{"id": 67, "kind": "msg", "spk": "", "ja": "あ……\nその……お気になさらず……。"},
{"id": 68, "kind": "msg", "spk": "", "ja": "スイカは入らないので\nキーホルダーをつけました。"},
{"id": 69, "kind": "msg", "spk": "", "ja": "中身ですか？\nなにも入っていませんが？"},
{"id": 70, "kind": "msg", "spk": "", "ja": "はい、カバンです。"},
{"id": 71, "kind": "msg", "spk": "", "ja": "カバンを拭いてくださって……\nありがとうございます。"},
{"id": 72, "kind": "msg", "spk": "", "ja": "あの……学校へ行くのは\n人間らしいでしょうか？"},
{"id": 73, "kind": "msg", "spk": "", "ja": "私もマスターになでなでして\n欲しい……です。"},
{"id": 74, "kind": "msg", "spk": "", "ja": "…………。"},
{"id": 75, "kind": "msg", "spk": "", "ja": "…………。"},
{"id": 76, "kind": "msg", "spk": "", "ja": "……それが、お望みなら……。"},
{"id": 77, "kind": "msg", "spk": "", "ja": "このようなことを……\nお望みなのですか……？"},
{"id": 78, "kind": "msg", "spk": "", "ja": "私は……エンジェロイド……\nマスターの……道具……。"},
{"id": 79, "kind": "msg", "spk": "", "ja": "これは……罰……ですか？"},
{"id": 80, "kind": "msg", "spk": "", "ja": "動力炉が……ざわつきます……。"},
{"id": 81, "kind": "msg", "spk": "", "ja": "私は、愛玩用ですから……。"},
{"id": 82, "kind": "msg", "spk": "", "ja": "私は……どうすれば\nいいのでしょう……。"},
{"id": 83, "kind": "msg", "spk": "", "ja": "兵器として、扱われるよりは……。"},
{"id": 84, "kind": "msg", "spk": "", "ja": "っ…………。"},
{"id": 85, "kind": "msg", "spk": "", "ja": "人とは……やはり違いますか……？"},
{"id": 86, "kind": "msg", "spk": "", "ja": "マスター……。"},
{"id": 87, "kind": "msg", "spk": "", "ja": "私は……人ではありませんから……。"},
{"id": 88, "kind": "msg", "spk": "", "ja": "そのようなことは……。"},
{"id": 89, "kind": "msg", "spk": "", "ja": "マスターが、どうしてもと……\nおっしゃられるなら……。"},
{"id": 90, "kind": "msg", "spk": "", "ja": "マスターは……\n女性が好きなんですね……。"},
{"id": 91, "kind": "msg", "spk": "", "ja": "わたし……は……。"},
{"id": 92, "kind": "msg", "spk": "", "ja": "あの……マスター？\n一体……なにを……。"},
{"id": 93, "kind": "msg", "spk": "", "ja": "これは……悲しみ……？"},
{"id": 94, "kind": "msg", "spk": "", "ja": "あの……困ります……マスター……。"},
{"id": 95, "kind": "msg", "spk": "イカロス", "ja": "ではマスター……。\nよろしくお願いします。"},
{"id": 96, "kind": "msg", "spk": "", "ja": "マスター……できれば\n真面目に調べてほしいのですが……。"},
{"id": 97, "kind": "msg", "spk": "", "ja": "マスター？\n先ほどからなにか様子が変ですが……。"},
{"id": 98, "kind": "msg", "spk": "", "ja": "はい……もっと調べて下さい、\nマスター。"},
{"id": 99, "kind": "msg", "spk": "", "ja": "すみません……\n私の気のせいだったみたいです。"},
{"id": 100, "kind": "msg", "spk": "", "ja": "私は本物でも偽者でも、\nどちらでもいいのですか？"},
{"id": 101, "kind": "msg", "spk": "", "ja": "マスターが正気をなくしてる……\nしっかりしてください。"},
{"id": 102, "kind": "msg", "spk": "", "ja": "マスター？\nお疲れなのでしょうか？"},
{"id": 103, "kind": "msg", "spk": "", "ja": "あの……どうかされましたか？"},
{"id": 104, "kind": "msg", "spk": "", "ja": "マスター……。あの……\nそんなに見つめられると……"},
{"id": 105, "kind": "msg", "spk": "", "ja": "マスターは、私がお嫌い……\nなのでしょうか？"},
{"id": 106, "kind": "msg", "spk": "イカロス", "ja": "どうでしたか？　私は、イカロスに\nなれていたでしょうか。"}
]}
