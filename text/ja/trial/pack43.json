{"file": "_Data/Script/Trial/PackScript43.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "きゃる～ん☆"},
{"id": 1, "kind": "msg", "spk": "", "ja": "きゅぴ☆"},
{"id": 2, "kind": "msg", "spk": "", "ja": "うっふ～ん☆"},
{"id": 3, "kind": "msg", "spk": "", "ja": "にゃあ～ん☆"},
{"id": 4, "kind": "msg", "spk": "", "ja": "えへ☆"},
{"id": 5, "kind": "msg", "spk": "", "ja": "トモ子、かわいい？"},
{"id": 6, "kind": "msg", "spk": "", "ja": "イェエェース！"},
{"id": 7, "kind": "msg", "spk": "", "ja": "トモ子、こまっちゃう～☆"},
{"id": 8, "kind": "msg", "spk": "", "ja": "にゃんにゃんにゃあ～ん☆"},
{"id": 9, "kind": "msg", "spk": "", "ja": "あっは～ん☆\nキュンキュンきちゃう☆"},
{"id": 10, "kind": "msg", "spk": "", "ja": "これ以上はぁ……\nダ・メ・だ・ゾ☆"},
{"id": 11, "kind": "msg", "spk": "", "ja": "やあ～ん☆\nトモ子、ドッキドキぃ～☆"},
{"id": 12, "kind": "msg", "spk": "", "ja": "んん☆　余裕が\nなくなっちゃいそう……！"},
{"id": 13, "kind": "msg", "spk": "", "ja": "あふっ、い、今の\nちょっとスゴイかも……！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "こういう髪留めが\n男心をくすぐるのよね～。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "このサラサラヘアー……\nトップアイドルの素質アリね☆"},
{"id": 16, "kind": "msg", "spk": "", "ja": "髪の毛のケアも大事よね！"},
{"id": 17, "kind": "msg", "spk": "", "ja": "わたしったら\nかわいすぎる～☆"},
{"id": 18, "kind": "msg", "spk": "", "ja": "この笑顔で～たくさんのファンを\nゲットしちゃうんだから！"},
{"id": 19, "kind": "msg", "spk": "", "ja": "フェイスマッサージをすると\nお化粧のノリがよくなるのよね！"},
{"id": 20, "kind": "msg", "spk": "", "ja": "お化粧をすれば\nもっときれいになるわね☆"},
{"id": 21, "kind": "msg", "spk": "", "ja": "やだ…頬紅してないのに\n赤くなってきちゃった…Ω"},
{"id": 22, "kind": "msg", "spk": "", "ja": "アイドルとしては\nウィンクのひとつもできないとね！"},
{"id": 23, "kind": "msg", "spk": "", "ja": "えいっ☆\nや～んウィンク難しい～☆"},
{"id": 24, "kind": "msg", "spk": "", "ja": "えへ☆\nやったぁ～ウィンク上手くできたぁ☆"},
{"id": 25, "kind": "msg", "spk": "", "ja": "すぐに、泣けることも\nアイドルとしては大事だわ。"},
{"id": 26, "kind": "msg", "spk": "", "ja": "トモ子、あなたのことが好きなの…Ω\nなーんてね☆"},
{"id": 27, "kind": "msg", "spk": "", "ja": "わたしってば\nこんな格好も似合っちゃうのね。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "んん～☆\nくすぐたぁ～い～☆"},
{"id": 29, "kind": "msg", "spk": "", "ja": "このプロポーションなら\nなんでも着こなせそうね。"},
{"id": 30, "kind": "msg", "spk": "", "ja": "いろんな衣装を着て\n注目を集めちゃうんだから！"},
{"id": 31, "kind": "msg", "spk": "", "ja": "次のステージには\n何を着ていこうかしら。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "トモ子、普通の女の子に戻ります！\nなーんちゃって☆"},
{"id": 33, "kind": "msg", "spk": "", "ja": "エントリーナンバー２番\nトモ子です！　なーんてね☆"},
{"id": 34, "kind": "msg", "spk": "", "ja": "このキュートな八重歯が\nチャームポイントでーす☆"},
{"id": 35, "kind": "msg", "spk": "", "ja": "トモ子、あなたのためだけに\n歌いますΩ"},
{"id": 36, "kind": "msg", "spk": "", "ja": "リップも塗ってみよっかな～。"},
{"id": 37, "kind": "msg", "spk": "", "ja": "トモ子の投げキッス受け取ってね☆\nんーチュッΩ"},
{"id": 38, "kind": "msg", "spk": "", "ja": "にゃお～んΩ"},
{"id": 39, "kind": "msg", "spk": "", "ja": "にゃはははは～。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "にゃお～ん☆\nえっへへ～。"},
{"id": 41, "kind": "msg", "spk": "", "ja": "ごろごろにゃ～んΩ"},
{"id": 42, "kind": "msg", "spk": "", "ja": "にゃんにゃん☆"},
{"id": 43, "kind": "msg", "spk": "", "ja": "うーん、もうちょっと\nポーズを研究しないとねー。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "（もっとだ！　もっとプリティに！）"},
{"id": 45, "kind": "msg", "spk": "", "ja": "アイドルの道は\n一日にしてならずよ！"},
{"id": 46, "kind": "msg", "spk": "", "ja": "うーん……このあたりは\nちょっと色気が足りないわね。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "（もっとだ！　もっとキュートに！）"},
{"id": 48, "kind": "msg", "spk": "", "ja": "（もっとだ！　もっとセクシーに！）"},
{"id": 49, "kind": "msg", "spk": "", "ja": "やぁ～ん☆"},
{"id": 50, "kind": "msg", "spk": "", "ja": "トモ子分かんな～い☆"},
{"id": 51, "kind": "msg", "spk": "", "ja": "なーんか違うのよねぇ……。\nどこかしら……"},
{"id": 52, "kind": "msg", "spk": "", "ja": "（ダメだ！　こんなんじゃ\n　アイドルになれねー！）"},
{"id": 53, "kind": "msg", "spk": "", "ja": "（こんなポーズじゃ天下を\n　取れないぞ！　トモ子！）"},
{"id": 54, "kind": "msg", "spk": "トモ子", "ja": "……ぶっちゃけ私ってイイ女よね。\nアイドルとかになれるんじゃ\nないかしら！"},
{"id": 55, "kind": "msg", "spk": "トモ子", "ja": "そうと決まればさっそく\nエクササイズ開始よ！"},
{"id": 56, "kind": "msg", "spk": "トモ子", "ja": "さぁ、アイドル目指して\nいち、に！　いち、に！"},
{"id": 57, "kind": "msg", "spk": "", "ja": "う……！\nいかん、男の本能が！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "し、しまった！\n興奮しすぎて変身がとけちまう！"},
{"id": 59, "kind": "msg", "spk": "", "ja": "ふー……。\nなんとか押さえ込んだわ！"},
{"id": 60, "kind": "msg", "spk": "", "ja": "ふー……。なんとか押さえ込んだわ！"},
{"id": 61, "kind": "msg", "spk": "", "ja": "し、しずまれ！　しずまれ！\n俺の……！"},
{"id": 62, "kind": "msg", "spk": "", "ja": "ぐあああ～！　む、むりやり\n押さえつけたが……！"},
{"id": 63, "kind": "msg", "spk": "", "ja": "何もしないってのも疲れるわ～。"},
{"id": 64, "kind": "msg", "spk": "", "ja": "何もしないってのも疲れるわ～。"},
{"id": 65, "kind": "msg", "spk": "", "ja": "ふう……ふう……\n最後、行っくわよ～☆"},
{"id": 66, "kind": "msg", "spk": "", "ja": "ダメだ……オレにはアイドルの\n才能はない。芸人に転向しよう……。"},
{"id": 67, "kind": "msg", "spk": "トモ子", "ja": "……いける、いけるわ！"},
{"id": 68, "kind": "msg", "spk": "トモ子", "ja": "この笑顔で日本中の男の視線を\nクギヅケにしちゃうんだからΩ"},
{"id": 69, "kind": "msg", "spk": "トモ子", "ja": "イエス！　イエーーース！！"}
]}
