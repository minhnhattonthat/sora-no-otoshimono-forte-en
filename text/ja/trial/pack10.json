{"file": "_Data/Script/Trial/PackScript10.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "あ……\n別になんとも……ないわよ。"},
{"id": 1, "kind": "msg", "spk": "", "ja": "な、なにこれ……。\n動力炉がポカポカしてきた……。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "はあ、はあ……\nこんなことって……！"},
{"id": 3, "kind": "msg", "spk": "", "ja": "こんなことで……\n負けないんだから！"},
{"id": 4, "kind": "msg", "spk": "", "ja": "ま、負けてたまるかぁ……！"},
{"id": 5, "kind": "msg", "spk": "", "ja": "う～。\nなんかクラクラする～。"},
{"id": 6, "kind": "msg", "spk": "", "ja": "き、気持ちよくなんてないわよ！"},
{"id": 7, "kind": "msg", "spk": "", "ja": "いやん、ちょっと\nやめてよぉー！"},
{"id": 8, "kind": "msg", "spk": "", "ja": "動力炉が熱いよぉ～！"},
{"id": 9, "kind": "msg", "spk": "", "ja": "あ、あんたなんかに\n好きにされるもんかーっ！"},
{"id": 10, "kind": "msg", "spk": "", "ja": "そ、そんなとこ……\nやああん……。"},
{"id": 11, "kind": "msg", "spk": "", "ja": "あうっ……んっ！"},
{"id": 12, "kind": "msg", "spk": "", "ja": "バカぁ……！\nんああっ……"},
{"id": 13, "kind": "msg", "spk": "", "ja": "あわわわわ！\nあわわわわわわ！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "さすがイカロス先輩のマスター！\n一筋縄ではいかないようね。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "さぁ、もっと油断しなさい！\nさぁ、さぁ、さぁ。"},
{"id": 16, "kind": "msg", "spk": "", "ja": "な、何ですか！？\n何なんですかぁ～！？"},
{"id": 17, "kind": "msg", "spk": "", "ja": "ひゃああああ！？\nバカバカバカぁー！"},
{"id": 18, "kind": "msg", "spk": "", "ja": "ああんっフリーズしちゃう！\n再起動しちゃうよぉ～！"},
{"id": 19, "kind": "msg", "spk": "", "ja": "え……ちょっと……\nなにそれ……ああっ！"},
{"id": 20, "kind": "msg", "spk": "", "ja": "な、何ですか！？\n何なんですかぁ～！？"},
{"id": 21, "kind": "msg", "spk": "", "ja": "ひゃああああ！？\nバカバカバカぁー！"},
{"id": 22, "kind": "msg", "spk": "", "ja": "ああんっフリーズしちゃう！\n再起動しちゃうよぉ～！"},
{"id": 23, "kind": "msg", "spk": "", "ja": "え……ちょっと……\nなにそれ……ああっ！"},
{"id": 24, "kind": "msg", "spk": "", "ja": "髪の感触を確かめてるの？\nいいわよ、好きなだけ調べて！"},
{"id": 25, "kind": "msg", "spk": "", "ja": "な、なでなでして\n反応をたしかめてるつもり！？"},
{"id": 26, "kind": "msg", "spk": "", "ja": "髪の毛なんて見ても見分けは\nつかないと思うけどなぁ……。"},
{"id": 27, "kind": "msg", "spk": "", "ja": "さらさらだってば！"},
{"id": 28, "kind": "msg", "spk": "", "ja": "そ、そんなにマジマジ見て\n分かるの？"},
{"id": 29, "kind": "msg", "spk": "", "ja": "ぷにぷにしちゃダメぇ……。"},
{"id": 30, "kind": "msg", "spk": "", "ja": "ん？　なになに？"},
{"id": 31, "kind": "msg", "spk": "", "ja": "シンタイソクテイを\n思い出します！"},
{"id": 32, "kind": "msg", "spk": "", "ja": "かかか、顔が近いわよ！"},
{"id": 33, "kind": "msg", "spk": "", "ja": "じー……。"},
{"id": 34, "kind": "msg", "spk": "", "ja": "ハイ！　ハイ！\n早く調べてください！"},
{"id": 35, "kind": "msg", "spk": "", "ja": "く、くすぐったいじゃない！"},
{"id": 36, "kind": "msg", "spk": "", "ja": "ふぁぁ……っ\nむずむずする……！"},
{"id": 37, "kind": "msg", "spk": "", "ja": "耳を見せればいいの？\nハイ！"},
{"id": 38, "kind": "msg", "spk": "", "ja": "な、何するの……！"},
{"id": 39, "kind": "msg", "spk": "", "ja": "え！　おむすびくれるの！？\nわーい！"},
{"id": 40, "kind": "msg", "spk": "", "ja": "お、おむすびなんかに……\nつられ……つられ……！"},
{"id": 41, "kind": "msg", "spk": "", "ja": "むにむにしないでよ！"},
{"id": 42, "kind": "msg", "spk": "", "ja": "お口の中を見るんですか？\nあーん！"},
{"id": 43, "kind": "msg", "spk": "", "ja": "地上の服より\nずっと頑丈なんだからね！"},
{"id": 44, "kind": "msg", "spk": "", "ja": "そ、そんなところまで\n触っちゃダメぇ！"},
{"id": 45, "kind": "msg", "spk": "", "ja": "わ、私の格好をほめてもらっても\n別に嬉しくないわよ！"},
{"id": 46, "kind": "msg", "spk": "", "ja": "服もホンモノかどうか\n確かめてよね！"},
{"id": 47, "kind": "msg", "spk": "", "ja": "鎖を調べれば分かるの？"},
{"id": 48, "kind": "msg", "spk": "", "ja": "ああんっ。そんなに\n音たてちゃダメだってば！"},
{"id": 49, "kind": "msg", "spk": "", "ja": "あ、引っ張っちゃダメぇ～！"},
{"id": 50, "kind": "msg", "spk": "", "ja": "羽はホンモノの証拠になるの？"},
{"id": 51, "kind": "msg", "spk": "", "ja": "そんなにじっと見ても\n何もかわらないわよ！"},
{"id": 52, "kind": "msg", "spk": "", "ja": "さ、さわさわしちゃダメぇ～！"},
{"id": 53, "kind": "msg", "spk": "", "ja": "か、カンショクで分かったりするの！？"},
{"id": 54, "kind": "msg", "spk": "", "ja": "ひっ、なんかゾワってきた！"},
{"id": 55, "kind": "msg", "spk": "", "ja": "ぷすす～。\nたいしたことないもんね～。"},
{"id": 56, "kind": "msg", "spk": "", "ja": "うぎぎぎ～……！"},
{"id": 57, "kind": "msg", "spk": "", "ja": "だ、ダメダメぇ！\n絶対ダメぇ！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "うわーん！　こわいよー！"},
{"id": 59, "kind": "msg", "spk": "", "ja": "くぅ～……ぐぐぐ……\nこのー！　でべそ！"},
{"id": 60, "kind": "msg", "spk": "", "ja": "バーカ！　バーカ！"},
{"id": 61, "kind": "msg", "spk": "", "ja": "ひぃえええ～、\nもう許してよぉ～……。"},
{"id": 62, "kind": "msg", "spk": "", "ja": "ひ、卑劣なやつめ！"},
{"id": 63, "kind": "msg", "spk": "", "ja": "このアホー！\nやめてよ！"},
{"id": 64, "kind": "msg", "spk": "", "ja": "ハイ！　ハイ！\n意味が分かりません！"},
{"id": 65, "kind": "msg", "spk": "", "ja": "ぐぬぬぬぬ～……！"},
{"id": 66, "kind": "msg", "spk": "", "ja": "ゆゆゆゆるさない～！"},
{"id": 67, "kind": "msg", "spk": "", "ja": "イカロス先輩助けて～っ"},
{"id": 68, "kind": "msg", "spk": "", "ja": "ぷすす～♪\nバーカバーカ！"},
{"id": 69, "kind": "msg", "spk": "", "ja": "きもちわるいよー！"},
{"id": 70, "kind": "msg", "spk": "", "ja": "なんておぞましい……！"},
{"id": 71, "kind": "msg", "spk": "", "ja": "やっぱりあんたなんて\n信用できない！"},
{"id": 72, "kind": "msg", "spk": "アストレア", "ja": "ふんだ！　じゃあさっさと\n試してみなさいよ！"},
{"id": 73, "kind": "msg", "spk": "", "ja": "まっぷたつにしてやる～！"},
{"id": 74, "kind": "msg", "spk": "", "ja": "ひどい目にあわせてやる～！"},
{"id": 75, "kind": "msg", "spk": "", "ja": "人間のくせに……エンジェロイドと\n渡り合えるなんて……！"},
{"id": 76, "kind": "msg", "spk": "", "ja": "そ、そんな～！"},
{"id": 77, "kind": "msg", "spk": "", "ja": "ざまーみろ！\nバーカバーカ！"},
{"id": 78, "kind": "msg", "spk": "", "ja": "ぷすす～♪\nいい気味！"},
{"id": 79, "kind": "msg", "spk": "", "ja": "やっぱりホンモノかニセモノかなんて\n分からないんでしょ！"},
{"id": 80, "kind": "msg", "spk": "", "ja": "ちょっと……ムシしないでよね！"},
{"id": 81, "kind": "msg", "spk": "", "ja": "結局、私はホンモノかニセモノか\nどっちなのよ！"},
{"id": 82, "kind": "msg", "spk": "", "ja": "ほーら！　やっぱり分からなかった\nじゃない！　バーカ！　バーカ！"},
{"id": 83, "kind": "msg", "spk": "アストレア", "ja": "う、うそー！\n……まさか本当に分かったの！？"}
]}
