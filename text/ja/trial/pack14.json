{"file": "_Data/Script/Trial/PackScript14.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "んん……。\nトモちゃん……。"},
{"id": 1, "kind": "msg", "spk": "", "ja": "あ……うう……、\nな、何ともないんだからぁ！"},
{"id": 2, "kind": "msg", "spk": "", "ja": "えへへ……。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "トモちゃん……。"},
{"id": 4, "kind": "msg", "spk": "", "ja": "もうお弁当作ってきて\nあげないよ～！"},
{"id": 5, "kind": "msg", "spk": "", "ja": "頑張って、トモちゃん。"},
{"id": 6, "kind": "msg", "spk": "", "ja": "くすぐったいよぉ……。"},
{"id": 7, "kind": "msg", "spk": "", "ja": "こんなふうになっちゃうのは……\n今だけ……なんだから！"},
{"id": 8, "kind": "msg", "spk": "", "ja": "ふふふ……！　くすぐったいよ。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "な、なんだか照れちゃうな。"},
{"id": 10, "kind": "msg", "spk": "", "ja": "やっ……！　そんな強く……！"},
{"id": 11, "kind": "msg", "spk": "", "ja": "えへへ……なんだか照れちゃうな。"},
{"id": 12, "kind": "msg", "spk": "", "ja": "トモちゃあん……。"},
{"id": 13, "kind": "msg", "spk": "", "ja": "昔っからトモちゃんは\nエッチなんだからぁ……！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "ほかの子には……\nこんなことしちゃダメだよ？"},
{"id": 15, "kind": "msg", "spk": "", "ja": "そ、それ以上……されたら\n……ああん！"},
{"id": 16, "kind": "msg", "spk": "", "ja": "トモちゃんのバカぁ！"},
{"id": 17, "kind": "msg", "spk": "", "ja": "髪の毛をおろすと\nリラックスできるんだよ。"},
{"id": 18, "kind": "msg", "spk": "", "ja": "ポニーテールじゃないと\n似合わないかな？"},
{"id": 19, "kind": "msg", "spk": "", "ja": "乱暴に扱っちゃダメだよ……。"},
{"id": 20, "kind": "msg", "spk": "", "ja": "いつもポニーテールだからね。\nちょっと恥ずかしいかも……。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "つねったりしたらダメだからね！"},
{"id": 22, "kind": "msg", "spk": "", "ja": "私の顔に興味があるんだね……。\nちょっと嬉しいかも……。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "トモちゃんの指\nすべすべしてるね……。"},
{"id": 24, "kind": "msg", "spk": "", "ja": "トモちゃんのやさしさが\n伝わってくるみたい……。"},
{"id": 25, "kind": "msg", "spk": "", "ja": "なあに？"},
{"id": 26, "kind": "msg", "spk": "", "ja": "トモちゃんってやさしいところだけは\n昔から変わらないよね。"},
{"id": 27, "kind": "msg", "spk": "", "ja": "トモちゃんの顔がこんな近くに……。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "わ、わたしだけを見てほしいな……\nな、なんてね。"},
{"id": 29, "kind": "msg", "spk": "", "ja": "わたし今、耳が真っ赤だよ……。\nトモちゃんのせいだからね！"},
{"id": 30, "kind": "msg", "spk": "", "ja": "そこは敏感なんだってば！"},
{"id": 31, "kind": "msg", "spk": "", "ja": "な、なにするのトモちゃん！"},
{"id": 32, "kind": "msg", "spk": "", "ja": "あう……。\n息を吹きかけちゃダメだよ……。"},
{"id": 33, "kind": "msg", "spk": "", "ja": "そ、そこはダメだよ！\nトモちゃん！"},
{"id": 34, "kind": "msg", "spk": "", "ja": "わ、私、まだ心の準備が……。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "トモちゃん……。\nううん……呼んでみただけ……。"},
{"id": 36, "kind": "msg", "spk": "", "ja": "トモちゃん\nリボンが気になるのかな？"},
{"id": 37, "kind": "msg", "spk": "", "ja": "イタズラしちゃダメだよ！"},
{"id": 38, "kind": "msg", "spk": "", "ja": "あはは！　リボンでコチョコチョ\nしたらくすぐったいよ！"},
{"id": 39, "kind": "msg", "spk": "", "ja": "くんくんしちゃダメェ……。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "もしかしてエッチなこと考えてる？"},
{"id": 41, "kind": "msg", "spk": "", "ja": "制服が好きなんだね……。\nや、休みの日でも着ちゃおうかな……。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "そんなに真剣な目で見られると\n恥ずかしいかも……。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "む～……。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "あ、ちょっとやめてよ……！"},
{"id": 45, "kind": "msg", "spk": "", "ja": "ううう～……！"},
{"id": 46, "kind": "msg", "spk": "", "ja": "トモちゃんのバカ！"},
{"id": 47, "kind": "msg", "spk": "", "ja": "昔っからトモちゃんは\nエッチなんだから！"},
{"id": 48, "kind": "msg", "spk": "", "ja": "トモちゃんのエッチ！"},
{"id": 49, "kind": "msg", "spk": "", "ja": "ねえ……そんな事して、\n何が楽しいの？"},
{"id": 50, "kind": "msg", "spk": "", "ja": "す、少し落ち着こ？　ね？"},
{"id": 51, "kind": "msg", "spk": "", "ja": "いいかげんに……しなさい！"},
{"id": 52, "kind": "msg", "spk": "", "ja": "私は幼なじみとして\n恥ずかしいよ……。"},
{"id": 53, "kind": "msg", "spk": "", "ja": "あんまり調子にのっちゃダメだよ！\nトモちゃん。"},
{"id": 54, "kind": "msg", "spk": "", "ja": "ねえ……ちょっと\n酷いんじゃないかな……。"},
{"id": 55, "kind": "msg", "spk": "", "ja": "後でチョップ決定なんだから！"},
{"id": 56, "kind": "msg", "spk": "", "ja": "トモちゃん……目が怖いよ……。"},
{"id": 57, "kind": "msg", "spk": "", "ja": "ふざけすぎだよトモちゃん！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "ト～モ～ちゃ～ん……？"},
{"id": 59, "kind": "msg", "spk": "", "ja": "それ以上したら……\nわかってるよね？　トモちゃん。"},
{"id": 60, "kind": "msg", "spk": "そはら", "ja": "うふふ……。\nやさしくしてね、トモちゃん……。"},
{"id": 61, "kind": "msg", "spk": "", "ja": "いいかげんにしてよ！"},
{"id": 62, "kind": "msg", "spk": "", "ja": "もう！　どうして\nそんなことするの！"},
{"id": 63, "kind": "msg", "spk": "", "ja": "そ、そんなぁ～！\nトモちゃんに遅れをとるなんて……。"},
{"id": 64, "kind": "msg", "spk": "", "ja": "え！？　嘘！？\nトモちゃんに……防がれた……？"},
{"id": 65, "kind": "msg", "spk": "", "ja": "わ、私もうガマンできないの！\n死んでトモちゃん！"},
{"id": 66, "kind": "msg", "spk": "", "ja": "わ、私もうガマンできないの！\n死んでトモちゃん！"},
{"id": 67, "kind": "msg", "spk": "", "ja": "どうしたの？トモちゃん……。"},
{"id": 68, "kind": "msg", "spk": "", "ja": "変なこと考えてないよね……。"},
{"id": 69, "kind": "msg", "spk": "", "ja": "……トモちゃん……\nここ、お願い……。"},
{"id": 70, "kind": "msg", "spk": "", "ja": "ごめんね……。\nもうおしまいだよ、トモちゃん。"},
{"id": 71, "kind": "msg", "spk": "そはら", "ja": "うふふ……どう？\nトモちゃん。満足した？"}
]}
