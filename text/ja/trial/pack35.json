{"file": "_Data/Script/Trial/PackScript35.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "わあ、かわいい！"},
{"id": 1, "kind": "msg", "spk": "", "ja": "さぁ、おいでおいでー。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "ここがいいんだね。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "そこが気になるのかな？"},
{"id": 4, "kind": "msg", "spk": "", "ja": "そんなに見つめて……\n何かあるのかな？"},
{"id": 5, "kind": "msg", "spk": "", "ja": "ほら、もっと近くにおいで。"},
{"id": 6, "kind": "msg", "spk": "", "ja": "うんうん、賢いね。"},
{"id": 7, "kind": "msg", "spk": "", "ja": "あはっ、ちょっとくすぐったいかも。"},
{"id": 8, "kind": "msg", "spk": "", "ja": "もっとしてもいいよ。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "き、気持ちいいかも……。"},
{"id": 10, "kind": "msg", "spk": "", "ja": "わあ……私のこと気に入って\nくれたんだぁ……うれしいなぁ。"},
{"id": 11, "kind": "msg", "spk": "", "ja": "きゃっ！\nううん……なんでもないの。"},
{"id": 12, "kind": "msg", "spk": "", "ja": "イルカさん、やさしいんだね……。"},
{"id": 13, "kind": "msg", "spk": "", "ja": "イ、イルカさん……\nそこはダメェ……。"},
{"id": 14, "kind": "msg", "spk": "", "ja": "ひゃん！\nそ、そんなとこ……。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "この髪型似合ってるかな？\n……なーんてね。"},
{"id": 16, "kind": "msg", "spk": "", "ja": "この髪型は\nポニーテールって言うんだよ。"},
{"id": 17, "kind": "msg", "spk": "", "ja": "イルカさんの好きな\nニオイがするのかな……。"},
{"id": 18, "kind": "msg", "spk": "", "ja": "あ、あんまりすりすりしちゃダメだよ。"},
{"id": 19, "kind": "msg", "spk": "", "ja": "イルカさんに気に入ってもらえて\n嬉しいな！"},
{"id": 20, "kind": "msg", "spk": "", "ja": "私のこと気に入ってくれたのかな。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "ひゃんっ、ちょっと\nびっくりしちゃった。"},
{"id": 22, "kind": "msg", "spk": "", "ja": "イルカさん、あったかいね……。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "ふふふ……！\n私のこと気にかけてくれてるんだね。"},
{"id": 24, "kind": "msg", "spk": "", "ja": "そんなに見つめてどうしたの？"},
{"id": 25, "kind": "msg", "spk": "", "ja": "吸い込まれちゃいそうな瞳だね。"},
{"id": 26, "kind": "msg", "spk": "", "ja": "ふふっ、人懐っこいイルカさんだね。"},
{"id": 27, "kind": "msg", "spk": "", "ja": "わ、私のこと好きなのかなぁ……。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "もう、じゃれすぎだよぉ……。"},
{"id": 29, "kind": "msg", "spk": "", "ja": "愛情表現……なのかな？"},
{"id": 30, "kind": "msg", "spk": "", "ja": "リボンが気になるのかな？"},
{"id": 31, "kind": "msg", "spk": "", "ja": "間違って食べたら\n大変なことになっちゃうよ？"},
{"id": 32, "kind": "msg", "spk": "", "ja": "そんなに欲しがっても\n食べられないよ？"},
{"id": 33, "kind": "msg", "spk": "", "ja": "イルカさんのお肌と似てるのかな？"},
{"id": 34, "kind": "msg", "spk": "", "ja": "そんなに水着が好きなんて\nトモちゃんみたい……。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "ひゃん！　そ、そんなに引っ張ったら\nや、破けちゃうよ……。"},
{"id": 36, "kind": "msg", "spk": "", "ja": "やん、引っ張っちゃダメぇっ。"},
{"id": 37, "kind": "msg", "spk": "", "ja": "な……なんだか……\nおかしいよ？"},
{"id": 38, "kind": "msg", "spk": "", "ja": "こ、この視線……どこかで……。"},
{"id": 39, "kind": "msg", "spk": "", "ja": "こら！　私は食べ物じゃないよ？"},
{"id": 40, "kind": "msg", "spk": "", "ja": "わぁ、キレイな目……\nじゃないかも。"},
{"id": 41, "kind": "msg", "spk": "", "ja": "痛っ、噛んじゃダメだよ。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "か、加減してくれると嬉しいな。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "そんな所触っちゃダメ！"},
{"id": 44, "kind": "msg", "spk": "", "ja": "そんなに強いと\nアザになっちゃうよ……。"},
{"id": 45, "kind": "msg", "spk": "", "ja": "きゃっ！　あ、暴れないで！"},
{"id": 46, "kind": "msg", "spk": "", "ja": "イルカさんが\nイルカさんじゃないみたい……。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "ダメだよ！　こんなことしちゃ！"},
{"id": 48, "kind": "msg", "spk": "", "ja": "イルカさんの目\nちょっと怖いかも……。"},
{"id": 49, "kind": "msg", "spk": "そはら", "ja": "わあーイルカさんかわいい！\n私と友達になってくれるかな？"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "（俺がイルカに変身していることも\n　知らないでのんきな奴め。）"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "（うひょひょひょ！\n　覚悟しろそはら！）"},
{"id": 52, "kind": "msg", "spk": "そはら", "ja": "あはっ、くすぐったいよぉ。"},
{"id": 53, "kind": "msg", "spk": "", "ja": "イルカってこんなことするのかな？"},
{"id": 54, "kind": "msg", "spk": "", "ja": "さっきから行動が変だよ！？"},
{"id": 55, "kind": "msg", "spk": "", "ja": "うーん……。\n私の気のせいなのかなぁ……。"},
{"id": 56, "kind": "msg", "spk": "", "ja": "気にしすぎちゃったかな。"},
{"id": 57, "kind": "msg", "spk": "", "ja": "あ、あやしい！絶対にあやしいよ！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "あ、あやしい！絶対にあやしいよ！"},
{"id": 59, "kind": "msg", "spk": "", "ja": "イルカさんどうしたのかな？\n元気ないのかな……。"},
{"id": 60, "kind": "msg", "spk": "", "ja": "機嫌、悪くしちゃったの？"},
{"id": 61, "kind": "msg", "spk": "", "ja": "え、乗せてくれるの？\nありがとう！"},
{"id": 62, "kind": "msg", "spk": "", "ja": "ねえ……まさか、とは思うけど……\nトモちゃんじゃないよね……？"},
{"id": 63, "kind": "msg", "spk": "そはら", "ja": "わあーイルカさんの背中、\nすごくいい乗り心地だよ！"},
{"id": 64, "kind": "msg", "spk": "そはら", "ja": "ふふふ……！\n私たちすっかり友達だね。"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "（うひょひょひょ！\n　ふとももの感触がたまらんのう！）"},
{"id": 66, "kind": "msg", "spk": "智樹", "ja": "（けど、ちょっと重い……うぐっ！\n　こ、これはキツイ！）"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "（だ、誰か助けてくれ！\n　うぐぐぐぐ！）"}
]}
