{"file": "_Data/Script/Trial/PackScript01.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "マスターも……うれしいのですか？"},
{"id": 1, "kind": "msg", "spk": "", "ja": "大丈夫……です。異常……ありません。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "お望みとあれば……。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "マスター、なんなりと\nご命令して下さい……。"},
{"id": 4, "kind": "msg", "spk": "", "ja": "これが……うれしいという\nことなんでしょうか。"},
{"id": 5, "kind": "msg", "spk": "", "ja": "（にやり）"},
{"id": 6, "kind": "msg", "spk": "", "ja": "エンジェロイドの身体に……\n興味がおありですか……？"},
{"id": 7, "kind": "msg", "spk": "", "ja": "マスターが楽しいと、私も嬉しいです。"},
{"id": 8, "kind": "msg", "spk": "", "ja": "体温……わずかに上昇……。\n活動に支障は……ありません。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "マスターと一緒だとなんだか\nぽかぽかします。"},
{"id": 10, "kind": "msg", "spk": "", "ja": "動力炉が……痛いです……。"},
{"id": 11, "kind": "msg", "spk": "", "ja": "この……感覚は……何でしょう……。"},
{"id": 12, "kind": "msg", "spk": "", "ja": "他にご命令は……。"},
{"id": 13, "kind": "msg", "spk": "", "ja": "（そわそわ……）"},
{"id": 14, "kind": "msg", "spk": "", "ja": "脈拍が……乱れています……。\n活動に支障は……ありません。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "（おろおろ……）"},
{"id": 16, "kind": "msg", "spk": "", "ja": "マスターの手……暖かい……。"},
{"id": 17, "kind": "msg", "spk": "", "ja": "マスターのような人には……\nはじめて、会いました。"},
{"id": 18, "kind": "msg", "spk": "", "ja": "あなたが楽しめることをなんなりと……\nマイ・マスター。"},
{"id": 19, "kind": "msg", "spk": "", "ja": "マスター……もっと私と一緒に……。"},
{"id": 20, "kind": "msg", "spk": "", "ja": "脈拍が……乱れています……。\n活動に支障は……ありません。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "あの日……最初に出会ったのが\nマスターで良かったです。"},
{"id": 22, "kind": "msg", "spk": "", "ja": "私は……大好きなマスターを守ります。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "どうでしょう？\n何か見つかりましたか？"},
{"id": 24, "kind": "msg", "spk": "", "ja": "ん……とても……\n心地いいです……。"},
{"id": 25, "kind": "msg", "spk": "", "ja": "マスターの手つき\nとても優しいです……。"},
{"id": 26, "kind": "msg", "spk": "", "ja": "マスターが私を\nなでなでしてくれる……。"},
{"id": 27, "kind": "msg", "spk": "", "ja": "マスターが近いと……\nうれしいです。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "マスター……私、\nなんだかしあわせ……です。"},
{"id": 29, "kind": "msg", "spk": "", "ja": "ん……\nいえ、なんでもありません……。"},
{"id": 30, "kind": "msg", "spk": "", "ja": "顔が……熱い……です。"},
{"id": 31, "kind": "msg", "spk": "", "ja": "あの……マスター\nあまり……近づかれると……。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "はい、なんでしょうか……\nマスター？"},
{"id": 33, "kind": "msg", "spk": "", "ja": "マスターが……\n私だけを見ている……？"},
{"id": 34, "kind": "msg", "spk": "", "ja": "見つめられると……\n動力炉が……熱くなります……。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "ん……っ。"},
{"id": 36, "kind": "msg", "spk": "", "ja": "口の中を確認するのですか？"},
{"id": 37, "kind": "msg", "spk": "", "ja": "んむ……\nマスターの味がします。"},
{"id": 38, "kind": "msg", "spk": "", "ja": "体が熱くなって……\n私、どうしてしまったんでしょうか？"},
{"id": 39, "kind": "msg", "spk": "", "ja": "マスターの手は\nとても安心します……。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "んん……\nそんな奥まで……。"},
{"id": 41, "kind": "msg", "spk": "", "ja": "マスター、あの……\nむずむずします……。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "リボンが……\nどうかしたのでしょうか。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "マスター、探し物は\n見つかりましたか？"},
{"id": 44, "kind": "msg", "spk": "", "ja": "リボンが気になるのですか？"},
{"id": 45, "kind": "msg", "spk": "", "ja": "羽を広げた方が調べやすいでしょうか。"},
{"id": 46, "kind": "msg", "spk": "", "ja": "すぐそばに、マスターを\n感じます……。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "マスターが触ってくれると\nうれしいです。"},
{"id": 48, "kind": "msg", "spk": "", "ja": "鎖に指を入れると危険です……。"},
{"id": 49, "kind": "msg", "spk": "", "ja": "この鎖がマスターと私を\nつなげてるんですね。"},
{"id": 50, "kind": "msg", "spk": "", "ja": "この鎖は延びるので\n引っ張られても大丈夫です。"},
{"id": 51, "kind": "msg", "spk": "", "ja": "私……マスターと\nもっと繋がっていたいです……。"},
{"id": 52, "kind": "msg", "spk": "", "ja": "なんというか……\nしっくりきます……。"},
{"id": 53, "kind": "msg", "spk": "", "ja": "スイカ……\nかわいいです。"},
{"id": 54, "kind": "msg", "spk": "", "ja": "マスターになでられて\nスイカさんもうれしそうです。"},
{"id": 55, "kind": "msg", "spk": "", "ja": "マスターもスイカが好き……？\nなんだか……うれしいです。"},
{"id": 56, "kind": "msg", "spk": "", "ja": "…………。"},
{"id": 57, "kind": "msg", "spk": "", "ja": "…………。"},
{"id": 58, "kind": "msg", "spk": "", "ja": "……それが、お望みなら……。"},
{"id": 59, "kind": "msg", "spk": "", "ja": "このようなことを……\nお望みなのですか……？"},
{"id": 60, "kind": "msg", "spk": "", "ja": "私は……エンジェロイド……\nマスターの……道具……。"},
{"id": 61, "kind": "msg", "spk": "", "ja": "これは……罰……ですか？"},
{"id": 62, "kind": "msg", "spk": "", "ja": "動力炉が……ざわつきます……。"},
{"id": 63, "kind": "msg", "spk": "", "ja": "私は、愛玩用ですから……。"},
{"id": 64, "kind": "msg", "spk": "", "ja": "私は……どうすれば\nいいのでしょう……。"},
{"id": 65, "kind": "msg", "spk": "", "ja": "兵器として、扱われるよりは……。"},
{"id": 66, "kind": "msg", "spk": "", "ja": "っ…………。"},
{"id": 67, "kind": "msg", "spk": "", "ja": "人とは……やはり違いますか……？"},
{"id": 68, "kind": "msg", "spk": "", "ja": "マスター……。"},
{"id": 69, "kind": "msg", "spk": "", "ja": "私は……人ではありませんから……。"},
{"id": 70, "kind": "msg", "spk": "", "ja": "そのようなことは……。"},
{"id": 71, "kind": "msg", "spk": "", "ja": "マスターが、どうしてもと……\nおっしゃられるなら……。"},
{"id": 72, "kind": "msg", "spk": "", "ja": "マスターは……\n女性が好きなんですね……。"},
{"id": 73, "kind": "msg", "spk": "", "ja": "わたし……は……。"},
{"id": 74, "kind": "msg", "spk": "", "ja": "あの……マスター？\n一体……なにを……。"},
{"id": 75, "kind": "msg", "spk": "", "ja": "これは……悲しみ……？"},
{"id": 76, "kind": "msg", "spk": "", "ja": "あの……困ります……マスター……。"},
{"id": 77, "kind": "msg", "spk": "イカロス", "ja": "どうぞ……\nマスターの望むことをなんなりと……。"},
{"id": 78, "kind": "msg", "spk": "", "ja": "心拍数の上昇によるエラー発生。\nアルテミス発射シーケンスに移行……。"},
{"id": 79, "kind": "msg", "spk": "", "ja": "発射シーケンスの解除を確認……\nすみませんでしたマスター。"},
{"id": 80, "kind": "msg", "spk": "", "ja": "全弾命中……あ、あの……\n大丈夫ですかマスター。"},
{"id": 81, "kind": "msg", "spk": "", "ja": "あの……マスター？\nどうかされましたか？"},
{"id": 82, "kind": "msg", "spk": "", "ja": "いつまでこうしていれば\nよろしいのでしょうか？"},
{"id": 83, "kind": "msg", "spk": "", "ja": "マスター……\nどうか、おそばに……。"},
{"id": 84, "kind": "msg", "spk": "", "ja": "マスター……\nあの、私はこれで失礼します……。"},
{"id": 85, "kind": "msg", "spk": "イカロス", "ja": "探し物は見つかったようですね。\nさすがはマスターです。"}
]}
