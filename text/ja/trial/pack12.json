{"file": "_Data/Script/Trial/PackScript12.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "んん……。\nトモちゃん……。"},
{"id": 1, "kind": "msg", "spk": "", "ja": "あ……うう……、\nな、何ともないんだからぁ！"},
{"id": 2, "kind": "msg", "spk": "", "ja": "えへへ……。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "トモちゃん……。"},
{"id": 4, "kind": "msg", "spk": "", "ja": "もうお弁当作ってきて\nあげないよ～！"},
{"id": 5, "kind": "msg", "spk": "", "ja": "頑張って、トモちゃん。"},
{"id": 6, "kind": "msg", "spk": "", "ja": "くすぐったいよぉ……。"},
{"id": 7, "kind": "msg", "spk": "", "ja": "こんなふうになっちゃうのは……\n今だけ……なんだから！"},
{"id": 8, "kind": "msg", "spk": "", "ja": "ふふふ……！　くすぐったいよ。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "な、なんだか照れちゃうな。"},
{"id": 10, "kind": "msg", "spk": "", "ja": "やっ……！　そんな強く……！"},
{"id": 11, "kind": "msg", "spk": "", "ja": "えへへ……なんだか照れちゃうな。"},
{"id": 12, "kind": "msg", "spk": "", "ja": "トモちゃあん……。"},
{"id": 13, "kind": "msg", "spk": "", "ja": "昔っからトモちゃんは\nエッチなんだからぁ……！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "ほかの子には……\nこんなことしちゃダメだよ？"},
{"id": 15, "kind": "msg", "spk": "", "ja": "そ、それ以上……されたら\n……ああん！"},
{"id": 16, "kind": "msg", "spk": "", "ja": "トモちゃんのバカぁ！"},
{"id": 17, "kind": "msg", "spk": "", "ja": "ちゃんとお手入れしてるんだからね。\n結構さらさらなんだよ。"},
{"id": 18, "kind": "msg", "spk": "", "ja": "トモちゃんはポニーテール……好き？"},
{"id": 19, "kind": "msg", "spk": "", "ja": "髪が傷まないように……優しくしてね。"},
{"id": 20, "kind": "msg", "spk": "", "ja": "えへへ。\nトモちゃんになでなでされちゃった。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "トモちゃん、どうしたの？"},
{"id": 22, "kind": "msg", "spk": "", "ja": "私の顔に……なにかついてるかな？"},
{"id": 23, "kind": "msg", "spk": "", "ja": "は、肌のお手入れは自分でしてるから\nもう大丈夫だよっ。"},
{"id": 24, "kind": "msg", "spk": "", "ja": "わ、私のお肌……大丈夫かな？"},
{"id": 25, "kind": "msg", "spk": "", "ja": "一生懸命なトモちゃんって……\n……かっこいい……。"},
{"id": 26, "kind": "msg", "spk": "", "ja": "トモちゃん……\nそんな真剣な目をして……。"},
{"id": 27, "kind": "msg", "spk": "", "ja": "ト、トモちゃん……\nそんなに見つめられると私……。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "そんなに見つめられると……\n……恥ずかしいよぉ。"},
{"id": 29, "kind": "msg", "spk": "", "ja": "トモちゃん。\n耳が気になるの……？"},
{"id": 30, "kind": "msg", "spk": "", "ja": "そ、そんなに見ちゃダメなんだからね。"},
{"id": 31, "kind": "msg", "spk": "", "ja": "ト、トモちゃん……\nくすぐったいってばぁ……。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "み、耳は弱いからダメぇ……。"},
{"id": 33, "kind": "msg", "spk": "", "ja": "トモちゃんが望むのなら……私は……。\nううん、なんでもない……。"},
{"id": 34, "kind": "msg", "spk": "", "ja": "私の唇がそんなに……気になるの……？"},
{"id": 35, "kind": "msg", "spk": "", "ja": "そ、そんなところ……ダメなんだから！"},
{"id": 36, "kind": "msg", "spk": "", "ja": "ト、トモちゃん。私はいいから……\n服のお手入れをお願い。"},
{"id": 37, "kind": "msg", "spk": "", "ja": "トモちゃん、\nリボンがどうかしたのかな？"},
{"id": 38, "kind": "msg", "spk": "", "ja": "あれ？\nもしかしてほどけそうなのかな？"},
{"id": 39, "kind": "msg", "spk": "", "ja": "トモちゃんは\nリボンをほどいた方が好き……かな？"},
{"id": 40, "kind": "msg", "spk": "", "ja": "ト、トモちゃん！\nそれよりも服のお手入れをしないと！"},
{"id": 41, "kind": "msg", "spk": "", "ja": "へぇー。\nそうやってお手入れするんだね。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "これならきっと\n服も満足してくれるよね。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "優しい手つきだね……\n……服がちょっと羨ましいかも。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "も、もうちょっと優しく……\nブラッシングして……。"},
{"id": 45, "kind": "msg", "spk": "", "ja": "ポンポンのお手入れもするんだ？"},
{"id": 46, "kind": "msg", "spk": "", "ja": "応援するならやっぱりこれがないとね！"},
{"id": 47, "kind": "msg", "spk": "", "ja": "うん、キレイにしないと\nすぐにほつれちゃうからね。"},
{"id": 48, "kind": "msg", "spk": "", "ja": "フレー、フレー、ト・モ・ちゃん！\n……な、なんてね。"},
{"id": 49, "kind": "msg", "spk": "", "ja": "む～……。"},
{"id": 50, "kind": "msg", "spk": "", "ja": "あ、ちょっとやめてよ……！"},
{"id": 51, "kind": "msg", "spk": "", "ja": "ううう～……！"},
{"id": 52, "kind": "msg", "spk": "", "ja": "トモちゃんのバカ！"},
{"id": 53, "kind": "msg", "spk": "", "ja": "昔っからトモちゃんは\nエッチなんだから！"},
{"id": 54, "kind": "msg", "spk": "", "ja": "トモちゃんのエッチ！"},
{"id": 55, "kind": "msg", "spk": "", "ja": "ねえ……そんな事して、\n何が楽しいの？"},
{"id": 56, "kind": "msg", "spk": "", "ja": "す、少し落ち着こ？　ね？"},
{"id": 57, "kind": "msg", "spk": "", "ja": "いいかげんに……しなさい！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "私は幼なじみとして\n恥ずかしいよ……。"},
{"id": 59, "kind": "msg", "spk": "", "ja": "あんまり調子にのっちゃダメだよ！\nトモちゃん。"},
{"id": 60, "kind": "msg", "spk": "", "ja": "ねえ……ちょっと\n酷いんじゃないかな……。"},
{"id": 61, "kind": "msg", "spk": "", "ja": "後でチョップ決定なんだから！"},
{"id": 62, "kind": "msg", "spk": "", "ja": "トモちゃん……目が怖いよ……。"},
{"id": 63, "kind": "msg", "spk": "", "ja": "ふざけすぎだよトモちゃん！"},
{"id": 64, "kind": "msg", "spk": "", "ja": "ト～モ～ちゃ～ん……？"},
{"id": 65, "kind": "msg", "spk": "", "ja": "それ以上したら……\nわかってるよね？　トモちゃん。"},
{"id": 66, "kind": "msg", "spk": "そはら", "ja": "触っていいのは服だけだよ！\n分かってるのトモちゃん！？"},
{"id": 67, "kind": "msg", "spk": "", "ja": "口で言っても分からないなら！\nこうだよ！"},
{"id": 68, "kind": "msg", "spk": "", "ja": "調子にのりすぎだよぉ～！\nトモちゃん！"},
{"id": 69, "kind": "msg", "spk": "", "ja": "そ、そんなぁ～！\nトモちゃんに遅れをとるなんて……。"},
{"id": 70, "kind": "msg", "spk": "", "ja": "え！？　嘘！？\nトモちゃんに……防がれた……？"},
{"id": 71, "kind": "msg", "spk": "", "ja": "わ、私もうガマンできないの！\n死んでトモちゃん！"},
{"id": 72, "kind": "msg", "spk": "", "ja": "トモちゃんのエッチ～～！！"},
{"id": 73, "kind": "msg", "spk": "", "ja": "トモちゃん？\n服のお手入れは終わったの？"},
{"id": 74, "kind": "msg", "spk": "", "ja": "トモちゃん。\n服が飛んでいく前にお願いね……。"},
{"id": 75, "kind": "msg", "spk": "", "ja": "あ、服の様子が\n変わってきたよ……。"},
{"id": 76, "kind": "msg", "spk": "", "ja": "こんなの服のお手入れじゃないよ……\nトモちゃんの、バカ！"},
{"id": 77, "kind": "msg", "spk": "そはら", "ja": "あ、私にも分かる……\n服が喜んでるよ……。"}
]}
