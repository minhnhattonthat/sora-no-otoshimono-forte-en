{"file": "_Data/Script/Trial/PackScript28.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "もう……そこは食べられないわよ。"},
{"id": 1, "kind": "msg", "spk": "", "ja": "慰めてくれてるの？"},
{"id": 2, "kind": "msg", "spk": "", "ja": "あはは、くすぐったいわよ♪"},
{"id": 3, "kind": "msg", "spk": "", "ja": "ひゃっ！\nついばんじゃダメだってばっ！"},
{"id": 4, "kind": "msg", "spk": "", "ja": "やわらかい羽毛ね……。\n触っていてもいいかしら。"},
{"id": 5, "kind": "msg", "spk": "", "ja": "人に慣れてるけど、どこかから\n逃げ出してきたの？"},
{"id": 6, "kind": "msg", "spk": "", "ja": "あは♪　かわいいわね……。"},
{"id": 7, "kind": "msg", "spk": "", "ja": "かわいい……んだけど、\n何か変ね……。"},
{"id": 8, "kind": "msg", "spk": "", "ja": "楽しい？　私も楽しいわ♪"},
{"id": 9, "kind": "msg", "spk": "", "ja": "ひゃあ！　ちょ、ちょっと！\nびっくりしたじゃない！"},
{"id": 10, "kind": "msg", "spk": "", "ja": "大丈夫。\nいまの私は、幸せよ。"},
{"id": 11, "kind": "msg", "spk": "", "ja": "私を気づかってくれるなんて\nあんた、やさしいのね。"},
{"id": 12, "kind": "msg", "spk": "", "ja": "ねえ……あんたウチの子に\nならない？"},
{"id": 13, "kind": "msg", "spk": "", "ja": "髪の毛を痛めちゃダメよ？"},
{"id": 14, "kind": "msg", "spk": "", "ja": "私の髪が気に入ったの？"},
{"id": 15, "kind": "msg", "spk": "", "ja": "羽で撫でてくれるの？"},
{"id": 16, "kind": "msg", "spk": "", "ja": "あははっ、\nあんたの羽、くすぐったいわよ♪"},
{"id": 17, "kind": "msg", "spk": "", "ja": "お肌傷付けちゃ嫌よ。"},
{"id": 18, "kind": "msg", "spk": "", "ja": "クチバシでつんつんされるの……\nクセになりそう……。"},
{"id": 19, "kind": "msg", "spk": "", "ja": "私のこと気に入ってくれたの？\nちょっと嬉しいかも。"},
{"id": 20, "kind": "msg", "spk": "", "ja": "あんたに気に入ってもらえて\n私も嬉しいわ……。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "そんなとこつっついちゃダメ！"},
{"id": 22, "kind": "msg", "spk": "", "ja": "もっと近くにおいで……。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "すてきな羽毛ね……。\nずーっと見てたいくらい……。"},
{"id": 24, "kind": "msg", "spk": "", "ja": "耳元でさえずってくれる？"},
{"id": 25, "kind": "msg", "spk": "", "ja": "うふふ、一緒に歌ってみる？"},
{"id": 26, "kind": "msg", "spk": "", "ja": "んもう。\nいきなりなにすんのよ♪"},
{"id": 27, "kind": "msg", "spk": "", "ja": "く、口をつっついちゃダメぇ！"},
{"id": 28, "kind": "msg", "spk": "", "ja": "アイスがついてるの……？"},
{"id": 29, "kind": "msg", "spk": "", "ja": "あら、アイスで汚れてたのね。"},
{"id": 30, "kind": "msg", "spk": "", "ja": "あんたの羽もとってもキレイよ！"},
{"id": 31, "kind": "msg", "spk": "", "ja": "空を自由に飛ぶのって楽しいわよね。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "私の羽に興味あるんだ。"},
{"id": 33, "kind": "msg", "spk": "", "ja": "あんたのとは随分違うわよね。"},
{"id": 34, "kind": "msg", "spk": "", "ja": "あんたにマスターはいないのよね……。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "地上の空は広いわ……\n私の言葉じゃないけどね。"},
{"id": 36, "kind": "msg", "spk": "", "ja": "マスターになってって言ったら、\nあいつはどんな顔するのかな……。"},
{"id": 37, "kind": "msg", "spk": "", "ja": "ふぁああっちょっと……！\nく、食い込んでる！"},
{"id": 38, "kind": "msg", "spk": "", "ja": "この布がそんなに気に入ったの？"},
{"id": 39, "kind": "msg", "spk": "", "ja": "引っ張ったりしちゃダメよ？"},
{"id": 40, "kind": "msg", "spk": "", "ja": "ちょっと！　引っ張りすぎよ！"},
{"id": 41, "kind": "msg", "spk": "", "ja": "一口だけならあげてもいいわよ？"},
{"id": 42, "kind": "msg", "spk": "", "ja": "ふふふ……\n食べてる食べてる。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "こっちに来て食べてもいいわよ？"},
{"id": 44, "kind": "msg", "spk": "", "ja": "垂れたアイスなんて食べて\nおいしいの？"},
{"id": 45, "kind": "msg", "spk": "", "ja": "うふふ。\nどんな味に感じるのかしら？"},
{"id": 46, "kind": "msg", "spk": "", "ja": "へぇ～、おいしそうに食べるのね。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "あんたの小さい口じゃ\n全部はムリそうね……。"},
{"id": 48, "kind": "msg", "spk": "", "ja": "まあ、鳥のすることだしね。"},
{"id": 49, "kind": "msg", "spk": "", "ja": "よく見たらあんた\nわたしの知らない鳥ね……。"},
{"id": 50, "kind": "msg", "spk": "", "ja": "変なとこつっつかないでよね。"},
{"id": 51, "kind": "msg", "spk": "", "ja": "こんな模様の鳥いたかしら……。"},
{"id": 52, "kind": "msg", "spk": "", "ja": "もう！　つっつきすぎ！"},
{"id": 53, "kind": "msg", "spk": "", "ja": "やさしくしてって……\nあんたに言ってもわからないか……。"},
{"id": 54, "kind": "msg", "spk": "", "ja": "痛っ！　ちょっと気をつけてよね。"},
{"id": 55, "kind": "msg", "spk": "", "ja": "鳥にしてはおかしな行動……\nなんかあやしいわね……。"},
{"id": 56, "kind": "msg", "spk": "", "ja": "あんたって……\nまるであいつみたいね……。"},
{"id": 57, "kind": "msg", "spk": "ニンフ", "ja": "あら、こんなところに小鳥が……。"},
{"id": 58, "kind": "msg", "spk": "ニンフ", "ja": "この子、こんなに小さな羽で\n迷い込んできたのね。"},
{"id": 59, "kind": "msg", "spk": "ニンフ", "ja": "おいで。ヒマだから\n一緒に遊んであげるわ。"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "（やべー！　バレたのかと\n　思ったけどそうじゃなかったか）"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "（こうなったら、ドサクサに\n　まぎれて色々やってやる！）"},
{"id": 62, "kind": "msg", "spk": "", "ja": "あんた、本当に鳥なの！？"},
{"id": 63, "kind": "msg", "spk": "", "ja": "こんなことするなんて\nなんかあやしいわね！"},
{"id": 64, "kind": "msg", "spk": "", "ja": "うーん……勘違いだったかしら。"},
{"id": 65, "kind": "msg", "spk": "", "ja": "いけない……\nうたぐり深くなってたわね。"},
{"id": 66, "kind": "msg", "spk": "", "ja": "そんな悪い子にはおしおきよ！"},
{"id": 67, "kind": "msg", "spk": "", "ja": "や、やだ……\nアイス溶けちゃった……。"},
{"id": 68, "kind": "msg", "spk": "", "ja": "もっとこっちに来ればいいのに……。"},
{"id": 69, "kind": "msg", "spk": "", "ja": "ねぇ、構ってくれないの？"},
{"id": 70, "kind": "msg", "spk": "", "ja": "あら？　そろそろ\n飛びたくなってきたのかしら？"},
{"id": 71, "kind": "msg", "spk": "", "ja": "……ねえ、あんたトモキよね。\n覚悟は……いいかしら……。"},
{"id": 72, "kind": "msg", "spk": "ニンフ", "ja": "ありがと。\n楽しかったわ、とても。"},
{"id": 73, "kind": "msg", "spk": "ニンフ", "ja": "さ、もう行きなさいよ。\nあんたにも仲間がいるんでしょ？"},
{"id": 74, "kind": "msg", "spk": "ニンフ", "ja": "元気でね♪"},
{"id": 75, "kind": "msg", "spk": "智樹", "ja": "（まあ、たまにはこういうのも\n　悪くないか……）"}
]}
