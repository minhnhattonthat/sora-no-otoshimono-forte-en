{"file": "_Data/Script/Trial/PackScript19.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "きゃる～ん☆"},
{"id": 1, "kind": "msg", "spk": "", "ja": "きゅぴ☆"},
{"id": 2, "kind": "msg", "spk": "", "ja": "うっふ～ん☆"},
{"id": 3, "kind": "msg", "spk": "", "ja": "にゃあ～ん☆"},
{"id": 4, "kind": "msg", "spk": "", "ja": "えへ☆"},
{"id": 5, "kind": "msg", "spk": "", "ja": "トモ子、かわいい？"},
{"id": 6, "kind": "msg", "spk": "", "ja": "イェエェース！"},
{"id": 7, "kind": "msg", "spk": "", "ja": "トモ子、こまっちゃう～☆"},
{"id": 8, "kind": "msg", "spk": "", "ja": "にゃんにゃんにゃあ～ん☆"},
{"id": 9, "kind": "msg", "spk": "", "ja": "あっは～ん☆\nキュンキュンきちゃう☆"},
{"id": 10, "kind": "msg", "spk": "", "ja": "これ以上はぁ……\nダ・メ・だ・ゾ☆"},
{"id": 11, "kind": "msg", "spk": "", "ja": "やあ～ん☆\nトモ子、ドッキドキぃ～☆"},
{"id": 12, "kind": "msg", "spk": "", "ja": "んん☆　余裕が\nなくなっちゃいそう……！"},
{"id": 13, "kind": "msg", "spk": "", "ja": "あふっ、い、今の\nちょっとスゴイかも……！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "うーん、わたしの髪ってば\nサラッサラねっ"},
{"id": 15, "kind": "msg", "spk": "", "ja": "絹のようなさわり心地……\nいいわね！"},
{"id": 16, "kind": "msg", "spk": "", "ja": "なんていうキューティクル……。"},
{"id": 17, "kind": "msg", "spk": "", "ja": "女の子なんだから。\nクシは常備しておかないとね！"},
{"id": 18, "kind": "msg", "spk": "", "ja": "ちょっとカワイすぎじゃね！？"},
{"id": 19, "kind": "msg", "spk": "", "ja": "ぷにぷにぃ☆"},
{"id": 20, "kind": "msg", "spk": "", "ja": "この肌……おそろしいほどの\nつやつやっぷりね。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "私トモ子☆　ラブリーキュートな\n女の子よ！"},
{"id": 22, "kind": "msg", "spk": "", "ja": "つぶらな瞳……\n惚れてしまいそうだわ！"},
{"id": 23, "kind": "msg", "spk": "", "ja": "あん☆\nトモ子、痺れちゃう！"},
{"id": 24, "kind": "msg", "spk": "", "ja": "やっぱ美少女の条件として\n瞳は重要ね！"},
{"id": 25, "kind": "msg", "spk": "", "ja": "じー……おっといけない！\n時間を忘れて見入ってしまったわ。"},
{"id": 26, "kind": "msg", "spk": "", "ja": "なんてセクシーな耳の穴なの……\nゴクリ……。"},
{"id": 27, "kind": "msg", "spk": "", "ja": "ほじほじ……あん☆"},
{"id": 28, "kind": "msg", "spk": "", "ja": "この耳たぶの曲線……\nもはや芸術だわ。"},
{"id": 29, "kind": "msg", "spk": "", "ja": "もみもみ……んんっ！"},
{"id": 30, "kind": "msg", "spk": "", "ja": "活発な服装がまた\nそそるわねー。"},
{"id": 31, "kind": "msg", "spk": "", "ja": "あん☆　あんまり動くと\nはずんじゃうよぉ～。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "私ってば結構グラマラスよね！"},
{"id": 33, "kind": "msg", "spk": "", "ja": "こうなったら色々な\n服を着てみたいわね～。"},
{"id": 34, "kind": "msg", "spk": "", "ja": "このキュートな八重歯が\nポイントなのよねー。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "健康的な歯並び……\nいいわぁー……。"},
{"id": 36, "kind": "msg", "spk": "", "ja": "んちゅーΩ\nなーんちゃって☆"},
{"id": 37, "kind": "msg", "spk": "", "ja": "このくちびるは\nまさに理想形ね☆"},
{"id": 38, "kind": "msg", "spk": "", "ja": "もうちょっと……こうかな……。"},
{"id": 39, "kind": "msg", "spk": "", "ja": "（うーむ……。難しいなー）"},
{"id": 40, "kind": "msg", "spk": "", "ja": "ん～、なーんかちょっと\n違うのよねー。"},
{"id": 41, "kind": "msg", "spk": "", "ja": "（む……若干やわらかさが\n　足りないなー）"},
{"id": 42, "kind": "msg", "spk": "", "ja": "トモ子分かんな～い☆"},
{"id": 43, "kind": "msg", "spk": "", "ja": "（うーん……このあたりは\n　後で少し修正しておこっと）"},
{"id": 44, "kind": "msg", "spk": "", "ja": "ちょっと他の所を見てみよっと。"},
{"id": 45, "kind": "msg", "spk": "", "ja": "（ここはいいや）"},
{"id": 46, "kind": "msg", "spk": "", "ja": "うーん、ちょっと惜しいかなー。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "（このあたりはもうちょい\n　こだわらないといかんな……）"},
{"id": 48, "kind": "msg", "spk": "", "ja": "（ええい！　まだ女体に\n　なりきれていないぞ！）"},
{"id": 49, "kind": "msg", "spk": "", "ja": "（いーや、ダメだダメだ！\n　もっと上を目指せるはずだ！）"},
{"id": 50, "kind": "msg", "spk": "トモ子", "ja": "さーて、じゃあどの程度うまく\n女体化できてるか、早速確認☆"},
{"id": 51, "kind": "msg", "spk": "", "ja": "う……！\nいかん、男の本能が！"},
{"id": 52, "kind": "msg", "spk": "", "ja": "し、しまった！\n興奮しすぎて変身がとけちまう！"},
{"id": 53, "kind": "msg", "spk": "", "ja": "ふー……。なんとか押さえ込んだわね！"},
{"id": 54, "kind": "msg", "spk": "", "ja": "ふー……。なんとか押さえ込んだわね！"},
{"id": 55, "kind": "msg", "spk": "", "ja": "ぐあああ～！　む、むりやり\n押さえつけたが……！"},
{"id": 56, "kind": "msg", "spk": "", "ja": "ぐあああ～！　む、むりやり\n押さえつけたが……！"},
{"id": 57, "kind": "msg", "spk": "", "ja": "やぁ～ん☆じっとしてるのやだぁ～☆"},
{"id": 58, "kind": "msg", "spk": "", "ja": "やぁ～ん☆じっとしてるのやだぁ～☆"},
{"id": 59, "kind": "msg", "spk": "", "ja": "最後にここを確認して終わりね☆"},
{"id": 60, "kind": "msg", "spk": "", "ja": "あ、やべぇ！　一番大事なところが\n男のままじゃねーか！"},
{"id": 61, "kind": "msg", "spk": "トモ子", "ja": "イエース！　どっからどう見ても\nオ・ン・ナ・ノ・コ・ね☆"}
]}
