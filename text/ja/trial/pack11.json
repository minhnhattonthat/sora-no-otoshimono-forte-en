{"file": "_Data/Script/Trial/PackScript11.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "あ……\n別になんとも……ないわよ。"},
{"id": 1, "kind": "msg", "spk": "", "ja": "な、なにこれ……。\n動力炉がポカポカしてきた……。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "はあ、はあ……\nこんなことって……！"},
{"id": 3, "kind": "msg", "spk": "", "ja": "こんなことで……\n負けないんだから！"},
{"id": 4, "kind": "msg", "spk": "", "ja": "ま、負けてたまるかぁ……！"},
{"id": 5, "kind": "msg", "spk": "", "ja": "う～。\nなんかクラクラする～。"},
{"id": 6, "kind": "msg", "spk": "", "ja": "き、気持ちよくなんてないわよ！"},
{"id": 7, "kind": "msg", "spk": "", "ja": "いやん、ちょっと\nやめてよぉー！"},
{"id": 8, "kind": "msg", "spk": "", "ja": "動力炉が熱いよぉ～！"},
{"id": 9, "kind": "msg", "spk": "", "ja": "あ、あんたなんかに\n好きにされるもんかーっ！"},
{"id": 10, "kind": "msg", "spk": "", "ja": "そ、そんなとこ……\nやああん……。"},
{"id": 11, "kind": "msg", "spk": "", "ja": "あうっ……んっ！"},
{"id": 12, "kind": "msg", "spk": "", "ja": "バカぁ……！\nんああっ……"},
{"id": 13, "kind": "msg", "spk": "", "ja": "あわわわわ！\nあわわわわわわ！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "さすがイカロス先輩のマスター！\n一筋縄ではいかないようね。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "さぁ、もっと油断しなさい！\nさぁ、さぁ、さぁ。"},
{"id": 16, "kind": "msg", "spk": "", "ja": "な、何ですか！？\n何なんですかぁ～！？"},
{"id": 17, "kind": "msg", "spk": "", "ja": "ひゃああああ！？\nバカバカバカぁー！"},
{"id": 18, "kind": "msg", "spk": "", "ja": "ああんっフリーズしちゃう！\n再起動しちゃうよぉ～！"},
{"id": 19, "kind": "msg", "spk": "", "ja": "え……ちょっと……\nなにそれ……ああっ！"},
{"id": 20, "kind": "msg", "spk": "", "ja": "な、何ですか！？\n何なんですかぁ～！？"},
{"id": 21, "kind": "msg", "spk": "", "ja": "ひゃああああ！？\nバカバカバカぁー！"},
{"id": 22, "kind": "msg", "spk": "", "ja": "ああんっフリーズしちゃう！\n再起動しちゃうよぉ～！"},
{"id": 23, "kind": "msg", "spk": "", "ja": "え……ちょっと……\nなにそれ……ああっ！"},
{"id": 24, "kind": "msg", "spk": "", "ja": "髪にもかかっちゃったから\nフキフキしてよね！"},
{"id": 25, "kind": "msg", "spk": "", "ja": "な、なんか拭き方が\nおかしくない？"},
{"id": 26, "kind": "msg", "spk": "", "ja": "ど、どさくさにまぎれて\nなでるなー！"},
{"id": 27, "kind": "msg", "spk": "", "ja": "し、仕方ないわね。拭き終わるまでは\nおとなしくしてるわよ。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "んん……。"},
{"id": 29, "kind": "msg", "spk": "", "ja": "な、なんか視線が\nすごい気になるんだけど……。"},
{"id": 30, "kind": "msg", "spk": "", "ja": "ハイ！　ハイ！\nここも拭いてください！"},
{"id": 31, "kind": "msg", "spk": "", "ja": "もう、なんでジッと見るのよ。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "うう、ごめんなさいー……。"},
{"id": 33, "kind": "msg", "spk": "", "ja": "私がフキフキしなきゃ\nいけないのに……。"},
{"id": 34, "kind": "msg", "spk": "", "ja": "うひゃああ～！"},
{"id": 35, "kind": "msg", "spk": "", "ja": "な、何いまのっ……！\nなんで息を吹きかけるんですかぁ！？"},
{"id": 36, "kind": "msg", "spk": "", "ja": "あんΩ　冷たくて\nびっくりしちゃったじゃない！"},
{"id": 37, "kind": "msg", "spk": "", "ja": "これがコスプレってことなの？\n良く分かんない。"},
{"id": 38, "kind": "msg", "spk": "", "ja": "え、もえるって何？\n燃えちゃうの！？"},
{"id": 39, "kind": "msg", "spk": "", "ja": "いやぁん、ひっぱらないでよ。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "うさぎって食べられ……\nううん、なんでもないよ！"},
{"id": 41, "kind": "msg", "spk": "", "ja": "ハデにこぼしちゃったよー……。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "おいしそうなジュース……。\nじゅるり……。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "のどがかわいたよー。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "ええーん……。\nもったいないよー。"},
{"id": 45, "kind": "msg", "spk": "", "ja": "まだ、今なら食べても\n大丈夫かな……。"},
{"id": 46, "kind": "msg", "spk": "", "ja": "口はフキフキしなくていいよ～。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "口の中はどうだって？\nはい、あーん。"},
{"id": 48, "kind": "msg", "spk": "", "ja": "ハイ！　ハイ！\n静かにしてます！"},
{"id": 49, "kind": "msg", "spk": "", "ja": "べ、別につまみ食いとか\nしてないんだからね！"},
{"id": 50, "kind": "msg", "spk": "", "ja": "ビショビショで\n寒いよぉ～。"},
{"id": 51, "kind": "msg", "spk": "", "ja": "ハイ！　ハイ！\nコスプレってなんですか！"},
{"id": 52, "kind": "msg", "spk": "", "ja": "もう、早く拭いてよ\n寒くなって来ちゃったじゃない。"},
{"id": 53, "kind": "msg", "spk": "", "ja": "このスーツは防御力に\n問題があります！"},
{"id": 54, "kind": "msg", "spk": "", "ja": "鎖にはかかってないけど\n拭いてくれるの？"},
{"id": 55, "kind": "msg", "spk": "", "ja": "そんなことしても\nこれははずせないよ！"},
{"id": 56, "kind": "msg", "spk": "", "ja": "わーい！\n鎖もピカピカだよー！"},
{"id": 57, "kind": "msg", "spk": "", "ja": "あうΩ　\nひっぱっちゃダメぇ……。"},
{"id": 58, "kind": "msg", "spk": "", "ja": "あ～、羽も少しぬれちゃったかも！"},
{"id": 59, "kind": "msg", "spk": "", "ja": "羽はビンカンなんだから拭くときは……\nやさしく、してよね……。"},
{"id": 60, "kind": "msg", "spk": "", "ja": "ひっぱっちゃダメだよぉ～！"},
{"id": 61, "kind": "msg", "spk": "", "ja": "ねえ……私の羽に\n興味があるの？"},
{"id": 62, "kind": "msg", "spk": "", "ja": "ひっ、なんかゾワってきた！"},
{"id": 63, "kind": "msg", "spk": "", "ja": "ぷすす～。\nたいしたことないもんね～。"},
{"id": 64, "kind": "msg", "spk": "", "ja": "うぎぎぎ～……！"},
{"id": 65, "kind": "msg", "spk": "", "ja": "だ、ダメダメぇ！\n絶対ダメぇ！"},
{"id": 66, "kind": "msg", "spk": "", "ja": "うわーん！　こわいよー！"},
{"id": 67, "kind": "msg", "spk": "", "ja": "くぅ～……ぐぐぐ……\nこのー！　でべそ！"},
{"id": 68, "kind": "msg", "spk": "", "ja": "バーカ！　バーカ！"},
{"id": 69, "kind": "msg", "spk": "", "ja": "ひぃえええ～、\nもう許してよぉ～……。"},
{"id": 70, "kind": "msg", "spk": "", "ja": "ひ、卑劣なやつめ！"},
{"id": 71, "kind": "msg", "spk": "", "ja": "このアホー！\nやめてよ！"},
{"id": 72, "kind": "msg", "spk": "", "ja": "ハイ！　ハイ！\n意味が分かりません！"},
{"id": 73, "kind": "msg", "spk": "", "ja": "ぐぬぬぬぬ～……！"},
{"id": 74, "kind": "msg", "spk": "", "ja": "ゆゆゆゆるさない～！"},
{"id": 75, "kind": "msg", "spk": "", "ja": "イカロス先輩助けて～っ"},
{"id": 76, "kind": "msg", "spk": "", "ja": "ぷすす～♪\nバーカバーカ！"},
{"id": 77, "kind": "msg", "spk": "", "ja": "きもちわるいよー！"},
{"id": 78, "kind": "msg", "spk": "", "ja": "なんておぞましい……！"},
{"id": 79, "kind": "msg", "spk": "", "ja": "やっぱりあんたなんて\n信用できない！"},
{"id": 80, "kind": "msg", "spk": "アストレア", "ja": "あ～ん、こぼしちゃいました～！"},
{"id": 81, "kind": "msg", "spk": "", "ja": "まっぷたつにしてやる～！"},
{"id": 82, "kind": "msg", "spk": "", "ja": "ひどい目にあわせてやる～！"},
{"id": 83, "kind": "msg", "spk": "", "ja": "人間のくせに……エンジェロイドと\n渡り合えるなんて……！"},
{"id": 84, "kind": "msg", "spk": "", "ja": "そ、そんな～！"},
{"id": 85, "kind": "msg", "spk": "", "ja": "ざまーみろ！\nバーカバーカ！"},
{"id": 86, "kind": "msg", "spk": "", "ja": "ぷすす～♪\nいい気味！"},
{"id": 87, "kind": "msg", "spk": "", "ja": "フキフキしてくれるなら早くしてよー。"},
{"id": 88, "kind": "msg", "spk": "", "ja": "ちょっとー、風邪ひいちゃうよー。"},
{"id": 89, "kind": "msg", "spk": "", "ja": "あ、あとはここだけみたいだよ。"},
{"id": 90, "kind": "msg", "spk": "", "ja": "もういいわよ！\n文化祭なんて興味ないもん！"},
{"id": 91, "kind": "msg", "spk": "アストレア", "ja": "ふ、ふんだ！　お礼なんて……\nあ、ありがと……。"}
]}
