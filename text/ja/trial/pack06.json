{"file": "_Data/Script/Trial/PackScript06.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "私は、トモキにとって必要？"},
{"id": 1, "kind": "msg", "spk": "", "ja": "し、仕方ないわねぇ。\nトモキがどうしてもって言うなら……。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "へ、変ね……。\n顔が熱いわ……。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "トモキ……。"},
{"id": 4, "kind": "msg", "spk": "", "ja": "ふん……。\nなかなかやるじゃない。"},
{"id": 5, "kind": "msg", "spk": "", "ja": "うん、なかなか\nいい感じよ。"},
{"id": 6, "kind": "msg", "spk": "", "ja": "ねえ……アルファーにも、\n同じことしてるの……？"},
{"id": 7, "kind": "msg", "spk": "", "ja": "これくらいなら……\n協力してあげるわよ。"},
{"id": 8, "kind": "msg", "spk": "", "ja": "ト、トモキがそうしたいなら……。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "ふ、ふん！\nたいしたことないわね！"},
{"id": 10, "kind": "msg", "spk": "", "ja": "……デルタには、\nこんなことしてないよね……？"},
{"id": 11, "kind": "msg", "spk": "", "ja": "んんっ……別にドキドキなんて\nしてないんだからね！"},
{"id": 12, "kind": "msg", "spk": "", "ja": "ねえ、私はトモキと一緒に居て\nいいのよね……？"},
{"id": 13, "kind": "msg", "spk": "", "ja": "……っ！\nな、なんともないんだからね！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "トモキは……\nやさしいんだね。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "動力炉が……\nおかしくなりそう……！"},
{"id": 16, "kind": "msg", "spk": "", "ja": "トモキ……。\nううん、呼んでみただけよ♪"},
{"id": 17, "kind": "msg", "spk": "", "ja": "な、なんでもない！\nなんでもないったら！"},
{"id": 18, "kind": "msg", "spk": "", "ja": "髪の毛なんて揉んで意味あるの？"},
{"id": 19, "kind": "msg", "spk": "", "ja": "トモキぃ……ちょっと\nくすぐったいわよ。"},
{"id": 20, "kind": "msg", "spk": "", "ja": "ふーん、そういう趣味なんだ。\nへえ～……。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "ト、トモキは私の髪の毛に\n思い入れでもあるの？"},
{"id": 22, "kind": "msg", "spk": "", "ja": "も、もう十分よ！\n大丈夫なの！"},
{"id": 23, "kind": "msg", "spk": "", "ja": "か、顔が赤いですって？\n……気のせいよ！"},
{"id": 24, "kind": "msg", "spk": "", "ja": "そうね。そのあたりを\n念入りにお願いするわ。"},
{"id": 25, "kind": "msg", "spk": "", "ja": "トモキってこういうことは上手よね。"},
{"id": 26, "kind": "msg", "spk": "", "ja": "はい……目、つむってるから\nよろしくね。"},
{"id": 27, "kind": "msg", "spk": "", "ja": "あんたこういうときだけは\n目が輝いてるわね……。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "なによ。見つめながらじゃないと\nマッサージできないっていうの？"},
{"id": 29, "kind": "msg", "spk": "", "ja": "ねぇ、どうしたの？"},
{"id": 30, "kind": "msg", "spk": "", "ja": "耳は塗らなくていいわよ。"},
{"id": 31, "kind": "msg", "spk": "", "ja": "……っ！\nな、なんでもないわ！"},
{"id": 32, "kind": "msg", "spk": "", "ja": "ひゃう！　ちょっと、変な\nマッサージしないでよ！"},
{"id": 33, "kind": "msg", "spk": "", "ja": "もう……いいって言ってるのに……。"},
{"id": 34, "kind": "msg", "spk": "", "ja": "ふふん……興奮するのが\n怖いんでしょ。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "あら、これでおしまいのつもり？"},
{"id": 36, "kind": "msg", "spk": "", "ja": "ほらほら、手が止まってるわよ！"},
{"id": 37, "kind": "msg", "spk": "", "ja": "は、羽のマッサージなんて……！"},
{"id": 38, "kind": "msg", "spk": "", "ja": "トモキがしたいなら\n続けてもいいわよ……。"},
{"id": 39, "kind": "msg", "spk": "", "ja": "もう……\n責任、とってくれるの？"},
{"id": 40, "kind": "msg", "spk": "", "ja": "ねえ、それだけでいいの……？"},
{"id": 41, "kind": "msg", "spk": "", "ja": "首輪……爆発……\nううん、なんでもないわよ。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "ねぇ、トモキさえよければ\n私は……。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "そこをマッサージしてどうするの？\n変なトモキ。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "トモキってときどき\nおかしなことするわね……。"},
{"id": 45, "kind": "msg", "spk": "", "ja": "トモキってホント水着好きよね……。"},
{"id": 46, "kind": "msg", "spk": "", "ja": "……さあ、どうかしら？"},
{"id": 47, "kind": "msg", "spk": "", "ja": "あんた、ちょっと心拍数\nが上がってるわよ？"},
{"id": 48, "kind": "msg", "spk": "", "ja": "き、気持ちよくなんかないわよ！"},
{"id": 49, "kind": "msg", "spk": "", "ja": "ダーメ。あんたにはあげないもん。"},
{"id": 50, "kind": "msg", "spk": "", "ja": "はむっ……甘いものだーい好き！"},
{"id": 51, "kind": "msg", "spk": "", "ja": "あ、ちょっと！\nこれって間接……っ！"},
{"id": 52, "kind": "msg", "spk": "", "ja": "ちょっと！\nアイスを台無しにする気！"},
{"id": 53, "kind": "msg", "spk": "", "ja": "ちょっと、調子に乗りすぎよ。"},
{"id": 54, "kind": "msg", "spk": "", "ja": "ト・モ・キ・ィ？\n覚悟はいいかしら！"},
{"id": 55, "kind": "msg", "spk": "", "ja": "へえ……私とそんなことしたいわけ？"},
{"id": 56, "kind": "msg", "spk": "", "ja": "パラダイスソングを受けたいのかしら？"},
{"id": 57, "kind": "msg", "spk": "", "ja": "もう、トモキなんて知らない！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "へぇ、あんたって\nそういう趣味だったのね。"},
{"id": 59, "kind": "msg", "spk": "", "ja": "なんでアルファーはこんな奴を……。"},
{"id": 60, "kind": "msg", "spk": "", "ja": "呆れて何も言えないわ……。"},
{"id": 61, "kind": "msg", "spk": "", "ja": "へえ……そんなのが楽しいんだ。"},
{"id": 62, "kind": "msg", "spk": "", "ja": "ちょっと、シナプスのことを\n思い出しちゃったわ……。"},
{"id": 63, "kind": "msg", "spk": "", "ja": "私を怒らせて、あんたに\n一体何の得があるのかしら？"},
{"id": 64, "kind": "msg", "spk": "", "ja": "次に変なことしたら\nジャミングしてやるからね。"},
{"id": 65, "kind": "msg", "spk": "", "ja": "不潔よ！今まで私のこと\nそんな目で見てたのね！"},
{"id": 66, "kind": "msg", "spk": "", "ja": "し、信じられない!！"},
{"id": 67, "kind": "msg", "spk": "", "ja": "……へたくそ。"},
{"id": 68, "kind": "msg", "spk": "", "ja": "は～……。あきれたわ。"},
{"id": 69, "kind": "msg", "spk": "", "ja": "まったくもう！\nいつもこんなこと考えてんの？"},
{"id": 70, "kind": "msg", "spk": "", "ja": "トモキのバカバカ！ド変態！"},
{"id": 71, "kind": "msg", "spk": "", "ja": "もう、許さないんだからね！！"},
{"id": 72, "kind": "msg", "spk": "", "ja": "このスケベ！　変態！何考えてんのよ！"},
{"id": 73, "kind": "msg", "spk": "", "ja": "いつもこんなこと考えてんの？\nまったくしょうがないわねぇ……。"},
{"id": 74, "kind": "msg", "spk": "", "ja": "ダメッ！　ダメだったらっ！"},
{"id": 75, "kind": "msg", "spk": "", "ja": "わ、私のことをそんな目で\n見てたのね！"},
{"id": 76, "kind": "msg", "spk": "", "ja": "ちょ、ちょっと！\nおかしいんじゃないの！？"},
{"id": 77, "kind": "msg", "spk": "", "ja": "へ、変態！"},
{"id": 78, "kind": "msg", "spk": "", "ja": "トモキ……トモキのこと、\n信じていたのに……！"},
{"id": 79, "kind": "msg", "spk": "", "ja": "トモキ……ひどいよ……。"},
{"id": 80, "kind": "msg", "spk": "", "ja": "ひどい……どうしてこんなことを……。"},
{"id": 81, "kind": "msg", "spk": "", "ja": "なにすんのよ！　このバカァ！"},
{"id": 82, "kind": "msg", "spk": "ニンフ", "ja": "ふふふ。さあ、マッサージ\n出来るもんならやってみなさいよ。"},
{"id": 83, "kind": "msg", "spk": "", "ja": "これ以上あんたのペースに\nさせないんだから！"},
{"id": 84, "kind": "msg", "spk": "", "ja": "ちょ、ちょっと落ち着きなさいよ！"},
{"id": 85, "kind": "msg", "spk": "", "ja": "もうちょっとで爆発の\n巻き添えくらうところだったわ。"},
{"id": 86, "kind": "msg", "spk": "", "ja": "もうちょっとだけ\nじっとしててあげるわよ。"},
{"id": 87, "kind": "msg", "spk": "", "ja": "トモキのバカーッ！"},
{"id": 88, "kind": "msg", "spk": "", "ja": "さあ、私がいいって言ってるんだから\n早くしなさいよ。"},
{"id": 89, "kind": "msg", "spk": "", "ja": "トモキは……私に興味ないの……？"},
{"id": 90, "kind": "msg", "spk": "", "ja": "トモキ、そろそろ限界なんじゃない？"},
{"id": 91, "kind": "msg", "spk": "", "ja": "きゃっ、カウントダウン始まってる！\nこっちこないでー！"},
{"id": 92, "kind": "msg", "spk": "ニンフ", "ja": "顔が真っ赤よ？\n興奮しないんじゃなかったの？"}
]}
