{"file": "_Data/Script/Trial/PackScript40.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "油断するなよ。"},
{"id": 1, "kind": "msg", "spk": "", "ja": "なるほど、これは新たな試みだな。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "まぁ、及第点だな。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "ふむ……。\nまあ、いいだろう。"},
{"id": 4, "kind": "msg", "spk": "", "ja": "ほう……そうくるか。"},
{"id": 5, "kind": "msg", "spk": "", "ja": "ぬぅ……っ！"},
{"id": 6, "kind": "msg", "spk": "", "ja": "成長したな、智樹！"},
{"id": 7, "kind": "msg", "spk": "", "ja": "まさか、俺の想像を超えるとは……。"},
{"id": 8, "kind": "msg", "spk": "", "ja": "ふ、冒険家だな……智樹。\nそういうのは嫌いじゃない。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "そうだ。それでこそ\n俺の見込んだ男だ。"},
{"id": 10, "kind": "msg", "spk": "", "ja": "そうだ智樹！\nもっと……もっとだ！"},
{"id": 11, "kind": "msg", "spk": "", "ja": "ああ……なかなか、クッ\n思い切りが、いいじゃないか……！"},
{"id": 12, "kind": "msg", "spk": "", "ja": "頭部か……まあ定石だな。"},
{"id": 13, "kind": "msg", "spk": "", "ja": "髪をつまんでどうするつもりだ？"},
{"id": 14, "kind": "msg", "spk": "", "ja": "どうした。俺の顔に\n何かついているのか？"},
{"id": 15, "kind": "msg", "spk": "", "ja": "……少し、離れてくれないか。\nさすがに顔が近い。"},
{"id": 16, "kind": "msg", "spk": "", "ja": "む……今のはなかなか……。"},
{"id": 17, "kind": "msg", "spk": "", "ja": "さあ、次はどう出る……？"},
{"id": 18, "kind": "msg", "spk": "", "ja": "ほう……俺の視界を奪って\nどうするつもりだ？"},
{"id": 19, "kind": "msg", "spk": "", "ja": "……ふむ、俺の視線から\n思考を読み取るつもりか？"},
{"id": 20, "kind": "msg", "spk": "", "ja": "おい、耳をくすぐらないでくれるか。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "ふむ……。\nまあ、いいだろう。"},
{"id": 22, "kind": "msg", "spk": "", "ja": "俺に気づかれることなく\n耳をつまむとは……。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "……口か。いい判断だ。"},
{"id": 24, "kind": "msg", "spk": "", "ja": "むぐ……いや、大丈夫だ。\n何も問題はない。"},
{"id": 25, "kind": "msg", "spk": "", "ja": "相手の呼吸音から次の\n一手を計ろうというのか？"},
{"id": 26, "kind": "msg", "spk": "", "ja": "……一瞬にして口元に拳が……？\nやるな……。"},
{"id": 27, "kind": "msg", "spk": "", "ja": "守りをおろそかにした気はないが……\nたいしたものだ。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "こういう場では動きやすい格好の\n方がいいだろう。"},
{"id": 29, "kind": "msg", "spk": "", "ja": "隙を見せるつもりはないぞ。"},
{"id": 30, "kind": "msg", "spk": "", "ja": "おっと、このネクタイに\n手を出すつもりか。"},
{"id": 31, "kind": "msg", "spk": "", "ja": "隠れたものを見つけようとする行為。\nそれはすなわち冒険心……悪くないぞ。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "引っ張るなよ。\nほどけてしまうだろう。"},
{"id": 33, "kind": "msg", "spk": "", "ja": "……っ！　これはっ\nマズイかもしれんな……！"},
{"id": 34, "kind": "msg", "spk": "", "ja": "俺が押されているだと……？"},
{"id": 35, "kind": "msg", "spk": "", "ja": "と、智樹……お前……！"},
{"id": 36, "kind": "msg", "spk": "", "ja": "くっ……信じられん！"},
{"id": 37, "kind": "msg", "spk": "", "ja": "お前に足りないものは\n何だか分かるか？"},
{"id": 38, "kind": "msg", "spk": "", "ja": "お前の力はその程度か？"},
{"id": 39, "kind": "msg", "spk": "", "ja": "おい、そんな動きで大丈夫か？"},
{"id": 40, "kind": "msg", "spk": "", "ja": "やれやれだな……。"},
{"id": 41, "kind": "msg", "spk": "", "ja": "陳腐だな。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "落第点だぞ、智樹。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "引き際が肝心だぞ。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "ふん、それがお前の限界か。"},
{"id": 45, "kind": "msg", "spk": "", "ja": "向上心のない奴だ。"},
{"id": 46, "kind": "msg", "spk": "", "ja": "その行為、なにか意味があるのか？"},
{"id": 47, "kind": "msg", "spk": "", "ja": "俺の目も曇ったものだな……。"},
{"id": 48, "kind": "msg", "spk": "", "ja": "これは……\n失敗したかもしれんな。"},
{"id": 49, "kind": "msg", "spk": "", "ja": "明らかに無駄の多い行動だな。"},
{"id": 50, "kind": "msg", "spk": "守形", "ja": "今日は一体どうしたんだ？"},
{"id": 51, "kind": "msg", "spk": "トモ子", "ja": "センパイ！　私の修行の成果を\n見てくれませんか？"},
{"id": 52, "kind": "msg", "spk": "トモ子", "ja": "ぶっちゃけ、今の私だったら\nセンパイを超えられると\n思うんですよね！"},
{"id": 53, "kind": "msg", "spk": "守形", "ja": "ならば試してみるか？\n全力でかかってくるがいい！"},
{"id": 54, "kind": "msg", "spk": "トモ子", "ja": "それじゃあ、遠慮なく\nいかせてもらいます！"},
{"id": 55, "kind": "msg", "spk": "", "ja": "では、こういうのはどうだ！？"},
{"id": 56, "kind": "msg", "spk": "", "ja": "では、こういうのはどうだ！？"},
{"id": 57, "kind": "msg", "spk": "", "ja": "なかなかやるじゃないか……！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "くっ……今のをよけるか……！"},
{"id": 59, "kind": "msg", "spk": "", "ja": "俺を相手に油断できる身分か！？\n智樹！"},
{"id": 60, "kind": "msg", "spk": "", "ja": "俺を相手に油断できる身分か！？\n智樹！"},
{"id": 61, "kind": "msg", "spk": "", "ja": "！？　まさかそいつを\nとられるとはな……。"},
{"id": 62, "kind": "msg", "spk": "", "ja": "臆するな。自分の力を信じろ。"},
{"id": 63, "kind": "msg", "spk": "", "ja": "探究心が足りんぞ、智樹！"},
{"id": 64, "kind": "msg", "spk": "", "ja": "まさか……ここまでとは……！"},
{"id": 65, "kind": "msg", "spk": "", "ja": "短い付き合いだったな……。"},
{"id": 66, "kind": "msg", "spk": "守形", "ja": "成長したな。\nもう、何も教えることはない……。"},
{"id": 67, "kind": "msg", "spk": "トモ子", "ja": "あっざーす！"},
{"id": 68, "kind": "msg", "spk": "トモ子", "ja": "守形先輩は、守形先輩は……\n最高の師匠でしたぁ！"}
]}
