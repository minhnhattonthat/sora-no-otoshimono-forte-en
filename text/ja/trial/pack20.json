{"file": "_Data/Script/Trial/PackScript20.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "きゃる～ん☆"},
{"id": 1, "kind": "msg", "spk": "", "ja": "きゅぴ☆"},
{"id": 2, "kind": "msg", "spk": "", "ja": "うっふ～ん☆"},
{"id": 3, "kind": "msg", "spk": "", "ja": "にゃあ～ん☆"},
{"id": 4, "kind": "msg", "spk": "", "ja": "えへ☆"},
{"id": 5, "kind": "msg", "spk": "", "ja": "トモ子、かわいい？"},
{"id": 6, "kind": "msg", "spk": "", "ja": "イェエェース！"},
{"id": 7, "kind": "msg", "spk": "", "ja": "トモ子、こまっちゃう～☆"},
{"id": 8, "kind": "msg", "spk": "", "ja": "にゃんにゃんにゃあ～ん☆"},
{"id": 9, "kind": "msg", "spk": "", "ja": "あっは～ん☆\nキュンキュンきちゃう☆"},
{"id": 10, "kind": "msg", "spk": "", "ja": "これ以上はぁ……\nダ・メ・だ・ゾ☆"},
{"id": 11, "kind": "msg", "spk": "", "ja": "やあ～ん☆\nトモ子、ドッキドキぃ～☆"},
{"id": 12, "kind": "msg", "spk": "", "ja": "んん☆　余裕が\nなくなっちゃいそう……！"},
{"id": 13, "kind": "msg", "spk": "", "ja": "あふっ、い、今の\nちょっとスゴイかも……！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "やっぱり地毛が一番だなー。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "先輩どうです？この髪は！"},
{"id": 16, "kind": "msg", "spk": "", "ja": "女の子なんだから。\nクシは常備しておかないとね！"},
{"id": 17, "kind": "msg", "spk": "", "ja": "ずっと触ってても\n飽きないわねー。"},
{"id": 18, "kind": "msg", "spk": "", "ja": "こんなテントの中でセンパイと\n二人っきりなんて～、あはっ☆"},
{"id": 19, "kind": "msg", "spk": "", "ja": "ちょっとカワイすぎじゃね！？"},
{"id": 20, "kind": "msg", "spk": "", "ja": "ほっぺたもモチ肌ね！"},
{"id": 21, "kind": "msg", "spk": "", "ja": "先輩、どうです？\n完全に女の子の顔ですよ！"},
{"id": 22, "kind": "msg", "spk": "", "ja": "この肌……おそろしいほどの\nつやつやっぷりね。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "虫に刺されないように\n気をつけないとね！"},
{"id": 24, "kind": "msg", "spk": "", "ja": "熱視線☆\nずっきゅーん！"},
{"id": 25, "kind": "msg", "spk": "", "ja": "先輩、この澄んだ瞳を見てください！"},
{"id": 26, "kind": "msg", "spk": "", "ja": "上目づかいで虜にしちゃうぞ！"},
{"id": 27, "kind": "msg", "spk": "", "ja": "うっふ～んΩ"},
{"id": 28, "kind": "msg", "spk": "", "ja": "じ、自分で自分の耳をいじってると……\n変な気分になっちゃうぅ……！"},
{"id": 29, "kind": "msg", "spk": "", "ja": "もみもみ……んんっ！"},
{"id": 30, "kind": "msg", "spk": "", "ja": "耳って、結構重要なポイントよね。"},
{"id": 31, "kind": "msg", "spk": "", "ja": "先輩、どうです？\n冬の制服もバッチリ着こなしてますよ！"},
{"id": 32, "kind": "msg", "spk": "", "ja": "あん☆　あんまり動くと\n服がシワになっちゃうΩ"},
{"id": 33, "kind": "msg", "spk": "", "ja": "この時期、冬の制服は\nちょっと早かったかなー。"},
{"id": 34, "kind": "msg", "spk": "", "ja": "トモ子、コスプレも\nいけるかもぉ～☆"},
{"id": 35, "kind": "msg", "spk": "", "ja": "このキュートな八重歯が\nポイントなのよねー。"},
{"id": 36, "kind": "msg", "spk": "", "ja": "らーらーららー♪\n声もばっちり女の子ね。"},
{"id": 37, "kind": "msg", "spk": "", "ja": "んちゅーΩ\nなーんちゃって☆"},
{"id": 38, "kind": "msg", "spk": "", "ja": "私の美声でささやかれたら\nどんな男もイチコロよ☆"},
{"id": 39, "kind": "msg", "spk": "", "ja": "な、なにかしらこのコケシ……。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "きゃん☆動いたぁ～っ！"},
{"id": 41, "kind": "msg", "spk": "", "ja": "お、大きい……ごくり……。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "これでマッサージしたら\n気持ちいいかも～Ω"},
{"id": 43, "kind": "msg", "spk": "", "ja": "もうちょっと……こうかな……。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "どうしちゃったのかな？"},
{"id": 45, "kind": "msg", "spk": "", "ja": "ん～、なーんかちょっと\n違うのよねー。"},
{"id": 46, "kind": "msg", "spk": "", "ja": "（この程度じゃダメだ！）"},
{"id": 47, "kind": "msg", "spk": "", "ja": "どう？\nイマイチですか？"},
{"id": 48, "kind": "msg", "spk": "", "ja": "（基本は出来ているんだけどなー）"},
{"id": 49, "kind": "msg", "spk": "", "ja": "オンナノコへの道は\n長く険しいわね……。"},
{"id": 50, "kind": "msg", "spk": "", "ja": "うーん、ちょっと惜しいかなー。"},
{"id": 51, "kind": "msg", "spk": "", "ja": "うーん、イマイチね。\n帰ったら研究しておこっと……。"},
{"id": 52, "kind": "msg", "spk": "", "ja": "トモ子ショックー！\n虫さされができてる～。"},
{"id": 53, "kind": "msg", "spk": "", "ja": "トモ子分かんな～い☆"},
{"id": 54, "kind": "msg", "spk": "", "ja": "ええい！\nまだ女体になりきれていないぞ！"},
{"id": 55, "kind": "msg", "spk": "トモ子", "ja": "え～っとぉ……\nポーズはこんな感じかなぁ～。"},
{"id": 56, "kind": "msg", "spk": "", "ja": "あんΩ　こ、興奮しすぎて……\n変身がとけちゃうう～！"},
{"id": 57, "kind": "msg", "spk": "", "ja": "あんΩ　こ、興奮しすぎて……\n変身がとけちゃうう～！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "あ～、危なかった☆"},
{"id": 59, "kind": "msg", "spk": "", "ja": "ふ～、まだまだ堪能しなくちゃ☆"},
{"id": 60, "kind": "msg", "spk": "", "ja": "ぐぁあああああ～！\n大事なモノにダメージが……！"},
{"id": 61, "kind": "msg", "spk": "", "ja": "ぐぁあああああ～！\n大事なモノにダメージが……！"},
{"id": 62, "kind": "msg", "spk": "", "ja": "トモ子、アンニュイな気分に\nなってきちゃった～。"},
{"id": 63, "kind": "msg", "spk": "", "ja": "トモ子、アンニュイな気分に\nなってきちゃった～。"},
{"id": 64, "kind": "msg", "spk": "", "ja": "はあ……はあ……\nイイ感じにみなぎってきたわ！"},
{"id": 65, "kind": "msg", "spk": "", "ja": "あ、やべぇ！　一番大事なところが\n男のままじゃねーか！"},
{"id": 66, "kind": "msg", "spk": "トモ子", "ja": "イエース！　どっからどう見ても\nオ・ン・ナ・ノ・コ・ね☆"}
