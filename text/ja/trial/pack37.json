{"file": "_Data/Script/Trial/PackScript37.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "フィルムは見つかったかしら～？"},
{"id": 1, "kind": "msg", "spk": "", "ja": "うふふふ～。\nがっついちゃダメよ～。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "次はどこを調べるのかしら～？"},
{"id": 3, "kind": "msg", "spk": "", "ja": "手つきがステキね～。"},
{"id": 4, "kind": "msg", "spk": "", "ja": "その程度じゃ\n降参しないわよ～。"},
{"id": 5, "kind": "msg", "spk": "", "ja": "頑張って探してね～。"},
{"id": 6, "kind": "msg", "spk": "", "ja": "見てるだけじゃ見つからないわよ～？"},
{"id": 7, "kind": "msg", "spk": "", "ja": "うふふふ～、\n見とれてる場合かしら～？"},
{"id": 8, "kind": "msg", "spk": "", "ja": "あら～？　頑張るじゃない～。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "そんな所を探すなんて……\nいい度胸してるわね～。"},
{"id": 10, "kind": "msg", "spk": "", "ja": "こんなに気持ちよくしてくれたら\nおしゃべりになっちゃうかも～。"},
{"id": 11, "kind": "msg", "spk": "", "ja": "んんっ……\nなかなか侮れないじゃな～い？"},
{"id": 12, "kind": "msg", "spk": "", "ja": "あんん……\nや……やるわね～。"},
{"id": 13, "kind": "msg", "spk": "", "ja": "もういいの～？\nあっさりしてるのね～？"},
{"id": 14, "kind": "msg", "spk": "", "ja": "あ……ん……\nそんなことするなんて……。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "やっぱり黒髪が一番でしょ～？"},
{"id": 16, "kind": "msg", "spk": "", "ja": "丹念に調べないとね～。"},
{"id": 17, "kind": "msg", "spk": "", "ja": "ご機嫌とったってフィルムの\nありかは教えられないわ～。"},
{"id": 18, "kind": "msg", "spk": "", "ja": "なでられるのは好きよ～。"},
{"id": 19, "kind": "msg", "spk": "", "ja": "何も見つからなかったら\nどうしてやろうかしら～。"},
{"id": 20, "kind": "msg", "spk": "", "ja": "刑事さんがこんなことして\nいいのかしら～？"},
{"id": 21, "kind": "msg", "spk": "", "ja": "んんっ……\nもみくちゃにされちゃった～。"},
{"id": 22, "kind": "msg", "spk": "", "ja": "変装なんてしてないわ～。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "物欲しそうな目で見たって\nフィルムはあげないわ～。"},
{"id": 24, "kind": "msg", "spk": "", "ja": "見つめられるだけじゃ\n満足しないわよ～？"},
{"id": 25, "kind": "msg", "spk": "", "ja": "そんなに真剣に見られたら\n照れちゃうわ～。"},
{"id": 26, "kind": "msg", "spk": "", "ja": "さすがに目の中に\nフィルムは入れないわ～。"},
{"id": 27, "kind": "msg", "spk": "", "ja": "隙を見せたら咬んじゃうわよ～。\nうふふ。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "黙秘権を行使するわ～。"},
{"id": 29, "kind": "msg", "spk": "", "ja": "いくらプレッシャーを与えても\n効かないわよ～？"},
{"id": 30, "kind": "msg", "spk": "", "ja": "んんっ……\n口の中まで調べるなんて～。"},
{"id": 31, "kind": "msg", "spk": "", "ja": "んむ……ムリヤリ口を開いたって\nしゃべらないわよ～？"},
{"id": 32, "kind": "msg", "spk": "", "ja": "潜入してるところの制服だけど\n似合うかしら～？"},
{"id": 33, "kind": "msg", "spk": "", "ja": "服の中なんてベタなところに\nフィルムを隠すと思う～？"},
{"id": 34, "kind": "msg", "spk": "", "ja": "においを嗅いじゃうの～？\nまるで警察犬ね～。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "大声出したらどうなるかしら～？"},
{"id": 36, "kind": "msg", "spk": "", "ja": "フィルムを探す気はあるの～？"},
{"id": 37, "kind": "msg", "spk": "", "ja": "そういうのダメだと思うわ～。"},
{"id": 38, "kind": "msg", "spk": "", "ja": "女の扱いがなってないわ～。"},
{"id": 39, "kind": "msg", "spk": "", "ja": "ちょっとイラッときたわ～。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "さすがにそれは引いちゃうわ～。"},
{"id": 41, "kind": "msg", "spk": "", "ja": "命が惜しくはないのかしら～。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "人としてそれはどうなのかしら～？"},
{"id": 43, "kind": "msg", "spk": "", "ja": "出世させてあげるわ～。\n二階級特進くらいかしら～。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "フィルムを探す気はあるの～？"},
{"id": 45, "kind": "msg", "spk": "", "ja": "やめてくれないかしら～？"},
{"id": 46, "kind": "msg", "spk": "", "ja": "呆れるわ～。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "とっても不愉快よ～？"},
{"id": 48, "kind": "msg", "spk": "", "ja": "公僕とはいっても\n所詮はただの男ね～。"},
{"id": 49, "kind": "msg", "spk": "", "ja": "今のうちに楽しんでおくといいわ～。"},
{"id": 50, "kind": "msg", "spk": "美香子", "ja": "ああんΩ　捕まっちゃったわ～。"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "よくも手こずらせてくれたな！\nとうとう捕まえたぞ！"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "さあ、国家機密の情報が入った\nマイクロフィルムを渡すんだ！"},
{"id": 53, "kind": "msg", "spk": "美香子", "ja": "あら～。だったら存分に\n探してみるといいわ～。"},
{"id": 54, "kind": "msg", "spk": "美香子", "ja": "うふふふふ～。でも、\n刑事さんに見つけられるかしら～？"},
{"id": 55, "kind": "msg", "spk": "", "ja": "あら～？　うっかり銃の撃鉄を\n起こしちゃったわ～。"},
{"id": 56, "kind": "msg", "spk": "", "ja": "ところで、パイナップルって\nお好きかしら～？"},
{"id": 57, "kind": "msg", "spk": "", "ja": "しまっておくわ～。危ないものね～。"},
{"id": 58, "kind": "msg", "spk": "", "ja": "あら～、こういうのは嫌いなの。\nしょうがないわね～。"},
{"id": 59, "kind": "msg", "spk": "", "ja": "はい、あ～ん。手榴弾よ～Ω"},
{"id": 60, "kind": "msg", "spk": "", "ja": "変なことするからつい、\n引き金を引いちゃったわ～。"},
{"id": 61, "kind": "msg", "spk": "", "ja": "いつまでも付き合えるほど\n暇じゃないんだけど～？"},
{"id": 62, "kind": "msg", "spk": "", "ja": "あらあら。お手上げなのかしら～？"},
{"id": 63, "kind": "msg", "spk": "", "ja": "そろそろ見つかったかしら～？"},
{"id": 64, "kind": "msg", "spk": "", "ja": "時間稼ぎは成功よ～。\nそれじゃあ、また会いましょう～。"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "あった、これだ！"},
{"id": 66, "kind": "msg", "spk": "美香子", "ja": "とうとうバレちゃったわ～。\nでもそれってニセモノなのよね～。"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "フィルムから煙幕が！？\nしまった！　逃げられた～！"},
{"id": 68, "kind": "msg", "spk": "美香子", "ja": "またね～。"},
{"id": 69, "kind": "msg", "spk": "美香子", "ja": "さあさあ、次は何の情報を\n探ってあげようかしら～。"}
]}
