{"file": "_Data/Script/Trial/PackScript04.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "や、やさしくしなさいよね。"},
{"id": 1, "kind": "msg", "spk": "", "ja": "ふん……。\nなかなかやるじゃない。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "な、なんかちょっと\n手馴れすぎてない？"},
{"id": 3, "kind": "msg", "spk": "", "ja": "うん、なかなか\nいい感じよ。"},
{"id": 4, "kind": "msg", "spk": "", "ja": "ふふふ、私の服があんたに\n恩を感じるのも分かる気がするわね。"},
{"id": 5, "kind": "msg", "spk": "", "ja": "これくらいなら……\n協力してあげるわよ。"},
{"id": 6, "kind": "msg", "spk": "", "ja": "トモキって、\nこういう才能はあるのねぇ……。"},
{"id": 7, "kind": "msg", "spk": "", "ja": "ふ、ふん！\nたいしたことないわね！"},
{"id": 8, "kind": "msg", "spk": "", "ja": "……ねえ、私の……\nううん、なんでもないわ。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "……っ！\nな、なんともないんだからね！"},
{"id": 10, "kind": "msg", "spk": "", "ja": "どう？　この格好。\nトモキはこんな服装が好きなんだよね。"},
{"id": 11, "kind": "msg", "spk": "", "ja": "トモキは……\nやさしいんだね。"},
{"id": 12, "kind": "msg", "spk": "", "ja": "トモキ？\n髪の手入れもするの？"},
{"id": 13, "kind": "msg", "spk": "", "ja": "ふふんっ。\nキレイな髪でしょ。"},
{"id": 14, "kind": "msg", "spk": "", "ja": "ちゃ、ちゃんと優しくしなさいよ！"},
{"id": 15, "kind": "msg", "spk": "", "ja": "へぇ……\nなんか手馴れてるわね。"},
{"id": 16, "kind": "msg", "spk": "", "ja": "ちょ、ちょっと。\nいきなりつつかないでよ。"},
{"id": 17, "kind": "msg", "spk": "", "ja": "トモキ……\nなにをしてるの……？"},
{"id": 18, "kind": "msg", "spk": "", "ja": "ふふっ。\nすべすべでしょ。"},
{"id": 19, "kind": "msg", "spk": "", "ja": "ト、トモキ……？\nそんな真剣な目をしてどうしたの……？"},
{"id": 20, "kind": "msg", "spk": "", "ja": "て、手入れはどうしたの？"},
{"id": 21, "kind": "msg", "spk": "", "ja": "な、なによ……？"},
{"id": 22, "kind": "msg", "spk": "", "ja": "そんなに見られたら……\n……恥ずかしいじゃない。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "も、もう！\nダメだったら！"},
{"id": 24, "kind": "msg", "spk": "", "ja": "そ、そこは関係ないでしょ！"},
{"id": 25, "kind": "msg", "spk": "", "ja": "そ、そこは手入れしなくていいわよ！"},
{"id": 26, "kind": "msg", "spk": "", "ja": "きゃっ！\nび、びっくりするじゃない！"},
{"id": 27, "kind": "msg", "spk": "", "ja": "ちょっと！\nどこを見てるのよ！"},
{"id": 28, "kind": "msg", "spk": "", "ja": "手入れが終わったら、\nお菓子食べたいな。"},
{"id": 29, "kind": "msg", "spk": "", "ja": "そ、そんなところダメだって……\nわ、わからないの！？"},
{"id": 30, "kind": "msg", "spk": "", "ja": "ねえ……そんなに気になるの……？"},
{"id": 31, "kind": "msg", "spk": "", "ja": "えへへ……キレイでしょ。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "ふふっ。\nなによ、見とれちゃった？"},
{"id": 33, "kind": "msg", "spk": "", "ja": "え……？\n羽の手入れも……するの？"},
{"id": 34, "kind": "msg", "spk": "", "ja": "この羽が生えたのは……\nきっとトモキたちのおかげなんだよね。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "ト、トモキさえ……よければ……\n……私の……マ……マス……。"},
{"id": 36, "kind": "msg", "spk": "", "ja": "もう爆発しないから大丈夫よ。"},
{"id": 37, "kind": "msg", "spk": "", "ja": "あっ……そこは……。"},
{"id": 38, "kind": "msg", "spk": "", "ja": "ね、ねえ……トモキ……\n……な、なんでもない！"},
{"id": 39, "kind": "msg", "spk": "", "ja": "へえ……なかなかやるじゃない。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "そうやって手入れするんだ？"},
{"id": 41, "kind": "msg", "spk": "", "ja": "ほらほら、もっとしてよ。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "トモキ……優しい手つきだね。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "うん、いい感じ。\n……もっとお願い。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "そのくらい私にも優しく……\n……な、なんでないわよ！"},
{"id": 45, "kind": "msg", "spk": "", "ja": "ちょっと、調子に乗りすぎよ。"},
{"id": 46, "kind": "msg", "spk": "", "ja": "ト・モ・キ・ィ？\n覚悟はいいかしら！"},
{"id": 47, "kind": "msg", "spk": "", "ja": "へえ……私とそんなことしたいわけ？"},
{"id": 48, "kind": "msg", "spk": "", "ja": "パラダイスソングを受けたいのかしら？"},
{"id": 49, "kind": "msg", "spk": "", "ja": "もう、トモキなんて知らない！"},
{"id": 50, "kind": "msg", "spk": "", "ja": "へぇ、あんたって\nそういう趣味だったのね。"},
{"id": 51, "kind": "msg", "spk": "", "ja": "なんでアルファーはこんな奴を……。"},
{"id": 52, "kind": "msg", "spk": "", "ja": "呆れて何も言えないわ……。"},
{"id": 53, "kind": "msg", "spk": "", "ja": "へえ……そんなのが楽しいんだ。"},
{"id": 54, "kind": "msg", "spk": "", "ja": "ちょっと、シナプスのことを\n思い出しちゃったわ……。"},
{"id": 55, "kind": "msg", "spk": "", "ja": "私を怒らせて、あんたに\n一体何の得があるのかしら？"},
{"id": 56, "kind": "msg", "spk": "", "ja": "次に変なことしたら\nジャミングしてやるからね。"},
{"id": 57, "kind": "msg", "spk": "", "ja": "不潔よ！今まで私のこと\nそんな目で見てたのね！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "し、信じられない!！"},
{"id": 59, "kind": "msg", "spk": "", "ja": "……へたくそ。"},
{"id": 60, "kind": "msg", "spk": "", "ja": "は～……。あきれたわ。"},
{"id": 61, "kind": "msg", "spk": "", "ja": "まったくもう！\nいつもこんなこと考えてんの？"},
{"id": 62, "kind": "msg", "spk": "", "ja": "トモキのバカバカ！ド変態！"},
{"id": 63, "kind": "msg", "spk": "", "ja": "もう、許さないんだからね！！"},
{"id": 64, "kind": "msg", "spk": "", "ja": "このスケベ！　変態！何考えてんのよ！"},
{"id": 65, "kind": "msg", "spk": "", "ja": "いつもこんなこと考えてんの？\nまったくしょうがないわねぇ……。"},
{"id": 66, "kind": "msg", "spk": "", "ja": "ダメッ！　ダメだったらっ！"},
{"id": 67, "kind": "msg", "spk": "", "ja": "わ、私のことをそんな目で\n見てたのね！"},
{"id": 68, "kind": "msg", "spk": "", "ja": "ちょ、ちょっと！\nおかしいんじゃないの！？"},
{"id": 69, "kind": "msg", "spk": "", "ja": "へ、変態！"},
{"id": 70, "kind": "msg", "spk": "", "ja": "トモキ……トモキのこと、\n信じていたのに……！"},
{"id": 71, "kind": "msg", "spk": "", "ja": "トモキ……ひどいよ……。"},
{"id": 72, "kind": "msg", "spk": "", "ja": "ひどい……どうしてこんなことを……。"},
{"id": 73, "kind": "msg", "spk": "", "ja": "なにすんのよ！　このバカァ！"},
{"id": 74, "kind": "msg", "spk": "ニンフ", "ja": "ほらほら、トモキ。\nちゃんと手入れしてよね。"},
{"id": 75, "kind": "msg", "spk": "", "ja": "ちゃんと服の手入れをしなさいよ！\nおしおきよ！"},
{"id": 76, "kind": "msg", "spk": "", "ja": "ちょっと……\n調子にのりすぎなんじゃないの！？"},
{"id": 77, "kind": "msg", "spk": "", "ja": "わ、わかったわよ。\nじっとしてればいいんでしょ。"},
{"id": 78, "kind": "msg", "spk": "", "ja": "トモキのバカーッ！"},
{"id": 79, "kind": "msg", "spk": "", "ja": "ふん！　変なことするからよ！"},
{"id": 80, "kind": "msg", "spk": "", "ja": "ちょっと恥ずかしいけど\nこれも特訓のためだよね！"},
{"id": 81, "kind": "msg", "spk": "", "ja": "ねえ……服の手入れしないの……？"},
{"id": 82, "kind": "msg", "spk": "", "ja": "トモキ、早く手入れをしてよね。"},
{"id": 83, "kind": "msg", "spk": "", "ja": "あ、服の気持ちが\n流れ込んでくるわ……。"},
{"id": 84, "kind": "msg", "spk": "", "ja": "これのどこが手入れなのよ！\nトモキのバカッ！"},
{"id": 85, "kind": "msg", "spk": "ニンフ", "ja": "服も満足したみたいね。\n……やるじゃない。"}
]}
