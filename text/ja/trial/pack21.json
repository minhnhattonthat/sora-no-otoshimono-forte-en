{"file": "_Data/Script/Trial/PackScript21.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "きゃる～ん☆"},
{"id": 1, "kind": "msg", "spk": "", "ja": "きゅぴ☆"},
{"id": 2, "kind": "msg", "spk": "", "ja": "うっふ～ん☆"},
{"id": 3, "kind": "msg", "spk": "", "ja": "にゃあ～ん☆"},
{"id": 4, "kind": "msg", "spk": "", "ja": "えへ☆"},
{"id": 5, "kind": "msg", "spk": "", "ja": "よゆーよ、よゆー♪"},
{"id": 6, "kind": "msg", "spk": "", "ja": "出来ることなら直に……\nまあムリか……。"},
{"id": 7, "kind": "msg", "spk": "", "ja": "これだったら大丈夫みたいね♪"},
{"id": 8, "kind": "msg", "spk": "", "ja": "興奮なんてしないわよ♪"},
{"id": 9, "kind": "msg", "spk": "", "ja": "もっと際どいところを\n攻めてみよっかなー。"},
{"id": 10, "kind": "msg", "spk": "", "ja": "ふふん♪\nむしろ、物足りないくらいよ！"},
{"id": 11, "kind": "msg", "spk": "", "ja": "ほ～ら、へっちゃらじゃない♪"},
{"id": 12, "kind": "msg", "spk": "", "ja": "は、歯止めがきかなく\nなっちゃいそ……ん！"},
{"id": 13, "kind": "msg", "spk": "", "ja": "ヴィイェエエエェァーッスッ！！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "自分のツボを知っているのは\nやっぱり自分ねー☆"},
{"id": 15, "kind": "msg", "spk": "", "ja": "これ以上はぁ……\nダ・メ・だ・ゾ☆"},
{"id": 16, "kind": "msg", "spk": "", "ja": "は、歯止めがきかなく\nなっちゃいそ……ん！"},
{"id": 17, "kind": "msg", "spk": "", "ja": "ヴィイェエエエェァーッスッ！！"},
{"id": 18, "kind": "msg", "spk": "", "ja": "自分のツボを知っているのは\nやっぱり自分ねー☆"},
{"id": 19, "kind": "msg", "spk": "", "ja": "これ以上はぁ……\nダ・メ・だ・ゾ☆"},
{"id": 20, "kind": "msg", "spk": "", "ja": "髪で興奮なんて……あんΩ"},
{"id": 21, "kind": "msg", "spk": "", "ja": "ネコミミにはどんな髪型が\n似合うのかしらね……。"},
{"id": 22, "kind": "msg", "spk": "", "ja": "ああ……サラサラの髪が……\nんっ！"},
{"id": 23, "kind": "msg", "spk": "", "ja": "うん、大丈夫。\n自分の顔に興奮なんてしないわ！"},
{"id": 24, "kind": "msg", "spk": "", "ja": "ネコヒゲなんかがあっても\nポイント高いかも♪"},
{"id": 25, "kind": "msg", "spk": "", "ja": "トモ子ってばアキバ系アイドルも\nいけちゃうかも！？"},
{"id": 26, "kind": "msg", "spk": "", "ja": "じーっ……\nむ、胸が高鳴るなんて！"},
{"id": 27, "kind": "msg", "spk": "", "ja": "ネコみたいにつぶらなおめめだわ！"},
{"id": 28, "kind": "msg", "spk": "", "ja": "ああ……もっと私を見てぇ！"},
{"id": 29, "kind": "msg", "spk": "", "ja": "……おおっとぉ！\n危うく興奮するところだったわ。"},
{"id": 30, "kind": "msg", "spk": "", "ja": "ネコの耳って人間より\n聞こえやすいのかしら？"},
{"id": 31, "kind": "msg", "spk": "", "ja": "なんか耳を触ると\nゾクゾクしちゃう。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "セーラー服に合わない\nシチュエーションなんてないわ！"},
{"id": 33, "kind": "msg", "spk": "", "ja": "なんでうちの学校はセーラー服じゃ\nないのかしらねー。"},
{"id": 34, "kind": "msg", "spk": "", "ja": "ちょっとレトロな着こなしも\nバッチリね☆"},
{"id": 35, "kind": "msg", "spk": "", "ja": "この格好……男心に\nクリーンヒット間違いナシね！"},
{"id": 36, "kind": "msg", "spk": "", "ja": "口元も猫っぽい感じに\nなったらどうなるかなぁー。"},
{"id": 37, "kind": "msg", "spk": "", "ja": "にゃお～んΩ"},
{"id": 38, "kind": "msg", "spk": "", "ja": "にゃはははは～。"},
{"id": 39, "kind": "msg", "spk": "", "ja": "ごろごろにゃ～んΩ"},
{"id": 40, "kind": "msg", "spk": "", "ja": "渚のネコミミプリンセス\nトモ子でーっす！"},
{"id": 41, "kind": "msg", "spk": "", "ja": "あと必要なのは肉球手袋\nくらいかしらねー。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "招きトモ子……\nなんちゃってね☆"},
{"id": 43, "kind": "msg", "spk": "", "ja": "しっぽの鈴がアクセントね♪"},
{"id": 44, "kind": "msg", "spk": "", "ja": "おっと、危ない危ない……！"},
{"id": 45, "kind": "msg", "spk": "", "ja": "はあ、はあ……うっ！"},
{"id": 46, "kind": "msg", "spk": "", "ja": "興奮なんて……はあっはあ\n……してないわよ。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "こんな体で迫られたら……\n興奮するに決まってるでしょうが！"},
{"id": 48, "kind": "msg", "spk": "", "ja": "もうちょっと本気でいかないと\n実験にならないわね……。"},
{"id": 49, "kind": "msg", "spk": "", "ja": "興奮しないってのも\n負けのような気がするわねー。"},
{"id": 50, "kind": "msg", "spk": "", "ja": "（は、鼻血が……！）"},
{"id": 51, "kind": "msg", "spk": "", "ja": "わ、私ってナルシストだっけ？"},
{"id": 52, "kind": "msg", "spk": "", "ja": "興奮すべきか、そうでないのか。\nむむむ……。"},
{"id": 53, "kind": "msg", "spk": "", "ja": "（いいか、これは俺の体だ。\n　抑えろ。分かったな？）"},
{"id": 54, "kind": "msg", "spk": "", "ja": "（あっぶねー……\n　今のはヤバかった……）"},
{"id": 55, "kind": "msg", "spk": "", "ja": "（ぐう……！）"},
{"id": 56, "kind": "msg", "spk": "トモ子", "ja": "さて、じゃあ自分の体で\n興奮するか試してみますか☆"},
{"id": 57, "kind": "msg", "spk": "", "ja": "いっけない！　爆発の前に\n変身がとけちゃう……！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "いっけない！　爆発の前に\n変身がとけちゃう……！"},
{"id": 59, "kind": "msg", "spk": "", "ja": "ふー、トモ子ったらドジッ子さんΩ"},
{"id": 60, "kind": "msg", "spk": "", "ja": "ふー、トモ子ったらドジッ子さんΩ"},
{"id": 61, "kind": "msg", "spk": "", "ja": "し、しずまれ！　しずまれ！\n俺の……！"},
{"id": 62, "kind": "msg", "spk": "", "ja": "し、しずまれ！　しずまれ！\n俺の……！"},
{"id": 63, "kind": "msg", "spk": "", "ja": "やぁ～ん☆\nじっとしてるのやだぁ～☆"},
{"id": 64, "kind": "msg", "spk": "", "ja": "ちょっと気持ちを落ち着けよっと♪"},
{"id": 65, "kind": "msg", "spk": "", "ja": "ちょ、ちょっとヤバイかも……\nそろそろやめなきゃ……っ！"},
{"id": 66, "kind": "msg", "spk": "", "ja": "興奮はしなかったけど、女としての\n自信もなくしちゃったわー……。"},
{"id": 67, "kind": "msg", "spk": "トモ子", "ja": "首輪が……！\nあ、ああ、うあああああーっ！"}
]}
