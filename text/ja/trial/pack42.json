{"file": "_Data/Script/Trial/PackScript42.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "なに、今の感じ……！"},
{"id": 1, "kind": "msg", "spk": "", "ja": "は、恥ずかしい……。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "ど……どきどきしちゃう。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "私は、あなたから生まれたの？"},
{"id": 4, "kind": "msg", "spk": "", "ja": "な、ナニこの感じ！？"},
{"id": 5, "kind": "msg", "spk": "", "ja": "ちょっと……素敵かも……。"},
{"id": 6, "kind": "msg", "spk": "", "ja": "そんなことしてて\n元に戻れるのかなぁ……。"},
{"id": 7, "kind": "msg", "spk": "", "ja": "あ……！　今、何か……。"},
{"id": 8, "kind": "msg", "spk": "", "ja": "どうしてこんなことに\nなっちゃったのかしら……。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "そ、そんな……。"},
{"id": 10, "kind": "msg", "spk": "", "ja": "イエス！　イエース！\nあ、私、今なにを……？"},
{"id": 11, "kind": "msg", "spk": "", "ja": "……かっこいい……？\nううん、そ、そんなはずない！"},
{"id": 12, "kind": "msg", "spk": "", "ja": "くっ……認めたくないのに……！"},
{"id": 13, "kind": "msg", "spk": "", "ja": "トモ子……トモ子、\nムズムズしちゃう！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "私の方が少し長いのかしら……。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "か、髪に変なことしないでよね。"},
{"id": 16, "kind": "msg", "spk": "", "ja": "あ、あなたが普段考えていることが\n記憶に残っちゃってるよぉ……。"},
{"id": 17, "kind": "msg", "spk": "", "ja": "じ、自分になでられるなんて……。"},
{"id": 18, "kind": "msg", "spk": "", "ja": "分離したせいか、頭が\nスッキリしてるわ。"},
{"id": 19, "kind": "msg", "spk": "", "ja": "当たり前かもしれないけど\nそっくりね……。"},
{"id": 20, "kind": "msg", "spk": "", "ja": "ほっぺたいじったって\n元に戻れないわよ。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "元に戻るにはどうすれば\nいいのかしらね……。"},
{"id": 22, "kind": "msg", "spk": "", "ja": "あなたのこと、\nなんて呼べばいいのかしら。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "そんなにじっと見ないでよ……。"},
{"id": 24, "kind": "msg", "spk": "", "ja": "私とあなたってどんな関係に\nなるのかな……？"},
{"id": 25, "kind": "msg", "spk": "", "ja": "え……どうして耳を見て\n興奮してるの？"},
{"id": 26, "kind": "msg", "spk": "", "ja": "指を入れるなんて……。"},
{"id": 27, "kind": "msg", "spk": "", "ja": "ああんΩ\nな、何をするのよ！"},
{"id": 28, "kind": "msg", "spk": "", "ja": "い、息を吹きかけちゃダメぇ～。"},
{"id": 29, "kind": "msg", "spk": "", "ja": "この服は……あなたの趣味なの？"},
{"id": 30, "kind": "msg", "spk": "", "ja": "他にも色々な服を着てみたいなぁ～。"},
{"id": 31, "kind": "msg", "spk": "", "ja": "この制服はかわいいから\n気に入っているけど……。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "私はなんで八重歯なのかしら……。"},
{"id": 33, "kind": "msg", "spk": "", "ja": "変なことしたら、\nかみついちゃうんだからね！"},
{"id": 34, "kind": "msg", "spk": "", "ja": "お、女の子のくちびるに\n何をする気なの！？"},
{"id": 35, "kind": "msg", "spk": "", "ja": "きゃ！　わ、私なんてものを……！"},
{"id": 36, "kind": "msg", "spk": "", "ja": "これ……う、動くの……？"},
{"id": 37, "kind": "msg", "spk": "", "ja": "こんなもの持たせて\n何をする気よ！"},
{"id": 38, "kind": "msg", "spk": "", "ja": "きゃんっ！"},
{"id": 39, "kind": "msg", "spk": "", "ja": "キライ……！"},
{"id": 40, "kind": "msg", "spk": "", "ja": "ひどい……ひどいよ……。"},
{"id": 41, "kind": "msg", "spk": "", "ja": "女の子に……いきなりそんな……。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "そんな汚いモノ……！"},
{"id": 43, "kind": "msg", "spk": "", "ja": "私があなたと同じなんて……\nウソよ！"},
{"id": 44, "kind": "msg", "spk": "", "ja": "男の人って信じられない……。"},
{"id": 45, "kind": "msg", "spk": "", "ja": "ふ、不潔！"},
{"id": 46, "kind": "msg", "spk": "", "ja": "いや、触らないで！"},
{"id": 47, "kind": "msg", "spk": "", "ja": "ひ、近づかないで！"},
{"id": 48, "kind": "msg", "spk": "", "ja": "ねえ……自分にこんなことして\n楽しいの？"},
{"id": 49, "kind": "msg", "spk": "", "ja": "へ、変態！"},
{"id": 50, "kind": "msg", "spk": "", "ja": "私はもうトモ子として\n生きたいのよ！"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "なんてこった……トモ子と\n分裂しちまったぞ……。"},
{"id": 52, "kind": "msg", "spk": "トモ子", "ja": "え、ウソ……。"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "オレ（煩悩）と切り離された\nせいか、自然に女の子らしく\nなってるし……。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "とりあえず、元に戻るために\nいろいろしてみるしかないだろ！"},
{"id": 55, "kind": "msg", "spk": "トモ子", "ja": "え、あの、何を！"},
{"id": 56, "kind": "msg", "spk": "", "ja": "この……！\nこっちへ、来ないで！"},
{"id": 57, "kind": "msg", "spk": "", "ja": "この……！\nこっちへ、来ないで！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "きゃー！　いやー！"},
{"id": 59, "kind": "msg", "spk": "", "ja": "きゃー！　いやー！"},
{"id": 60, "kind": "msg", "spk": "", "ja": "わ、私、あなたなんかと\nひとつに戻りたくない！"},
{"id": 61, "kind": "msg", "spk": "", "ja": "この……ゴキブリ！"},
{"id": 62, "kind": "msg", "spk": "", "ja": "私たち、ずっと\nこのままなのかな……。"},
{"id": 63, "kind": "msg", "spk": "", "ja": "う～ん、何も進展しないわね……。"},
{"id": 64, "kind": "msg", "spk": "", "ja": "私に……足りないものがある？\n一体何が足りないの！？"},
{"id": 65, "kind": "msg", "spk": "", "ja": "私はあなたとは違うのよ！\nもうあなたなんていらない！"},
{"id": 66, "kind": "msg", "spk": "トモ子", "ja": "……私の本能が、あなたとひとつに\nなりたがっているっていうの？"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "思い出したか！\nお前が俺と同じってことを！"},
{"id": 68, "kind": "msg", "spk": "トモ子", "ja": "……認めるわよ。私が認めれば\nきっと元に戻れるのよね。"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "ふー、これでなんとか治まったぜ！"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "これからもよろしく頼むぜ！\nトモ子！"}
]}
