{"file": "_Data/Script/Trial/PackScript26.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "ん……下僕にしては\n上手じゃない……。"},
{"id": 1, "kind": "msg", "spk": "", "ja": "へぇー、やるわね。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "なによ。\n今日はやけに素直なのね……。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "悪くないんだけど、\nもうちょっと優しくしてくれる？"},
{"id": 4, "kind": "msg", "spk": "", "ja": "げ、下僕のくせに……。"},
{"id": 5, "kind": "msg", "spk": "", "ja": "ふん、なかなかやるじゃない！"},
{"id": 6, "kind": "msg", "spk": "", "ja": "げ、下僕の分際で生意気よ！"},
{"id": 7, "kind": "msg", "spk": "", "ja": "ん……上手いわね……。"},
{"id": 8, "kind": "msg", "spk": "", "ja": "いいわよ。\nその調子で続けなさい。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "な、なに？\n今、なにをしたの……？"},
{"id": 10, "kind": "msg", "spk": "", "ja": "トモキ……。\nちょ、ちょっと呼んでみただけよ！"},
{"id": 11, "kind": "msg", "spk": "", "ja": "う、嬉しいだなんて\nこれっぽっちも思ってないわ！"},
{"id": 12, "kind": "msg", "spk": "", "ja": "……バカぁ。"},
{"id": 13, "kind": "msg", "spk": "", "ja": "たまになら……\n名前で呼んでもいいわよ。"},
{"id": 14, "kind": "msg", "spk": "", "ja": "キレイな髪ですって？\n今更なに言ってるの？"},
{"id": 15, "kind": "msg", "spk": "", "ja": "ん……なんだか\n安心するわね……。"},
{"id": 16, "kind": "msg", "spk": "", "ja": "美しい髪は貴族のステータスよ！"},
{"id": 17, "kind": "msg", "spk": "", "ja": "トモキ……。"},
{"id": 18, "kind": "msg", "spk": "", "ja": "なによ！　いきなり…\nびっくりしたじゃない！"},
{"id": 19, "kind": "msg", "spk": "", "ja": "顔が赤いですって？\nき、気のせいよ！　気のせい！"},
{"id": 20, "kind": "msg", "spk": "", "ja": "顔のマッサージをしてくれるの？\n下僕にしては気が利くじゃない！"},
{"id": 21, "kind": "msg", "spk": "", "ja": "なによ……\nそんなに見つめちゃって……。"},
{"id": 22, "kind": "msg", "spk": "", "ja": "そ、そんなに\nこっちを見ないでよ……。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "べ、別になんでもないわよ！"},
{"id": 24, "kind": "msg", "spk": "", "ja": "っ……！！"},
{"id": 25, "kind": "msg", "spk": "", "ja": "ひゃあ！\nちょっと！　なんて声出させるのよ！"},
{"id": 26, "kind": "msg", "spk": "", "ja": "なっ！\nふざけないで！"},
{"id": 27, "kind": "msg", "spk": "", "ja": "そこは大切な人のために\nとってあるんだからね。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "口紅も落としてくれるの？"},
{"id": 29, "kind": "msg", "spk": "", "ja": "ドキドキなんて\nしてないわよ！　バカ！"},
{"id": 30, "kind": "msg", "spk": "", "ja": "あんたは、私の羽好き？\n……へぇ、そうなんだ……。"},
{"id": 31, "kind": "msg", "spk": "", "ja": "キレイな羽だって、\nみんなほめてくれたわ。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "こんなに間近で私の羽を\n見られるなんて、光栄なことよ！"},
{"id": 33, "kind": "msg", "spk": "", "ja": "この鎖のお陰で\n舞踏会でも注目の的だったわ。"},
{"id": 34, "kind": "msg", "spk": "", "ja": "下僕にしては\n悪くないチョイスだったわね。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "ふふっ……今度の舞踏会にも\n身に着けていこうかしらね。"},
{"id": 36, "kind": "msg", "spk": "", "ja": "みがいてくれるの？\n気が利くわね。"},
{"id": 37, "kind": "msg", "spk": "", "ja": "もっと心をこめてみがきなさい！"},
{"id": 38, "kind": "msg", "spk": "", "ja": "よく似合ってるって？\nと、当然よ！　なにをいまさら……。"},
{"id": 39, "kind": "msg", "spk": "", "ja": "お気に入りのドレスなんだから\nしっかり頼むわよ。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "丁寧に扱いなさいよ。"},
{"id": 41, "kind": "msg", "spk": "", "ja": "ちゃんとシワを伸ばしなさいよね。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "あんたと一緒だと……\n安心するわ……。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "わたしの肌はデリケートなんだから\n優しくなさい！"},
{"id": 44, "kind": "msg", "spk": "", "ja": "ひゃん！　ちょ、ちょっと！\nふああっ……！"},
{"id": 45, "kind": "msg", "spk": "", "ja": "私の背中……\nキレイ……？"},
{"id": 46, "kind": "msg", "spk": "", "ja": "ちょっと！\nそこは関係ないでしょ！"},
{"id": 47, "kind": "msg", "spk": "", "ja": "あんた……お給金\nいらないの？"},
{"id": 48, "kind": "msg", "spk": "", "ja": "……使えない下僕ね。"},
{"id": 49, "kind": "msg", "spk": "", "ja": "あ～。舞踏会でしつこく私を\n誘ってきた奴を思い出したわ！"},
{"id": 50, "kind": "msg", "spk": "", "ja": "ちょっと！\n乱暴にしないでよ！"},
{"id": 51, "kind": "msg", "spk": "", "ja": "雑ねぇ……。\nあんた、何年私に仕えてるの？"},
{"id": 52, "kind": "msg", "spk": "", "ja": "……他の使用人に\n任せたほうがよかったかしら。"},
{"id": 53, "kind": "msg", "spk": "", "ja": "は～……。もう呆れたわ。"},
{"id": 54, "kind": "msg", "spk": "", "ja": "あんたって……最低ね……。"},
{"id": 55, "kind": "msg", "spk": "", "ja": "なにしてるのよ！\n私を誰だと思っているの！？"},
{"id": 56, "kind": "msg", "spk": "", "ja": "ふん！\n口も聞きたくないわ！"},
{"id": 57, "kind": "msg", "spk": "ニンフ", "ja": "あ～、今日の舞踏会は疲れたわ。\n下僕、ドレスの手入れをしなさい！"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "お嬢様相手なら、例えドレスの\n外でも中でも！　いざ！"},
{"id": 59, "kind": "msg", "spk": "ニンフ", "ja": "変なことしたら……\n分かってるでしょうね。"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "あ、はい……\nもちろんです……。"},
{"id": 61, "kind": "msg", "spk": "ニンフ", "ja": "それじゃあ、しっかり頼むわよ。"},
{"id": 62, "kind": "msg", "spk": "", "ja": "言ってもわからない下僕には\n体で教える必要がありそうね！"},
{"id": 63, "kind": "msg", "spk": "", "ja": "おしおき部屋へ連行されたいの！？"},
{"id": 64, "kind": "msg", "spk": "", "ja": "な、なによ……意外と\nたくましいじゃない……。"},
{"id": 65, "kind": "msg", "spk": "", "ja": "今回は許すけど、今度は\nタダじゃおかないわよ！"},
{"id": 66, "kind": "msg", "spk": "", "ja": "お給金カットよ！\n休暇もなし！"},
{"id": 67, "kind": "msg", "spk": "", "ja": "お給金カットよ！\n休暇もなし！"},
{"id": 68, "kind": "msg", "spk": "", "ja": "べ、別にあんたのために\n外すんじゃないんだからね！"},
{"id": 69, "kind": "msg", "spk": "", "ja": "舞踏会で汗をかいたの！\nた、他意はないわよ！"},
{"id": 70, "kind": "msg", "spk": "", "ja": "ねえ……服の手入れしないの……？"},
{"id": 71, "kind": "msg", "spk": "", "ja": "トモキ、早く手入れをしてよね。"},
{"id": 72, "kind": "msg", "spk": "", "ja": "最後に、髪を梳いてもらえるかしら。"},
{"id": 73, "kind": "msg", "spk": "", "ja": "もういい！\nあんたなんてクビよ、クビ！"},
{"id": 74, "kind": "msg", "spk": "ニンフ", "ja": "ねえ、あんたの前なら……\n私は素直になっていいのかな……。"},
{"id": 75, "kind": "msg", "spk": "ニンフ", "ja": "なーんてね、冗談よ。"},
{"id": 76, "kind": "msg", "spk": "ニンフ", "ja": "また明日ね。\n私だけのし・も・べ。"}
]}
