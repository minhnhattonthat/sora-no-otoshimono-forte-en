{"file": "_Data/Script/Trial/PackScript07.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "私は、トモキにとって必要？"},
{"id": 1, "kind": "msg", "spk": "", "ja": "し、仕方ないわねぇ。\nトモキがどうしてもって言うなら……。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "へ、変ね……。\n顔が熱いわ……。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "トモキ……。"},
{"id": 4, "kind": "msg", "spk": "", "ja": "ふん……。\nなかなかやるじゃない。"},
{"id": 5, "kind": "msg", "spk": "", "ja": "うん、なかなか\nいい感じよ。"},
{"id": 6, "kind": "msg", "spk": "", "ja": "ねえ……アルファーにも、\n同じことしてるの……？"},
{"id": 7, "kind": "msg", "spk": "", "ja": "これくらいなら……\n協力してあげるわよ。"},
{"id": 8, "kind": "msg", "spk": "", "ja": "ト、トモキがそうしたいなら……。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "ふ、ふん！\nたいしたことないわね！"},
{"id": 10, "kind": "msg", "spk": "", "ja": "……デルタには、\nこんなことしてないよね……？"},
{"id": 11, "kind": "msg", "spk": "", "ja": "んんっ……別にドキドキなんて\nしてないんだからね！"},
{"id": 12, "kind": "msg", "spk": "", "ja": "ねえ、私はトモキと一緒に居て\nいいのよね……？"},
{"id": 13, "kind": "msg", "spk": "", "ja": "……っ！\nな、なんともないんだからね！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "トモキは……\nやさしいんだね。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "動力炉が……\nおかしくなりそう……！"},
{"id": 16, "kind": "msg", "spk": "", "ja": "トモキ……。\nううん、呼んでみただけよ♪"},
{"id": 17, "kind": "msg", "spk": "", "ja": "な、なんでもない！\nなんでもないったら！"},
{"id": 18, "kind": "msg", "spk": "", "ja": "ん……信じてるからね……？"},
{"id": 19, "kind": "msg", "spk": "", "ja": "いつも通りの髪型よ？"},
{"id": 20, "kind": "msg", "spk": "", "ja": "や、やさしく撫でれば\nいいってもんじゃ……。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "髪質が違うっていうの？"},
{"id": 22, "kind": "msg", "spk": "", "ja": "な、なによ突然！\nびっくりするじゃない。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "私の顔をつついたって\nなにも分からないわよ？"},
{"id": 24, "kind": "msg", "spk": "", "ja": "そんなにベタベタしないでよ！"},
{"id": 25, "kind": "msg", "spk": "", "ja": "そ、それだけ調べれば十分でしょ！"},
{"id": 26, "kind": "msg", "spk": "", "ja": "あ、あんたの視線がイヤらしいから\nそらしただけなんだからね！"},
{"id": 27, "kind": "msg", "spk": "", "ja": "もう……なんでそんなに\n真剣なのよ……。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "そんなに見つめないでよ！"},
{"id": 29, "kind": "msg", "spk": "", "ja": "め、目なんかそらしてないわよ！"},
{"id": 30, "kind": "msg", "spk": "", "ja": "耳がいつもと違うって言うの？"},
{"id": 31, "kind": "msg", "spk": "", "ja": "ひゃあ！\nこ、こんな調べ方するなんて……！"},
{"id": 32, "kind": "msg", "spk": "", "ja": "そ、そこは調べなくていいわよ。"},
{"id": 33, "kind": "msg", "spk": "", "ja": "もう！　そこは敏感なの！"},
{"id": 34, "kind": "msg", "spk": "", "ja": "あら、おやつでも用意してくれるの？"},
{"id": 35, "kind": "msg", "spk": "", "ja": "そこは調べなくてもいいでしょ！"},
{"id": 36, "kind": "msg", "spk": "", "ja": "むぐむぐ……ちょっと！\n口の中なんて調べる必要ないでしょ！"},
{"id": 37, "kind": "msg", "spk": "", "ja": "指なんて入れようとしないで！"},
{"id": 38, "kind": "msg", "spk": "", "ja": "羽が違うっていうの？"},
{"id": 39, "kind": "msg", "spk": "", "ja": "いつも見慣れてるじゃない！"},
{"id": 40, "kind": "msg", "spk": "", "ja": "ふーん……\nここが気になるんだ。"},
{"id": 41, "kind": "msg", "spk": "", "ja": "そんなに気になるなら\n好きにすればいいじゃない。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "鎖におかしなところでもあるの？"},
{"id": 43, "kind": "msg", "spk": "", "ja": "ここは、爆発なんてしないわよ。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "私が自由になれたのは、\nトモキとみんなのおかげだったわね。"},
{"id": 45, "kind": "msg", "spk": "", "ja": "ふーん……\n丹念に調べるのね。"},
{"id": 46, "kind": "msg", "spk": "", "ja": "ねぇ、私の……\nマ……マスターに……。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "いつもの制服じゃない。\nおかしくないでしょ？"},
{"id": 48, "kind": "msg", "spk": "", "ja": "そこを調べるの？\n別にいいけど。"},
{"id": 49, "kind": "msg", "spk": "", "ja": "ちょ、ちょっと！\nどこ調べてるのよ！！"},
{"id": 50, "kind": "msg", "spk": "", "ja": "興味なかったんじゃないの？"},
{"id": 51, "kind": "msg", "spk": "", "ja": "もう！　そんなに調べたら\nシワになっちゃう！"},
{"id": 52, "kind": "msg", "spk": "", "ja": "ちょっと、調子に乗りすぎよ。"},
{"id": 53, "kind": "msg", "spk": "", "ja": "ト・モ・キ・ィ？\n覚悟はいいかしら！"},
{"id": 54, "kind": "msg", "spk": "", "ja": "へえ……私とそんなことしたいわけ？"},
{"id": 55, "kind": "msg", "spk": "", "ja": "なにすんのよ！　このバカァ！"},
{"id": 56, "kind": "msg", "spk": "", "ja": "パラダイスソングを受けたいのかしら？"},
{"id": 57, "kind": "msg", "spk": "", "ja": "もう、トモキなんて知らない！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "へぇ、あんたってそういう\n趣味だったのね。"},
{"id": 59, "kind": "msg", "spk": "", "ja": "なんでアルファーはこんな奴を……。"},
{"id": 60, "kind": "msg", "spk": "", "ja": "呆れて何も言えないわ……。"},
{"id": 61, "kind": "msg", "spk": "", "ja": "へえ……そんなのが楽しいんだ。"},
{"id": 62, "kind": "msg", "spk": "", "ja": "ちょっと、シナプスのことを\n思い出しちゃったわ……。"},
{"id": 63, "kind": "msg", "spk": "", "ja": "私を怒らせて、あんたに\n一体何の得があるのかしら？"},
{"id": 64, "kind": "msg", "spk": "", "ja": "次に変なことしたら\nジャミングしてやるからね。"},
{"id": 65, "kind": "msg", "spk": "", "ja": "不潔よ！今まで私のこと\nそんな目で見てたのね！"},
{"id": 66, "kind": "msg", "spk": "", "ja": "し、信じられない!！"},
{"id": 67, "kind": "msg", "spk": "", "ja": "……へたくそ。"},
{"id": 68, "kind": "msg", "spk": "", "ja": "は～……。あきれたわ。"},
{"id": 69, "kind": "msg", "spk": "", "ja": "まったくもう！\nいつもこんなこと考えてんの？"},
{"id": 70, "kind": "msg", "spk": "", "ja": "トモキのバカバカ！ド変態！"},
{"id": 71, "kind": "msg", "spk": "", "ja": "もう、許さないんだからね！！"},
{"id": 72, "kind": "msg", "spk": "", "ja": "このスケベ！　変態！何考えてんのよ！"},
{"id": 73, "kind": "msg", "spk": "", "ja": "いつもこんなこと考えてんの？\nまったくしょうがないわねぇ……。"},
{"id": 74, "kind": "msg", "spk": "", "ja": "ダメッ！　ダメだったらっ！"},
{"id": 75, "kind": "msg", "spk": "", "ja": "わ、私のことをそんな目で\n見てたのね！"},
{"id": 76, "kind": "msg", "spk": "", "ja": "ひどい……どうしてこんなことを……。"},
{"id": 77, "kind": "msg", "spk": "", "ja": "あんた……いい度胸してるわね。"},
{"id": 78, "kind": "msg", "spk": "", "ja": "へ、変態！"},
{"id": 79, "kind": "msg", "spk": "", "ja": "トモキ……トモキのこと、\n信じていたのに……！"},
{"id": 80, "kind": "msg", "spk": "", "ja": "トモキ……ひどいよ……。"},
{"id": 81, "kind": "msg", "spk": "", "ja": "ちょ、ちょっと！\nおかしいんじゃないの！？"},
{"id": 82, "kind": "msg", "spk": "ニンフ", "ja": "ここまでされたんじゃ仕方ないわ！\n私が本物かどうか確かめなさいよ！"},
{"id": 83, "kind": "msg", "spk": "", "ja": "こんなことするなんて\n聞いてないわよ！"},
{"id": 84, "kind": "msg", "spk": "", "ja": "ちょ、ちょっと何するのよ！"},
{"id": 85, "kind": "msg", "spk": "", "ja": "わ、分かったわよ。\nもうちょっとだけ我慢してあげる……。"},
{"id": 86, "kind": "msg", "spk": "", "ja": "もう……仕方ないわね。"},
{"id": 87, "kind": "msg", "spk": "", "ja": "変態！　変態！　変態！"},
{"id": 88, "kind": "msg", "spk": "", "ja": "私はあんたなんかのペースに\nまきこまれないわよ！"},
{"id": 89, "kind": "msg", "spk": "", "ja": "私が本物かどうかなんて\nトモキは興味ないんだ……。"},
{"id": 90, "kind": "msg", "spk": "", "ja": "そんなに考え込んじゃって……\nどっちか本物かわかったの？"},
{"id": 91, "kind": "msg", "spk": "", "ja": "ねえ、そろそろ\n分かったんじゃないの？"},
{"id": 92, "kind": "msg", "spk": "", "ja": "こんなことでわかるわけないでしょ！\nトモキのバカッ！　もう知らない！"},
{"id": 93, "kind": "msg", "spk": "ニンフ", "ja": "ど、どう！？\n私が本物だってわかったでしょ！"}
]}
