{"file": "_Data/Script/Trial/PackScript05.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "私は、トモキにとって必要？"},
{"id": 1, "kind": "msg", "spk": "", "ja": "し、仕方ないわねぇ。\nトモキがどうしてもって言うなら……。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "へ、変ね……。\n顔が熱いわ……。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "トモキ……。"},
{"id": 4, "kind": "msg", "spk": "", "ja": "ふん……。\nなかなかやるじゃない。"},
{"id": 5, "kind": "msg", "spk": "", "ja": "うん、なかなか\nいい感じよ。"},
{"id": 6, "kind": "msg", "spk": "", "ja": "ねえ……アルファーにも、\n同じことしてるの……？"},
{"id": 7, "kind": "msg", "spk": "", "ja": "これくらいなら……\n協力してあげるわよ。"},
{"id": 8, "kind": "msg", "spk": "", "ja": "ト、トモキがそうしたいなら……。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "ふ、ふん！\nたいしたことないわね！"},
{"id": 10, "kind": "msg", "spk": "", "ja": "……デルタには、\nこんなことしてないよね……？"},
{"id": 11, "kind": "msg", "spk": "", "ja": "んんっ……別にドキドキなんて\nしてないんだからね！"},
{"id": 12, "kind": "msg", "spk": "", "ja": "ねえ、私はトモキと一緒に居て\nいいのよね……？"},
{"id": 13, "kind": "msg", "spk": "", "ja": "……っ！\nな、なんともないんだからね！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "トモキは……\nやさしいんだね。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "動力炉が……\nおかしくなりそう……！"},
{"id": 16, "kind": "msg", "spk": "", "ja": "トモキ……。\nううん、呼んでみただけよ♪"},
{"id": 17, "kind": "msg", "spk": "", "ja": "な、なんでもない！\nなんでもないったら！"},
{"id": 18, "kind": "msg", "spk": "", "ja": "え？　髪に虫がついてるの？"},
{"id": 19, "kind": "msg", "spk": "", "ja": "髪の毛の中にはいないみたいだけど？"},
{"id": 20, "kind": "msg", "spk": "", "ja": "なんか撫でてるだけみたいな……\n別にいいけど。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "……えへへ。"},
{"id": 22, "kind": "msg", "spk": "", "ja": "トモキは私の顔が気になるの？"},
{"id": 23, "kind": "msg", "spk": "", "ja": "ねぇ、どこどこ？\nいるなら早く取ってよ。"},
{"id": 24, "kind": "msg", "spk": "", "ja": "顔が赤い？\nき、気のせいよ！"},
{"id": 25, "kind": "msg", "spk": "", "ja": "さっきからずっとさすってるけど\nまだ取れないの？"},
{"id": 26, "kind": "msg", "spk": "", "ja": "……私の目にはあんたしか\n映ってないわよ。"},
{"id": 27, "kind": "msg", "spk": "", "ja": "目に違和感はないわよ。\nってかさすがに気づくってば。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "なによ……\nそんなに見つめてきて。"},
{"id": 29, "kind": "msg", "spk": "", "ja": "な、なによ、トモキ！\n私をからかってるの？"},
{"id": 30, "kind": "msg", "spk": "", "ja": "耳に止まったの？"},
{"id": 31, "kind": "msg", "spk": "", "ja": "もう……くすぐったいじゃない！"},
{"id": 32, "kind": "msg", "spk": "", "ja": "っ……。\nいきなり耳をなぞらないでよ！"},
{"id": 33, "kind": "msg", "spk": "", "ja": "そんなにあせらなくても\nちゃんと見せてあげるわよ……。"},
{"id": 34, "kind": "msg", "spk": "", "ja": "さすがにそこにいたら気付くわよ。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "や、やめなさいよ！\nそ、それ以上はダメェ！"},
{"id": 36, "kind": "msg", "spk": "", "ja": "……そんなに調べたいなら\n調べればいいじゃない。ほらほら。"},
{"id": 37, "kind": "msg", "spk": "", "ja": "そんなに念入りに\n調べなくていいってば。"},
{"id": 38, "kind": "msg", "spk": "", "ja": "きゃん、くすぐったいわよっ！"},
{"id": 39, "kind": "msg", "spk": "", "ja": "ら、乱暴にしないでよね。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "ねえ、もうちょっと近づかないと\n分からないんじゃないの……？"},
{"id": 41, "kind": "msg", "spk": "", "ja": "べ、別に時間がかかっても\nいいわよ。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "そ、そんなにじっと見ないでよ……。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "い、痛くしないでよね。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "早く取ってよね。"},
{"id": 45, "kind": "msg", "spk": "", "ja": "この辺にはいないと思うわよ。"},
{"id": 46, "kind": "msg", "spk": "", "ja": "本当にそこにいるの？\nワザとじゃないでしょうね。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "……ふぅん、虫なんて\nどこにいるのかしらねぇ？"},
{"id": 48, "kind": "msg", "spk": "", "ja": "服の中に入っちゃったのかしらね。"},
{"id": 49, "kind": "msg", "spk": "", "ja": "ふぅん、面白い探し方するのね。"},
{"id": 50, "kind": "msg", "spk": "", "ja": "ちょっと、調子に乗りすぎよ。"},
{"id": 51, "kind": "msg", "spk": "", "ja": "ト・モ・キ・ィ？\n覚悟はいいかしら！"},
{"id": 52, "kind": "msg", "spk": "", "ja": "へえ……私とそんなことしたいわけ？"},
{"id": 53, "kind": "msg", "spk": "", "ja": "なにすんのよ！　このバカァ！"},
{"id": 54, "kind": "msg", "spk": "", "ja": "パラダイスソングを受けたいのかしら？"},
{"id": 55, "kind": "msg", "spk": "", "ja": "もう、トモキなんて知らない！"},
{"id": 56, "kind": "msg", "spk": "", "ja": "へぇ、あんたってそういう\n趣味だったのね。"},
{"id": 57, "kind": "msg", "spk": "", "ja": "なんでアルファーはこんな奴を……。"},
{"id": 58, "kind": "msg", "spk": "", "ja": "呆れて何も言えないわ……。"},
{"id": 59, "kind": "msg", "spk": "", "ja": "へえ……そんなのが楽しいんだ。"},
{"id": 60, "kind": "msg", "spk": "", "ja": "ちょっと、シナプスのことを\n思い出しちゃったわ……。"},
{"id": 61, "kind": "msg", "spk": "", "ja": "私を怒らせて、あんたに\n一体何の得があるのかしら？"},
{"id": 62, "kind": "msg", "spk": "", "ja": "次に変なことしたら\nジャミングしてやるからね。"},
{"id": 63, "kind": "msg", "spk": "", "ja": "不潔よ！今まで私のこと\nそんな目で見てたのね！"},
{"id": 64, "kind": "msg", "spk": "", "ja": "し、信じられない!！"},
{"id": 65, "kind": "msg", "spk": "", "ja": "……へたくそ。"},
{"id": 66, "kind": "msg", "spk": "", "ja": "は～……。あきれたわ。"},
{"id": 67, "kind": "msg", "spk": "", "ja": "まったくもう！\nいつもこんなこと考えてんの？"},
{"id": 68, "kind": "msg", "spk": "", "ja": "トモキのバカバカ！ド変態！"},
{"id": 69, "kind": "msg", "spk": "", "ja": "もう、許さないんだからね！！"},
{"id": 70, "kind": "msg", "spk": "", "ja": "このスケベ！　変態！何考えてんのよ！"},
{"id": 71, "kind": "msg", "spk": "", "ja": "いつもこんなこと考えてんの？\nまったくしょうがないわねぇ……。"},
{"id": 72, "kind": "msg", "spk": "", "ja": "ダメッ！　ダメだったらっ！"},
{"id": 73, "kind": "msg", "spk": "", "ja": "わ、私のことをそんな目で\n見てたのね！"},
{"id": 74, "kind": "msg", "spk": "", "ja": "ひどい……どうしてこんなことを……。"},
{"id": 75, "kind": "msg", "spk": "", "ja": "あんた……いい度胸してるわね。"},
{"id": 76, "kind": "msg", "spk": "", "ja": "へ、変態！"},
{"id": 77, "kind": "msg", "spk": "", "ja": "トモキ……トモキのこと、\n信じていたのに……！"},
{"id": 78, "kind": "msg", "spk": "", "ja": "トモキ……ひどいよ……。"},
{"id": 79, "kind": "msg", "spk": "", "ja": "ちょ、ちょっと！\nおかしいんじゃないの！？"},
{"id": 80, "kind": "msg", "spk": "ニンフ", "ja": "虫ねぇ……まあいいわ。\n探してみてよね。"},
{"id": 81, "kind": "msg", "spk": "", "ja": "ちょっと！\n虫を取ってくれるんじゃなかったの！？"},
{"id": 82, "kind": "msg", "spk": "", "ja": "さっきからおとなしくしてれば！"},
{"id": 83, "kind": "msg", "spk": "", "ja": "もう……次は承知しないわよ！"},
{"id": 84, "kind": "msg", "spk": "", "ja": "ふん……もう少しだけ\n我慢してあげるわよ。"},
{"id": 85, "kind": "msg", "spk": "", "ja": "覚悟はできてる！？"},
{"id": 86, "kind": "msg", "spk": "", "ja": "ちょっと……虫はどうなったのよ。"},
{"id": 87, "kind": "msg", "spk": "", "ja": "虫なんて別に\nどうってことないけど……。"},
{"id": 88, "kind": "msg", "spk": "", "ja": "ねえ、そろそろ見つけて\nくれないかしら。"},
{"id": 89, "kind": "msg", "spk": "", "ja": "せっかくトモキと一緒に\nいられたのに……もう……。"},
{"id": 90, "kind": "msg", "spk": "ニンフ", "ja": "ふーん……そんなところにいたんだ。\n一応お礼は言っておくわ。ありがと…。"}
]}
