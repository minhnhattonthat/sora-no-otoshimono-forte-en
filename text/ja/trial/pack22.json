{"file": "_Data/Script/Trial/PackScript22.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "どう……でしょうか？"},
{"id": 1, "kind": "msg", "spk": "", "ja": "あの……続けてください……。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "そこは……大丈夫みたいです。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "あ……\nくすぐったいです……。"},
{"id": 4, "kind": "msg", "spk": "", "ja": "ん……\nなにか……わかりましたか？"},
{"id": 5, "kind": "msg", "spk": "", "ja": "ん……平気です。\nどうか、ほかの場所も……。"},
{"id": 6, "kind": "msg", "spk": "", "ja": "体が熱い……です。"},
{"id": 7, "kind": "msg", "spk": "", "ja": "はい、大丈夫です。\n問題ありません……"},
{"id": 8, "kind": "msg", "spk": "", "ja": "んんっ……\nあ……お気になさらず……。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "あっ……！\nすみません、いきなりだったので……。"},
{"id": 10, "kind": "msg", "spk": "", "ja": "お医者さんごっこ……\n奥が深いです……。"},
{"id": 11, "kind": "msg", "spk": "", "ja": "髪を調べると\n病気がわかるのですか……？"},
{"id": 12, "kind": "msg", "spk": "", "ja": "先生の手つき……優しいです。"},
{"id": 13, "kind": "msg", "spk": "", "ja": "なでられるとうれしい……です。\nあ……診察……でしたね。"},
{"id": 14, "kind": "msg", "spk": "", "ja": "私の顔になにか気になることが\nあるのでしょうか……。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "笑顔になれないのは……\n病気でしょうか？"},
{"id": 16, "kind": "msg", "spk": "", "ja": "先生……顔が熱くなって\nしまいました……。"},
{"id": 17, "kind": "msg", "spk": "", "ja": "はい、ちゃんと見えてます。\n機能は問題ありません。"},
{"id": 18, "kind": "msg", "spk": "", "ja": "先生に見つめられると体が……\n熱くなってしまいます……。"},
{"id": 19, "kind": "msg", "spk": "", "ja": "あの……そんなに見られると……。"},
{"id": 20, "kind": "msg", "spk": "", "ja": "口の中、ですか？\nはい、お願いします……。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "先生は歯医者さんだったのですか？"},
{"id": 22, "kind": "msg", "spk": "", "ja": "触診……ですか。\nお願いします……。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "あの……\nなにか変ですか？"},
{"id": 24, "kind": "msg", "spk": "", "ja": "……あの……\nくすぐったいです……。"},
{"id": 25, "kind": "msg", "spk": "", "ja": "マッサージもしてくれるのですね。"},
{"id": 26, "kind": "msg", "spk": "", "ja": "服を脱いだほうが\n診察しやすいのでしょうか……。"},
{"id": 27, "kind": "msg", "spk": "", "ja": "服の上からでも診察できるなんて\nすごいです……。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "システムスキャン開始……\n異常は無いようです、先生。"},
{"id": 29, "kind": "msg", "spk": "", "ja": "先生……\nそれは包帯ではありません。"},
{"id": 30, "kind": "msg", "spk": "", "ja": "リボン……\n私に似合っているでしょうか？"},
{"id": 31, "kind": "msg", "spk": "", "ja": "リボンをご覧になりたいのですか……\nではどうぞ……。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "羽に興味がおありですか？"},
{"id": 33, "kind": "msg", "spk": "", "ja": "これは……生まれたときから\nありますので……。"},
{"id": 34, "kind": "msg", "spk": "", "ja": "あっ……\n大丈夫です、続けて……ください……。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "翼を広げたほうが\n診察しやすいでしょうか？"},
{"id": 36, "kind": "msg", "spk": "", "ja": "これは、大事なものです……。"},
{"id": 37, "kind": "msg", "spk": "", "ja": "鋭いメスでも……\n切ることはできません。"},
{"id": 38, "kind": "msg", "spk": "", "ja": "鎖ごしでも、ぬくもりが\n伝わってきます……。"},
{"id": 39, "kind": "msg", "spk": "", "ja": "抱いていると……安心します。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "注射器のクッション……です。"},
{"id": 41, "kind": "msg", "spk": "", "ja": "先生も抱いてみますか？\nふかふか……です。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "これは包帯です。\n治療につかう物です……。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "先生が……ケガをしたら\n私が包帯を巻きます……。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "包帯を使うのは、お医者さん\nらしいと思います……。"},
{"id": 45, "kind": "msg", "spk": "", "ja": "包帯を引っ張ると……\n楽しいのでしょうか。"},
{"id": 46, "kind": "msg", "spk": "", "ja": "少し、困ります……。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "や……。"},
{"id": 48, "kind": "msg", "spk": "", "ja": "先生、そのようなことは……。"},
{"id": 49, "kind": "msg", "spk": "", "ja": "先生は……\nいつもこんなことを……？"},
{"id": 50, "kind": "msg", "spk": "", "ja": "……これが必要なことなら……。"},
{"id": 51, "kind": "msg", "spk": "", "ja": "あの、それ以上は……。"},
{"id": 52, "kind": "msg", "spk": "", "ja": "あの……なにを……？"},
{"id": 53, "kind": "msg", "spk": "", "ja": "先生……\n顔がにやけていますが……。"},
{"id": 54, "kind": "msg", "spk": "", "ja": "悲しい……です……。"},
{"id": 55, "kind": "msg", "spk": "", "ja": "そんな……。"},
{"id": 56, "kind": "msg", "spk": "", "ja": "少々やりすぎなのでは……。"},
{"id": 57, "kind": "msg", "spk": "", "ja": "先生、手元が\n狂われたようですが……。"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "よーし、イカロス。\n今からお医者さんごっこを始めるぞ！"},
{"id": 59, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "違う！　お医者さんごっこを\nやるときは俺のことは先生と呼べ！"},
{"id": 61, "kind": "msg", "spk": "イカロス", "ja": "はい……先生。"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "うむ、それでは診察を開始する！"},
{"id": 63, "kind": "msg", "spk": "", "ja": "大変です……先生が\nおかしくなってしまいました……。"},
{"id": 64, "kind": "msg", "spk": "", "ja": "すみません……。\n先生を疑うなんて……。"},
{"id": 65, "kind": "msg", "spk": "", "ja": "わかりました……。\nどうぞ続けてください。"},
{"id": 66, "kind": "msg", "spk": "", "ja": "あの……お注射をしておきます……。"},
{"id": 67, "kind": "msg", "spk": "", "ja": "こういうときは、確かチョップが\n効くとそはらさんが……。"},
{"id": 68, "kind": "msg", "spk": "", "ja": "先生……ほかになにかご用事が？"},
{"id": 69, "kind": "msg", "spk": "", "ja": "診察は、いつまで\n続くのでしょうか……。"},
{"id": 70, "kind": "msg", "spk": "", "ja": "先生……\n何か……分かりましたか？"},
{"id": 71, "kind": "msg", "spk": "", "ja": "お医者さんごっこ……\n私にはよく分かりませんでした……。"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "ふー、まあ、大体こんな感じだな！"},
{"id": 73, "kind": "msg", "spk": "イカロス", "ja": "先生、診断結果はどうでしょうか。"},
{"id": 74, "kind": "msg", "spk": "智樹", "ja": "ああ、大丈夫だよ。健康そのものだ！"},
{"id": 75, "kind": "msg", "spk": "智樹", "ja": "じゃ、お医者さんゴッコはお終いだ。\n俺は部屋に戻ってるぞ。じゃあな。"},
{"id": 76, "kind": "msg", "spk": "智樹", "ja": "あ……マスターが\n行ってしまわれた……。"},
{"id": 77, "kind": "msg", "spk": "智樹", "ja": "では……この動力炉の異常は\n一体何なのでしょうか……。"}
]}
