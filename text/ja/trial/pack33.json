{"file": "_Data/Script/Trial/PackScript33.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "はい！　拭いてくれて\nありがとうございます……。"},
{"id": 1, "kind": "msg", "spk": "", "ja": "やさしく拭いてください！"},
{"id": 2, "kind": "msg", "spk": "", "ja": "今度はキチンとしますから、\n見捨てないでください～。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "お給料減らさないでください～……。"},
{"id": 4, "kind": "msg", "spk": "", "ja": "ご主人さまにかかった分は\n私が拭きます！"},
{"id": 5, "kind": "msg", "spk": "", "ja": "そ、そんなところもぬれてたんですね！\nありがとうございます！"},
{"id": 6, "kind": "msg", "spk": "", "ja": "こ、こんなことは\nほかの誰にもしないでくださいね。"},
{"id": 7, "kind": "msg", "spk": "", "ja": "お仕事がんばります！"},
{"id": 8, "kind": "msg", "spk": "", "ja": "ご主人さまはやさしいから\n大好きです！"},
{"id": 9, "kind": "msg", "spk": "", "ja": "ハイ！　ハイ！\n髪はちゃんとキレイにしてます！"},
{"id": 10, "kind": "msg", "spk": "", "ja": "髪の毛をほめられると\nとってもうれしいです！"},
{"id": 11, "kind": "msg", "spk": "", "ja": "顔をキレイにしてくれて\nありがとうございます！"},
{"id": 12, "kind": "msg", "spk": "", "ja": "あっ！　顔で遊んじゃダメです！"},
{"id": 13, "kind": "msg", "spk": "", "ja": "わーい！　ご主人さまやさしいです！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "そ、そんなにじっと見られると\n照れちゃいます！"},
{"id": 15, "kind": "msg", "spk": "", "ja": "ハイ！　ハイ！\n目はつむっておきます！"},
{"id": 16, "kind": "msg", "spk": "", "ja": "く、くすぐったいです！"},
{"id": 17, "kind": "msg", "spk": "", "ja": "こ、こっちは本物の耳です！"},
{"id": 18, "kind": "msg", "spk": "", "ja": "今の私は耳が４つあるので\n良く聞こえますよ！"},
{"id": 19, "kind": "msg", "spk": "", "ja": "ひやんっ！\nそっちはビンカンなんです！"},
{"id": 20, "kind": "msg", "spk": "", "ja": "あ、さわさわされると\nうれしいです……。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "なんだかうさぎさんに\nなったみたいです！"},
{"id": 22, "kind": "msg", "spk": "", "ja": "ひ、ひっぱられると困っちゃいます！"},
{"id": 23, "kind": "msg", "spk": "", "ja": "あっ……！　そんなに強く\n握っちゃダメです！"},
{"id": 24, "kind": "msg", "spk": "", "ja": "こぼしたのは私なのにぃ……。\nすみません～。"},
{"id": 25, "kind": "msg", "spk": "", "ja": "ジュースのにおい嗅いでたら\n頭がフワフワします！"},
{"id": 26, "kind": "msg", "spk": "", "ja": "とんだそそうをしてしまいました。\nごめんなさーい。"},
{"id": 27, "kind": "msg", "spk": "", "ja": "んにゅ……。\n口にも、飛んじゃってますぅ……。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "ハイ！　ハイ！\n静かにしてます！"},
{"id": 29, "kind": "msg", "spk": "", "ja": "はあ……はあ……\nんん……っ。"},
{"id": 30, "kind": "msg", "spk": "", "ja": "ご主人さまは、この服装が\n好きなんですね！"},
{"id": 31, "kind": "msg", "spk": "", "ja": "この格好は身軽で、私も好きです！"},
{"id": 32, "kind": "msg", "spk": "", "ja": "肌にぴっちりして動きやすいです！"},
{"id": 33, "kind": "msg", "spk": "", "ja": "汚しちゃってごめんなさいぃ……。"},
{"id": 34, "kind": "msg", "spk": "", "ja": "すみません、鎖も汚しちゃいました。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "錆びちゃうと大変ですよね。\nそれじゃあ、ここも拭いてください。"},
{"id": 36, "kind": "msg", "spk": "", "ja": "あ……ひっぱった方が\nふきやすいですか？"},
{"id": 37, "kind": "msg", "spk": "", "ja": "羽はやさしく拭いてくださいね！"},
{"id": 38, "kind": "msg", "spk": "", "ja": "ご主人さまの手……。\nあ、な、なんでもありません！"},
{"id": 39, "kind": "msg", "spk": "", "ja": "そ、そんなぁっ！"},
{"id": 40, "kind": "msg", "spk": "", "ja": "……な、なにをするんですかぁっ！\nふあああっん！"},
{"id": 41, "kind": "msg", "spk": "", "ja": "そ、そこは！"},
{"id": 42, "kind": "msg", "spk": "", "ja": "ち、力が抜けてしまいます……。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "よ、汚れていないところは\n拭かなくていいです！"},
{"id": 44, "kind": "msg", "spk": "", "ja": "あ……汚れが広がっちゃいました……。"},
{"id": 45, "kind": "msg", "spk": "", "ja": "や、やめてください！　ご主人さまぁ！"},
{"id": 46, "kind": "msg", "spk": "", "ja": "ご奉仕してただけなのに～……。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "ご主人さま……あんまりです！"},
{"id": 48, "kind": "msg", "spk": "", "ja": "ひゃあっ……！\nやめてください！"},
{"id": 49, "kind": "msg", "spk": "", "ja": "もぉ、いい加減にしてくださいっ!!"},
{"id": 50, "kind": "msg", "spk": "", "ja": "くうううううう……！\nひ、ひどいです！"},
{"id": 51, "kind": "msg", "spk": "", "ja": "つらくても負けません！"},
{"id": 52, "kind": "msg", "spk": "アストレア", "ja": "わぁー！　ご、ごめんなさい\nご主人さま。またそそうを……。"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "いかん……いかんなぁ……\nこれは実にいかんよ。"},
{"id": 54, "kind": "msg", "spk": "アストレア", "ja": "ゆゆゆ許してください～……！"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "もちろん許すとも……\n私は紳士だからね。"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "まずは身体を拭かないと\n風邪をひいてしまうからね。"},
{"id": 57, "kind": "msg", "spk": "アストレア", "ja": "は、はい～……。"},
{"id": 58, "kind": "msg", "spk": "", "ja": "こ、これ以上は許せません！"},
{"id": 59, "kind": "msg", "spk": "", "ja": "もう、我慢の限界なんだから！"},
{"id": 60, "kind": "msg", "spk": "", "ja": "さ、さすがはご主人さまです！"},
{"id": 61, "kind": "msg", "spk": "", "ja": "ご、ごめんなさーい！"},
{"id": 62, "kind": "msg", "spk": "", "ja": "正気に戻ってください！　えい！"},
{"id": 63, "kind": "msg", "spk": "", "ja": "正気に戻ってください！　えい！"},
{"id": 64, "kind": "msg", "spk": "", "ja": "え、ちょっと何するんですか？\nいやああ～！"},
{"id": 65, "kind": "msg", "spk": "", "ja": "ク、クビだけは\nカンベンしてくださいぃ……。"},
{"id": 66, "kind": "msg", "spk": "", "ja": "そんな……無言にならないで\nくださいよぉ。"},
{"id": 67, "kind": "msg", "spk": "", "ja": "あ……こんなところも\n水びたしになってます！"},
{"id": 68, "kind": "msg", "spk": "", "ja": "えーん！　もう別のご主人様の\nところへ行きます！"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "よーし、これでキレイになったぞ、\nアストレア。"},
{"id": 70, "kind": "msg", "spk": "アストレア", "ja": "わーい、ありがとうございます！\nご主人さま！"},
{"id": 71, "kind": "msg", "spk": "アストレア", "ja": "今度はぜったいに粗相なんて\nしませんから、見ていてください！"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "はあ～やれやれ、\nどうなることやら……。"}
]}
