{"file": "_Data/Script/Trial/PackScript23.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "……気持ちいい……です。"},
{"id": 1, "kind": "msg", "spk": "", "ja": "優しい気持が……伝わってきます……。"},
{"id": 2, "kind": "msg", "spk": "", "ja": "あたたかい手ですね……。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "どうですか……？"},
{"id": 4, "kind": "msg", "spk": "", "ja": "楽になったかも……しれません。"},
{"id": 5, "kind": "msg", "spk": "", "ja": "はい、とてもいいです……。"},
{"id": 6, "kind": "msg", "spk": "", "ja": "今度は……私にマッサージを\nさせてくれませんか……？"},
{"id": 7, "kind": "msg", "spk": "", "ja": "体がぽかぽかしてきます……。"},
{"id": 8, "kind": "msg", "spk": "", "ja": "もう少し……\n近づいてみてください……。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "……疲れが……\n全部とれていきます……。"},
{"id": 10, "kind": "msg", "spk": "", "ja": "とても……上手です……。"},
{"id": 11, "kind": "msg", "spk": "", "ja": "髪が乱れていましたか？"},
{"id": 12, "kind": "msg", "spk": "", "ja": "良い匂い……ですか？\n特に何もつけてないですが……。"},
{"id": 13, "kind": "msg", "spk": "", "ja": "なでなでされるのは、\n新鮮です……。"},
{"id": 14, "kind": "msg", "spk": "", "ja": "感情表現は……苦手です……。"},
{"id": 15, "kind": "msg", "spk": "", "ja": "すべすべですか？\nほめてもらえると……嬉しいです。"},
{"id": 16, "kind": "msg", "spk": "", "ja": "顔が、ほころびます……。"},
{"id": 17, "kind": "msg", "spk": "", "ja": "はい……じっと見ています……。"},
{"id": 18, "kind": "msg", "spk": "", "ja": "……ずっとこのままで……\nいられたら……。"},
{"id": 19, "kind": "msg", "spk": "", "ja": "目の疲れがとれていきます……。"},
{"id": 20, "kind": "msg", "spk": "", "ja": "笑顔になれるということは……\nとても大切なことです……。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "私の口元に……何か\nついていますか？"},
{"id": 22, "kind": "msg", "spk": "", "ja": "笑顔の練習……ですか？\n……にやり。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "んんっ……\n……くすぐったいです……。"},
{"id": 24, "kind": "msg", "spk": "", "ja": "あ……そこは……。"},
{"id": 25, "kind": "msg", "spk": "", "ja": "どこか……変でしたか？"},
{"id": 26, "kind": "msg", "spk": "", "ja": "あ……リボンが\n絡まってましたか？"},
{"id": 27, "kind": "msg", "spk": "", "ja": "リボンの感触が……\n好きなのですか？"},
{"id": 28, "kind": "msg", "spk": "", "ja": "私のリボンに……愛着が\nあるのでしょうか……。"},
{"id": 29, "kind": "msg", "spk": "", "ja": "羽のマッサージも\nしてくれるんですね……。"},
{"id": 30, "kind": "msg", "spk": "", "ja": "この後、一緒に散歩に……。"},
{"id": 31, "kind": "msg", "spk": "", "ja": "……自分のココロに、大きな翼が\nあることを忘れないでください。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "鎖が……気に入ったのですか？"},
{"id": 33, "kind": "msg", "spk": "", "ja": "楽しそう……ですね。"},
{"id": 34, "kind": "msg", "spk": "", "ja": "あ……そんなに引っ張っては……。\nんん……っ。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "ほかに３時のおやつを用意して\nますから……これはダメです……。"},
{"id": 36, "kind": "msg", "spk": "", "ja": "いつまでも……\n抱いていたいです……。"},
{"id": 37, "kind": "msg", "spk": "", "ja": "一緒に、なでてみませんか？"},
{"id": 38, "kind": "msg", "spk": "", "ja": "念入りにしてくれるんですね……"},
{"id": 39, "kind": "msg", "spk": "", "ja": "そこ……弱いみたいです……。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "あ……こんなことを……っ。"},
{"id": 41, "kind": "msg", "spk": "", "ja": "あまり……\n困らせないでください……。"},
{"id": 42, "kind": "msg", "spk": "", "ja": "ごめんなさい……。\nそれ以上は……。"},
{"id": 43, "kind": "msg", "spk": "", "ja": "これは……マッサージと\n言えるのでしょうか……。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "他のところを……。"},
{"id": 45, "kind": "msg", "spk": "", "ja": "少し、痛いです……。"},
{"id": 46, "kind": "msg", "spk": "", "ja": "叱るべきでしょうか……。"},
{"id": 47, "kind": "msg", "spk": "", "ja": "ごめんなさい……。\nよく分からないです……。"},
{"id": 48, "kind": "msg", "spk": "", "ja": "……ああ……。"},
{"id": 49, "kind": "msg", "spk": "", "ja": "何故、こんなことを……。"},
{"id": 50, "kind": "msg", "spk": "", "ja": "おしおき……しなくちゃ……。"},
{"id": 51, "kind": "msg", "spk": "", "ja": "いけない子、です……。"},
{"id": 52, "kind": "msg", "spk": "", "ja": "悲しい……です……。"},
{"id": 53, "kind": "msg", "spk": "イカロス", "ja": "……また、テストで０点を\nとってしまったのですね……。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "かーちゃん、ごめんよ。\nいつも恥かかせちゃって……。"},
{"id": 55, "kind": "msg", "spk": "イカロス", "ja": "……大丈夫です。\n次はがんばりましょう……。"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "ありがとうかーちゃん……。"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "せめて、せめて日ごろのお礼に\nマッサージさせてくれよ！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "私が……ちゃんと\n叱ってあげないと……。"},
{"id": 59, "kind": "msg", "spk": "", "ja": "……今回は……許します。"},
{"id": 60, "kind": "msg", "spk": "", "ja": "……しかたのない子ですね……。"},
{"id": 61, "kind": "msg", "spk": "", "ja": "悪い子には……お尻ペンペンです。"},
{"id": 62, "kind": "msg", "spk": "", "ja": "……メッ……です。"},
{"id": 63, "kind": "msg", "spk": "", "ja": "あ……スイカが……。"},
{"id": 64, "kind": "msg", "spk": "", "ja": "あの……続きは……。"},
{"id": 65, "kind": "msg", "spk": "", "ja": "もう……終わり……でしょうか……。"},
{"id": 66, "kind": "msg", "spk": "", "ja": "やっぱり、やれば\n出来る子です……。"},
{"id": 67, "kind": "msg", "spk": "", "ja": "ああ……家庭崩壊……です。"},
{"id": 68, "kind": "msg", "spk": "イカロス", "ja": "……おかげで元気が出ました。"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "俺、かーちゃんが少しでも\n楽できるようにがんばるよ！"},
{"id": 70, "kind": "msg", "spk": "イカロス", "ja": "はい……一緒にがんばりましょう……。"}
]}
