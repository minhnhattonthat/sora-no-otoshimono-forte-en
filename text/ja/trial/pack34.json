{"file": "_Data/Script/Trial/PackScript34.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "これも特訓なの？"},
{"id": 1, "kind": "msg", "spk": "", "ja": "うん！　頑張るよ！"},
{"id": 2, "kind": "msg", "spk": "", "ja": "私、めげないからね！"},
{"id": 3, "kind": "msg", "spk": "", "ja": "そこがダメなんだね！"},
{"id": 4, "kind": "msg", "spk": "", "ja": "もっと厳しく、お願いね！"},
{"id": 5, "kind": "msg", "spk": "", "ja": "手を抜いちゃダメだよ？"},
{"id": 6, "kind": "msg", "spk": "", "ja": "もっと厳しくても大丈夫だよ！"},
{"id": 7, "kind": "msg", "spk": "", "ja": "私、負けないから！"},
{"id": 8, "kind": "msg", "spk": "", "ja": "気合十分だよ！"},
{"id": 9, "kind": "msg", "spk": "", "ja": "そこを重点的に鍛えてくれるんだね！"},
{"id": 10, "kind": "msg", "spk": "", "ja": "そこがわたしの弱点なのかな……。"},
{"id": 11, "kind": "msg", "spk": "", "ja": "もっと厳しくても大丈夫だよ！"},
{"id": 12, "kind": "msg", "spk": "", "ja": "私、負けないから！"},
{"id": 13, "kind": "msg", "spk": "", "ja": "気合十分だよ！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "そこを重点的に鍛えてくれるんだね！"},
{"id": 15, "kind": "msg", "spk": "", "ja": "そこがわたしの弱点なのかな……。"},
{"id": 16, "kind": "msg", "spk": "", "ja": "期待に答えられるよう、頑張るね！"},
{"id": 17, "kind": "msg", "spk": "", "ja": "もっと……もっと……\n特訓して……欲しい……。"},
{"id": 18, "kind": "msg", "spk": "", "ja": "これが愛のムチっていうものなんだね。"},
{"id": 19, "kind": "msg", "spk": "", "ja": "特訓は辛いけど、楽しいよ！"},
{"id": 20, "kind": "msg", "spk": "", "ja": "期待に答えられるよう、頑張るね！"},
{"id": 21, "kind": "msg", "spk": "", "ja": "もっと……もっと……\n特訓して……欲しい……。"},
{"id": 22, "kind": "msg", "spk": "", "ja": "これが愛のムチっていうものなんだね。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "特訓は辛いけど、楽しいよ！"},
{"id": 24, "kind": "msg", "spk": "", "ja": "髪の毛がどうかしたの？"},
{"id": 25, "kind": "msg", "spk": "", "ja": "ポニーテールはチアに\n向いてるよね。"},
{"id": 26, "kind": "msg", "spk": "", "ja": "私、うまく出来てるかな？"},
{"id": 27, "kind": "msg", "spk": "", "ja": "やっぱり、誰かにほめてもらえると\nとっても嬉しいよね……。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "笑顔の特訓だね！"},
{"id": 29, "kind": "msg", "spk": "", "ja": "自然に笑うって難しいよね。\nでも、頑張るよ！"},
{"id": 30, "kind": "msg", "spk": "", "ja": "もっと……教えてほしい……かも。"},
{"id": 31, "kind": "msg", "spk": "", "ja": "応援には、笑顔が一番大事だねっ！"},
{"id": 32, "kind": "msg", "spk": "", "ja": "ウィンクの特訓だね！"},
{"id": 33, "kind": "msg", "spk": "", "ja": "えいっ！　どうかな？\n上手く片目だけ閉じてたかな？"},
{"id": 34, "kind": "msg", "spk": "", "ja": "そ、そんな真剣に見つめられると……。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "視線になれるための特訓なんだね、\n頑張るよ。"},
{"id": 36, "kind": "msg", "spk": "", "ja": "そこは特訓と関係あるの？"},
{"id": 37, "kind": "msg", "spk": "", "ja": "私、耳が弱いんだ……\nえっ！　これも特訓!?"},
{"id": 38, "kind": "msg", "spk": "", "ja": "そんなに耳たぶをぷにぷにして\nどうしたの？"},
{"id": 39, "kind": "msg", "spk": "", "ja": "ちょっと、熱っぽいかも……。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "ど、どうしたの？\n急に……。"},
{"id": 41, "kind": "msg", "spk": "", "ja": "フレー、フレー！\n……ど、どうかな？"},
{"id": 42, "kind": "msg", "spk": "", "ja": "ゴーゴー！\nトモちゃんっ！"},
{"id": 43, "kind": "msg", "spk": "", "ja": "私、応援するとき……\nちょっぴりあがっちゃうんだ……。"},
{"id": 44, "kind": "msg", "spk": "", "ja": "リボンがほどけそうになってる？"},
{"id": 45, "kind": "msg", "spk": "", "ja": "リボンを直してくれてたんだね！\nこれで特訓に集中できるよ！"},
{"id": 46, "kind": "msg", "spk": "", "ja": "やん！　そんなに引っ張ったら\nほどけちゃうよ！"},
{"id": 47, "kind": "msg", "spk": "", "ja": "変じゃないかな？\nチェックをお願い！"},
{"id": 48, "kind": "msg", "spk": "", "ja": "あ！　そこがおかしかったんだね？"},
{"id": 49, "kind": "msg", "spk": "", "ja": "この衣装を着るのが、\n憧れだったんだ……。"},
{"id": 50, "kind": "msg", "spk": "", "ja": "ひゃん！　そんなに引っ張ると\n衣装がずれちゃうよ。"},
{"id": 51, "kind": "msg", "spk": "", "ja": "やっぱり、チアリーダーには\nこれがないとダメだよね！"},
{"id": 52, "kind": "msg", "spk": "", "ja": "毎日お手入れは\nかかしてないんだから！"},
{"id": 53, "kind": "msg", "spk": "", "ja": "ん、どこかほつれてる？"},
{"id": 54, "kind": "msg", "spk": "", "ja": "道具のお手入れは\n基本だよねっ！"},
{"id": 55, "kind": "msg", "spk": "", "ja": "なんかスースーするよ……。"},
{"id": 56, "kind": "msg", "spk": "", "ja": "し、下から覗いたりしたらダメだよ！"},
{"id": 57, "kind": "msg", "spk": "", "ja": "恥ずかしさに耐える特訓なんだね！\nが、がんばるよ！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "えっ？　これも特訓なの……\n恥ずかしいよ……"},
{"id": 59, "kind": "msg", "spk": "", "ja": "そこは関係ないよね？"},
{"id": 60, "kind": "msg", "spk": "", "ja": "そんな顔、見たくないんだから！"},
{"id": 61, "kind": "msg", "spk": "", "ja": "ちょっと、やめてよ！"},
{"id": 62, "kind": "msg", "spk": "", "ja": "わたしに信じさせてよ……。"},
{"id": 63, "kind": "msg", "spk": "", "ja": "こんなのじゃ特訓にならないよ！\n手を抜かないで！"},
{"id": 64, "kind": "msg", "spk": "", "ja": "ねえ……本気で\n特訓しようとしてる？"},
{"id": 65, "kind": "msg", "spk": "", "ja": "もう……嫌いになっちゃうよ……？"},
{"id": 66, "kind": "msg", "spk": "", "ja": "ひどいよ……。\nこれでチアが本当にうまくなるの？"},
{"id": 67, "kind": "msg", "spk": "", "ja": "顔……ニヤけてるんだけど……。"},
{"id": 68, "kind": "msg", "spk": "", "ja": "それはないんじゃないかな？"},
{"id": 69, "kind": "msg", "spk": "そはら", "ja": "ねえ……今日もしてもらっていい？\n秘密の特訓……。"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "そはらは優秀だなぁ。\nとても教えがいがあるぞ。"},
{"id": 71, "kind": "msg", "spk": "そはら", "ja": "特訓を受ければ……\nチアがもっとうまくなれるんだよね？"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "それはそはら次第だぞ。\nふっふっふっふ……。"},
{"id": 73, "kind": "msg", "spk": "", "ja": "こんな特訓……絶対に間違ってるよ！"},
{"id": 74, "kind": "msg", "spk": "", "ja": "……こんな特訓でチアがうまくなれる\nなんて思えないよ！"},
{"id": 75, "kind": "msg", "spk": "", "ja": "ごめんなさい……！\nもっと特訓頑張るね。"},
{"id": 76, "kind": "msg", "spk": "", "ja": "ごめんなさい……\nもうちょっとだけ頑張ってみるね。"},
{"id": 77, "kind": "msg", "spk": "", "ja": "酷いよ！　私、本気で\n特訓したいのに！"},
{"id": 78, "kind": "msg", "spk": "", "ja": "マジメに特訓してよ！"},
{"id": 79, "kind": "msg", "spk": "", "ja": "ちょっと恥ずかしいけど\nこれも特訓のためだよね！"},
{"id": 80, "kind": "msg", "spk": "", "ja": "私、まだまだ頑張れるよ！"},
{"id": 81, "kind": "msg", "spk": "", "ja": "私を見捨てないでね……。"},
{"id": 82, "kind": "msg", "spk": "", "ja": "これで、ラストスパート！\nお願いね！"},
{"id": 83, "kind": "msg", "spk": "", "ja": "もういやだよ！\nこんな特訓にはついていけないよ！"},
{"id": 84, "kind": "msg", "spk": "そはら", "ja": "はあっ……はあ、どう？\n私、上達したかな？"},
{"id": 85, "kind": "msg", "spk": "智樹", "ja": "ああ、そはらは本当に\nのみこみが早いな。"},
{"id": 86, "kind": "msg", "spk": "智樹", "ja": "きっと立派なチアリーダーに\nなれるぜ！"},
{"id": 87, "kind": "msg", "spk": "そはら", "ja": "うん！　私、がんばるね！"}
]}
