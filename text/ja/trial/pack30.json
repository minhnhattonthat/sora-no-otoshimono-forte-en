{"file": "_Data/Script/Trial/PackScript30.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "あ……\nべ、別になんとも……ないわよ。"},
{"id": 1, "kind": "msg", "spk": "", "ja": "そんなところに\nおむすびがあるの？"},
{"id": 2, "kind": "msg", "spk": "", "ja": "わあ、熱心に探して\nくれるんだねぇー。"},
{"id": 3, "kind": "msg", "spk": "", "ja": "う～。\nなんかクラクラする～。"},
{"id": 4, "kind": "msg", "spk": "", "ja": "ねえ、もっと構ってよー。"},
{"id": 5, "kind": "msg", "spk": "", "ja": "あわわわわ！\nあわわわわわわ！"},
{"id": 6, "kind": "msg", "spk": "", "ja": "はふぅう～……。"},
{"id": 7, "kind": "msg", "spk": "", "ja": "はあ、はあ……\nこんなことって……！"},
{"id": 8, "kind": "msg", "spk": "", "ja": "ひゃああああ！？\nバカバカバカぁー！"},
{"id": 9, "kind": "msg", "spk": "", "ja": "お・兄・ち・ゃ・んΩ"},
{"id": 10, "kind": "msg", "spk": "", "ja": "な、何ですか！？\n何なんですかぁ～！？"},
{"id": 11, "kind": "msg", "spk": "", "ja": "んもう、くしゃくしゃに\nしないでよぉー。"},
{"id": 12, "kind": "msg", "spk": "", "ja": "えっへへへへ～。"},
{"id": 13, "kind": "msg", "spk": "", "ja": "もっとなでなでしてくれると\nうれしいな……。"},
{"id": 14, "kind": "msg", "spk": "", "ja": "ほっぺたつっついても\nおむすびは出てこないよ？"},
{"id": 15, "kind": "msg", "spk": "", "ja": "いひゃひゃひゃひゃ！\nほっぺらひっぱっひゃらめぇ！"},
{"id": 16, "kind": "msg", "spk": "", "ja": "そ、そんなにじっと\n見ないでよー。"},
{"id": 17, "kind": "msg", "spk": "", "ja": "い、いきなり\nびっくりさせないでよね！"},
{"id": 18, "kind": "msg", "spk": "", "ja": "ぷすす～。\nおもしろい顔近づけないでよね～。"},
{"id": 19, "kind": "msg", "spk": "", "ja": "ひゃんっ！\n耳をつっつかないでよぉ！"},
{"id": 20, "kind": "msg", "spk": "", "ja": "耳元でしゃべっちゃダメぇ……。"},
{"id": 21, "kind": "msg", "spk": "", "ja": "んん、ああんっ！"},
{"id": 22, "kind": "msg", "spk": "", "ja": "あ……く、くちびるに指が……。"},
{"id": 23, "kind": "msg", "spk": "", "ja": "はむっ。\n指、くわえちゃった！"},
{"id": 24, "kind": "msg", "spk": "", "ja": "ハイ！　ハーイ！\nそろそろおなかがすいてきました！"},
{"id": 25, "kind": "msg", "spk": "", "ja": "制服、似合ってるでしょう！"},
{"id": 26, "kind": "msg", "spk": "", "ja": "学校の制服は気に入ってるよ！"},
{"id": 27, "kind": "msg", "spk": "", "ja": "さあ、ほめていいわよ？\nさあ、さあ！"},
{"id": 28, "kind": "msg", "spk": "", "ja": "鎖が似合う女って\n大人の人って感じよね！"},
{"id": 29, "kind": "msg", "spk": "", "ja": "鎖……ひっぱってみる？\nいいよ……。"},
{"id": 30, "kind": "msg", "spk": "", "ja": "わ、私の羽になんてこと\nするのよぉ～！"},
{"id": 31, "kind": "msg", "spk": "", "ja": "や、やさしくしてよ……。"},
{"id": 32, "kind": "msg", "spk": "", "ja": "この体勢だと、羽が\n押しつぶされちゃうわよ……。"},
{"id": 33, "kind": "msg", "spk": "", "ja": "え？　靴下？\n靴下に何をする気なの？"},
{"id": 34, "kind": "msg", "spk": "", "ja": "わ、私の靴下に興味があるんだ……。"},
{"id": 35, "kind": "msg", "spk": "", "ja": "あ！　持って行かないでよね！"},
{"id": 36, "kind": "msg", "spk": "", "ja": "い、いじめないでよね！"},
{"id": 37, "kind": "msg", "spk": "", "ja": "ぐぬぬぬぬ～……！"},
{"id": 38, "kind": "msg", "spk": "", "ja": "うぎぎぎぎ～……！"},
{"id": 39, "kind": "msg", "spk": "", "ja": "そんなところに\nおむすびはないよぉ～。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "いくらなんでも、それ以上は\n許さないわよ！"},
{"id": 41, "kind": "msg", "spk": "", "ja": "え～ん、お兄ちゃんが\nいじめるよぉ～！"},
{"id": 42, "kind": "msg", "spk": "", "ja": "もう！　ちゃんと探してよね！"},
{"id": 43, "kind": "msg", "spk": "", "ja": "ハイ！　ハイ！\n意味が分かりません！"},
{"id": 44, "kind": "msg", "spk": "", "ja": "バーカ！　バーカ！"},
{"id": 45, "kind": "msg", "spk": "", "ja": "ちょっと！\nこの仕打ちはひどいよ！"},
{"id": 46, "kind": "msg", "spk": "", "ja": "もうやだぁ～！"},
{"id": 47, "kind": "msg", "spk": "アストレア", "ja": "ちょっとお兄ちゃん！\n私のおむすび食べたでしょ！"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "はあ？　食ってねーよ！"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "どうせお前がどっかに\n隠してるんだろう！"},
{"id": 50, "kind": "msg", "spk": "アストレア", "ja": "むっかー！　そんなに\n言うなら探してみてよね！"},
{"id": 51, "kind": "msg", "spk": "", "ja": "私を怒らせるとどうなるか……\n思い知らせてやるー！"},
{"id": 52, "kind": "msg", "spk": "", "ja": "ちょっと！\nいいかげんにしてよー！"},
{"id": 53, "kind": "msg", "spk": "", "ja": "そ、そんな～！\n避けられるなんて……。"},
{"id": 54, "kind": "msg", "spk": "", "ja": "え、うそ！　信じられない！"},
{"id": 55, "kind": "msg", "spk": "", "ja": "手加減しないんだから！"},
{"id": 56, "kind": "msg", "spk": "", "ja": "ぷすす～、お兄ちゃん弱～い♪"},
{"id": 57, "kind": "msg", "spk": "", "ja": "ちょっと、私のおむすび\n探してくれるんじゃないの！？"},
{"id": 58, "kind": "msg", "spk": "", "ja": "ねえ、早く探してよー。"},
{"id": 59, "kind": "msg", "spk": "", "ja": "もぉ……結局、私のおむすびは\nどこへ行ったのよー！"},
{"id": 60, "kind": "msg", "spk": "", "ja": "もう絶交だよ！　大っ嫌い！\nお兄ちゃんなんて知らない！"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "んん？　お前……。\n米粒が口についてるじゃねーか！"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "さては、すでに自分で\n食ってやがったな！？"},
{"id": 63, "kind": "msg", "spk": "アストレア", "ja": "え？　あれ？　そういえば\nそうだったっけ……。"},
{"id": 64, "kind": "msg", "spk": "アストレア", "ja": "あははは！　でも、お兄ちゃんと\n遊べて楽しかったよ！"}
]}
