{"file": "_Data/Script/Chara/Chapter00/31/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "いい天気だなー。"},
{"id": 1, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}チュン、チュンチュン。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "すずめが鳴いてら。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "（平和なもんだな……\n　服が飛んで行ってるなんて、\n　忘れちゃいそうだ）"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "（まさに俺の望んでいる平穏\n　そのものだな）"},
{"id": 5, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}チュン、チュンチュン。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "そうか……\n庭でひなたぼっこするのも\nいいかもな。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "海パンでひなたぼっこか……\n新しい発見があるかもな？"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "ひなたぼっこというか……\n日光浴だな。"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "ジリジリくるぜ……"},
{"id": 10, "kind": "msg", "spk": "", "ja": "　\n{1F}{11}ドン、ドタン！　ズシャ！"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "ん？　隣の家が騒がしいぞ？\nあれは……そはらか？"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "おーい、そはら、何やってんだ？"},
{"id": 13, "kind": "msg", "spk": "そはら", "ja": "あ、トモちゃん！\nおはよう！"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "おう、おはよ。\nなんかドタドタやってるけど、\nどうかしたのか？"},
{"id": 15, "kind": "msg", "spk": "そはら", "ja": "あ、うるさかった？\nごめんね。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "いや、ぜんぜん気にしないけど、\nどうかしたのかと思ってさ。"},
{"id": 17, "kind": "msg", "spk": "そはら", "ja": "庭で箪笥を干してたんだ。"},
{"id": 18, "kind": "msg", "spk": "そはら", "ja": "ほら、カードの効果で\n服が飛んでいっちゃったでしょ？"},
{"id": 19, "kind": "msg", "spk": "そはら", "ja": "だから、普段は服がいっぱいに入ってる\n箪笥が空っぽじゃない？"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "ああ、そうだな。"},
{"id": 21, "kind": "msg", "spk": "そはら", "ja": "普段はできないから、\n箪笥を水拭きして、\n日干ししようかと思って。"},
{"id": 22, "kind": "msg", "spk": "そはら", "ja": "今回のことで、服にも気持ちが\nあるんだなって、わかったしね。"},
{"id": 23, "kind": "msg", "spk": "そはら", "ja": "清潔な箪笥のほうが服たちも\n気持ちよくすごせるでしょ？"},
{"id": 24, "kind": "choice", "spk": "", "ja": "えらいな"},
{"id": 25, "kind": "choice", "spk": "", "ja": "気持ちよくか"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "そはらって、そういうとこ\n偉いな。よく気が回るよ。"},
{"id": 27, "kind": "msg", "spk": "そはら", "ja": "えっ？　そ、そうかな？"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "ああ、意外と家庭的だよな。"},
{"id": 29, "kind": "msg", "spk": "そはら", "ja": "意外と、は余計なんじゃないの、\nトモちゃん？"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "ははっ、そうだな。"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "ま、冗談はともかく、そういうとこ\n素直にえらいと思うよ。"},
{"id": 32, "kind": "msg", "spk": "そはら", "ja": "褒めたって何も出ないからね？\nあははは！"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "気持ちよくか……"},
{"id": 34, "kind": "msg", "spk": "そはら", "ja": "トモちゃん、なんか\n変なこと考えてない？"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "え？　いや、今日は考えてないぞ！？"},
{"id": 36, "kind": "msg", "spk": "そはら", "ja": "いつもは考えてるんだね……\nまぁ、わかってるけど。"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "いや、俺もやろうかなって思ってさ。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "箪笥の掃除なんか、\nしたことなかったしな。"},
{"id": 39, "kind": "msg", "spk": "そはら", "ja": "うん、やったほうがいいよ。"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "よし、やるか！"},
{"id": 41, "kind": "msg", "spk": "そはら", "ja": "ふふっ、服たちが、喜ぶといいね。"}
]}
