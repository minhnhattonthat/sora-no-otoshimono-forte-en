{"file": "_Data/Script/Chara/Chapter03/70/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "よーし、スイカ割りやろうぜ！"},
{"id": 1, "kind": "msg", "spk": "イカロス", "ja": "スイカ割りですか。"},
{"id": 2, "kind": "msg", "spk": "ニンフ", "ja": "そういえば、出かけるときに、\nそんなこと言ってたわね。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "海に来たからには、スイカ割りだよな！"},
{"id": 4, "kind": "msg", "spk": "イカロス", "ja": "………………\nスイカを……割るのですか？"},
{"id": 5, "kind": "msg", "spk": "イカロス", "ja": "……わかりました。\nマスターのご命令とあれば。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "あ、いや、俺は命令なんて\nしたつもりはないんだ！"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "ただ、イカロスもこういうのを\nやってみるのはどうかと思ってな。"},
{"id": 8, "kind": "msg", "spk": "イカロス", "ja": "私は……"},
{"id": 9, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}なでなで……"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "ふーむ。\nまぁ、スイカをなでるのが好きって\nことなら、無理に割ったりしないよ。"},
{"id": 11, "kind": "msg", "spk": "イカロス", "ja": "ありがとうございます……マスター。"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "でも、せっかく海に来たんだし、\nなにかやりたいなー。"},
{"id": 13, "kind": "msg", "spk": "美香子", "ja": "メロンなんて、どうかしら～？"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "わっ、会長！？\n……聞いてたんですか？"},
{"id": 15, "kind": "msg", "spk": "美香子", "ja": "スイカほど大きくないけど、\n似たような物だと思うのよ～。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "いや、ぜんぜん違うと思いますけど……"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "メロンって、棒で叩いたら、\n割れるんじゃなくて、\n潰れるんじゃないですか？"},
{"id": 18, "kind": "msg", "spk": "美香子", "ja": "どうかしら～？"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "（とはいえ、イカロスが嫌がってるし、\n　スイカでやるわけには\n　いかないしな……）"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "うーん、やってみないとわからないし、\nメロン割りにしてみるか。"},
{"id": 21, "kind": "msg", "spk": "美香子", "ja": "楽しみね～。"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "あとは、目隠しだな。\nエンジェロイドには意味がないって\n言ってたからさ。"},
{"id": 23, "kind": "msg", "spk": "ニンフ", "ja": "まぁ、視覚以外にも\n多くのセンサーがあるしね。"},
{"id": 24, "kind": "msg", "spk": "ニンフ", "ja": "私が目隠しの代わりにジャミングを\nかけるってのは、どう？"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "へー、そんなことできるんだ。"},
{"id": 26, "kind": "msg", "spk": "ニンフ", "ja": "試してみる？"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "そうだな。"},
{"id": 28, "kind": "msg", "spk": "ニンフ", "ja": "知覚、ジャミング{16}{15}"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "（………………ッ！？）"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "（うわ……何も見えない。\n　自分の声さえ聞こえない。\n　砂の感触も風も……）"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "（ここは、砂浜で、まわりには\n　イカロスやニンフや会長が\n　いたはず……）"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "（俺は、今、立ってるのか？\n　それすらもわからない！）"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "（……………………\n　……………………）"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "ぶはっ！？"},
{"id": 35, "kind": "msg", "spk": "ニンフ", "ja": "完璧な知覚遮断だったでしょ？"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "完璧すぎて危ないわ！"},
{"id": 37, "kind": "msg", "spk": "ニンフ", "ja": "そうなの？\nけっこう面倒なのね。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "何かないのか、エンジェロイドの\n便利なセンサーを使わない方法は！？"},
{"id": 39, "kind": "msg", "spk": "イカロス", "ja": "私は……\nマスターのご命令であれば……\nセンサーを使いません。"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "それもそうか。遊びなんだしな。\nじゃあ、ズルはナシってことで。"},
{"id": 41, "kind": "msg", "spk": "ニンフ", "ja": "トモキがそれでいいなら、\n私もいいけど。"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "よし、んじゃスイカ割り……じゃない、\nメロン割りをするか！"},
{"id": 43, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "あ、棒がねえや。"},
{"id": 45, "kind": "msg", "spk": "美香子", "ja": "会長もメロンを用意しておくわ～。\n今、手配したから、少し待ってて～。"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "そうっスか。\nじゃあ、用意できたらということで。"},
{"id": 47, "kind": "msg", "spk": "ニンフ", "ja": "そうね。楽しみにしてるわ。"}
]}
