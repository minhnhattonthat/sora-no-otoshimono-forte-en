{"file": "_Data/Script/Chara/Chapter01/72/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "イカロス", "ja": "マスター……何かご用でしょうか？"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "いや、ちょっと暇なんでな。\n雑談でもしないか？"},
{"id": 2, "kind": "msg", "spk": "イカロス", "ja": "はい……。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "まあ、そんなに長話をする気は\nないんだけどな。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "んー、なにか話題は……"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "ああ、そういや、俺が寝てるとき、\nイカロスは何やってるんだ？"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "お前たちは眠らないんだろ？"},
{"id": 7, "kind": "msg", "spk": "イカロス", "ja": "はい……エンジェロイドは眠りません。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "便利だよなー。\n本を読んだりゲームやったり。"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "いくらでも時間あるもんな！"},
{"id": 10, "kind": "msg", "spk": "イカロス", "ja": "はい……とても長いです。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "その間、何やってるのか\n気になっててさ。"},
{"id": 12, "kind": "msg", "spk": "イカロス", "ja": "私は、マスターを見ています。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "え？"},
{"id": 14, "kind": "msg", "spk": "イカロス", "ja": "ずっと、マスターを見ています。"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "俺が寝てる間、ずっとか？"},
{"id": 16, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "もうすこし、自分のために\n時間を使ったほうがいいぞ？"},
{"id": 18, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 19, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。\nわかりました。"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "本当にわかったのかなあ？"}
]}
