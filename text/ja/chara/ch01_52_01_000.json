{"file": "_Data/Script/Chara/Chapter01/52/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "（ん？　アストレアじゃないか。\n　花壇で何やってんだ？）"},
{"id": 1, "kind": "msg", "spk": "アストレア", "ja": "う～ん、どこだろう？"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "（なんだ、アストレアのやつ？\n　花壇のまわりをうろついて……？）"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "（あそこは、チューリップを植えた\n　あたりだな……\n　世話でもしてるのか？）"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "（いや、それだったら、\n　うろうろするのは変か……）"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "（あの辺には、何があったかな……？）"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "（アストレアの見てるのは……\n　新大陸発見部の花壇……か？）"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "（あそこは、守形先輩が\n　野菜を育ててる場所じゃないか！）"},
{"id": 8, "kind": "msg", "spk": "アストレア", "ja": "うーん、ないなぁ。"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "おい、アストレア！"},
{"id": 10, "kind": "msg", "spk": "アストレア", "ja": "ん？\nあ、センセイ、こんにちは！"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "（おっと、そうだった！\n　俺は先生だ！）"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "アストレア、新大陸発見部の\n野菜が欲しいのか？"},
{"id": 13, "kind": "msg", "spk": "アストレア", "ja": "野菜？\nそりゃ、野菜も好きですけど……"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "そんなにお腹が空いてるなら\n一緒にメシでもどうだ。"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "だから、人の畑のものを\n欲しがったりするんじゃないぞ？"},
{"id": 16, "kind": "msg", "spk": "アストレア", "ja": "ち、違いますよ！！"},
{"id": 17, "kind": "msg", "spk": "アストレア", "ja": "お腹は減ってますけど、\n野菜が欲しかったわけじゃないです。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "（野菜が欲しいわけじゃないと\n　言ってるけど、じゃあアストレアは\n　ここで何をしてたんだ？"},
{"id": 19, "kind": "choice", "spk": "", "ja": "恥ずかしがらなくてもいいぞ"},
{"id": 20, "kind": "choice", "spk": "", "ja": "本当は何やってんだ？"},
{"id": 21, "kind": "choice", "spk": "", "ja": "がんばれよ"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "恥ずかしがらなくてもいいぞ。\n本当は野菜が欲しいんだろ？\n隠さなくてもいいよ。"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "守形先輩なら、ちゃんと頼めば\nわけてくれると思うぞ。"},
{"id": 24, "kind": "msg", "spk": "アストレア", "ja": "もーっ！　だから誤解ですよ！！\n野菜が欲しいわけじゃないです！\nセンセイひどいですよ！"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "あ、いや……\nホントに違ったのか。"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "じゃあ、花壇で何をしてたんだ？"},
{"id": 27, "kind": "msg", "spk": "アストレア", "ja": "落し物のストラップを\n探していたんです。"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "ストラップって、\nあの携帯電話にぶら下げる？"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "おまえ、携帯なんか持ってたっけ？"},
{"id": 30, "kind": "msg", "spk": "アストレア", "ja": "クラスの子が、大切なストラップを\n落としてしまったらしくて。"},
{"id": 31, "kind": "msg", "spk": "アストレア", "ja": "この辺りで落としたらしいんですが、\n見当たらなくて……"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "そういうことか。"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "で、どんなストラップなんだ？"},
{"id": 34, "kind": "msg", "spk": "アストレア", "ja": "赤いやつです！"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "仕方ないな、困ってるんなら、\n手伝ってやるよ！"},
{"id": 36, "kind": "msg", "spk": "アストレア", "ja": "ありがとうございます、センセイ！"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "捜し物ってのは、うろうろしたって\n見つかるもんじゃないんだよ。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "アストレア、おまえ飛べるんだろ。\nすこしだけ浮くとか、できるか？"},
{"id": 39, "kind": "msg", "spk": "アストレア", "ja": "はい。"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "赤色のストラップなら目立つだろ。\nすこし浮いて、\n全体を見てみたらどうだ？"},
{"id": 41, "kind": "msg", "spk": "アストレア", "ja": "なるほど……やってみます！"},
{"id": 42, "kind": "msg", "spk": "アストレア", "ja": "急上昇！！"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "バカー！\nどんだけ高くまで飛ぶ気だー！"},
{"id": 44, "kind": "msg", "spk": "アストレア", "ja": "ハッ！　そうでした！"},
{"id": 45, "kind": "msg", "spk": "アストレア", "ja": "ちょっと浮くんでした！"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "おう！\n地面のストラップが見えるていどにな！"},
{"id": 47, "kind": "msg", "spk": "アストレア", "ja": "あっ、ありました！！\nこれです！"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "おお、よかったじゃないか。"},
{"id": 49, "kind": "msg", "spk": "アストレア", "ja": "はい！\nセンセイ、ありがとうございました！"},
{"id": 50, "kind": "msg", "spk": "アストレア", "ja": "クラスの子に渡してきます！"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "そこは、歩いて行けよ！！"},
{"id": 52, "kind": "msg", "spk": "", "ja": "　\n{1F}{13}ガッシャーーーン！！"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "あーあ、窓ガラス割りやがった。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "まぁ、でも、探してたものが\n見つかってよかった……よな？"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "本当は何やってんだ？"},
{"id": 56, "kind": "msg", "spk": "アストレア", "ja": "クラスの子が、大切なストラップを\n落としてしまったらしくて。"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "ストラップって、\nあの携帯電話にぶら下げる？"},
{"id": 58, "kind": "msg", "spk": "アストレア", "ja": "はい。\nこの辺りで落としたらしいんですが、\n見当たらなくて……"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "ふーん。\nストラップねえ……"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "花壇でストラップをなくす可能性……"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "そいつ、携帯電話で写真でも\n撮ってたんじゃないか？"},
{"id": 62, "kind": "msg", "spk": "アストレア", "ja": "あ、そういえば、\nいつも花の写真を撮ってました！"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "どの花だ？"},
{"id": 64, "kind": "msg", "spk": "アストレア", "ja": "黄色い花です！"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "だとすると……\nこのへんか？"},
{"id": 66, "kind": "msg", "spk": "智樹", "ja": "お、これじゃないのか？\n赤色のストラップ。"},
{"id": 67, "kind": "msg", "spk": "アストレア", "ja": "あ、それ！　それです！\nクラスの子が持ってたやつ！"},
{"id": 68, "kind": "msg", "spk": "アストレア", "ja": "やったー！"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "おう、早く持って行ってやりな。"},
{"id": 70, "kind": "msg", "spk": "アストレア", "ja": "はい！\nセンセイ、ありがとうございました！"},
{"id": 71, "kind": "msg", "spk": "智樹", "ja": "やれやれ、いいことした後は\n気分がいいな。"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "あー、まあ、なんだ……\nがんばれよ？"},
{"id": 73, "kind": "msg", "spk": "智樹", "ja": "（守形先輩なら、頼めば少しくらい\n　野菜をわけてくれるだろう）"},
{"id": 74, "kind": "msg", "spk": "アストレア", "ja": "え？　あ、はい！\nがんばります！"},
{"id": 75, "kind": "msg", "spk": "智樹", "ja": "うう……\nなんて不憫なやつ。"},
{"id": 76, "kind": "msg", "spk": "智樹", "ja": "いつでもメシを食いに来ていいからな？"},
{"id": 77, "kind": "msg", "spk": "アストレア", "ja": "センセイ、ご飯くれるんですか！？"},
{"id": 78, "kind": "msg", "spk": "智樹", "ja": "ああ、いつでも来い！"},
{"id": 79, "kind": "msg", "spk": "アストレア", "ja": "ありがとうございます！\nそれじゃ、そのうち行きますね！"},
{"id": 80, "kind": "msg", "spk": "智樹", "ja": "それじゃあ、またな！"},
{"id": 81, "kind": "msg", "spk": "アストレア", "ja": "あっ！　あった～！\nあんな所に落ちてたんだ～！"},
{"id": 82, "kind": "msg", "spk": "智樹", "ja": "（なんだ食べ物を探してた\n　わけじゃなくて\n　別に何か捜し物があったのか……）"}
]}
