{"file": "_Data/Script/Chara/Chapter02/31/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "あ、守形先輩、どうもっス。"},
{"id": 1, "kind": "msg", "spk": "守形", "ja": "智樹か。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "なにしてるんですか？"},
{"id": 3, "kind": "msg", "spk": "守形", "ja": "今は、これを調べているところだ。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "それ……\nもしかして、イカロスの\n量子変換器ですか？"},
{"id": 5, "kind": "msg", "spk": "守形", "ja": "そうだ。"},
{"id": 6, "kind": "msg", "spk": "守形", "ja": "シナプスの機器は、どれも人類の科学を\nはるかに超えるものばかりだ。"},
{"id": 7, "kind": "msg", "spk": "守形", "ja": "これを調べていけば、新大陸に\nつながるヒントを見つけられる\n可能性がある。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "……先輩、どれも人類の科学を\nはるかに超えるものばかりって、\n言いましたよね？"},
{"id": 9, "kind": "msg", "spk": "守形", "ja": "うむ。"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "それなのに、先輩には\n調べられるんですか？"},
{"id": 11, "kind": "msg", "spk": "守形", "ja": "人類の科学ではわからない。"},
{"id": 12, "kind": "msg", "spk": "守形", "ja": "だからこそ、調べる価値があるんだ。"},
{"id": 13, "kind": "msg", "spk": "守形", "ja": "智樹、人類の科学は万能か？"},
{"id": 14, "kind": "msg", "spk": "守形", "ja": "わかっていないことなど無数にある。"},
{"id": 15, "kind": "msg", "spk": "守形", "ja": "むしろ、わかっていることのほうが\n少ないくらいだ。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "はぁ……"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "いや……もう先輩の行動には、\nいちいちツッコミませんけどね。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "なにかわかったこと、\nあるんですか？"},
{"id": 19, "kind": "msg", "spk": "守形", "ja": "だいたいのところは理解できている。"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "マジで……！？\nもしかして、もう自由自在に\n扱えちゃったりします？"},
{"id": 21, "kind": "msg", "spk": "守形", "ja": "ある程度ならな。"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "スゲェ！！"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "そいつがあればまた風呂とか更衣室とか\n覗き放題じゃないですか！！"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "みなぎってきたー！！"},
{"id": 25, "kind": "msg", "spk": "守形", "ja": "智樹……？"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "おおおぉぉ……見える……\n見えるぜ……\n美女たちの姿が……"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "揺れるおっぱい！\nお尻！　太もも！\n全裸全裸全裸！"},
{"id": 28, "kind": "msg", "spk": "守形", "ja": "智樹。"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "むひょひょひょー、イケませんなー、\nそんなけしからんおっぱいを……\nたまらーん！"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "そこはらめぇ～。\n大胆すぎるのぉ～。\nイヤンッ！　ばかンッ！　うっふん！"},
{"id": 31, "kind": "msg", "spk": "守形", "ja": "智樹、聞いてるか？"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "守形先輩！\n空美町のあらゆる覗きスポット、\nチェックしてありますよ！"},
{"id": 33, "kind": "msg", "spk": "守形", "ja": "それは興味ない。"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "はい？"},
{"id": 35, "kind": "msg", "spk": "守形", "ja": "ひと通り使い方を調べたから、\n実験してみるつもりだ。"},
{"id": 36, "kind": "msg", "spk": "守形", "ja": "新大陸発見部の部員として、\n協力してくれるな？"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "うっ……"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "（実験ってとこに、\n　嫌な響きがあるけど……）"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "任せてください！"},
{"id": 40, "kind": "msg", "spk": "守形", "ja": "智樹……\nおまえってやつは……\n部員の鏡だな。"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "先輩……俺、女子の裸パラダイスの\nためなら、なんだってしますよ！"},
{"id": 42, "kind": "msg", "spk": "守形", "ja": "そうか……。"},
{"id": 43, "kind": "msg", "spk": "守形", "ja": "生きて、戻れないかもしれんぞ？"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "覚悟の上です！"},
{"id": 45, "kind": "msg", "spk": "守形", "ja": "よし。\nまずは、お前を変換しようと思うのだが\n希望はあるか？"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "そうですね……\n俺が変身するとしたら……"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "あっ、そうだ。\n俺を女の子にしてくださいよ。"},
{"id": 48, "kind": "msg", "spk": "守形", "ja": "女の子か。"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "はい！\nあれから、さらに練習した俺の\n『女らしさ』を確かめてください！"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "かなり練習しましたから、\nもうばっちりですよ！"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "女子更衣室だろうが、\n女子トイレだろうが、\n自然に入れます！"},
{"id": 52, "kind": "msg", "spk": "守形", "ja": "…………そうか。"},
{"id": 53, "kind": "msg", "spk": "守形", "ja": "では早速、実験してみよう。\n智樹、じっとしていろよ。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "はい！"},
{"id": 55, "kind": "msg", "spk": "守形", "ja": "量子変換器、起動。"},
{"id": 56, "kind": "msg", "spk": "トモ子", "ja": "トモ子で～す！　どうですか？\nちゃんと変身できてます？"},
{"id": 57, "kind": "msg", "spk": "守形", "ja": "うむ。\nしかし、冬服になってしまったな。\n設定したつもりはなかったが……？"},
{"id": 58, "kind": "msg", "spk": "トモ子", "ja": "そのくらい平気ですよ。\nじゃあ、ちゃんと女の子らしいか。\n見ててくださいね☆"},
{"id": 59, "kind": "msg", "spk": "守形", "ja": "ふむ。\nしかし、量子変換器の実験に、\nその必要はないのでは……"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "はぁ……はぁ……。\nどうですか、守形先輩。\nばっちり女の子でしたか！？"},
{"id": 61, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}シーーーン"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "あれ？　先輩？"},
{"id": 63, "kind": "msg", "spk": "美香子", "ja": "守形くんなら、さっき山へと入って\nいったわよ～？"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "会長！？\nど、どうしているんですか！？"},
{"id": 65, "kind": "msg", "spk": "美香子", "ja": "前を通りがかったら、\n変な声が聞こえるんですもの～。"},
{"id": 66, "kind": "msg", "spk": "美香子", "ja": "そうしたら、見てみるのが当然だわ～。"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "そ、それじゃ……\nもしかして、ずっと見てたんですか！？"},
{"id": 68, "kind": "msg", "spk": "美香子", "ja": "安心していいわ～。\nちゃんと女の子だったわよ～。"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "う、うわぁぁぁ～～～！"}
]}
