{"file": "_Data/Script/Chara/Chapter00/12/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ニンフ、なに見てんだ？"},
{"id": 1, "kind": "msg", "spk": "ニンフ", "ja": "昼ドラ。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "ニンフって、ほんとに\nそれが好きだよな。"},
{"id": 3, "kind": "msg", "spk": "ニンフ", "ja": "おもしろいわよ、昼ドラ。\nずっとやってればいいのに。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "ふーん、俺にはよくわからないけど……"},
{"id": 5, "kind": "msg", "spk": "ニンフ", "ja": "理屈はどうでもいいのよ。\n昼ドラを見ながら、お菓子を食べるのが\n楽しみなんだから……あ。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "どうした？"},
{"id": 7, "kind": "msg", "spk": "ニンフ", "ja": "……ない。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "ないって、何が？"},
{"id": 9, "kind": "msg", "spk": "ニンフ", "ja": "お菓子が、なくなっちゃった。"},
{"id": 10, "kind": "msg", "spk": "ニンフ", "ja": "どうするのよ、トモキ！？\n私の楽しみが\nなくなっちゃったじゃない！"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "俺に聞かれても困るよ。\n買ってくればいいだろ？"},
{"id": 12, "kind": "msg", "spk": "ニンフ", "ja": "あーっ、我慢できない！\n自分で買ってくるわよ！"},
{"id": 13, "kind": "msg", "spk": "ニンフ", "ja": "駄菓子屋さんもスーパーも\n閉まってた！！"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "そりゃそうか……"},
{"id": 15, "kind": "msg", "spk": "ニンフ", "ja": "トモキのせいよ！\nなんとかしなさいよね！"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "そんなこと言われてもなー。"},
{"id": 17, "kind": "choice", "spk": "", "ja": "それどころじゃない"},
{"id": 18, "kind": "choice", "spk": "", "ja": "実は買ってある"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "それどころじゃないって。"},
{"id": 20, "kind": "msg", "spk": "ニンフ", "ja": "お菓子よりも重要なことが\nあるっていうの？"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "いっぱいあるだろ！"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "お菓子のことよりも、\n例えば、洗剤がないほうが重要だよ！"},
{"id": 23, "kind": "msg", "spk": "ニンフ", "ja": "洗剤ってそんなに重要なの？"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "そりゃ、重要だろ！"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "洗濯物とか、汚れが落ちないんだぞ！？"},
{"id": 26, "kind": "msg", "spk": "ニンフ", "ja": "それもそうよね。\n困ってるなら、出してあげるわよ。"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "なに？"},
{"id": 28, "kind": "msg", "spk": "ニンフ", "ja": "洗濯用のでいいのよね？\nちょっと待っててくれる。"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "お、おう、出してくれ！"},
{"id": 30, "kind": "msg", "spk": "ニンフ", "ja": "わかったわ。\nえーっと……このカードよね。"},
{"id": 31, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ポンッ！"},
{"id": 32, "kind": "msg", "spk": "ニンフ", "ja": "はい、洗濯用の洗剤。"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "うおー、ありがとな、ニンフ！\nすげえ助かるぜ！"},
{"id": 34, "kind": "msg", "spk": "ニンフ", "ja": "えへへ……\nどういたしまして。"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "あれ？\nそのカードでお菓子も出せば\nいいんじゃないか？"},
{"id": 36, "kind": "msg", "spk": "ニンフ", "ja": "……旧型カードは\nたいてい使い捨てなのよ。それに\n決められた一つの能力しかないの。"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "じゃあ、\nお菓子を出すカードなんてものは、\nもうとっくに使っちまったんだろ？"},
{"id": 38, "kind": "msg", "spk": "ニンフ", "ja": "しょうがないじゃない！\nその時は食べたかったんだから！！"},
{"id": 39, "kind": "msg", "spk": "ニンフ", "ja": "あーぁ、結局お菓子どうしようかしら。"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "（実は買ってあったりして！）"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "ふっふっふっふっふっ……"},
{"id": 42, "kind": "msg", "spk": "ニンフ", "ja": "な、なに？"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "おや、頭が高いんじゃないか、ニンフ？"},
{"id": 44, "kind": "msg", "spk": "ニンフ", "ja": "はぁ？\nまた頭がどうかしたの、トモキ？"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "これを見ても、そんな口がきけるかな？\nそりゃ！"},
{"id": 46, "kind": "msg", "spk": "ニンフ", "ja": "あっ、お菓子じゃない！\nどうしてあるの！？"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "こんなこともあろうかと、\n買っておいたんだ！"},
{"id": 48, "kind": "msg", "spk": "ニンフ", "ja": "やるじゃないの、トモキ！"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "まぁ、予想して買っておいた\nなんてのは冗談だけどな。"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "前に、ニンフにやろうと思って\n買ったんだ。"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "でも、おまえ、いつもお菓子\n食べてるからさ。"},
{"id": 52, "kind": "msg", "spk": "ニンフ", "ja": "そ、そんなに食べてばかりじゃ\nないと思うけど……"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "まぁ、役に立ってよかったよ。"},
{"id": 54, "kind": "msg", "spk": "ニンフ", "ja": "う、うん……"},
{"id": 55, "kind": "msg", "spk": "ニンフ", "ja": "まぁ、そんなに好みのお菓子じゃ\nないけど……\nしょうがないからもらっとくわ。"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "おう！"},
{"id": 57, "kind": "msg", "spk": "ニンフ", "ja": "トモキ！"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "ん？"},
{"id": 59, "kind": "msg", "spk": "ニンフ", "ja": "えっと……\nありがとね。"}
]}
