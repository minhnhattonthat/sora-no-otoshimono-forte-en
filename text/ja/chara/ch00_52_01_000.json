{"file": "_Data/Script/Chara/Chapter00/52/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "守形", "ja": "人類は、あらゆる困難を打開してきた！"},
{"id": 1, "kind": "msg", "spk": "守形", "ja": "多くの伝染病の根絶、\n安全な住居の確保、\n食料の保存……"},
{"id": 2, "kind": "msg", "spk": "守形", "ja": "人類は宇宙にさえも進出した。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "はぁ……"},
{"id": 4, "kind": "msg", "spk": "守形", "ja": "そして、今、ここに、\n新たなる困難が存在している！"},
{"id": 5, "kind": "msg", "spk": "守形", "ja": "服が意志を持って\n飛んでいってしまう、\nという現象だ！！"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "……そうっスね。"},
{"id": 7, "kind": "msg", "spk": "守形", "ja": "想定していたよりも長期間、\nこの現象は継続している！"},
{"id": 8, "kind": "msg", "spk": "守形", "ja": "人類は解明せねばならない、\n困難の正体を！！"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "は、はあ……"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "それは、俺が連れてこられたのと\n関係あるんスか？"},
{"id": 11, "kind": "msg", "spk": "守形", "ja": "うむ。"},
{"id": 12, "kind": "msg", "spk": "守形", "ja": "服が飛んでいってしまう\nというカードの効果を調べるのに\n協力してもらおうと思ってな。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "はぁ……"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "でも、俺、詳しいことは\n何も聞いてませんよ？"},
{"id": 15, "kind": "msg", "spk": "守形", "ja": "知識を期待しているわけではないから\n安心しろ。"},
{"id": 16, "kind": "msg", "spk": "守形", "ja": "今から、おまえに服を着せる。"},
{"id": 17, "kind": "msg", "spk": "守形", "ja": "本当に服が着られないのか？\n着られないとすれば、\nどこからが服なのか？"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "どこからが？"},
{"id": 19, "kind": "msg", "spk": "守形", "ja": "まずは、この葉っぱを\n身につけてみろ！"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "ああ……そういうことですか……"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "まぁ、いいですけどね。\nんじゃ、ぺたん、と。"},
{"id": 22, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}バサバサバサバサバサ！"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "うわっぷ！？"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "先輩……葉っぱ、\n飛んでいっちゃいましたよ。"},
{"id": 25, "kind": "msg", "spk": "守形", "ja": "そうだな。\nどうやら、自分を\n服だと認識したようだ。"},
{"id": 26, "kind": "msg", "spk": "守形", "ja": "そうなると、木の肌も同じか。\n平たい石はどうだ？"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "装着！"},
{"id": 28, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}ヒューーン！！"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "うわわっ！？"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "ダメでした、守形先輩！"},
{"id": 31, "kind": "msg", "spk": "守形", "ja": "意外と効果が広いな。\n葉っぱどころか、石まで\n服として認識するとは。"},
{"id": 32, "kind": "msg", "spk": "守形", "ja": "次は何を試すか……？\n智樹、何か案は無いか？"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "そうですね……"},
{"id": 34, "kind": "choice", "spk": "", "ja": "地球を服にするぜ！"},
{"id": 35, "kind": "choice", "spk": "", "ja": "俺を着てください！"},
{"id": 36, "kind": "choice", "spk": "", "ja": "ボディペイントは？"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "地球を服にするっていう考えは、\nどうですか？\n地面に穴をほって、埋まるんです。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "そうすれば、服ってことに\nなるんじゃないでしょうか？"},
{"id": 39, "kind": "msg", "spk": "守形", "ja": "そうだな……試してみるか。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}ガッ！　ガッ！"},
{"id": 41, "kind": "msg", "spk": "守形", "ja": "ふむ、人ひとりぶん……\nこんなものだろう。"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "この穴に入れば、\n地球を服にしたことになるぜ！"},
{"id": 43, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}すぽーん！"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "成功ですよ、守形先輩！！\n飛んでいきません！！"},
{"id": 45, "kind": "msg", "spk": "守形", "ja": "いや……失敗だ。"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "な、なんでですか！？"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "俺の裸は見えてない！\n実験は成功ですよ！？"},
{"id": 48, "kind": "msg", "spk": "守形", "ja": "穴に入っていては、\n自由に出歩けないからな。"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "しまったーーーーー！！"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "先輩、俺を着てください！！"},
{"id": 51, "kind": "msg", "spk": "守形", "ja": "……なにを言っている？"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "人間が椅子をやる人間椅子って\nあるじゃないですか。"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "人間が文字の形を真似る\n人文字ってあるじゃないですか。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "それなら、人間が服になって、\n人間服になっても、いいんじゃ\nないかと思うんですよ！！"},
{"id": 55, "kind": "msg", "spk": "守形", "ja": "なるほど……"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "いきますよ、先輩！！"},
{"id": 57, "kind": "msg", "spk": "守形", "ja": "こい……智樹！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ガシッ！"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "ど、どうですか、先輩。"},
{"id": 60, "kind": "msg", "spk": "守形", "ja": "……抱きつかれているような感じだな。"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "そうですね。俺も、そう思います。"},
{"id": 62, "kind": "msg", "spk": "守形", "ja": "俺は、歩行に問題ないが……\n服としては、やや重たいかもしれんな。"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "な、なるほど。"},
{"id": 64, "kind": "msg", "spk": "守形", "ja": "だが、飛んでいかない。"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "はい！　俺、飛んでいきません！"},
{"id": 66, "kind": "msg", "spk": "守形", "ja": "体が隠せて、飛んでも行かない。\n動き回ることが不可能でもない。\nこれは……"},
{"id": 67, "kind": "msg", "spk": "そはら", "ja": "トモちゃーん、守形先輩！"},
{"id": 68, "kind": "msg", "spk": "ニンフ", "ja": "トモキー、お弁当、持ってき……\nき……！？"},
{"id": 69, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 70, "kind": "msg", "spk": "ニンフ", "ja": "きゃああああぁぁぁ～～～！？"},
{"id": 71, "kind": "msg", "spk": "そはら", "ja": "なにやってるの、トモちゃん！？"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "え？　ちが……\nこれは人間服の実験でだな！！"},
{"id": 73, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 74, "kind": "msg", "spk": "守形", "ja": "ふむ……\n実用上には、問題アリ、か。"},
{"id": 75, "kind": "msg", "spk": "智樹", "ja": "体に描いたら、どうですかね？"},
{"id": 76, "kind": "msg", "spk": "守形", "ja": "なに！？"},
{"id": 77, "kind": "msg", "spk": "智樹", "ja": "服を素肌のうえに描く、\nボディペイントですよ！！"},
{"id": 78, "kind": "msg", "spk": "守形", "ja": "智樹、本当にそれが\n服の代わりになると思ってるのか！？"},
{"id": 79, "kind": "msg", "spk": "智樹", "ja": "あ、いや……"},
{"id": 80, "kind": "msg", "spk": "守形", "ja": "よし、すぐに実験しよう。\n安心しろ、俺は絵も描ける。"},
{"id": 81, "kind": "msg", "spk": "智樹", "ja": "す、すみません。\nやっぱり、いいです。"},
{"id": 82, "kind": "msg", "spk": "守形", "ja": "臆するな。\n失敗のないところに成功はない！"},
{"id": 83, "kind": "msg", "spk": "智樹", "ja": "ちょっ、先輩、待って……"},
{"id": 84, "kind": "msg", "spk": "守形", "ja": "さあ、体に服を描くぞ。"},
{"id": 85, "kind": "msg", "spk": "智樹", "ja": "ひゃあああぁぁぁ～～～！\nくすぐったい～～～！"},
{"id": 86, "kind": "msg", "spk": "守形", "ja": "智樹、そんなに暴れると描けないぞ。"},
{"id": 87, "kind": "msg", "spk": "智樹", "ja": "（これはダメだ！全身描かれるまで、\nくすぐったくて耐えられないっ！）"}
]}
