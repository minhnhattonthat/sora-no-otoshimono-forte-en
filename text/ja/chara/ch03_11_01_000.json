{"file": "_Data/Script/Chara/Chapter03/11/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "ニンフ", "ja": "ん～、ふんふ～♪"},
{"id": 1, "kind": "msg", "spk": "", "ja": "　\n{1F}{13}さくりっ、さくりっ。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "ん？　ニンフ、なにやってんだ、\n砂山なんかいじくって。"},
{"id": 3, "kind": "msg", "spk": "ニンフ", "ja": "ふふん。\nこの集めた砂でお城を作るのよ。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "砂の城？\n妙なこと知ってるな～？"},
{"id": 5, "kind": "msg", "spk": "ニンフ", "ja": "昼ドラでそんなシーンが\nあったのよね。"},
{"id": 6, "kind": "msg", "spk": "ニンフ", "ja": "愛し合う男女が２人で仲良く\n砂のお城を作っていく……"},
{"id": 7, "kind": "msg", "spk": "ニンフ", "ja": "いい雰囲気になるのよね～。\nそういうのってちょっとイイかも。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "そんなもんか……？\n要はただの砂遊びだろ？"},
{"id": 9, "kind": "msg", "spk": "ニンフ", "ja": "いいの！　ただの砂遊びでも。\nドラマでは、すごく細かくて\n素敵なお城だったの！"},
{"id": 10, "kind": "msg", "spk": "ニンフ", "ja": "私も、そんなのを\n作ろうと思ってるのよ。"},
{"id": 11, "kind": "msg", "spk": "", "ja": "　\n{1F}{13}さくりっ、さくりっ。"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "（小さい手で、\n　がんばって作ってるなぁ……）"},
{"id": 13, "kind": "msg", "spk": "ニンフ", "ja": "ね、ねえ、トモキ。\nどうせ見てるなら、一緒に作らない？"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "え？　俺も作るのか？"},
{"id": 15, "kind": "msg", "spk": "ニンフ", "ja": "まぁ……見てるだけなんて、\n暇だろうなって思ったから。"},
{"id": 16, "kind": "msg", "spk": "ニンフ", "ja": "や、やりたくないって言うなら、\nかまわないけど……"},
{"id": 17, "kind": "msg", "spk": "ニンフ", "ja": "昼ドラでは２人で一緒に作ってたから、\nそのほうが雰囲気が出るかと思って……"},
{"id": 18, "kind": "msg", "spk": "ニンフ", "ja": "そ、それに２人で作った方が、\n早く出来るでしょっ！"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "（砂のお城か……どうしようかな？）"},
{"id": 20, "kind": "choice", "spk": "", "ja": "もっと凄いの作るぜ！"},
{"id": 21, "kind": "choice", "spk": "", "ja": "一緒に作る"},
{"id": 22, "kind": "choice", "spk": "", "ja": "見守る"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "わかった。俺も作るぜ……\nニンフの城の隣にもっと凄いやつをな！"},
{"id": 24, "kind": "msg", "spk": "ニンフ", "ja": "え？"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "見てろよ！\nそっちよりでかい城を作るからな！"},
{"id": 26, "kind": "msg", "spk": "ニンフ", "ja": "ちょ、ちょっと！\n２人で作るって、\nそういう意味じゃないんだけど……"},
{"id": 27, "kind": "msg", "spk": "ニンフ", "ja": "どうして、\nわざわざ別の城を作るのよ！？"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "そこに砂があるからだ！\nじゃあ早速はじめるぞ！\nおりゃあああー！"},
{"id": 29, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}どしゃっ、どしゃしゃっ"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "まずは砂を集めまくるぜ！"},
{"id": 31, "kind": "msg", "spk": "ニンフ", "ja": "ちょっと！\n私の陣地に侵入してこないでよ！"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "弱肉強食じゃー！\nほっ！　とりゃ！\nだんだんできてきたぞ！"},
{"id": 33, "kind": "msg", "spk": "ニンフ", "ja": "なによそれ、城って言うより\n砂を高く積んだだけじゃないの？"},
{"id": 34, "kind": "msg", "spk": "ニンフ", "ja": "っていうか積みすぎよ。\nトモキの身長を超えてるじゃない。"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "こんなもん大きけりゃいいんだよ！\n大きけりゃ！"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "名づけて、砂浜に屹立して\n海の平和を守る\nＴＯＭＯ☆ＫＩ灯台だぜ！"},
{"id": 37, "kind": "msg", "spk": "ニンフ", "ja": "ダサい……"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "よーし。いい感じの高さに\nなってきたぞ！　このまま\n積めるところまで積んでやる！"},
{"id": 39, "kind": "msg", "spk": "", "ja": "　\n{1F}{15}びゅううううーっ"},
{"id": 40, "kind": "msg", "spk": "ニンフ", "ja": "あ、風が……"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "げっ……お、俺の\nＴＯＭＯ☆ＫＩ灯台が……\n倒れ……！"},
{"id": 42, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ぐしゃっ"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "うぎゃー！"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "お、重い！　動けねえ！\n高く積みすぎたか！？"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "た、助けてくれ！　ニンフ！"},
{"id": 46, "kind": "msg", "spk": "ニンフ", "ja": "なによ、なんなのよこれ……\n全然いい雰囲気になんか\nならないじゃない……"},
{"id": 47, "kind": "msg", "spk": "ニンフ", "ja": "私はただ、昼ドラみたいに\nトモキと一緒に\nお城を作りたかっただけなのに……"},
{"id": 48, "kind": "msg", "spk": "ニンフ", "ja": "もう台無しよー！　トモキのバカ！\n砂に埋まって反省しなさい！"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "オ、オヤオヤ～？"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "マジか。行っちまった……。\nだ、誰かー！"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "いいぜ、手伝ってやるよ。\nどうせ暇だしな。"},
{"id": 52, "kind": "msg", "spk": "ニンフ", "ja": "え？　いいの！？"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "なんだよ、ニンフのほうから\n誘ったんだろ？"},
{"id": 54, "kind": "msg", "spk": "ニンフ", "ja": "う、うん。\n……えへへ。"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "よーし、やるぞ！"},
{"id": 56, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}どしゃっ！　どしゃっ！"},
{"id": 57, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}さくり、さくり"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "なんか、ちょっと形にしただけでも\nそれっぽく見えてきたな。\nよーし、玄関はここにしようぜ！"},
{"id": 59, "kind": "msg", "spk": "ニンフ", "ja": "正門ね。\n塔は３つくらいつけましょう。"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "塔には窓とか付けてみるか。"},
{"id": 61, "kind": "msg", "spk": "ニンフ", "ja": "あら、素敵ね。\nちょっと位置がおかしいけど……"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "トイレはここだ！"},
{"id": 63, "kind": "msg", "spk": "ニンフ", "ja": "そんなことは決めなくていいのよ！"},
{"id": 64, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}さくり、さくり"},
{"id": 65, "kind": "msg", "spk": "ニンフ", "ja": "お姫様の部屋はここね！"},
{"id": 66, "kind": "msg", "spk": "智樹", "ja": "ニンフだって決めてるじゃんか！"},
{"id": 67, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}さくり、さくり"},
{"id": 68, "kind": "msg", "spk": "智樹", "ja": "完成だ！"},
{"id": 69, "kind": "msg", "spk": "ニンフ", "ja": "うーん。こんなものかしら。\n……でも、あんまりいい雰囲気には\nならなかったわね……"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "ん？　何か言ったか？"},
{"id": 71, "kind": "msg", "spk": "ニンフ", "ja": "な、なんでもないわよ。"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "あー、随分手が汚れちまったな。\nニンフもちょっと手を見せてみろよ。"},
{"id": 73, "kind": "msg", "spk": "", "ja": "　\n{1F}{1A}ぎゅっ"},
{"id": 74, "kind": "msg", "spk": "ニンフ", "ja": "あ……。"},
{"id": 75, "kind": "msg", "spk": "智樹", "ja": "ニンフの手も汚れちまったな。\n俺とお揃いだ！　ははっ。"},
{"id": 76, "kind": "msg", "spk": "ニンフ", "ja": "……そうね。お揃いね。"},
{"id": 77, "kind": "msg", "spk": "ニンフ", "ja": "ねえ、トモキ。\n……昼ドラのとは、ちょっと\n違っちゃったけど……"},
{"id": 78, "kind": "msg", "spk": "ニンフ", "ja": "砂のお城、作るの\nとっても楽しかったわよ。"},
{"id": 79, "kind": "msg", "spk": "智樹", "ja": "いや、俺は見てるよ。"},
{"id": 80, "kind": "msg", "spk": "ニンフ", "ja": "そう……"},
{"id": 81, "kind": "msg", "spk": "ニンフ", "ja": "よっと。んしょ……\nこんな感じ、かしら？"},
{"id": 82, "kind": "msg", "spk": "ニンフ", "ja": "ここをこうして……\n穴を、あけて……"},
{"id": 83, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}さくり、さくり"},
{"id": 84, "kind": "msg", "spk": "ニンフ", "ja": "トモキは、見てるだけで楽しいの？"},
{"id": 85, "kind": "msg", "spk": "智樹", "ja": "え？　ああ、そうだな。"},
{"id": 86, "kind": "msg", "spk": "智樹", "ja": "（砂だから崩れちゃうかと\n　思ってたけど……）"},
{"id": 87, "kind": "msg", "spk": "智樹", "ja": "（みるみる城の形になってくから、\n　思わず見とれちまったよ）"},
{"id": 88, "kind": "msg", "spk": "智樹", "ja": "いや、見ててなかなか楽しいよ。\n器用なんだな、ニンフって。"},
{"id": 89, "kind": "msg", "spk": "ニンフ", "ja": "えっ！？\nど、どうせ、冗談とかでしょ？"},
{"id": 90, "kind": "msg", "spk": "智樹", "ja": "こんなこと、冗談で言っても\nしょうがないだろ。\nべつに信じなくてもいいけどさ。"},
{"id": 91, "kind": "msg", "spk": "ニンフ", "ja": "本当に良いと思う？\n素晴らしい？　感動した！？"},
{"id": 92, "kind": "msg", "spk": "智樹", "ja": "そこまでは言ってないだろ！\n俺は、悪くないって言っただけでだな！"},
{"id": 93, "kind": "msg", "spk": "ニンフ", "ja": "えへへ……そっか。\n悪くないか……"},
{"id": 94, "kind": "msg", "spk": "ニンフ", "ja": "えーっと、やっぱり、ここは\nこだわってアーチを……"},
{"id": 95, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ぐら……"},
{"id": 96, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ぐしゃり"},
{"id": 97, "kind": "msg", "spk": "ニンフ", "ja": "あ……"},
{"id": 98, "kind": "msg", "spk": "智樹", "ja": "崩れた！？"},
{"id": 99, "kind": "msg", "spk": "ニンフ", "ja": "……崩れちゃった……。"},
{"id": 100, "kind": "msg", "spk": "ニンフ", "ja": "……せっかくトモキと\nいい雰囲気になっていたのに……。"},
{"id": 101, "kind": "msg", "spk": "ニンフ", "ja": "（キッ！）"},
{"id": 102, "kind": "msg", "spk": "智樹", "ja": "な、何でにらむんだよ。"},
{"id": 103, "kind": "msg", "spk": "智樹", "ja": "……行っちまった。\n喜んだり怒ったり忙しい奴だなぁ……。"}
]}
