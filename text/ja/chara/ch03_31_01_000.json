{"file": "_Data/Script/Chara/Chapter03/31/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "", "ja": "　\n{1F}{13}ジュー……ジュー……"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "お、いい感じに焼けてきてるぞ。\nうーん、食欲をそそる匂いだぜ！"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "しっかし、さすがに会長が\n調達してきただけあって\nいい肉ばっかりだなー。"},
{"id": 3, "kind": "msg", "spk": "そはら", "ja": "牛の色々な部位のお肉が\nあるんだね。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "ああ、よりどりみどりだぜ。"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "ほら、食えよそはら。\nタレもたっぷりかかってて\nおいしいぞ！"},
{"id": 6, "kind": "msg", "spk": "そはら", "ja": "ありがとう！　あ、トモちゃんの分は\n私が焼いてあげるね。\nトモちゃんはどこのお肉がいい？"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "む、そうだな……。"},
{"id": 8, "kind": "choice", "spk": "", "ja": "貴重なヒレだな"},
{"id": 9, "kind": "choice", "spk": "", "ja": "霜降りサーロインかな"},
{"id": 10, "kind": "choice", "spk": "", "ja": "おっぱい！"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "断然ヒレだな。なんてったって\n１頭の牛から少ししか取れないんだぞ。"},
{"id": 12, "kind": "msg", "spk": "そはら", "ja": "ヒレだね。分かったよ、トモちゃん。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "脂肪が少ないけど柔らかくて\nうまいんだコレが。おっと、\nあまり焼きすぎないようにな！"},
{"id": 14, "kind": "msg", "spk": "", "ja": "　\n{1F}{13}ジュー……ジュー……"},
{"id": 15, "kind": "msg", "spk": "そはら", "ja": "確かにおいしそうだね。\nはい、召し上がれ。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "サンキューそはら。\nはぐ、はぐ、うめー！"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "うん、やっぱりヒレにして\n正解だったな。"},
{"id": 18, "kind": "msg", "spk": "そはら", "ja": "…………"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "ん？　どうしたそはら。\nじっと見て。"},
{"id": 20, "kind": "msg", "spk": "そはら", "ja": "あ、ううん。\nおいしそうだなーって。"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "なんだ、欲しいのか？\nだったら一口ならやるよ。\nほら、あーん。"},
{"id": 22, "kind": "msg", "spk": "そはら", "ja": "え！　そ、それって……\nと、トモちゃん……"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "どうしたんだよ、いらないのか？\nだったら全部食っちまうぞ。"},
{"id": 24, "kind": "msg", "spk": "そはら", "ja": "ま、待ってトモちゃん！\n食べる、食べるから！"},
{"id": 25, "kind": "msg", "spk": "そはら", "ja": "スー、ハー、スー、ハー……"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "（な、なんでいちいち\n　深呼吸するんだよ？）"},
{"id": 27, "kind": "msg", "spk": "そはら", "ja": "はむっ、もぐもぐ。"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "どうだ、うまいだろ！"},
{"id": 29, "kind": "msg", "spk": "そはら", "ja": "う、うん。\nおいしいよ、トモちゃん"},
{"id": 30, "kind": "msg", "spk": "そはら", "ja": "（どきどきしちゃって、\n　味なんて分かんなかったよ、\n　トモちゃん……）"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "やっぱり、肉と言ったら\nサーロインだな！"},
{"id": 32, "kind": "msg", "spk": "そはら", "ja": "おいしーよねー、サーロイン！\n私も焼いちゃお！"},
{"id": 33, "kind": "msg", "spk": "", "ja": "　\n{1F}{13}ジュー……ジュー……"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "おう！　人間で言うなら\nちょうど腰まわりの部分だな。\n腰まわり……"},
{"id": 35, "kind": "msg", "spk": "そはら", "ja": "はむはむ、もぐもぐ。\nおいしー！　もう一個\n食べちゃおっと！"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "……おい、そはら。"},
{"id": 37, "kind": "msg", "spk": "そはら", "ja": "んー、幸せ！"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "……お前、またウェストが\n大きくなったんじゃないのか？"},
{"id": 39, "kind": "msg", "spk": "そはら", "ja": "（ギク！）"},
{"id": 40, "kind": "msg", "spk": "そはら", "ja": "……や、やだなぁトモちゃん。\nいきなり、変なこと言うから\nお箸落としちゃったよ。"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "ふふん、俺の目はごまかせんぞ。\n海に来る前の夜よりも明らかに\n増量しているじゃないか！"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "いかん！　いかんぞー、そはら。"},
{"id": 43, "kind": "msg", "spk": "そはら", "ja": "…………"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "胸が増量するのは構わん。ウェストも、\nちょっとふくよかなくらいなら、\nむしろ大歓迎だ！"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "しかし！　これ以上お前の\nサーロインが増量するのはダメだ！\n霜降りにも限度がある！"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "というわけで、お前のウェストの\n未来のために、この肉は\n俺が食ってやろう！"},
{"id": 47, "kind": "msg", "spk": "そはら", "ja": "…………"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "もぐもぐ。\nうひょー、うめー！"},
{"id": 49, "kind": "msg", "spk": "そはら", "ja": "トモちゃん……"},
{"id": 50, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}メキッ！"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "はぶっ！"},
{"id": 52, "kind": "msg", "spk": "そはら", "ja": "トモちゃんのデリカシーの無さは\nいまさら言うことじゃないけどさ……"},
{"id": 53, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}バキッ！"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "へぶっ！"},
{"id": 55, "kind": "msg", "spk": "そはら", "ja": "今回は、ちょっと……\n酷すぎるんじゃないかなぁ……"},
{"id": 56, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}グッシャアッ！"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "おぶっ！"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "待て、そはら！\nお、俺が悪かった！\n許し……"},
{"id": 59, "kind": "msg", "spk": "そはら", "ja": "私、トモちゃんを解体するね。"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "うわあああああーーーー！！"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "さすがにもうダメだと思いましたが\nなんとか解体はまぬがれました。\n俺は生きています。"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "おっぱいだ！"},
{"id": 63, "kind": "msg", "spk": "そはら", "ja": "え……？"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "俺はそはら牛の\nおっぱいを所望するぞ！"},
{"id": 65, "kind": "msg", "spk": "そはら", "ja": "ちょっとトモちゃん！？\nなにするの、やめ……！"},
{"id": 66, "kind": "msg", "spk": "智樹", "ja": "うひょひょひょひょ！\nさあ、出せ！　それ出せ！"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "うひょひょひょ……ひょ？"},
{"id": 68, "kind": "msg", "spk": "そはら", "ja": "トモちゃん……食事中に\nふざけちゃダメでしょー！"},
{"id": 69, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}スパーン！"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "うびょっ！"},
{"id": 71, "kind": "msg", "spk": "智樹", "ja": "この後、正座で説教されました。\n真夏の砂浜の熱さは忘れられそうに\nありません。"}
]}
