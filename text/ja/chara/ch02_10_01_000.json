{"file": "_Data/Script/Chara/Chapter02/10/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ふぃー、腹ペコだぜー。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "さーて、今日の朝食はなにかな？"},
{"id": 2, "kind": "msg", "spk": "守形", "ja": "智樹か。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "あ、おはようございます！\n守形先輩、今日の朝食なんスか？"},
{"id": 4, "kind": "msg", "spk": "守形", "ja": "見ての通り焼き魚だな。\n今、焼いているところだ。"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "あれ？　さっき、朝食の準備は\nできてるって\n言ってませんでしたっけ？"},
{"id": 6, "kind": "msg", "spk": "守形", "ja": "みんなが集まるまでの時間を\n計算に入れれば、ちょうど\n焼き上がるはずだ。"},
{"id": 7, "kind": "msg", "spk": "守形", "ja": "先に焼いておくと\n冷めてしまうからな。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "ああ。なるほど。"},
{"id": 9, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}ジュージュー"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "んー、いい匂いっスねー。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "その魚、持ってきたんですか？"},
{"id": 12, "kind": "msg", "spk": "守形", "ja": "今朝、俺が釣ったものだ。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "マジっすか！？"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "守形先輩、早朝だけで、そんなに\n釣れるんですか！？"},
{"id": 15, "kind": "msg", "spk": "守形", "ja": "日によるが……"},
{"id": 16, "kind": "msg", "spk": "守形", "ja": "今日は、半分、熊に譲ってもらった。"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "く、クマァーーー！？"},
{"id": 18, "kind": "msg", "spk": "守形", "ja": "智樹も前に会ったことがあるだろう？\nあの熊だ。"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "会ったことがっていうか、\n襲われましたけどね……"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "つーか、守形先輩って熊と\n仲いーんすか？"},
{"id": 21, "kind": "msg", "spk": "守形", "ja": "まぁな。何度も拳を交えてる……\nよきライバルといったところか。"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "へ、へぇー。"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "（相変わらず非常識な先輩だぜ……）"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "守形先輩って、\n砂漠だろうが北極だろうが\nサバイバルしていけそうですよね。"},
{"id": 25, "kind": "msg", "spk": "守形", "ja": "可能かどうかは分からないが……\n特に行ってみたいという\n気持ちはないな。"},
{"id": 26, "kind": "msg", "spk": "守形", "ja": "新大陸の可能性が見出せれば\n話は別だが。"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "そうっスか。"},
{"id": 28, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}ジュージュー"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "もう焼き上がりますかね？"},
{"id": 30, "kind": "msg", "spk": "守形", "ja": "もう少しだな。"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "こうして見てると腹減ってきますね。\nなんか三匹でも四匹でも\n食べられそうっスよ。"},
{"id": 32, "kind": "choice", "spk": "", "ja": "でも、魚の数足りますか？"},
{"id": 33, "kind": "choice", "spk": "", "ja": "ホントうまそうですねー"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "でも、魚の数足りますか？"},
{"id": 35, "kind": "msg", "spk": "守形", "ja": "十分な数があると思うが？"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "アストレアとかバカ食いしそうだし、\n俺もですけど。"},
{"id": 37, "kind": "msg", "spk": "守形", "ja": "ふむ。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "もうちょっと釣ってきますか？"},
{"id": 39, "kind": "msg", "spk": "守形", "ja": "いや、捕りすぎても\n自然によくないからな。"},
{"id": 40, "kind": "msg", "spk": "守形", "ja": "ちょっと待っていろ。"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "あれ？　守形先輩、\nなんで森のほうになんか？"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "森の中で魚が捕れる……\nわけねーよな。"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "なにしに行ったんだ……？\nあ、戻ってきた。"},
{"id": 44, "kind": "msg", "spk": "守形", "ja": "待たせたな。"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "そんな待ってないですけど、\nなにしてきたんスか？"},
{"id": 46, "kind": "msg", "spk": "守形", "ja": "食料調達だ。"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "調達ってなにを……？"},
{"id": 48, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}シャーーーーー"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "ヘ、ヘビィーーーー！？"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "な、なんで蛇なんか捕まえて\nきてんスかぁー！？"},
{"id": 51, "kind": "msg", "spk": "守形", "ja": "蛇の蒲焼はうまいぞ。"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "誰が食うかー！"},
{"id": 53, "kind": "msg", "spk": "守形", "ja": "だまされたと思って食ってみろ。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "だますもなにも正面から堂々と\n食わせようとしてんじゃねーか！"},
{"id": 55, "kind": "msg", "spk": "守形", "ja": "うまいぞ。"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "焼くなー！！"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "ホント、うまそうですねー！"},
{"id": 58, "kind": "msg", "spk": "守形", "ja": "そうか？"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "先輩は、いつもサバイバル食生活\nだからですよ。"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "家のコンロで焼いた魚とは違う、\nたき火で焼く魚ってのは\nまったく別物に見えますね！"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "鮮度も抜群だし、景色はいいし。"},
{"id": 62, "kind": "msg", "spk": "守形", "ja": "そういうものか。"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "見てるだけでよだれが\n止まりませんよ。"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "早く焼けないかなー。"},
{"id": 65, "kind": "msg", "spk": "守形", "ja": "ふむ……"},
{"id": 66, "kind": "msg", "spk": "守形", "ja": "そんなに食いたければ、\n先に食べるか？"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "え？　いいんスか？"},
{"id": 68, "kind": "msg", "spk": "守形", "ja": "この小さな魚なら、\nもう火が通っている。\n毒見してくれ。"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "毒見って……"},
{"id": 70, "kind": "msg", "spk": "守形", "ja": "味見のことだ。"},
{"id": 71, "kind": "msg", "spk": "智樹", "ja": "余計な脅しを入れないで\nくださいよ……"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "まーいいや、\nいただきまーす！！"},
{"id": 73, "kind": "msg", "spk": "", "ja": "　\n{1F}{1A}ガブッ"},
{"id": 74, "kind": "msg", "spk": "智樹", "ja": "アツッ！　アツッ！\nッとほぉー！　うめぇ！\nやっぱ、うまいですよ、先輩！"},
{"id": 75, "kind": "msg", "spk": "守形", "ja": "そうか、それはよかったな。"},
{"id": 76, "kind": "msg", "spk": "智樹", "ja": "先輩、こんな美味いもの食ってんなら、\nわざわざ俺ん家に来て食べなくても\nいいんじゃないですか？"},
{"id": 77, "kind": "msg", "spk": "守形", "ja": "……智樹の家の食事は\nうまいぞ。"},
{"id": 78, "kind": "msg", "spk": "智樹", "ja": "そうっスかね？"},
{"id": 79, "kind": "msg", "spk": "守形", "ja": "うむ。"}
]}
