{"file": "_Data/Script/Chara/Chapter04/71/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "なぁイカロス、このカードって\n想像力を強化するものだ、\nって言ったよな。"},
{"id": 1, "kind": "msg", "spk": "イカロス", "ja": "はい。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "それって『理想の彼女』みたいな、\n実際にはいない人間も\n想像できるのか？"},
{"id": 3, "kind": "msg", "spk": "イカロス", "ja": "……マスターに彼女がいれば、\nその人をモデルに想像を膨らませること\nが可能と思いますが。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "……うっうっうっ。しくしくしく。\nどうせ……どうせ俺は、\nどうせ俺はぁ……。"},
{"id": 5, "kind": "msg", "spk": "イカロス", "ja": "すみません。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "いや、お前が謝ることじゃないし。\nやるだけやってみるさ。"},
{"id": 7, "kind": "msg", "spk": "イカロス", "ja": "はい。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "はぁぁぁぁぁぁぁ……！！\n出てこい、俺の理想の彼女！！"},
{"id": 9, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}ギュゥゥゥゥゥゥン{16}{15}"},
{"id": 10, "kind": "msg", "spk": "イカロス", "ja": "…………。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "……あれ？\n何も、起きない？"},
{"id": 12, "kind": "msg", "spk": "そはら？", "ja": "マスター。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "あれ？　そはらいつの間に……って、\nえ？　マスター？"},
{"id": 14, "kind": "msg", "spk": "そはら？", "ja": "マスターは『理想の彼女』が\n欲しいのでしょうか。"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "そ、そりゃ欲しい……さ。\nって……そはらじゃない？"},
{"id": 16, "kind": "msg", "spk": "そはら？", "ja": "マスターが望む『理想の彼女』とは、\n例えばどんなものですか？"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "そりゃあ、可愛くて性格がよくて料理が\n得意で、お淑やかでスタイルがよくて\nセクシーダイナマイツで{16}{17}。"},
{"id": 18, "kind": "msg", "spk": "そはら？", "ja": "今、マスターには私が『理想の彼女』に\n見えていますか？"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "（{16}{17}ハッ！？　これって、まさか）"},
{"id": 20, "kind": "msg", "spk": "そはら？", "ja": "どうやらカードの力で、\nそのような補正が\nかかっているようなのですが……。"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "（やっぱり……見た目はそはらだけど、\n　中身はイカロス？）"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "（これが……これが俺の、\n　理想の彼女だっていうのか！？）"},
{"id": 23, "kind": "choice", "spk": "", "ja": "悪くない、悪くないのぉ～"},
{"id": 24, "kind": "choice", "spk": "", "ja": "絶対違う！！"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "ひょっひょっひょっ！\n普段暴れてばかりのそはらが、\nイカロスみたいにおとなしく！"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "これはこれでいいかもしれない。\n悪くない、悪くないのぉ～。\nほれ、近う寄れ、近うへ。"},
{"id": 27, "kind": "msg", "spk": "そはら？", "ja": "はい。"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "お手。"},
{"id": 29, "kind": "msg", "spk": "そはら？", "ja": "はい。"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "お回り。"},
{"id": 31, "kind": "msg", "spk": "そはら？", "ja": "はい。"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "服を……服を脱げ！"},
{"id": 33, "kind": "msg", "spk": "そはら？", "ja": "はい。"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "いや！　やっぱ待て待て！！"},
{"id": 35, "kind": "msg", "spk": "そはら？", "ja": "はい。\nどうしました、マスター？"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "……なんか、物足りないな。"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "ダメだダメだダメだ！\nこんなの絶対違う！！"},
{"id": 38, "kind": "msg", "spk": "そはら？", "ja": "……私では、その『理想の彼女』には\nなれませんか。マスター？"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "そうじゃなくて！\nこんなの、イカロスともそはらとも\n違うだろ！！"},
{"id": 40, "kind": "msg", "spk": "そはら？", "ja": "はい。マスターの『理想の彼女』が\n曖昧な定義でした。"},
{"id": 41, "kind": "msg", "spk": "そはら？", "ja": "ですので、ひとまず身近なサンプルで\nカードが再現を試みたのかと\n思われるのですが……"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "ああもう、\nそういう難しいことじゃなくてさ！"},
{"id": 43, "kind": "msg", "spk": "そはら？", "ja": "？"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "俺にとってはイカロスも、そはらも、\nその……そのまんまがいいんだって！"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "ヘンに性格なんて変わらずにさ、\nありのままの２人が俺は{16}{17}。"},
{"id": 46, "kind": "msg", "spk": "そはら", "ja": "何してるのトモちゃん。"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "うお！？"},
{"id": 48, "kind": "msg", "spk": "イカロス", "ja": "あ、カードの効果が……。"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "ほ、本物のそはら、か？"},
{"id": 50, "kind": "msg", "spk": "そはら", "ja": "本物ってどうかしたの？"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "い、いやなんでもない。\nふぅ～……。\nよかったよ、元に戻って。"},
{"id": 52, "kind": "msg", "spk": "イカロス", "ja": "……。"},
{"id": 53, "kind": "msg", "spk": "そはら", "ja": "？　ヘンなトモちゃん。"}
]}
