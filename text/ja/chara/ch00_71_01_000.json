{"file": "_Data/Script/Chara/Chapter00/71/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ん？　ニンフが空を見てるな。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "よお、ニンフ、なに見てるんだ？"},
{"id": 2, "kind": "msg", "spk": "ニンフ", "ja": "トモキ？　なにか用？"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "べつに用はないけど……\nニンフも空を見るのが好きなのか？"},
{"id": 4, "kind": "msg", "spk": "ニンフ", "ja": "なにそれ？\nべつに空は嫌いじゃないけど、\nそんなの眺めてても仕方ないじゃない？"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "そうなのか。\nイカロスはよく空を見てるからさ。"},
{"id": 6, "kind": "msg", "spk": "ニンフ", "ja": "ふーん。\n私は鳥を見てたのよ。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "ああ、ほんとだ。\n小鳥が遊んでるな。"},
{"id": 8, "kind": "msg", "spk": "ニンフ", "ja": "鳥と空を飛ぶの……楽しいのよ。"},
{"id": 9, "kind": "msg", "spk": "ニンフ", "ja": "この服じゃ飛びにくいから、\nやらないけどね。"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "そうなのか。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "鳥、飼ってみたいとか？"},
{"id": 12, "kind": "msg", "spk": "ニンフ", "ja": "ううん……飼うのは、やめておくわ。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "なんでだ？"},
{"id": 14, "kind": "msg", "spk": "ニンフ", "ja": "狭い鳥籠に閉じ込めておくのも、\nかわいそうだしね。"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "ああ、そうか。\nそうだな。"},
{"id": 16, "kind": "msg", "spk": "ニンフ", "ja": "そろそろ、昼ドラの時間ね。\nあと、お菓子、お菓子……。"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "ニンフは好きなものが、\nいっぱいあるなあ。"},
{"id": 18, "kind": "msg", "spk": "ニンフ", "ja": "そう？"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "小鳥に昼ドラにお菓子に……\n甘い物は大好きだろ？"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "イカロスは、あんまり好きとか嫌いとか\n言わないからさ。"},
{"id": 21, "kind": "msg", "spk": "ニンフ", "ja": "まぁ、そうかもね。"},
{"id": 22, "kind": "msg", "spk": "ニンフ", "ja": "でも、アルファーが感情表現を得意じゃ\nないだけで、私たちには好きも嫌いも\nちゃんとあるわよ。"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "そうみたいだな。"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "この騒動が落ち着いたら、\nゆっくりパフェでも食べにいこうぜ。"},
{"id": 25, "kind": "msg", "spk": "ニンフ", "ja": "……そうね。\nそんな余裕があるか、わからないけど。"},
{"id": 26, "kind": "msg", "spk": "ニンフ", "ja": "お腹いっぱい食べさせてくれるなら、\n一緒に行くわ。"}
]}
