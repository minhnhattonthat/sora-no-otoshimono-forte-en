{"file": "_Data/Script/Chara/Chapter02/11/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "アストレア", "ja": "お、お腹すいた～。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "ん？　アストレアじゃん。\nなにやってんだそんなところで？"},
{"id": 2, "kind": "msg", "spk": "アストレア", "ja": "お腹～。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "あん？"},
{"id": 4, "kind": "msg", "spk": "アストレア", "ja": "お腹すいたのー！！"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "なんで森の中にいるんだよ？"},
{"id": 6, "kind": "msg", "spk": "アストレア", "ja": "食べ物ないかと思って……"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "野生動物か！"},
{"id": 8, "kind": "msg", "spk": "アストレア", "ja": "お腹空いたのー！！"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "騒ぐなって。\nそんなアストレアに朗報だ。\n朝食の準備ができたぞ。"},
{"id": 10, "kind": "msg", "spk": "アストレア", "ja": "えっ！？\nホント！？"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "ホントホント。\nだから、キャンプに戻ってこい。"},
{"id": 12, "kind": "msg", "spk": "アストレア", "ja": "うん！\nやったー！\n……ん？"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "なんだよ？"},
{"id": 14, "kind": "msg", "spk": "アストレア", "ja": "キノコ見つけた！"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "ん？\nうお、毒々しい色！\nどう見ても毒キノコだろ！？"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "そんなのいいから、\nとっとと朝食にしようぜ。"},
{"id": 17, "kind": "msg", "spk": "アストレア", "ja": "………………はぁ、はぁ……"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "お、おい？"},
{"id": 19, "kind": "msg", "spk": "アストレア", "ja": "………………じゅるり。"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "ちょっ！　待て！"},
{"id": 21, "kind": "choice", "spk": "", "ja": "無理やり取り上げる"},
{"id": 22, "kind": "choice", "spk": "", "ja": "声をかけて制止する"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "こんなもん食うんじゃねぇ！"},
{"id": 24, "kind": "msg", "spk": "", "ja": "　\n{1F}{1A}バシッ"},
{"id": 25, "kind": "msg", "spk": "アストレア", "ja": "ああ～！？\n返しなさいよ！\n私のなんだからー！"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "これは絶対に毒だ！\nやめとけって！"},
{"id": 27, "kind": "msg", "spk": "アストレア", "ja": "ご飯は食べるけど、\nそれも食べるの！"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "毒だって言ってるだろ、このバカ！"},
{"id": 29, "kind": "msg", "spk": "アストレア", "ja": "あー！　またバカって言った！？"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "どうして、そんなところだけ\n聞いてるんだ！？"},
{"id": 31, "kind": "msg", "spk": "アストレア", "ja": "返せー！"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "こんなもん！"},
{"id": 33, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ポーーン！"},
{"id": 34, "kind": "msg", "spk": "アストレア", "ja": "アアーーー！？\n投げた！"},
{"id": 35, "kind": "msg", "spk": "アストレア", "ja": "なんてことすんのよ、アンタ！？"},
{"id": 36, "kind": "msg", "spk": "", "ja": "　\n{1F}{11}ポカポカポカポカポカポカ"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "痛ぇ！　痛いっての！\nクソぅ、ちったぁ感謝しろ！"},
{"id": 38, "kind": "msg", "spk": "ニンフ", "ja": "あんたたち、なにしてんの……？"},
{"id": 39, "kind": "msg", "spk": "アストレア", "ja": "あ、ニンフ先輩！"},
{"id": 40, "kind": "msg", "spk": "アストレア", "ja": "こいつが、私の見つけたキノコ、\n投げちゃったんですよ！"},
{"id": 41, "kind": "msg", "spk": "ニンフ", "ja": "キノコって……\nこれのこと？"},
{"id": 42, "kind": "msg", "spk": "アストレア", "ja": "わぁー、ニンフ先輩、\n拾ってくれたんですか！\nありがとうございます！"},
{"id": 43, "kind": "msg", "spk": "ニンフ", "ja": "歩いてたら、いきなり頭に\nぶつかったのよ……。"},
{"id": 44, "kind": "msg", "spk": "ニンフ", "ja": "そう、これはトモキが投げたのね……"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "いや、このバカが毒キノコを\n食べようとしたのを\n助けてやっただけでだな！"},
{"id": 46, "kind": "msg", "spk": "ニンフ", "ja": "毒？　そうなの？\n解析開始……"},
{"id": 47, "kind": "msg", "spk": "ニンフ", "ja": "………………"},
{"id": 48, "kind": "msg", "spk": "ニンフ", "ja": "解析完了。"},
{"id": 49, "kind": "msg", "spk": "アストレア", "ja": "どうですか！？\nそんなキレイなキノコ、\n毒なわけないですよね！？"},
{"id": 50, "kind": "msg", "spk": "ニンフ", "ja": "デルタ、\n食べなくてよかったわね。"},
{"id": 51, "kind": "msg", "spk": "アストレア", "ja": "ほえ？"},
{"id": 52, "kind": "msg", "spk": "ニンフ", "ja": "もし食べてたら、\n大変なことになってたわよ？"},
{"id": 53, "kind": "msg", "spk": "ニンフ", "ja": "エンジェロイドが、\nどのていど影響を受けるかは、\nわからないけど。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "ほら見ろ！\n俺の言った通りじゃねぇか！"},
{"id": 55, "kind": "msg", "spk": "アストレア", "ja": "む、むむむ……"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "むむむ、じゃねぇ！\n謝れ！　俺に感謝しろ！"},
{"id": 57, "kind": "msg", "spk": "アストレア", "ja": "べっ、べっつにー！\nそんなもの本気で食べるつもりなんて\nなかったもん！　バーカ！"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "謝りやがれこのバカぁ～！"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "おい、やめとけって！\n絶対に毒だぞ？"},
{"id": 60, "kind": "msg", "spk": "アストレア", "ja": "そんなの、食べてみなきゃ、\nわからないでしょ！？"},
{"id": 61, "kind": "msg", "spk": "アストレア", "ja": "いただきます！"},
{"id": 62, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}バクッ！"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "あ、バカ！"},
{"id": 64, "kind": "msg", "spk": "アストレア", "ja": "……もぐもぐ。ごくっ！"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "お、おい……\nアストレア？"},
{"id": 66, "kind": "msg", "spk": "アストレア", "ja": "………………"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "おい、大丈夫か？"},
{"id": 68, "kind": "msg", "spk": "アストレア", "ja": "……プヒョッ！"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "ぷひょ？"},
{"id": 70, "kind": "msg", "spk": "アストレア", "ja": "プヒョヒョヒョヒョヒョヒョ！\nプヘラッ！　ヘキョー！　ウフッ！\nウヘヘヘヘへヘヘヘヘヘヘヘヘヘヘ！"},
{"id": 71, "kind": "msg", "spk": "智樹", "ja": "おい、しっかりしろ！　現実に帰れ！"},
{"id": 72, "kind": "msg", "spk": "アストレア", "ja": "キキョー！　キッキョッキョッキョッ！\nドゥルッルルルルルルルルンルルンッ！\nルルルルル…………"},
{"id": 73, "kind": "msg", "spk": "智樹", "ja": "お、お？　止まった……か？"},
{"id": 74, "kind": "msg", "spk": "アストレア", "ja": "……。\n…………。\n………………トナカイ。"},
{"id": 75, "kind": "msg", "spk": "智樹", "ja": "……は？\nいや、俺は智樹だぞ？"},
{"id": 76, "kind": "msg", "spk": "アストレア", "ja": "トナカイがいるぅー？\nなんで～？　んー？"},
{"id": 77, "kind": "msg", "spk": "智樹", "ja": "もしかして、毒キノコのせいで\n幻覚を見てるのか？"},
{"id": 78, "kind": "msg", "spk": "アストレア", "ja": "トナカイ……おいしそう。\nじゅるり。"},
{"id": 79, "kind": "msg", "spk": "智樹", "ja": "俺はトナカイじゃねぇー！"},
{"id": 80, "kind": "msg", "spk": "智樹", "ja": "目を覚ませ、バカ！"},
{"id": 81, "kind": "msg", "spk": "ニンフ", "ja": "……なにしてんの？"},
{"id": 82, "kind": "msg", "spk": "智樹", "ja": "あっ！　ニンフいいところに来た！\nバカが毒キノコを食べちまったんだ！"},
{"id": 83, "kind": "msg", "spk": "ニンフ", "ja": "なんでそんなものを……？\n吐き出させればいいんじゃない？"},
{"id": 84, "kind": "msg", "spk": "智樹", "ja": "よし、それだ！"},
{"id": 85, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ドンッ！"},
{"id": 86, "kind": "msg", "spk": "アストレア", "ja": "けほっ！"},
{"id": 87, "kind": "msg", "spk": "", "ja": "　\n{1F}{1A}ポロッ"},
{"id": 88, "kind": "msg", "spk": "アストレア", "ja": "お肉……お肉……おにくぅるぅ～？"},
{"id": 89, "kind": "msg", "spk": "アストレア", "ja": "……ほえっ？　あれ？\nお肉は～？"},
{"id": 90, "kind": "msg", "spk": "ニンフ", "ja": "まったく……。"},
{"id": 91, "kind": "msg", "spk": "智樹", "ja": "ほんとにな……。"},
{"id": 92, "kind": "msg", "spk": "アストレア", "ja": "あれ？　ニンフ先輩いつ来たんですか？"},
{"id": 93, "kind": "msg", "spk": "ニンフ", "ja": "ついさっきよ。"},
{"id": 94, "kind": "msg", "spk": "アストレア", "ja": "そうなんですか！\n早くご飯にしましょう！"},
{"id": 95, "kind": "msg", "spk": "アストレア", "ja": "ごはん！　ごはん！"}
]}
