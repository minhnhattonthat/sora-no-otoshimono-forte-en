{"file": "_Data/Script/Chara/Chapter04/10/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "美香子", "ja": "それにしても驚きだわ～。\nあの桜井くんが健全な青少年になった、\nだなんて。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "やだなぁ先輩、ボクはもう\nどこからどう見ても健全ですよ。"},
{"id": 2, "kind": "msg", "spk": "美香子", "ja": "煩悩の固まりで～、\nこの世に生まれ出たこと自体が罪、\nと言われていたのにね～。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "そこまでは言われてないっス……。"},
{"id": 4, "kind": "msg", "spk": "美香子", "ja": "空美町に住む人間すべての煩悩を\n集めても、桜井くん１人に敵わない、\nって会長聞いたんだけど～。"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "なんですかそれはっ！\n証拠も何もないでしょっ！"},
{"id": 6, "kind": "msg", "spk": "美香子", "ja": "この前、ニンフちゃんのセンサーで\n統計をとってもらったの～。\n会長暇だったから～。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "本当に迷惑な暇人ですね……。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "（くそっ、会長はまだ、\n　俺がエロだと疑ってるのか？）"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "（実際そうなんだけどね～♪）"},
{"id": 10, "kind": "msg", "spk": "美香子", "ja": "ねぇ～桜井くん。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "なんでしょう。"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "（落ち着け俺。ここで失敗したら、\n　矯正施設送りになるぞ……！）"},
{"id": 13, "kind": "msg", "spk": "美香子", "ja": "今、会長はいてないんだけど～。"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "……はい？"},
{"id": 15, "kind": "msg", "spk": "美香子", "ja": "今、会長はいてないんだけど～。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "（は　い　て　な　い？）"},
{"id": 17, "kind": "msg", "spk": "美香子", "ja": "今、会長はいてないんだけど～。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "いやそんな、繰り返さなくても聞こえて\n……ハッ！？"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "ま・さ・か……。"},
{"id": 20, "kind": "msg", "spk": "美香子", "ja": "うふふ～。"},
{"id": 21, "kind": "msg", "spk": "？？？", "ja": "鈍いぜ、相棒。"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "（くっ……目覚めてしまうのか、\n　我が暴れん棒よ！）"},
{"id": 23, "kind": "msg", "spk": "？？？", "ja": "ああ……俺にはとっくに\nわかっていたからな。"},
{"id": 24, "kind": "msg", "spk": "？？？", "ja": "は　い　て　な　い\nの意味が、な。"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "まさか……そんな。"},
{"id": 26, "kind": "msg", "spk": "美香子", "ja": "疑うの～？\n確かめてみる～？"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "ぶはっ！？"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "（くっ……卑怯な！\n　スカートをめくって太腿をチラリだ\n　なんて……）"},
{"id": 29, "kind": "msg", "spk": "美香子", "ja": "うふふ～。"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "（しかも、こちらからでは見えそうで\n　見えない、絶妙な角度！！）"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "（これは……俺に対する\n　挑戦なのか～～～！？）"},
{"id": 32, "kind": "choice", "spk": "", "ja": "妄想を膨らませる"},
{"id": 33, "kind": "choice", "spk": "", "ja": "妄想を抑える！"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "（くっそぉ……会長め～、\n　矯正施設がなんだ！\n　俺の本気をみせてやる！！）"},
{"id": 35, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}ギュゥゥゥゥゥゥン{16}{15}"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "（俺の妄想……俺の心眼で、\n　とらえられないものは……ない！！）"},
{"id": 37, "kind": "msg", "spk": "美香子", "ja": "うふふ～。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "（弾けろ！　俺の妄・想・力！！！！）"},
{"id": 39, "kind": "msg", "spk": "美香子", "ja": "あ～、ちなみに～。"},
{"id": 40, "kind": "msg", "spk": "美香子", "ja": "ウソだから～。"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "……へ？"},
{"id": 42, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}ピュルルルルルルル{16}{15}"},
{"id": 43, "kind": "msg", "spk": "美香子", "ja": "さすがに会長も～、\nこんなに人目のあるところじゃ、\nちゃんとはいているわ～。"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "で、ですよね。ははっ。"},
{"id": 45, "kind": "msg", "spk": "美香子", "ja": "ただし～、\n黒でレース入りの、\nものすごくセクシーなやつだけど～。"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "（セクシー妄想いただきました！！）"},
{"id": 47, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}ギュゥゥゥゥゥゥン{16}{15}"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "（会長の白い肌に黒の下着、\n　会長の白い肌に黒の下着……！！）"},
{"id": 49, "kind": "msg", "spk": "美香子", "ja": "ちょっときついんだけど、ね～。\nこの靴下。"},
{"id": 50, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}ピュルルルルルルル{16}{15}"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "く……靴下ぁ？"},
{"id": 52, "kind": "msg", "spk": "美香子", "ja": "ほら～。"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "あ、ホントだ。"},
{"id": 54, "kind": "msg", "spk": "美香子", "ja": "あとで履き替えるつもりなんだけど～。"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "（わざとか？　わざとなのか？\n　わざと俺に揺さぶりをかけて……？\n　つ、疲れる……）"},
{"id": 56, "kind": "msg", "spk": "美香子", "ja": "うふふ～。"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "（いやいや待て待て！\n　ここで妄想を発動してしまったら、\n　それこそ相手の思うつぼ！）"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "（こらえろ！\n　こらえるんだ相棒！\n　そして俺！　桜井智樹！！）"},
{"id": 59, "kind": "msg", "spk": "？？？", "ja": "…………。"},
{"id": 60, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}ピュルルルルルルル{16}{15}"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "……ふぅ～。"},
{"id": 62, "kind": "msg", "spk": "美香子", "ja": "あら～どうしたの～？\nなんだか、一仕事やり遂げた、\nっていうような顔して～。"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "ええ。今の俺は清々しい気分です。\n何しろ健・全！　な少年ですから。"},
{"id": 64, "kind": "msg", "spk": "美香子", "ja": "あらそうなの～。\n残念だわ～。"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "（やはり……罠だったのか！？）"},
{"id": 66, "kind": "msg", "spk": "美香子", "ja": "あ～あ。もっと激しく反応してくれる\nと思ったんだけど～。\n会長がっかり～。"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "ふ……はは、ナンノコトですか？"},
{"id": 68, "kind": "msg", "spk": "", "ja": "　\n{1F}{11}キーンコーンカーンコーン"},
{"id": 69, "kind": "msg", "spk": "美香子", "ja": "……まぁいいわ～。\nそれじゃまたね～。"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "……はぁ～！\nた、助かったぁ～……。"}
]}
