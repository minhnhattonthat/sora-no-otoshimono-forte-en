{"file": "_Data/Script/Chara/Chapter02/70/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "美香子", "ja": "………………"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "あれって……会長か？\nあんな隅っこで、こそこそと……\nなにしてるんだ？"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "こっそり近づいてみるか。"},
{"id": 3, "kind": "msg", "spk": "美香子", "ja": "………………"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "会長？"},
{"id": 5, "kind": "msg", "spk": "美香子", "ja": "あ、あら～。"},
{"id": 6, "kind": "msg", "spk": "美香子", "ja": "桜井くんじゃないの、\nどうしたの～？"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "会長、なんか後ろに隠しましたよね？"},
{"id": 8, "kind": "msg", "spk": "美香子", "ja": "なんのことかしら～？"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "いや、だから、後ろ手に\nなにか隠しましたよね？"},
{"id": 10, "kind": "msg", "spk": "美香子", "ja": "なにも隠してないわ～。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "（いや、隠した！　絶対に隠した！）"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "ちょっと見せてくださいよ！"},
{"id": 13, "kind": "msg", "spk": "美香子", "ja": "あら～？\n桜井くんは……デリカシーってものが\nないのかしら～？"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "デリカシー？"},
{"id": 15, "kind": "msg", "spk": "美香子", "ja": "女の子には、ナイショの１つや２つ\nあるものよ～。"},
{"id": 16, "kind": "msg", "spk": "美香子", "ja": "男の人には見せられないものくらい。"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "そ、それは……"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "（それこそ見たい！！）"},
{"id": 19, "kind": "msg", "spk": "美香子", "ja": "でも、どうしてもって言うなら、\nちょっとだけ見せてあげるわ～。"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "マジっすか！？"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "今、公開される、乙女の秘密！？"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "うへへへ……"},
{"id": 23, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}スチャッ"},
{"id": 24, "kind": "msg", "spk": "美香子", "ja": "これの手入れをしていたのだけれど、\n見れてうれしいかしら～？"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "黒くて固くてゴツゴツした……"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "拳銃じゃねえか！！"},
{"id": 27, "kind": "msg", "spk": "美香子", "ja": "オモチャよ、オモチャ～。"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "どこが乙女の秘密だよ！？"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "そんなもの持ち歩くやつが\n乙女なわけないだろ！！"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "俺のワクワクドキドキを返せ！！"},
{"id": 31, "kind": "msg", "spk": "美香子", "ja": "試し撃ち、しないといけないわ～。"},
{"id": 32, "kind": "msg", "spk": "美香子", "ja": "桜井くん、いい的、知らないかしら～？"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "え、いや……知らないですけど。"},
{"id": 34, "kind": "msg", "spk": "美香子", "ja": "そうなの～？\n目の前にとっても的に良さそう顔が\nあるんだけど～。"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "（それは……\n　まさか、俺の顔のことか！？）"},
{"id": 36, "kind": "msg", "spk": "美香子", "ja": "ところで、会長って、\n乙女じゃないのかしら～？"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "も、もちろん、会長は乙女ですよ！\nめちゃくちゃ絶世の美女です！！"},
{"id": 38, "kind": "msg", "spk": "美香子", "ja": "あら～、そんなことないわ～。"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "じゃあ、俺は、このへんで！"},
{"id": 40, "kind": "msg", "spk": "美香子", "ja": "またね～。"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "ん？　なにか落ちてるぞ？"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "風景の写った写真？\nいや、この小さく写ってるのは……\n俺か？"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "なんなんだ？"}
]}
