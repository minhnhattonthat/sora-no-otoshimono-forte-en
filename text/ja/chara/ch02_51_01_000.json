{"file": "_Data/Script/Chara/Chapter02/51/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "うーん、そろそろ時間が\nなくなってきたな～。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "会長が誰かに貼ったシール……\nホントに見つけられんのかぁ？"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "もし見つからなかったら、\n会長に何をされるやら……"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "ん？　あそこにいるのは……"},
{"id": 4, "kind": "msg", "spk": "ニンフ", "ja": "はぁ……"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "おーい、ニンフー。"},
{"id": 6, "kind": "msg", "spk": "ニンフ", "ja": "ト、トモキ！？"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "どうした？\nなに、そんな驚いた顔してんだよ？"},
{"id": 8, "kind": "msg", "spk": "ニンフ", "ja": "な、なんでもないわよ！\nあっち行って！"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "でも、今、ため息とか\nついてたよな？"},
{"id": 10, "kind": "msg", "spk": "ニンフ", "ja": "いいから、あっちに行ってなさいよ！"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "わ、わかったよ……"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "なんだったんだ、あいつ？"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "……もしかして、さっきの小鳥のことで\n落ち込んでんのか？"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "うーん……\n余計なお世話かもしれないけど、\n励ましてやるか！"},
{"id": 15, "kind": "choice", "spk": "", "ja": "後ろから抱きつく"},
{"id": 16, "kind": "choice", "spk": "", "ja": "岩の陰にいた虫をくっつける"},
{"id": 17, "kind": "msg", "spk": "ニンフ", "ja": "はぁ……"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "（よし、気づかれてないな……）"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "（せーの……ッ！）"},
{"id": 20, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ガバッ！"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "ニンフ！！"},
{"id": 22, "kind": "msg", "spk": "ニンフ", "ja": "キャアアアアァァァ～～～！？"},
{"id": 23, "kind": "msg", "spk": "ニンフ", "ja": "な、なに！？　なんなの！？"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "ハッハッハッ！\nニンフ、びっくりしたか！？"},
{"id": 25, "kind": "msg", "spk": "ニンフ", "ja": "ト、トモキ！？"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "おう！\nどうしたんだよ、ニンフ、\n元気ないじゃんか！"},
{"id": 27, "kind": "msg", "spk": "ニンフ", "ja": "それで、こんな！？"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "びっくりすると、\n元気、出ないか？"},
{"id": 29, "kind": "msg", "spk": "ニンフ", "ja": "うっ……。"},
{"id": 30, "kind": "msg", "spk": "ニンフ", "ja": "ま……また……"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "なんだ？"},
{"id": 32, "kind": "msg", "spk": "ニンフ", "ja": "また……触った。"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "あ、あれ？　ニンフさん……？\nもしかして、怒っちゃいました？"},
{"id": 34, "kind": "msg", "spk": "ニンフ", "ja": "放しなさいよ、トモキ！"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "ああ、わかったよ。"},
{"id": 36, "kind": "msg", "spk": "ニンフ", "ja": "怒ってないわよ。\nでも、呆れてるかもね。"},
{"id": 37, "kind": "msg", "spk": "ニンフ", "ja": "ト、トモキが……\nさっきから……ッ！"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "俺が、どうしたんだ？"},
{"id": 39, "kind": "msg", "spk": "ニンフ", "ja": "変なことするからよ！"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "変なことって、なんだ？"},
{"id": 41, "kind": "msg", "spk": "ニンフ", "ja": "それは……"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "それは？"},
{"id": 43, "kind": "msg", "spk": "ニンフ", "ja": "言えないわよ、\nそんな変なこと！！"},
{"id": 44, "kind": "msg", "spk": "ニンフ", "ja": "もういいわよ！\n……トモキのバカ！"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "どうしたんだ、ニンフのやつ？"},
{"id": 46, "kind": "msg", "spk": "ニンフ", "ja": "はぁ……\nトモキ……"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "（よし、気づかれてないな……）"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "（あとはこの虫を……）"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "よっ、と。"},
{"id": 50, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ひょいっ"},
{"id": 51, "kind": "msg", "spk": "ニンフ", "ja": "え？　あ、トモキ。\nまた来たわけ？"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "あ、いや……\nははは……"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "（あれ？\n　虫に気づいてない？）"},
{"id": 54, "kind": "msg", "spk": "ニンフ", "ja": "なにか用があるわけ？\nそれとも、また変なことしにきた？"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "ギクッ……"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "あ、いや、ちょっと心配になってよ。"},
{"id": 57, "kind": "msg", "spk": "ニンフ", "ja": "余計な、お世話よ。\n私がトモキに心配されるようなこと\nあるわけないでしょ。"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "そうは言うけどさ……。"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "（待てよ……ニンフは、まだ虫を\n　つけられたことに気づいてない）"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "（虫のこと教えてやれば、\n　きっと俺に感謝するはず！）"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "あー、おほん。\nニンフ、背中に虫がついてるぞ？"},
{"id": 62, "kind": "msg", "spk": "ニンフ", "ja": "え……？"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "（くくく……\n　さぁ、俺の胸に\n　飛び込んでこい！）"},
{"id": 64, "kind": "msg", "spk": "ニンフ", "ja": "トモキ……\nまた、そんなウソついて……"},
{"id": 65, "kind": "msg", "spk": "ニンフ", "ja": "もしかして……\nまた私の体に興味あるの？"},
{"id": 66, "kind": "msg", "spk": "智樹", "ja": "……は？"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "（あ、あれ……なんか\n　想像してたのと違うぞ？）"},
{"id": 68, "kind": "msg", "spk": "智樹", "ja": "（ハッ！　そうか！\n　虫がついてるぞって……）"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "（さっき俺がついた嘘と\n　同じだからか！）"},
{"id": 70, "kind": "msg", "spk": "ニンフ", "ja": "トモキ……？"},
{"id": 71, "kind": "msg", "spk": "智樹", "ja": "いや、待て、ニンフ！\n今のは違う！"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "今回は、やましい気持ちで\n言ったんじゃない！"},
{"id": 73, "kind": "msg", "spk": "智樹", "ja": "ホントに虫がだな！"},
{"id": 74, "kind": "msg", "spk": "ニンフ", "ja": "そう、わかったわ。"},
{"id": 75, "kind": "msg", "spk": "ニンフ", "ja": "トモキが、どうしてもって、言うなら、\nちょっとくらいなら……"},
{"id": 76, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}カサカサカサ。"},
{"id": 77, "kind": "msg", "spk": "ニンフ", "ja": "え？"},
{"id": 78, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}カサカサカサ。"},
{"id": 79, "kind": "msg", "spk": "ニンフ", "ja": "イ、イヤーーーーッ！\nムシーーー！！"},
{"id": 80, "kind": "msg", "spk": "智樹", "ja": "あ……"},
{"id": 81, "kind": "msg", "spk": "ニンフ", "ja": "いやあぁぁぁ～～～！！"},
{"id": 82, "kind": "msg", "spk": "ニンフ", "ja": "もうバカ、最低！！\nわ～～～～ん！！"},
{"id": 83, "kind": "msg", "spk": "智樹", "ja": "泣きながら走っていっちまった。"},
{"id": 84, "kind": "msg", "spk": "智樹", "ja": "う……胸にじわりと罪悪感が……"}
]}
