{"file": "_Data/Script/Chara/Chapter01/72/02_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "よ、イカロス。"},
{"id": 1, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。\n何か御用でしょうか？"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "ああ、すこし話でもしないか？"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "と言った手前、何を話そうかな。\nイカロス、なんか話題ないか？"},
{"id": 4, "kind": "msg", "spk": "イカロス", "ja": "……以前は、\nマスターが寝ているときの\n私の話をしました。"},
{"id": 5, "kind": "msg", "spk": "イカロス", "ja": "ですから、マスターが寝ているときの\nニンフの話をするのは……\nどうでしょうか？"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "ああ、いいね。\nまさか、ニンフまで俺のこと\n見てるなんて言わないだろうな？"},
{"id": 7, "kind": "msg", "spk": "イカロス", "ja": "はい……ときどきです。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "ときどき、見てるのかよ！？"},
{"id": 9, "kind": "msg", "spk": "イカロス", "ja": "いつもは、ＴＶを見ています。"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "え……深夜ってＴＶなんか\nやってないだろ？"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "まさか、何も映ってないＴＶを\n一晩中ながめてるのか……？"},
{"id": 12, "kind": "msg", "spk": "イカロス", "ja": "いえ、昼ドラの録画を\n見ているようです。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "ああ、そっちか。\nなんか、安心したよ。"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "イカロスも、そうやって\n自分の見たいものを見てていいんだぞ？"},
{"id": 15, "kind": "msg", "spk": "イカロス", "ja": "だいじょうぶです。"},
{"id": 16, "kind": "msg", "spk": "イカロス", "ja": "私も……見たいものを見ていますから。"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "ああ、そうなのか。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "（そういえば、イカロスの好きな\n　ＴＶ番組ってなんだろうな……？）"}
]}
