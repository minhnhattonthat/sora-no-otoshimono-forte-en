{"file": "_Data/Script/Chara/Chapter02/72/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "あれ？　そはらじゃないか？"},
{"id": 1, "kind": "msg", "spk": "そはら", "ja": "………………"},
{"id": 2, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ガサゴソ"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "なんだあいつ森の中に入っていって……\nしかも、なんか慌ててた？"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "おもしろそうだし、\nあとをつけてみるか。"},
{"id": 5, "kind": "msg", "spk": "そはら", "ja": "うーん……"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "（なんかやってるみたいだけど、\n　こっからじゃよく見えないな）"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "（つけてるのも飽きてきたし、\n　声、かけるか！）"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "おーい、そはらー。"},
{"id": 9, "kind": "msg", "spk": "そはら", "ja": "ト、トモちゃん！？"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "なにやってんだよ？"},
{"id": 11, "kind": "msg", "spk": "そはら", "ja": "わっ、わっ！　トモちゃん！\nシィー！"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "（静かにしろってことか？）"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "（とりあえず、見に行くか）"},
{"id": 14, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ガサゴソ"},
{"id": 15, "kind": "msg", "spk": "そはら", "ja": "わわっ、脅かさないでよ、トモちゃん！"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "脅かすって……俺、なんかしたか？"},
{"id": 17, "kind": "name", "spk": "女子生徒Ｅ", "ja": "子狐"},
{"id": 18, "kind": "msg", "spk": "子狐", "ja": "こーん。"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "ん？"},
{"id": 20, "kind": "msg", "spk": "そはら", "ja": "あっ……！"},
{"id": 21, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}ガサガサッ！"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "今の、狐の子供か？"},
{"id": 23, "kind": "msg", "spk": "そはら", "ja": "うん……昨日、見つけて、\nせっかく仲良くなったのに。"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "俺に驚いて、逃げちゃったのか。\n悪かったな。"},
{"id": 25, "kind": "msg", "spk": "そはら", "ja": "……ううん、いいの。"},
{"id": 26, "kind": "msg", "spk": "そはら", "ja": "野生の動物に餌をあげるのって、\nよくないよね。"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "まぁ、そうだな。"},
{"id": 28, "kind": "msg", "spk": "そはら", "ja": "でも、かわいかったなー。"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "そのうち……"},
{"id": 30, "kind": "msg", "spk": "そはら", "ja": "え、なに？"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "そのうち、動物園にでも行こうぜ。\nだから、元気だせよな。"},
{"id": 32, "kind": "msg", "spk": "そはら", "ja": "えっ、ホント？"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "ああ。"},
{"id": 34, "kind": "msg", "spk": "そはら", "ja": "うれしいなー。\nイカロスさんたちもよろこぶね！"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "いや、ダメだ！\nあいつら檻を壊したがるから！"},
{"id": 36, "kind": "msg", "spk": "そはら", "ja": "えっ！？\nじゃあ……２人っきりで！？"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "ん？\nまぁ……そうなるな？\n嫌か？"},
{"id": 38, "kind": "msg", "spk": "そはら", "ja": "う、ううん！　全然！\nむしろ大歓迎というか……"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "そっか。今度、行こうな。"},
{"id": 40, "kind": "msg", "spk": "そはら", "ja": "……うん！　うれしい！"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "（そっか……\n　そはらのやつ……）"},
{"id": 42, "kind": "msg", "spk": "そはら", "ja": "……やった。２人っきりだ。"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "（そんなに、動物園が好きなのか）"}
]}
