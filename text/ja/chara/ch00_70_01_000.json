{"file": "_Data/Script/Chara/Chapter00/70/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "よお、イカロス、なにやってんだ？"},
{"id": 1, "kind": "msg", "spk": "イカロス", "ja": "空を……見ていました。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "空？　なんか見えたか？\n鳥とか？"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "もしかして、服が飛んでたか？"},
{"id": 4, "kind": "msg", "spk": "イカロス", "ja": "ただ……空を……"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "ああ、そうか。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "好きなのか？　空を見るの。"},
{"id": 7, "kind": "msg", "spk": "イカロス", "ja": "……好き、なのでしょうか？\nわかりません。"},
{"id": 8, "kind": "msg", "spk": "イカロス", "ja": "ただ、ふと見たくなります。\n空の青い色を……"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "それは、好きってことなんじゃないか？"},
{"id": 10, "kind": "msg", "spk": "イカロス", "ja": "そう……なのでしょうか？"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "他にも好きなものがあると、\nわかりやすいかな……？"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "イカロスは、好きな花とかは\nないのか？"},
{"id": 13, "kind": "msg", "spk": "イカロス", "ja": "好きな花……？"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "育ててみたいとか。"},
{"id": 15, "kind": "msg", "spk": "イカロス", "ja": "スイカ……です。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "それは花なのか！？\nまぁ、いいか。"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "そのスイカに向けてるのと\n同じような気持ちが、\n空を見たいって気持ちじゃないか？"},
{"id": 18, "kind": "msg", "spk": "イカロス", "ja": "……そうかもしれません。"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "他にも、好きな食べ物とか、\nあるだろ？"},
{"id": 20, "kind": "msg", "spk": "イカロス", "ja": "みんな……美味しいです。"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "好き嫌いないのか……\nじゃあ、他には……\nひよことかも好きだろ？"},
{"id": 22, "kind": "msg", "spk": "イカロス", "ja": "ひよこ……大切です。"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "うん、うん。"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "イカロスにとって、空を見るのは、\n好きなことなんだな。"},
{"id": 25, "kind": "msg", "spk": "イカロス", "ja": "……はい。"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "この騒動が落ち着いたら、\n山にピクニックにでも行くか。\n空が広いぞ！"},
{"id": 27, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"}
]}
