{"file": "_Data/Script/Chara/Chapter00/33/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "あ、会長。ちわーす。"},
{"id": 1, "kind": "msg", "spk": "美香子", "ja": "あら～、桜井くんじゃない。\nまた遊びにきてくれたの～？"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "いや、そういうわけじゃ……"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "会長……\n服、着てますね。"},
{"id": 4, "kind": "msg", "spk": "美香子", "ja": "もちろんよ～。"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "飛んでいこうとしませんでしたか？"},
{"id": 6, "kind": "msg", "spk": "美香子", "ja": "ええ、したわ～。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "守形先輩みたいに説得したんですか？"},
{"id": 8, "kind": "msg", "spk": "美香子", "ja": "そうね～。\nそんな感じだわ～。"},
{"id": 9, "kind": "msg", "spk": "美香子", "ja": "桜井くん、せっかく来たんだから、\nうちに寄っていったら～？\nお茶くらい出すわ～。"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "へ？"},
{"id": 11, "kind": "msg", "spk": "美香子", "ja": "お茶くらい飲んでいく時間、\nあるでしょう～？"},
{"id": 12, "kind": "msg", "spk": "美香子", "ja": "学校もないし、お買い物もできなくて、\n会長、退屈してるのよ～。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "そうですか……\nじゃあ、お茶くらいなら。"},
{"id": 14, "kind": "msg", "spk": "美香子", "ja": "嬉しいわ～、どうぞ入って～。"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "お邪魔します。"},
{"id": 16, "kind": "name", "spk": "男子生徒Ｈ", "ja": "黒服"},
{"id": 17, "kind": "msg", "spk": "黒服", "ja": "お帰りなさいませ、お嬢。\nいらっしゃいませ、お客人。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "あ、ども……\nうおぉぉぉぉ～～～！？"},
{"id": 19, "kind": "msg", "spk": "美香子", "ja": "あら、どうしたのかしら～？"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "ど、どうしたのかしらって……\nなんすかコレ！？"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "筋肉ムキムキの全裸の男だらけじゃ\nないッスか！"},
{"id": 22, "kind": "msg", "spk": "美香子", "ja": "そうね～桜井くんのせいで、\n黒服たちの黒服も飛んで\nいっちゃったから～。"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "うお……\nそりゃそうか……"},
{"id": 24, "kind": "name", "spk": "男子生徒Ｈ", "ja": "黒服"},
{"id": 25, "kind": "msg", "spk": "黒服", "ja": "お嬢、お荷物をお持ちします。"},
{"id": 26, "kind": "msg", "spk": "美香子", "ja": "部屋に運んでおいて～。"},
{"id": 27, "kind": "name", "spk": "男子生徒Ｈ", "ja": "黒服"},
{"id": 28, "kind": "msg", "spk": "黒服", "ja": "かしこまりました。"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "うぷ……"},
{"id": 30, "kind": "msg", "spk": "", "ja": "（※見苦しいので全裸の黒服は\n　画面に表示できません）"},
{"id": 31, "kind": "msg", "spk": "美香子", "ja": "これも、桜井くんの願いの結果よ～？"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "断固として、こんなものは\n望んでいませんよ！"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "つーか、会長は、\n気にならないんですか！？"},
{"id": 34, "kind": "msg", "spk": "美香子", "ja": "あら～、何のことかしら～？\n気になるようなものが\n見えてるかしら～？"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "あ、いや……\nべつに、いいんですけど……\n会長が気にしてないなら。"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "（か、帰りたい……）"},
{"id": 37, "kind": "msg", "spk": "美香子", "ja": "好きなところに座って。\nすぐお茶を持ってこさせるわ～。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "は、はい。"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "（くっ……全裸の男どもがいるなら、\n　全裸のお姉さんたちは……！？）"},
{"id": 40, "kind": "msg", "spk": "美香子", "ja": "女の子たちは騒動が収まるまで\n休みを与えてるわ～。"},
{"id": 41, "kind": "msg", "spk": "美香子", "ja": "桜井くんに見られたら、\nかわいそうだもの～。"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "なんだとぉ……！？"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "あ、いや、やだなあ……\nそんなイヤラシイ目で見ませんよ？"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "（意味ないな。\n　早くお茶のんで帰ろう）"},
{"id": 45, "kind": "msg", "spk": "美香子", "ja": "んッ……"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "どうかしたんですか、会長？"},
{"id": 47, "kind": "msg", "spk": "美香子", "ja": "いえ、なんでもないわ～。"},
{"id": 48, "kind": "msg", "spk": "", "ja": "　\n{1F}{11}バサバサッ　バサバサッ！"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "え、今、服が暴れたような……？"},
{"id": 50, "kind": "msg", "spk": "美香子", "ja": "くっ……\nそうなの……\nまだ足りなかったのね～。"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "（もしや、会長の服が飛ぼうと\n　してるのか！？）"},
{"id": 52, "kind": "msg", "spk": "", "ja": "　\n{1F}{11}バサバサッ　バサバサッ！"},
{"id": 53, "kind": "msg", "spk": "美香子", "ja": "だめよ、飛んでいったら～。\n会長、そんなの許さないわ～。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "（なんか、ヤバイ気がする！\n　でも、見てみたい！）"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "（むしろ、服が自由に飛び立つのを\n　応援したいくらいだ！\n　でも、やっぱり、ヤバイよなあ……）"},
{"id": 56, "kind": "choice", "spk": "", "ja": "さっさと帰る"},
{"id": 57, "kind": "choice", "spk": "", "ja": "じっくりと観察する"},
{"id": 58, "kind": "choice", "spk": "", "ja": "服を応援する"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "えーっと……\nじゃあ、会長は忙しそうなんで、\n俺は帰りますね！"},
{"id": 60, "kind": "msg", "spk": "美香子", "ja": "そうなの？\nごめんなさいね～。"},
{"id": 61, "kind": "msg", "spk": "美香子", "ja": "今度は、\nちゃんと服を調教しておくから～。\nそしたら、また遊びにきてね～。"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "（調教って言った！？）"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "は、ははは……\nそれじゃあ、おじゃましました～！"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "（服を調教って……\n　会長、何をしてたんだ？\n　そ、想像するのも怖すぎる……）"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "（これは……ッ！\n　じっくりと様子を\n　見なけりゃなりませんな！！）"},
{"id": 66, "kind": "msg", "spk": "", "ja": "　\n{1F}{11}バサバサッ　バサバサッ！"},
{"id": 67, "kind": "msg", "spk": "美香子", "ja": "う、く、この……ッ！！"},
{"id": 68, "kind": "msg", "spk": "智樹", "ja": "（お、おおお～～～！？）"},
{"id": 69, "kind": "msg", "spk": "美香子", "ja": "ごめんなさいね～。\n会長、用事ができちゃったから、\n席をはずすわ～。"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "くっ……\n逃がすかー！！"},
{"id": 71, "kind": "msg", "spk": "智樹", "ja": "俺は……見届けなきゃいけないんだ！！"},
{"id": 72, "kind": "msg", "spk": "美香子", "ja": "あら～？\n桜井くん、あいからわず楽しいわね～。"},
{"id": 73, "kind": "msg", "spk": "美香子", "ja": "でも、会長、ちょっと忙しいから、\nみんなに任せるわね～。"},
{"id": 74, "kind": "msg", "spk": "智樹", "ja": "え……みんな？"},
{"id": 75, "kind": "name", "spk": "男子生徒Ｈ", "ja": "黒服"},
{"id": 76, "kind": "msg", "spk": "黒服", "ja": "………………"},
{"id": 77, "kind": "msg", "spk": "智樹", "ja": "あ、いや、これは……"},
{"id": 78, "kind": "msg", "spk": "美香子", "ja": "たっぷり、自分の立場を\nわからせてあげるわ～。"},
{"id": 79, "kind": "msg", "spk": "智樹", "ja": "（隣の部屋から会長の声が？）"},
{"id": 80, "kind": "msg", "spk": "", "ja": "　\n{1F}{13}ビシィ！　バシンッ！"},
{"id": 81, "kind": "msg", "spk": "智樹", "ja": "（ウワッ……\n　なんか、嫌な音がしてる！）"},
{"id": 82, "kind": "msg", "spk": "智樹", "ja": "（会長の服は、いったい\n　何をされてるんだ……！？）"},
{"id": 83, "kind": "name", "spk": "男子生徒Ｈ", "ja": "黒服"},
{"id": 84, "kind": "msg", "spk": "黒服", "ja": "お客人は、こちらにどうぞ。"},
{"id": 85, "kind": "msg", "spk": "智樹", "ja": "ハッ！\nあ、お帰りは、こちらですね！\nそれでは、失礼しまッス！！"},
{"id": 86, "kind": "name", "spk": "男子生徒Ｈ", "ja": "黒服"},
{"id": 87, "kind": "msg", "spk": "黒服", "ja": "お帰りになられるなんてとんでも無い。\nこちらで、お嬢の用意した、\nとくべつなもてなしをお受け下さい。"},
{"id": 88, "kind": "msg", "spk": "智樹", "ja": "はっ！？\nや、やめ……"},
{"id": 89, "kind": "msg", "spk": "智樹", "ja": "ぎゃあああぁぁぁ～～～！？"},
{"id": 90, "kind": "msg", "spk": "智樹", "ja": "頑張れ、服！\n飛べる！　おまえは、飛べるんだ！\nお前なら飛べるって！"},
{"id": 91, "kind": "msg", "spk": "", "ja": "　\n{1F}{11}バサバサッ　バサバサッ！"},
{"id": 92, "kind": "msg", "spk": "智樹", "ja": "いけ！　今だ！\n飛び立て！！　あきらめるな！！"},
{"id": 93, "kind": "msg", "spk": "美香子", "ja": "桜井く～ん？"},
{"id": 94, "kind": "msg", "spk": "智樹", "ja": "ハッ！　しまった！！\nつい本音で行動してしまった！！"},
{"id": 95, "kind": "msg", "spk": "美香子", "ja": "うふふふ～、どうやらこの子だけ\nじゃなく、桜井くんにも調教……\nもとい説得が必要みたいね～？"},
{"id": 96, "kind": "msg", "spk": "智樹", "ja": "あわわ……いや、今のは、\n物のはずみというか！"},
{"id": 97, "kind": "msg", "spk": "智樹", "ja": "服ががんばってるのを、\nつい応援してしまっただけでして！"},
{"id": 98, "kind": "msg", "spk": "美香子", "ja": "そうね～。\n会長も、がんばってる桜井くんが\n見てみたいわ～。"},
{"id": 99, "kind": "msg", "spk": "智樹", "ja": "は？　がんばってる、俺？"},
{"id": 100, "kind": "msg", "spk": "美香子", "ja": "苦痛に、がんばって耐える\n桜井くんを見てみたいわ～。"},
{"id": 101, "kind": "msg", "spk": "智樹", "ja": "イヤアァァァ～～～！？\nお、俺には、そんな趣味はないッス！\n興味ないッスから！"},
{"id": 102, "kind": "msg", "spk": "美香子", "ja": "本気で嫌がるほうが\n楽しいわ～。"},
{"id": 103, "kind": "msg", "spk": "美香子", "ja": "さあ、服ともども、奥の部屋で調教……\nもとい、しつけをしてあげるわ～。"},
{"id": 104, "kind": "msg", "spk": "智樹", "ja": "ウギャアアアァァァ～～～！！"}
]}
