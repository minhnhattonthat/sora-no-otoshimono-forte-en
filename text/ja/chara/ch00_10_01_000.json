{"file": "_Data/Script/Chara/Chapter00/10/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ただいまー。\nいや、まいった、まいった。"},
{"id": 1, "kind": "msg", "spk": "イカロス", "ja": "お帰りなさい……マスター。\nどうでしたか？"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "ダメだな。\n商店街はどこもシャッターが\n下りてたよ。"},
{"id": 3, "kind": "msg", "spk": "ニンフ", "ja": "当然よね。\n服が飛んでいっちゃったんだもの。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "くっ……\nこんなことになるなんて……\n考えてもみなかったぜ。"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "みんな全裸でいつも通り\n生活してくれると思ってたのに！"},
{"id": 6, "kind": "msg", "spk": "ニンフ", "ja": "そんなわけにはいかないでしょ。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "そうだよなあ……"},
{"id": 8, "kind": "msg", "spk": "ニンフ", "ja": "それで、どうするのよ？\nお昼ご飯。夕飯も。"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "う～ん、家にあるもので\nしのぐしかないなぁ。"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "カップラーメンとか缶詰とか。"},
{"id": 11, "kind": "msg", "spk": "ニンフ", "ja": "べつに嫌いじゃないけど、\n同じのばかりなんて、\nいまいちね。"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "がまんしろって。"},
{"id": 13, "kind": "msg", "spk": "ニンフ", "ja": "まったく、トモキは\nロクなことしないんだから。"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "何を～！\nべつに俺が町中の服を持ち出して、\n遠くに飛ばしたわけじゃないぞ！？"},
{"id": 15, "kind": "msg", "spk": "ニンフ", "ja": "でも、トモキの願いでしょ？"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "願うくらい自由だろ！？"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "みんな全裸だったらいいのにって、\n考えちゃうくらい仕方ない事だろ！？"},
{"id": 18, "kind": "msg", "spk": "ニンフ", "ja": "そはらの前でも同じこと\n言ってみたら？"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "すんません、調子に乗ってました。\n俺の考えがいけなかったです。"},
{"id": 20, "kind": "msg", "spk": "ニンフ", "ja": "反省しなさいよね。"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "とても反省してます。"},
{"id": 22, "kind": "msg", "spk": "ニンフ", "ja": "んもう！"},
{"id": 23, "kind": "msg", "spk": "イカロス", "ja": "……お昼は、どうしましょうか？"},
{"id": 24, "kind": "msg", "spk": "ニンフ", "ja": "まず、家に何があるか、\n確認しないとね。"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "そうだな。"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "さて……探してみたわけだが。"},
{"id": 27, "kind": "msg", "spk": "ニンフ", "ja": "こっちの棚には、なんにもないわね。"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "そうか。\nイカロスのほうは、どうだ？"},
{"id": 29, "kind": "msg", "spk": "イカロス", "ja": "……ツナの缶詰が８個\nサバの缶詰が３個\nパスタが１袋ありました。"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "おっ、そうか。\nこっちにも缶詰があるぞ。"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "米も残ってるし。\nけっこう何とかなりそうだな！"},
{"id": 32, "kind": "msg", "spk": "ニンフ", "ja": "そうね。\nよかったじゃない。"},
{"id": 33, "kind": "msg", "spk": "ニンフ", "ja": "アルファー、\nあとは任せても大丈夫？"},
{"id": 34, "kind": "msg", "spk": "イカロス", "ja": "うん……。"},
{"id": 35, "kind": "msg", "spk": "ニンフ", "ja": "じゃあ、私は用事があるから、\nあとはお願いね。"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "用事……？\nああ、昼ドラの時間か。"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "んじゃ、俺たちは昼飯の用意をするか。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "といっても、ツナ缶か……\nドレッシングでもかけるか？"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "こいつを美味しく食べる料理とか\nできればいいんだけどな。"},
{"id": 40, "kind": "msg", "spk": "イカロス", "ja": "わかりました……マスター。\n美味しく料理します。"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "え？　料理できるのか？\n材料は缶詰だけだけど、大丈夫か？"},
{"id": 42, "kind": "msg", "spk": "イカロス", "ja": "はい……大丈夫です。"},
{"id": 43, "kind": "choice", "spk": "", "ja": "手伝う"},
{"id": 44, "kind": "choice", "spk": "", "ja": "任せる"},
{"id": 45, "kind": "choice", "spk": "", "ja": "勝負だ！"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "俺も手伝うよ、イカロス。"},
{"id": 47, "kind": "msg", "spk": "イカロス", "ja": "ありがとうございます……マスター。"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "でも、缶詰で料理って、どうするんだ？\n上手いこと盛りつければ\n見栄えはよくなるだろうけどさ。"},
{"id": 49, "kind": "msg", "spk": "イカロス", "ja": "ツナ缶を……量子変換します。"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "待て待て、カード使うのはナシ！\nなんかヤバイことになりそうだしな！"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "こんな状況になってるのも、\nカードが原因なんだし。"},
{"id": 52, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "知恵と工夫で乗り切るんだ！"},
{"id": 54, "kind": "msg", "spk": "イカロス", "ja": "はい……。"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "お昼、できたぞ！"},
{"id": 56, "kind": "msg", "spk": "ニンフ", "ja": "缶詰にしては\n時間かかったわね？"},
{"id": 57, "kind": "msg", "spk": "イカロス", "ja": "どうぞ……。"},
{"id": 58, "kind": "msg", "spk": "ニンフ", "ja": "なにこれ！？\nすごい豪華じゃないの！"},
{"id": 59, "kind": "msg", "spk": "ニンフ", "ja": "ステーキっぽい料理だの、\nスープだの……\n前菜にはカルパッチョ！？"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "ああ、イカロスがいろいろと\nやってくれてな。"},
{"id": 61, "kind": "msg", "spk": "ニンフ", "ja": "ほんとに缶詰だけなの！？"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "当然だろ、それしかなかったんだから。\nでも、この通り美味そうな料理に\nしてくれたよ。"},
{"id": 63, "kind": "msg", "spk": "ニンフ", "ja": "ほんと、おいしそうねー。\nさすがね、アルファー。"},
{"id": 64, "kind": "msg", "spk": "イカロス", "ja": "……マスターも、\n手伝ってくださいました。"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "皿を出したくらいだけどな。"},
{"id": 66, "kind": "msg", "spk": "ニンフ", "ja": "まぁ、いいじゃない！"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "そうだな。冷める前に食べるか。"},
{"id": 68, "kind": "msg", "spk": "ニンフ", "ja": "わーい！"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "いただきまーす！"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "じゃあ、任せるか。"},
{"id": 71, "kind": "msg", "spk": "智樹", "ja": "俺はニンフと待ってるよ。"},
{"id": 72, "kind": "msg", "spk": "イカロス", "ja": "はい……わかりました、マスター。"},
{"id": 73, "kind": "msg", "spk": "ニンフ", "ja": "もうできたの？"},
{"id": 74, "kind": "msg", "spk": "智樹", "ja": "イカロスが缶詰で料理を作るってさ。"},
{"id": 75, "kind": "msg", "spk": "ニンフ", "ja": "料理？\nアルファーは料理が上手いけど、\nさすがに缶詰だけじゃね。"},
{"id": 76, "kind": "msg", "spk": "ニンフ", "ja": "上手く盛りつけるくらいじゃないの？"},
{"id": 77, "kind": "msg", "spk": "智樹", "ja": "そうだと思うけどな。\nまぁ、任せてきた。"},
{"id": 78, "kind": "msg", "spk": "ニンフ", "ja": "ふーん。"},
{"id": 79, "kind": "msg", "spk": "イカロス", "ja": "……お待たせしました。"},
{"id": 80, "kind": "msg", "spk": "智樹", "ja": "おう。"},
{"id": 81, "kind": "msg", "spk": "智樹", "ja": "って、なんだ！？\nお刺身！？"},
{"id": 82, "kind": "msg", "spk": "ニンフ", "ja": "なんで、缶詰から、\nサラダが作られてるわけ！？"},
{"id": 83, "kind": "msg", "spk": "イカロス", "ja": "……量子変換、しました。"},
{"id": 84, "kind": "msg", "spk": "智樹", "ja": "大丈夫なのかよ！？"},
{"id": 85, "kind": "msg", "spk": "イカロス", "ja": "元に戻っても、食べられるもの\nですから……大丈夫です。"},
{"id": 86, "kind": "msg", "spk": "ニンフ", "ja": "なるほど。\n理屈は通ってるわね。\nそういうことなら食べましょうよ。"},
{"id": 87, "kind": "msg", "spk": "智樹", "ja": "う～～～ん。"},
{"id": 88, "kind": "msg", "spk": "ニンフ", "ja": "トモキは食べないの？"},
{"id": 89, "kind": "msg", "spk": "イカロス", "ja": "マスター……いけませんでしたか？"},
{"id": 90, "kind": "msg", "spk": "智樹", "ja": "あ、いや……\nちょっと驚いただけだ。"},
{"id": 91, "kind": "msg", "spk": "智樹", "ja": "よし、食べようぜ！"},
{"id": 92, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 93, "kind": "msg", "spk": "ニンフ", "ja": "わーい、いただきまーす！"},
{"id": 94, "kind": "msg", "spk": "智樹", "ja": "………………"},
{"id": 95, "kind": "msg", "spk": "智樹", "ja": "（缶詰が元になった刺身やサラダか。\n　美味いんだろうけど……\n　ちょっと恐いな）"},
{"id": 96, "kind": "msg", "spk": "智樹", "ja": "よし、勝負だ！"},
{"id": 97, "kind": "msg", "spk": "イカロス", "ja": "勝負……ですか？"},
{"id": 98, "kind": "msg", "spk": "智樹", "ja": "俺も料理する！\nイカロスも料理する！"},
{"id": 99, "kind": "msg", "spk": "智樹", "ja": "この缶詰で、より美味い料理を\n作ったほうの勝ちだ！"},
{"id": 100, "kind": "msg", "spk": "イカロス", "ja": "はい……わかりました。"},
{"id": 101, "kind": "msg", "spk": "ニンフ", "ja": "なにしてたのよ？\nずいぶん時間かけてたけど……"},
{"id": 102, "kind": "msg", "spk": "ニンフ", "ja": "え！？\nちょっとトモキ、なにそれ！？"},
{"id": 103, "kind": "msg", "spk": "智樹", "ja": "……ツナ＆サバの煮付けサラダ油\nドレッシング塩辛～中略～炒めだ！"},
{"id": 104, "kind": "msg", "spk": "ニンフ", "ja": "………………"},
{"id": 105, "kind": "msg", "spk": "ニンフ", "ja": "なんか、黒くてドロドロしてて、\n気味が悪いんだけど？"},
{"id": 106, "kind": "msg", "spk": "智樹", "ja": "いろいろやってたら途中から\nおかしくなってな……\n焼けば食えると思ったら、こんな風に。"},
{"id": 107, "kind": "msg", "spk": "ニンフ", "ja": "それ食べられるわけ？"},
{"id": 108, "kind": "msg", "spk": "智樹", "ja": "う、美味いに決まってるだろ！"},
{"id": 109, "kind": "msg", "spk": "ニンフ", "ja": "アルファーの料理はおいしそうね。"},
{"id": 110, "kind": "msg", "spk": "イカロス", "ja": "ありがとう……ニンフ。"},
{"id": 111, "kind": "msg", "spk": "ニンフ", "ja": "アルファー、私のぶんもあるんでしょ？"},
{"id": 112, "kind": "msg", "spk": "イカロス", "ja": "うん。"},
{"id": 113, "kind": "msg", "spk": "ニンフ", "ja": "トモキは、それ食べなさいよね。\nもったいないから残したらダメよ？"},
{"id": 114, "kind": "msg", "spk": "智樹", "ja": "……はい。"}
]}
