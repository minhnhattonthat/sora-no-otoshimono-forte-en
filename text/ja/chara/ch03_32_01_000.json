{"file": "_Data/Script/Chara/Chapter03/32/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "守形", "ja": "智樹、肉が焼けたぞ。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "守形先輩、ありがとうッス！"},
{"id": 2, "kind": "msg", "spk": "守形", "ja": "見月、アストレア、\n２人のぶんの肉も焼けたぞ。"},
{"id": 3, "kind": "msg", "spk": "そはら", "ja": "はい、ありがとうございます。"},
{"id": 4, "kind": "msg", "spk": "アストレア", "ja": "わーい、お肉！\nありがとうございまーす！"},
{"id": 5, "kind": "msg", "spk": "美香子", "ja": "美味しいわね～。"},
{"id": 6, "kind": "msg", "spk": "守形", "ja": "うむ……"},
{"id": 7, "kind": "msg", "spk": "守形", "ja": "智樹、ちょっといいか？"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "はい、なんですか？"},
{"id": 9, "kind": "msg", "spk": "守形", "ja": "コンロで使う炭と水が\n足りなくなってきた。"},
{"id": 10, "kind": "msg", "spk": "守形", "ja": "クルマから持ってくるから、\n肉を焼いててくれ。"},
{"id": 11, "kind": "msg", "spk": "美香子", "ja": "デザートと飲み物も欲しいわね～。"},
{"id": 12, "kind": "msg", "spk": "守形", "ja": "そうだな。\n持ってこよう。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "（先輩１人で大丈夫なのか？\n　結構、大荷物になるよなぁ。）"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "（俺が手伝った方が、\n　早く終わるんじゃないのか？）"},
{"id": 15, "kind": "choice", "spk": "", "ja": "指示通り、代わりに肉を焼く"},
{"id": 16, "kind": "choice", "spk": "", "ja": "あえて、荷物持ちを手伝う"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "分かりました、\n俺が代わりに肉を焼いておきます！"},
{"id": 18, "kind": "msg", "spk": "守形", "ja": "そうか、では頼む。"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "へーい、肉、焼くよー。\nどんどん焼くよー！"},
{"id": 20, "kind": "msg", "spk": "アストレア", "ja": "お肉ください！"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "ほいよ！"},
{"id": 22, "kind": "msg", "spk": "アストレア", "ja": "わーい！！"},
{"id": 23, "kind": "msg", "spk": "ニンフ", "ja": "私ももらえる？"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "おう！"},
{"id": 25, "kind": "msg", "spk": "ニンフ", "ja": "ん？　ちょっとトモキ、\nそれちゃんと焼けてないじゃない！？"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "あれ？　そうだったか？"},
{"id": 27, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}ジュージュー！"},
{"id": 28, "kind": "msg", "spk": "ニンフ", "ja": "………………"},
{"id": 29, "kind": "msg", "spk": "ニンフ", "ja": "ちょっとトモキ、まだなの？"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "わ、わかってるって。\nほらよ。"},
{"id": 31, "kind": "msg", "spk": "ニンフ", "ja": "うん、今度は、ちゃんと\n焼けてるわね。"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "ほら、そはらにも。"},
{"id": 33, "kind": "msg", "spk": "そはら", "ja": "トモちゃん、ありがとう。"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "えへへ……"},
{"id": 35, "kind": "msg", "spk": "アストレア", "ja": "お肉ちょうだい！"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "早いな！"},
{"id": 37, "kind": "msg", "spk": "美香子", "ja": "桜井くん、会長にも\nもらえるかしら～？"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "は、はい……\nちょっと待っててくださいね。"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "（うう……さっきまでは、\n　ほとんど待たずに\n　食べられたのに……）"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "（よく考えると、この人数の食べる\n　ペースに合わせて肉を焼くのって、\n　実はすごいことなんじゃねえの？）"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "はい、焼けました！"},
{"id": 42, "kind": "msg", "spk": "アストレア", "ja": "わーい、お肉ー！"},
{"id": 43, "kind": "msg", "spk": "美香子", "ja": "いただくわ～。"},
{"id": 44, "kind": "msg", "spk": "美香子", "ja": "ん？\n……桜井く～ん？"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "は、はい！？"},
{"id": 46, "kind": "msg", "spk": "美香子", "ja": "会長、もっと生のほうが好みだわ～。"},
{"id": 47, "kind": "msg", "spk": "ニンフ", "ja": "私は、しっかり焼いてあるのが\n好きなんだけどね。"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "うっ……"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "（それぞれの焼き加減の好みまで\n　あるのかよ！）"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "（だがな、\n　一度代わりにやると言ったからには\n　男として引くわけにはいかん！）"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "（やってやるぜ！\n　うおおおおおーーー！）"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "（へへへ……燃え尽きちまったぜ……\n　焼肉だけに……）"},
{"id": 53, "kind": "msg", "spk": "守形", "ja": "……戻ったぞ。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "せ、先輩、あんた……\nあんたすげえよ！"},
{"id": 55, "kind": "msg", "spk": "守形", "ja": "なんだ、急に？"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "いや、参りました。\n俺には肉焼くの無理っぽいんで、\n別のことを手伝わせてください。"},
{"id": 57, "kind": "msg", "spk": "守形", "ja": "ふむ……では、炭を入れるのを\n手伝ってもらうか。"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "わかりました！"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "俺も荷物持ちに行きますよ！\n２人で運んだ方が、早く終りますし。"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "イカロス、\n肉、焼けるよな？"},
{"id": 61, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "んじゃ、行ってくる！"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "クルマまで来てみたけど……\n荷物、けっこう多いですね。"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "炭の箱に水だけでも大きいのに、\n飲み物とデザートの\nクーラーＢＯＸだもんな。"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "うお、このクーラーＢＯＸ、重てえ。\n飲み物って、どんだけ入ってるんだ！？"},
{"id": 66, "kind": "msg", "spk": "守形", "ja": "それはデザートだ。\n氷が入っているせいだろう。"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "デザート、何なんすかね？"},
{"id": 68, "kind": "msg", "spk": "守形", "ja": "アイスクリーム、だそうだ。"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "夏の浜辺でアイスクリームか……\nすげー贅沢だなー。"},
{"id": 70, "kind": "msg", "spk": "守形", "ja": "そっちは俺が持とう。"},
{"id": 71, "kind": "msg", "spk": "智樹", "ja": "いや、大丈夫ですから！\n重たいの持たなかったら、\n手伝いに来た意味がないですし！"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "そりゃっ！！"},
{"id": 73, "kind": "msg", "spk": "守形", "ja": "……そうか。"},
{"id": 74, "kind": "msg", "spk": "智樹", "ja": "ふぅ～～～、ようやく着いたぜ。"},
{"id": 75, "kind": "msg", "spk": "智樹", "ja": "（先輩も、かなりの荷物を持ってきた\n　はずだけど、顔色ひとつ変えないで\n　すぐに料理してるよ……すげえな）"},
{"id": 76, "kind": "msg", "spk": "", "ja": "　\n{1F}{14}ジュー、ジュー……"},
{"id": 77, "kind": "msg", "spk": "守形", "ja": "智樹、肉が焼けたぞ。\n食べるといい。"},
{"id": 78, "kind": "msg", "spk": "智樹", "ja": "うぃーっス！"},
{"id": 79, "kind": "msg", "spk": "守形", "ja": "それと、冷えたジュースだ。\nご苦労だったな。"},
{"id": 80, "kind": "msg", "spk": "智樹", "ja": "あざーっす！"},
{"id": 81, "kind": "msg", "spk": "守形", "ja": "智樹。\n助かった。感謝する。"}
]}
