{"file": "_Data/Script/Chara/Chapter03/52/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ん？　どうしたんだよ、アストレア、\nこんなところで寝転んで。"},
{"id": 1, "kind": "msg", "spk": "アストレア", "ja": "あ～～～……\nお腹が空いたの。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "へ？\nだって、おまえ、めちゃめちゃ\n食べてただろ？"},
{"id": 3, "kind": "msg", "spk": "アストレア", "ja": "そうだけど……\nずっと泳ぐ練習したりして、\nたくさん動いたから。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "まぁ、たしかに\nいっぱい動いた日は、\n腹が減るものだけどな。"},
{"id": 5, "kind": "msg", "spk": "アストレア", "ja": "もう一度、バーベキューしたーい！"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "もう肉は残ってないと思うぞ。"},
{"id": 7, "kind": "msg", "spk": "アストレア", "ja": "それは、わかってるけど～。"},
{"id": 8, "kind": "msg", "spk": "アストレア", "ja": "でも、まだ道具は使えるでしょ？"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "まだ全部片付けてはいないけどな。\nそういや、\nまだ残ってる食材があったかも？"},
{"id": 10, "kind": "msg", "spk": "アストレア", "ja": "食べた～い！"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "余ったもの、自分で焼いて\n食べたらどうだ？"},
{"id": 12, "kind": "msg", "spk": "アストレア", "ja": "スガタさんが、１人でコンロを\n使っちゃダメって言ってたし……"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "たしかに、アストレアが\n１人で使うのは心配だな。"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "ソーセージとか、焼かなくても\n食べられる物は残ってないのか？"},
{"id": 15, "kind": "msg", "spk": "アストレア", "ja": "そのまま食べられる物は、\nバーベキューの時にみんなで、\n食べちゃったみたいだし……"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "うーん。"},
{"id": 17, "kind": "choice", "spk": "", "ja": "何とかしてやる"},
{"id": 18, "kind": "choice", "spk": "", "ja": "海には魚がいるぞ"},
{"id": 19, "kind": "choice", "spk": "", "ja": "がまんしろ"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "しょうがねえな、何とかしてやるか。"},
{"id": 21, "kind": "msg", "spk": "アストレア", "ja": "ほんと！？"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "あんまり期待するなよ？"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "えーっと……食材は……"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "キャベツやニンジンはあるけど、\n肉はほとんどないな。"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "キャベツとかニンジンとか\n生でかじるか？"},
{"id": 26, "kind": "msg", "spk": "アストレア", "ja": "う～、お肉が食べたい……"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "贅沢、言うなって。\nコンロは使えるから、\n野菜炒めとか、どうだ？"},
{"id": 28, "kind": "msg", "spk": "アストレア", "ja": "うん、それなら。"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "あとは……おっ！？\n焼きそばの麺があるじゃねえか！"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "いらっしゃい！　いらっしゃい！\n焼きそばあるよ～！"},
{"id": 31, "kind": "msg", "spk": "アストレア", "ja": "わーい！\nほしい、ほしいー！"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "はいよ、焼きそば一丁！！"},
{"id": 33, "kind": "msg", "spk": "アストレア", "ja": "わ～い！\n美味しい～！"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "海で食べる焼きそばは、\nまた独特の美味さがあるよな！"},
{"id": 35, "kind": "msg", "spk": "そはら", "ja": "わ～、いいニオイ。"},
{"id": 36, "kind": "msg", "spk": "ニンフ", "ja": "なにやってんのよ？"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "おっ、ニンフも食べるか？\n焼きそば、美味いぞ！"},
{"id": 38, "kind": "msg", "spk": "ニンフ", "ja": "さっき食べたばかりだけど……\nでも、ちょっと食べてみたいかも。"},
{"id": 39, "kind": "msg", "spk": "そはら", "ja": "私も！\nトモちゃん、もらえる？"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "はいよ、やきそば二丁！"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "お、イカロス、おまえも食べろよ、\n美味いぞ！"},
{"id": 42, "kind": "msg", "spk": "イカロス", "ja": "はい……いただきます、マスター。"},
{"id": 43, "kind": "msg", "spk": "アストレア", "ja": "おかわりー！！"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "おう、食べな、食べな！\nたくさんあるぜ！！"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "（きっかけは、アストレアの\n　わがままだったけど……）"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "（結果的に、みんな喜んでくれてる\n　みたいでなによりだぜ！）"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "食べ物かあ……\n海には魚がいるぞ。"},
{"id": 48, "kind": "msg", "spk": "アストレア", "ja": "あ、そうか！\nねぇねぇ、それって\nすっごく多いのかな？"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "おう、それはもう、\nいっぱいいるぞ。"},
{"id": 50, "kind": "msg", "spk": "アストレア", "ja": "わかった！　捕ってくる！"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "おう、気をつけろよ～。"},
{"id": 52, "kind": "msg", "spk": "アストレア", "ja": "お魚ー！"},
{"id": 53, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}どぼーん！"},
{"id": 54, "kind": "msg", "spk": "ニンフ", "ja": "ちょっ！？\nデルタ、なにやってんの！？"},
{"id": 55, "kind": "msg", "spk": "イカロス", "ja": "アストレアが……！？"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "魚、捕りに行くって言ってたぞ。"},
{"id": 57, "kind": "msg", "spk": "ニンフ", "ja": "ばか言わないで！\nデルタは、泳げないのよ！？"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "あ……"},
{"id": 59, "kind": "msg", "spk": "アストレア", "ja": "ごばごべごぼぼぼ～～～！？"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "アストレアー！！"},
{"id": 61, "kind": "msg", "spk": "アストレア", "ja": "ぶはー！　ぜはー！"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "ふ～～～、びっくりしたぜ。"},
{"id": 63, "kind": "msg", "spk": "ニンフ", "ja": "すこしは、後先考えなさいよね、\nデルタ！"},
{"id": 64, "kind": "msg", "spk": "アストレア", "ja": "ううぅ……すみません。"},
{"id": 65, "kind": "msg", "spk": "イカロス", "ja": "無事で、よかった。"},
{"id": 66, "kind": "msg", "spk": "アストレア", "ja": "ぐす……お魚。"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "がまんしろって。\nさっき、あんなに食べたんだしさ。"},
{"id": 68, "kind": "msg", "spk": "アストレア", "ja": "う～、お腹、すいたー！"},
{"id": 69, "kind": "msg", "spk": "アストレア", "ja": "あ、海にはお魚がいるよね！？"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "ん？　まあ、そうだな。"},
{"id": 71, "kind": "msg", "spk": "アストレア", "ja": "捕ってくる！"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "おまえ、泳げるのか？"},
{"id": 73, "kind": "msg", "spk": "アストレア", "ja": "ガクッ……\n泳げないです……"},
{"id": 74, "kind": "msg", "spk": "智樹", "ja": "イカロスみたいに深いところでも\n歩ければ、いいんだろうけどな。"},
{"id": 75, "kind": "msg", "spk": "智樹", "ja": "おとなしく、バーベキューの残り物の\n野菜でもつまんでろよ。"},
{"id": 76, "kind": "msg", "spk": "アストレア", "ja": "うー、お肉が食べたかったなー。"},
{"id": 77, "kind": "msg", "spk": "アストレア", "ja": "ぼりぼり……"},
{"id": 78, "kind": "msg", "spk": "アストレア", "ja": "あ……\nけっこう美味しいです！"},
{"id": 79, "kind": "msg", "spk": "智樹", "ja": "（まあ、結果オーライかな）"}
]}
