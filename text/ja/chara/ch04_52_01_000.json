{"file": "_Data/Script/Chara/Chapter04/52/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "美香子", "ja": "ねぇ～桜井く～ん。\n会長、聞きたいことがほかにも\n色々とあるんだけど～。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "勘弁してくださいよー。"},
{"id": 2, "kind": "msg", "spk": "イカロス", "ja": "……。"},
{"id": 3, "kind": "msg", "spk": "美香子", "ja": "会長は今ず～っと、\n桜井くんのことばかり\n考えちゃってるのよ～。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "そんなこと言われても、\nだまされないですよ！"},
{"id": 5, "kind": "msg", "spk": "イカロス", "ja": "……。"},
{"id": 6, "kind": "msg", "spk": "美香子", "ja": "会長～、桜井くんのすべてが\n知りたいのよ～。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "解剖しそうな勢いで\n言わないでください！"},
{"id": 8, "kind": "msg", "spk": "イカロス", "ja": "……。"},
{"id": 9, "kind": "msg", "spk": "美香子", "ja": "さっくらっいく～ん♪"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "うひゃあっ！？\n会長、いきなり出てこないで\nくださいよ！"},
{"id": 11, "kind": "msg", "spk": "イカロス", "ja": "……。"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "って、どうしたイカロス、\nさっきから。"},
{"id": 13, "kind": "msg", "spk": "イカロス", "ja": "はい。マスターと会長さんは、\nとても仲が良いのかと思いまして。"},
{"id": 14, "kind": "msg", "spk": "美香子", "ja": "うふふ～。\nさすがイカロスちゃん、\nよくわかってるわ～。"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "いや、ぜんっぜんわかってませんから。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "いいかイカロス、\nさっきまでのやり取りを見て、\nどこが仲良しに見えるんだ？"},
{"id": 17, "kind": "msg", "spk": "イカロス", "ja": "違うのですか？"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "そりゃあ{16}{17}。"},
{"id": 19, "kind": "msg", "spk": "美香子", "ja": "うふふ～。私はいいけど、\nウチの若い衆は血の気が多いのよね～。"},
{"id": 20, "kind": "msg", "spk": "美香子", "ja": "私と仲が悪い、なんて言う人がいたら、\n次の日にその人は空美町から\nいなくなっているかも～。"},
{"id": 21, "kind": "msg", "spk": "美香子", "ja": "あ、空美町じゃなくて、\nこの世から～かしら～。"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "……な、仲が悪くなんかはない、\nですよ。"},
{"id": 23, "kind": "msg", "spk": "イカロス", "ja": "では、マスターは会長さんと一緒に\nいると楽しいのですね。"},
{"id": 24, "kind": "msg", "spk": "美香子", "ja": "楽しいわ～～～すご～く。"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "会長だけでしょ……。"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "（特に今は、俺の煩悩が本当に消えたか\n　どうか、疑ってきてるみたいだしな）"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "（実際消えるどころか、妄想力のおかげ\n　でますます元気なんだが。\n　はっはっは）"},
{"id": 28, "kind": "msg", "spk": "イカロス", "ja": "私に何かお手伝いできないでしょうか。"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "ん？"},
{"id": 30, "kind": "msg", "spk": "イカロス", "ja": "マスターに楽しく過ごして頂くのが、\n私たちエンジェロイド本来の\n使命ですから。"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "ん～……。"},
{"id": 32, "kind": "choice", "spk": "", "ja": "そういう考え方はやめろって"},
{"id": 33, "kind": "choice", "spk": "", "ja": "なら１つ頼みが"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "だから、そういう考え方はやめろって。\n俺のためにどうこうじゃなくて{16}{17}。"},
{"id": 35, "kind": "msg", "spk": "美香子", "ja": "そうね～、それなら会長と桜井くんを\n２人っきりで、ゆっくり過ごさせて\n欲しいわ～。"},
{"id": 36, "kind": "msg", "spk": "美香子", "ja": "誰にも邪魔されないように、\n見張っていて欲しいの～。"},
{"id": 37, "kind": "msg", "spk": "イカロス", "ja": "承知しました。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "待て、待って！\nなんで会長が命令してるんですか！？"},
{"id": 39, "kind": "msg", "spk": "美香子", "ja": "あら～？　桜井くんは、\n会長と濃密な時間を過ごすのが、\nイヤなのかしら～。"},
{"id": 40, "kind": "msg", "spk": "美香子", "ja": "テキ屋のおじさんのところへお買い物\nに行ったり～。"},
{"id": 41, "kind": "msg", "spk": "美香子", "ja": "電流の流れる金網に囲まれたリングで、\nゆっくり拳と拳を交えよう、\nと思ったんだけど～。"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "それ、デートとか友情を深める儀式じゃ\nなくて、単なる命の削り合いですから！"},
{"id": 43, "kind": "msg", "spk": "イカロス", "ja": "…………。"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "なら１つ、頼みがあるんだが。"},
{"id": 45, "kind": "msg", "spk": "イカロス", "ja": "なんなりとどうぞ、マスター。"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "ここで、お前が、\n会長の相手をしてくれ。"},
{"id": 47, "kind": "msg", "spk": "美香子", "ja": "あら～。"},
{"id": 48, "kind": "msg", "spk": "イカロス", "ja": "私が、ですか？"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "ああ。お前にしかできないことなんだ。"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "できるだけ長～く、ゆ～っくり、\n会長の相手をしていてくれ。"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "（そして俺は、イカロスが会長の相手を\n　している内にさっさと逃げ……）"},
{"id": 52, "kind": "msg", "spk": "美香子", "ja": "ねぇイカロスちゃん？"},
{"id": 53, "kind": "msg", "spk": "イカロス", "ja": "はい。"},
{"id": 54, "kind": "msg", "spk": "美香子", "ja": "２人で桜井くんを\n極楽へ招待したくな～い？"},
{"id": 55, "kind": "msg", "spk": "イカロス", "ja": "極楽……。"},
{"id": 56, "kind": "msg", "spk": "美香子", "ja": "そう。\nと～っても気持ちよくなれるのよ～。\n主に桜井くんだけが、だけど。"},
{"id": 57, "kind": "msg", "spk": "イカロス", "ja": "マスターが、気持ちよく……。"},
{"id": 58, "kind": "msg", "spk": "イカロス", "ja": "承知しました。"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "承知すんな！　違うから、\n会長の言ってる意味は\n絶対違うから！！"},
{"id": 60, "kind": "msg", "spk": "美香子", "ja": "うふふ～。\n痛いのは最初だけよ～。"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "はぁ、まったくもう……\nいいからイカロスはもう帰れよ。"},
{"id": 62, "kind": "msg", "spk": "イカロス", "ja": "あ……。"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "ニンフだって家に１人じゃ\nつまんないだろうしさ。"},
{"id": 64, "kind": "msg", "spk": "イカロス", "ja": "はい……。"},
{"id": 65, "kind": "msg", "spk": "美香子", "ja": "桜井くん～罪な男ね～。"},
{"id": 66, "kind": "msg", "spk": "智樹", "ja": "何がですかっ！？"},
{"id": 67, "kind": "msg", "spk": "イカロス", "ja": "……あの、マスター。"},
{"id": 68, "kind": "msg", "spk": "智樹", "ja": "ん？"},
{"id": 69, "kind": "msg", "spk": "イカロス", "ja": "ニンフと一緒に、\nまた来てもいいですか？"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "ん？　なんだ？\n学校にいたいのか？"},
{"id": 71, "kind": "msg", "spk": "イカロス", "ja": "……。"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "……はぁ。\nわかったよ、好きにしろ。"},
{"id": 73, "kind": "msg", "spk": "イカロス", "ja": "……はい。ありがとうございます。"},
{"id": 74, "kind": "msg", "spk": "美香子", "ja": "よかったわね～イカロスちゃん。\nさぁ、一緒に桜井くん“で”\n遊びましょう～。"},
{"id": 75, "kind": "msg", "spk": "智樹", "ja": "“で”じゃなくて、せめて“と”！"},
{"id": 76, "kind": "msg", "spk": "イカロス", "ja": "はい。"},
{"id": 77, "kind": "msg", "spk": "智樹", "ja": "？　あれ、今お前、笑った？"},
{"id": 78, "kind": "msg", "spk": "イカロス", "ja": "……そう、ですか？\nすみません、わかりません。"},
{"id": 79, "kind": "msg", "spk": "智樹", "ja": "ん～、見間違いかなぁ。\n……あ。"},
{"id": 80, "kind": "msg", "spk": "智樹", "ja": "（イカロスが俺と会長の間であれこれ\n　しようとしたのって……）"},
{"id": 81, "kind": "msg", "spk": "智樹", "ja": "（ひょっとして、\n　自分も交ざりたかっただけ？\n　だから今、楽しそう……？）"},
{"id": 82, "kind": "msg", "spk": "イカロス", "ja": "…………。"},
{"id": 83, "kind": "msg", "spk": "智樹", "ja": "（いやいや、まさか、ね）"}
]}
