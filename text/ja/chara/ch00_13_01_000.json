{"file": "_Data/Script/Chara/Chapter00/13/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "右、よーし。\n左、よーし。\n前後、よーし。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "よしよし……\nみんな、いませんね、と。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "せっかく空美町の服が全て\n飛んでいったというのに、\n家でじっとしてる手はないよな！"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "このクラス名簿を使って、\nクラス中の女たちの家を……\n家庭訪問してやるぜ～！"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "うひょひょひょひょひょ～！"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "全裸生活、密着２４時！"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "この目で、あますところなく\n観察しつくしてやるぜ～！"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "さて、まずクラスの女子の家でも\n家庭訪問しましょうかねえ？"},
{"id": 8, "kind": "msg", "spk": "そはら", "ja": "なにやってるの、トモちゃん？"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "いや、だから、\nまず誰の家に……"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "うおぉぉぉっと！！\nそはら！？"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "な、なんでもないぞ！？\nちょっと散歩にな！"},
{"id": 12, "kind": "msg", "spk": "そはら", "ja": "……クラス名簿を持って？"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "（ギクッ！）"},
{"id": 14, "kind": "msg", "spk": "そはら", "ja": "どうせ女の子の家を\nのぞきに行こうとしてたんでしょ？"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "（ギクギクッ！！）"},
{"id": 16, "kind": "msg", "spk": "そはら", "ja": "ホントにトモちゃんは……"},
{"id": 17, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}ドグシャァ！！"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "ぐはっ！！"},
{"id": 19, "kind": "msg", "spk": "そはら", "ja": "エッチなんだから！！"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "わ、わかったよ。"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "んじゃ、俺はこれで……"},
{"id": 22, "kind": "msg", "spk": "そはら", "ja": "うん、じゃあ……\nって、行かせるわけないでしょ！？"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "チィッ……\nごまかせなかったか。"},
{"id": 24, "kind": "msg", "spk": "そはら", "ja": "トモちゃん……"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "（や……やばい、このままだと\n　更にそはらのチョップが……\n　どうしたらいいんだ！？）"},
{"id": 26, "kind": "choice", "spk": "", "ja": "家に戻る"},
{"id": 27, "kind": "choice", "spk": "", "ja": "クラス名簿をそはらに渡す"},
{"id": 28, "kind": "choice", "spk": "", "ja": "そはらから訪問する"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "ふぅ……仕方ないな。\n家に戻るよ。"},
{"id": 30, "kind": "msg", "spk": "そはら", "ja": "そうそう、エッチな目的で\n家から出ちゃダメだよ！？"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "ちぇー。\nせっかくのチャンスなのに。"},
{"id": 32, "kind": "msg", "spk": "そはら", "ja": "まったくもう！\nトモちゃんは、いつまで経っても\nエッチなんだから！"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "な～んてな！\nそはらが居なくなってから\nこっそり出直したのさ。"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "俺が簡単にあきらめるわけ\nないだろうが！\nヴァーカ！　ヴァーカ！"},
{"id": 35, "kind": "msg", "spk": "そはら", "ja": "………………"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "ハッ！？\nまさか！？\nずっと待っていただと！？"},
{"id": 37, "kind": "msg", "spk": "そはら", "ja": "私が、トモちゃんの考えてること……\nわからないわけないでしょ？"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "ヒッ！？"},
{"id": 39, "kind": "msg", "spk": "そはら", "ja": "トモちゃんのバカーーー！！"},
{"id": 40, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}ドゴォォ！！"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "ぐはぁぁぁっ！？"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "わかったよ、そはら。\nほら、クラス名簿。"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "これを渡すから、\nかんべんしてくれよな。"},
{"id": 44, "kind": "msg", "spk": "そはら", "ja": "う、うん……"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "（ククク……甘いなそはら！）"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "（もう女子の家の住所は\n　頭にインプット済みだぜ！）"},
{"id": 47, "kind": "msg", "spk": "そはら", "ja": "……ねぇ、トモちゃん？"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "ん？　なんだよ、そはら？"},
{"id": 49, "kind": "msg", "spk": "そはら", "ja": "トモちゃんて、\nエッチなことが関係すると、\nすごく頭いいよね。"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "（ギクッ！）"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "そ、そんなこと……\nないんじゃないか？"},
{"id": 52, "kind": "msg", "spk": "そはら", "ja": "覚えてるんでしょ？\nみんなの住所……"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "（ギクギクッ！！）"},
{"id": 54, "kind": "msg", "spk": "そはら", "ja": "忘れさせる……！！"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "ええ！？\nそ、そはらさん？\nなにするんですかー！？"},
{"id": 56, "kind": "msg", "spk": "そはら", "ja": "トモちゃんの頭から、みんなの住所を\n忘れさせるんだよ！！"},
{"id": 57, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}ズバババババーーー！！"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "うぎゃあああぁぁぁ～～～っ！？"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "こうなったら、目の前から家庭訪問だ！\nそはら、覚悟ォーーー！！"},
{"id": 60, "kind": "msg", "spk": "そはら", "ja": "ええ！？\nなんでそうなるの！？"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "うるせー！\nそはらのところにも\n行くつもりだったんだ！"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "ちょっと順番が\n狂っただけじゃー！"},
{"id": 63, "kind": "msg", "spk": "そはら", "ja": "え……わ、私のとこにも、\n来るつもりだったんだ……？"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "うひょひょひょひょひょー！\n当然だろうが！！\n見逃してやらないぜー！！"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "チア服はあっても、パジャマは\nないだろうからな！！\nとなれば、当然寝る時は……"},
{"id": 66, "kind": "msg", "spk": "智樹", "ja": "他のみんなと同じ、全裸っ！"},
{"id": 67, "kind": "msg", "spk": "そはら", "ja": "そ、そうだけど……"},
{"id": 68, "kind": "msg", "spk": "智樹", "ja": "ならば、訪問しないはずがなかろう！"},
{"id": 69, "kind": "msg", "spk": "そはら", "ja": "なんて事、想像してるのっ！\nトモちゃんのバカーーーーっ！！"},
{"id": 70, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ドガッ！！"},
{"id": 71, "kind": "msg", "spk": "智樹", "ja": "はぐぁっ！？"}
]}
