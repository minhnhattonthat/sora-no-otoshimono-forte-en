{"file": "_Data/Script/Chara/Chapter02/30/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "あー、シール探しとか、\n面倒になってきたなー。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "んなこと言ったら、\n会長に殺されそうだけど……"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "しばらく、この辺りを散歩でもして\n気分転換するくらい、いいよな？"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "ん？\nあれは……？"},
{"id": 4, "kind": "msg", "spk": "アストレア", "ja": "じぃぃぃーーーー……"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "アストレアか。\nなにやってんだ？"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "ずっと川の中を\n覗いてるみたいだけど……？"},
{"id": 7, "kind": "msg", "spk": "アストレア", "ja": "……じゅるり。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "よ、よだれ？\n見てるのは……あれって、サワガニか？"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "……まさか、サワガニを食うつもりじゃ\nねえだろうな？"},
{"id": 10, "kind": "msg", "spk": "アストレア", "ja": "じぃぃぃーーーー……えいっ！"},
{"id": 11, "kind": "msg", "spk": "アストレア", "ja": "って、イタアァァー！？"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "手、出して、はさまれてるし……"},
{"id": 13, "kind": "choice", "spk": "", "ja": "サワガニを獲ってやる"},
{"id": 14, "kind": "choice", "spk": "", "ja": "放っておく"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "ちょっと手助けしてやるか。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "おーい、アストレアー。"},
{"id": 17, "kind": "msg", "spk": "アストレア", "ja": "ん？\nなんだ、アンタか。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "おまえ、サワガニを\n狙ってるのか？"},
{"id": 19, "kind": "msg", "spk": "アストレア", "ja": "う、うん。\nカニって食べたことないし。でも、\nスガタさんが美味しいって言ってた。"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "俺も食べたことはないな。\n捕まえるの手伝ってやるよ。"},
{"id": 21, "kind": "msg", "spk": "アストレア", "ja": "えっ、ホント！？"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "サワガニくらい、ガキの頃は\nよく捕まえてたからな。\n任せとけ！"},
{"id": 23, "kind": "msg", "spk": "アストレア", "ja": "ダ、ダメー！"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "どぅわっと！！\nな、なんだよ急に大声出して？"},
{"id": 25, "kind": "msg", "spk": "アストレア", "ja": "あんたも、カニを捕まえて\n食べる気でしょ！？"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "食べねーよ！\n横取りなんてしねえよ！"},
{"id": 27, "kind": "msg", "spk": "アストレア", "ja": "信じられない！"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "そこは信じろよ！\nおい、カニは、どこに行った？"},
{"id": 29, "kind": "msg", "spk": "アストレア", "ja": "え！？\nあ……いなくなっちゃった。"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "石とかひっくり返してみろ。\n隠れてるから。"},
{"id": 31, "kind": "msg", "spk": "アストレア", "ja": "うん！"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "よーし、俺もやるぞ！"},
{"id": 33, "kind": "msg", "spk": "アストレア", "ja": "とわちゃー！"},
{"id": 34, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}バシャーン！"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "うわっ、石を投げるなよ！\n危ねーなー！"},
{"id": 36, "kind": "msg", "spk": "アストレア", "ja": "あ、ごめん。"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "気をつけろよな。\nよいしょっと。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "おっ、アストレア、いたぞ。"},
{"id": 39, "kind": "msg", "spk": "アストレア", "ja": "あ、ホントだ！！"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "待ってろよ、\n今、捕まえるから……なっと！"},
{"id": 41, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ばしゃッ！"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "うへへ……ゲットー。"},
{"id": 43, "kind": "msg", "spk": "アストレア", "ja": "すごーーーい！"},
{"id": 44, "kind": "msg", "spk": "アストレア", "ja": "ちょっと、ちょうだい！\nちょうだいよ！"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "わかってるって、ほらよ。"},
{"id": 46, "kind": "msg", "spk": "アストレア", "ja": "わーい！"},
{"id": 47, "kind": "msg", "spk": "アストレア", "ja": "あーん！"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "わっ！　そのまんま食うのかよ！？"},
{"id": 49, "kind": "msg", "spk": "アストレア", "ja": "え、ダメなの？"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "たぶん、腹を壊すぞ。"},
{"id": 51, "kind": "msg", "spk": "アストレア", "ja": "そうなの！？"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "ちゃんと煮るか揚げるかしてから\n食わないとな。"},
{"id": 53, "kind": "msg", "spk": "アストレア", "ja": "そうなんだー。\nお魚と一緒にスガタさんに\n料理してもらう！"},
{"id": 54, "kind": "msg", "spk": "アストレア", "ja": "えへへ。"},
{"id": 55, "kind": "msg", "spk": "アストレア", "ja": "あ、あの……"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "ん？"},
{"id": 57, "kind": "msg", "spk": "アストレア", "ja": "アンタにも、一口あげるから！"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "おう、楽しみにしてるよ。"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "……お魚と一緒に焼く？\nあいつが持ってたのは、\n長靴じゃねえか？"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "まぁ、いいか。"},
{"id": 61, "kind": "msg", "spk": "アストレア", "ja": "ギャー！　鼻、はさまれたー！？\nは、はな、はなせー！"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "………………\n楽しそうだしな。"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "さて、もう少しその辺ぶらぶら\nしてくるか。"},
{"id": 64, "kind": "msg", "spk": "アストレア", "ja": "もー許さない！\n絶対に捕まえてやるんだからー！"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "山の中で散歩ってのも\nいいもんだな。"},
{"id": 66, "kind": "msg", "spk": "アストレア", "ja": "とうりゃーーー！！"},
{"id": 67, "kind": "msg", "spk": "アストレア", "ja": "って、イッタァアーーーイ！"},
{"id": 68, "kind": "msg", "spk": "智樹", "ja": "アストレアのやつ、\nまだやってるのか……？"},
{"id": 69, "kind": "msg", "spk": "アストレア", "ja": "きゃーーー！！"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "山を楽しんでるみたいだな。"}
]}
