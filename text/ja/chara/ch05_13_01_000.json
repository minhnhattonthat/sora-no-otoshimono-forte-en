{"file": "_Data/Script/Chara/Chapter05/13/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "おっと、お宝ＤＶＤのパッケージを\n出しっぱなしだったぜ。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "ん？　やけに軽いな。\nって、中身が空っぽじゃねえか！"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "えーっと……\n昨日、じっくり鑑賞してから……"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "デッキに入れっぱなしだ！"},
{"id": 4, "kind": "msg", "spk": "ニンフ", "ja": "あはははっ！"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "（ニンフがＴＶ、見てるよ）"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "（しかも、すげえ楽しそうな顔して\n　見てるな～）"},
{"id": 7, "kind": "msg", "spk": "ニンフ", "ja": "はぁ～、昼ドラって面白いわね～。\nずっとやってればいいのに。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "また昼ドラ見てるのか。"},
{"id": 9, "kind": "msg", "spk": "ニンフ", "ja": "うん。\nトモキ、どうしたの？\n私になにか用？"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "あ、いや。\nちょっと忘れ物をしてな。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "（え～っと、\n　ＤＶＤのリモコン、どこだ？）"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "（ああ、あった。\n　リモコンは手にしたものの……\n　さ～て、どうしましょうかね？）"},
{"id": 13, "kind": "msg", "spk": "ニンフ", "ja": "どうかしたの？"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "あ、いや、なんでもないけどさ。"},
{"id": 15, "kind": "msg", "spk": "ニンフ", "ja": "ふーん。\nお菓子、食べる？"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "おう、サンキュ。"},
{"id": 17, "kind": "msg", "spk": "ニンフ", "ja": "あはは……\nやっぱり面白いわね～。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "（まだ時間が掛かりそうだけど、\n　どうするか？）"},
{"id": 19, "kind": "choice", "spk": "", "ja": "とにかくＤＶＤ回収"},
{"id": 20, "kind": "choice", "spk": "", "ja": "ニンフに聞く"},
{"id": 21, "kind": "choice", "spk": "", "ja": "ひたすら待つ"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "ちょっとＤＶＤ取り出すぞ。"},
{"id": 23, "kind": "msg", "spk": "ニンフ", "ja": "え？"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "取り出し、と。"},
{"id": 25, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ブツッ！"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "あれ？　ＴＶが消えちまったぞ。"},
{"id": 27, "kind": "msg", "spk": "ニンフ", "ja": "なにすんのよ！\nせっかく良いところだったのに！"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "これ、昼ドラを録画した\nＤＶＤじゃねえか！？"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "ここに入ってたやつ、どうした！？"},
{"id": 30, "kind": "msg", "spk": "ニンフ", "ja": "取り出して、そこに置いてあるわよ！"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "うおぉぉぉ～～～！？\n俺のお宝ＤＶＤが、床に転がってる！？"},
{"id": 32, "kind": "msg", "spk": "ニンフ", "ja": "変なもの入れとかないでよね！\n昼ドラのムードが台無しじゃない！"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "うるせー！\nいきなり再生しなかっただけ、\nありがたく思えー！"},
{"id": 34, "kind": "msg", "spk": "ニンフ", "ja": "せっかく盛りあがってたのに、\nトモキのバカ～～～～～！！"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "うお！？\nあいつ、どっか行っちゃったよ……"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "しょうがねえな。\nとりあえず、昼ドラＤＶＤは\n入れ直しておくか……"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "ニンフ、デッキにお宝ＤＶＤが入って\nるんだけど、取っていいか？"},
{"id": 38, "kind": "msg", "spk": "ニンフ", "ja": "それなら、出しておいたわよ。"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "ん？　うおっ！？\n俺のお宝ＤＶＤが、床に！"},
{"id": 40, "kind": "msg", "spk": "ニンフ", "ja": "大切なものなら、忘れないで\n持ち帰りなさいよね。"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "うう……"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "ごめんよ、お宝ＤＶＤ……\n俺が悪かった！"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "これからは、\nもっと大切にするからな！"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "（なんか、昼ドラ、盛りあがってるし、\n　待ってやるか）"},
{"id": 45, "kind": "msg", "spk": "ニンフ", "ja": "ん？\nトモキも見るの？"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "あ、ああ……"},
{"id": 47, "kind": "msg", "spk": "ニンフ", "ja": "今、すっごくいいところなのよ！"},
{"id": 48, "kind": "msg", "spk": "ニンフ", "ja": "このドラマの見所はね{16}{15}"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "（うお……なんか勘違いされた。\n　すげえ語りだしたぞ……）"},
{"id": 50, "kind": "msg", "spk": "ニンフ", "ja": "まぁ、今、見てるのは、\nその録画なんだけど。"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "（……録画までして\n　何度も見てるのかよ！？）"},
{"id": 52, "kind": "msg", "spk": "ニンフ", "ja": "{16}{17}というわけなのよ。\nねっ！？\nすごく盛りあがってるでしょ！？"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "ああ、そうだな。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "（うーむ、いつまで続くんだろう？\n　まぁ、楽しそうだからいいか）"}
]}
