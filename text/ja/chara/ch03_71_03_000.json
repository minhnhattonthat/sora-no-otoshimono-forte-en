{"file": "_Data/Script/Chara/Chapter03/71/03_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "そはら、アイスキャンディーなんて\nどうだ？"},
{"id": 1, "kind": "msg", "spk": "そはら", "ja": "え？　そんなの持ってきてるの？"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "ニンフに借りた機器で作れるんだ。"},
{"id": 3, "kind": "msg", "spk": "そはら", "ja": "あ、うん。\n食べたいんだけど……"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "どうした、お腹おさえて。\nもう入らないか？"},
{"id": 5, "kind": "msg", "spk": "そはら", "ja": "そ、そんなことないんだけど、\n冷やしたらよくないかなって。"},
{"id": 6, "kind": "msg", "spk": "そはら", "ja": "（ううぅ……\n　今日、ちょっと食べ過ぎて、\n　体重が気になるよ……）"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "この暑さで冷やすってことも\nないと思うけどな。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "いろんな味が出せるらしいぞ。\nチョコ味とか。"},
{"id": 9, "kind": "msg", "spk": "そはら", "ja": "そんなのもあるんだ？"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "食べてみるか？"},
{"id": 11, "kind": "msg", "spk": "そはら", "ja": "う、うん。\nせっかくだしね。海だし。\n今日、いっぱい泳いで運動したし！"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "んじゃ、出すぞ！"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "ほれ。"},
{"id": 14, "kind": "msg", "spk": "そはら", "ja": "うん、ありがとう。"},
{"id": 15, "kind": "msg", "spk": "そはら", "ja": "あ、ほんとに美味しい！\nこれ、すごく美味しいよ、トモちゃん。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "へー、俺にも、ちょっとくれよ。"},
{"id": 17, "kind": "msg", "spk": "そはら", "ja": "え？　いいけど……"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "ぱく！"},
{"id": 19, "kind": "msg", "spk": "そはら", "ja": "あっ！？"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "ん？　もしゃもしゃ……\nおお、たしかに意外な美味さ！"},
{"id": 21, "kind": "msg", "spk": "そはら", "ja": "か……かん……かんせ……\nキキキ……"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "あれ？　どうしたら、そはら？\n俺、かじったの多すぎたか？"},
{"id": 23, "kind": "msg", "spk": "そはら", "ja": "かんせつ……キ……"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "んんん？"},
{"id": 25, "kind": "msg", "spk": "そはら", "ja": "トモちゃんの、エッチ！"},
{"id": 26, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}スパーン！"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "なんでだーーー！？"}
]}
