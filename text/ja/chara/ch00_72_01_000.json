{"file": "_Data/Script/Chara/Chapter00/72/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "そはら", "ja": "ごめんくださーい。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "よお、そはらか。どうしたんだ？"},
{"id": 2, "kind": "msg", "spk": "そはら", "ja": "ごめんね、トモちゃん、\nお醤油、切らしちゃって。"},
{"id": 3, "kind": "msg", "spk": "そはら", "ja": "すこし、わけてくれないかな？"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "おう、いいぞ。"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "イカロス、\nそはらが醤油くれってさ。"},
{"id": 6, "kind": "msg", "spk": "イカロス", "ja": "すみません、マスター……\nお醤油はウチでも切らして\nしまいました。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "ええ！？"},
{"id": 8, "kind": "msg", "spk": "そはら", "ja": "そうなんだ、無理言ってごめんね。\nかといって、お店も閉まってるし……"},
{"id": 9, "kind": "msg", "spk": "イカロス", "ja": "いえ……他にも必要なものがあるので、\n今から買ってきます。"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "隣町までか？\n大丈夫なのか、そんな格好で？"},
{"id": 11, "kind": "msg", "spk": "イカロス", "ja": "はい……大丈夫です。"},
{"id": 12, "kind": "msg", "spk": "イカロス", "ja": "では、行ってきます。"},
{"id": 13, "kind": "msg", "spk": "そはら", "ja": "ごめんね、トモちゃん。"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "ウチも買い出しが必要だったし、\n気にするなよ。"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "ちょっと待ってれば、\nすぐ戻ってくるよ。"},
{"id": 16, "kind": "msg", "spk": "そはら", "ja": "うん。それじゃ、トモちゃんと\nお話しして待ってようかな。"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "ああ……\nそういや、イカロスって料理とか\n家事全般が、ひと通り出来るよなぁ。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "どこで、覚えてきたのやら……。\nまあ、お陰で男のひとり暮らしとしては\nすげぇ助かってるけどな。"},
{"id": 19, "kind": "msg", "spk": "そはら", "ja": "わ、私だってお料理とか出来るもん。\nいつだってお手伝いにいくよ！"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "でも、お前って……。"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "目玉焼きが下手で、\n裁縫がすごい下手で、\nよく花を育てるけど枯らしちゃって……"},
{"id": 22, "kind": "msg", "spk": "そはら", "ja": "………………"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "（し、しまった、言い過ぎたか……！？\n　別の話題で気をそらさないと……）"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "そ、そういえば、そはらは、\nチョ、チョココロネと\nハッサクが好きだったよな！"},
{"id": 25, "kind": "msg", "spk": "そはら", "ja": "あ、うん。\n智ちゃん、覚えてたんだ？"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "も、もちろん。"},
{"id": 27, "kind": "msg", "spk": "そはら", "ja": "他に……もっと好きなもの……あるよ？"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "そうなのか？\nえーっと……\nたしか、他にそはらが好きなのは……"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "花なら……\nコスモスとたんぽぽが好きだったよな？"},
{"id": 30, "kind": "msg", "spk": "そはら", "ja": "そんなことまで、よく覚えてるね。"},
{"id": 31, "kind": "msg", "spk": "そはら", "ja": "でも……花よりも、\nもっと好きなものが、あるよ？"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "そうなの？\nなんだろうな？\n食べ物か？"},
{"id": 33, "kind": "msg", "spk": "イカロス", "ja": "……ただいま、戻りました。"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "おっ、おつかれさん！"},
{"id": 35, "kind": "msg", "spk": "そはら", "ja": "さすがイカロスさん、早いねー！"},
{"id": 36, "kind": "msg", "spk": "イカロス", "ja": "お醤油です、そはらさん。"},
{"id": 37, "kind": "msg", "spk": "そはら", "ja": "ありがとう！"},
{"id": 38, "kind": "msg", "spk": "そはら", "ja": "またね、トモちゃん。"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "そはら、もっと好きなものって、\nなんだよ？"},
{"id": 40, "kind": "msg", "spk": "そはら", "ja": "え……\nそれは……"},
{"id": 41, "kind": "msg", "spk": "そはら", "ja": "ナイショ！！"}
]}
