{"file": "_Data/Script/Chara/Chapter00/30/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "右、よーし。\n左、よーし。\n前後、よーし。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "家の外に、誰もいませんね、と。\nそはら、よーし。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "クックック……。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "突撃！\nクラスメートの家、\n夏の夜編！"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "今の空美町には服がない！"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "つまり、パジャマもない！\nみんな夜だろうと、全裸のはず！！"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "見に行くしかないだろ！\n当然の行動ではないだろうか！？"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "いざ、少女たちの家へ……！！"},
{"id": 8, "kind": "msg", "spk": "ニンフ", "ja": "なにやってるのよ、トモキ？"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "うおわぁぁぁ～～～！？"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "なんだ、ニンフか……\nどうしたんだよ、おまえ。\nこんな時間まで起きてたのか？"},
{"id": 11, "kind": "msg", "spk": "ニンフ", "ja": "エンジェロイドは眠らないのよ。"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "あ、そうだったな。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "（うぬぬ……。\n　そはらには見つからないと思ったのに\n　まさかの伏兵だぜ）"},
{"id": 14, "kind": "msg", "spk": "ニンフ", "ja": "トモキ、こんな時間に\n何してるのよ？"},
{"id": 15, "kind": "choice", "spk": "", "ja": "星を見にいくんだ"},
{"id": 16, "kind": "choice", "spk": "", "ja": "安全を確認しにいくんだ"},
{"id": 17, "kind": "choice", "spk": "", "ja": "おとなしく部屋に戻る"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "星を見にいくんだ！"},
{"id": 19, "kind": "msg", "spk": "ニンフ", "ja": "星なんて見てどうするの？"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "そりゃ、おまえ……\nキ、キレイだろ？\nたまに見たくなるんだよ。"},
{"id": 21, "kind": "msg", "spk": "ニンフ", "ja": "ふーん……？"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "（よし！　そのまま興味をなくして\n　あっち行ってくれ！）"},
{"id": 23, "kind": "msg", "spk": "ニンフ", "ja": "なら……私も見てみようかしら。"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "へ？\nあ、いや、つまんないものだぞ？\n動かないし！"},
{"id": 25, "kind": "msg", "spk": "ニンフ", "ja": "いいじゃない。\nトモキが見たいっていうもの、\n私も興味あるし。"},
{"id": 26, "kind": "msg", "spk": "ニンフ", "ja": "それとも、他にも用事あるの？"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "な、ない！　まったくないぞ！\n朝まで見てようぜ！"},
{"id": 28, "kind": "msg", "spk": "ニンフ", "ja": "朝まで！？\nいいわよ、ちょうど退屈してたから！"},
{"id": 29, "kind": "msg", "spk": "ニンフ", "ja": "ほんと……キレイね……\n今まで気づかなかった。"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "（はぁ……なんでこんな……\n　今頃は全裸の少女たちを\n　見ているはずなのに）"},
{"id": 31, "kind": "msg", "spk": "ニンフ", "ja": "ねぇ、トモキ？"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "ふぅ……\nなんだ？"},
{"id": 33, "kind": "msg", "spk": "ニンフ", "ja": "私、こんなふうに星を見たの\n初めて。"},
{"id": 34, "kind": "msg", "spk": "ニンフ", "ja": "ぜんぜん知らなかった。\n夜空がこんなに素敵だなんて……"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "……そうか。"},
{"id": 36, "kind": "msg", "spk": "ニンフ", "ja": "エンジェロイドは眠らないから、\n夜がとても長いの。"},
{"id": 37, "kind": "msg", "spk": "ニンフ", "ja": "でも……退屈したら、\nときどきは星を眺めることにするわ。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "……うん。"},
{"id": 39, "kind": "msg", "spk": "", "ja": "その日は、朝まで\nニンフにつき合った。"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "安全を確認しにいくんだ！"},
{"id": 41, "kind": "msg", "spk": "ニンフ", "ja": "……は？"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "今、この町の少女たちには服がない！\nどう暮らしているのか心配だから、\n安全を確認するんだ！"},
{"id": 43, "kind": "msg", "spk": "ニンフ", "ja": "あんたなに言ってんの、トモキ！？"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "心配だろ！？\n無防備な姿で不安なまま、\n朝を待っている……。"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "安心して、ぐっすり寝ることも出来ない\nそんな状況をほっておけるか！"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "全裸の女の子たちが、\n俺が来るのを待ってるんだー！！"},
{"id": 47, "kind": "msg", "spk": "ニンフ", "ja": "そんなわけないでしょ、バカ！"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "いや、待ってるね！\n待ってるに違いない！"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "だって、全裸なんだぞ！？"},
{"id": 50, "kind": "msg", "spk": "ニンフ", "ja": "あんたのせいでしょ！？\n誰も好きでやってないわよ！！"},
{"id": 51, "kind": "msg", "spk": "ニンフ", "ja": "ぜんぜん反省してないみたいね……\nちょっと、そこに座りなさい！"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "いや、俺には様子を見に行くという\n使命が……！"},
{"id": 53, "kind": "msg", "spk": "ニンフ", "ja": "座る！"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "は、はい……"},
{"id": 55, "kind": "msg", "spk": "", "ja": "その日は、朝まで\nニンフに説教されてしまった。"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "い、いや、今から部屋に\n戻るとこだぞ？"},
{"id": 57, "kind": "msg", "spk": "ニンフ", "ja": "そうなの？\n出かけようとしてなかった？"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "まさか！！"},
{"id": 59, "kind": "msg", "spk": "ニンフ", "ja": "ふーん……\n何しに下りてきたの？"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "（ギクゥ！）"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "えっと、だな……"},
{"id": 62, "kind": "msg", "spk": "ニンフ", "ja": "うん。"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "えーと……………………\nや、夜食が欲しくてな。"},
{"id": 64, "kind": "msg", "spk": "ニンフ", "ja": "ああ、そういうこと。\nでも何もないのよね。"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "そうなんだよ。"},
{"id": 66, "kind": "msg", "spk": "ニンフ", "ja": "あ、お菓子、食べる？\nすこしあるわよ？"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "お、おう、サンキュ。"},
{"id": 68, "kind": "msg", "spk": "ニンフ", "ja": "それじゃあね、トモキ。\nおやすみ！"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "ああ、おやすみ……"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "エンジェロイドは眠らないか……\n夜に出かけるのは無理だな。"},
{"id": 71, "kind": "msg", "spk": "", "ja": "結局、おとなしく寝たのだった。"}
]}
