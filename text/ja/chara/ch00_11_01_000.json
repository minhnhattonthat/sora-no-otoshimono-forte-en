{"file": "_Data/Script/Chara/Chapter00/11/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "そはら", "ja": "トモちゃん、こんにちは。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "おう、そはらか。どうしたんだ？"},
{"id": 2, "kind": "msg", "spk": "そはら", "ja": "ちょっと聞きたいことがあるの。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "ん？　なんだ？"},
{"id": 4, "kind": "msg", "spk": "そはら", "ja": "トモちゃんの家に、もう他の服って、\n残ってないかな？"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "服？\nチアの衣装だけじゃ、ダメなのか？"},
{"id": 6, "kind": "msg", "spk": "そはら", "ja": "私じゃなくて、アストレアさんのだよ。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "アストレア？\nあいつ、どこにいるんだ？"},
{"id": 8, "kind": "msg", "spk": "そはら", "ja": "さっき、見かけて\n連れてきたんだけど……"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "全裸で出歩いてたのか！？"},
{"id": 10, "kind": "msg", "spk": "そはら", "ja": "まぁ、そうなるけど……\nエッチな想像したらダメだよ？"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "で、でも、全裸だったんだろ！？"},
{"id": 12, "kind": "msg", "spk": "そはら", "ja": "ワラみたいなものを体に巻きつけて、\n隠れながら歩いてたよ。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "なんだ。\nんで、連れてきたってことは……\n今、家にいるのか？"},
{"id": 14, "kind": "msg", "spk": "そはら", "ja": "うん。"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "挨拶してくる！"},
{"id": 16, "kind": "msg", "spk": "そはら", "ja": "……トモちゃん？"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "冗談だって。\n全裸だもんな！　無理だよな！"},
{"id": 18, "kind": "msg", "spk": "そはら", "ja": "うん。\nだから、服を貸してあげて。"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "そうは言っても、\nもう残ってないと思うけどな～。"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "アストレアも普通のサイズじゃ\nないから、適当なやつだと\n入らないだろうし……"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "ん？　あ、待てよ！"},
{"id": 22, "kind": "msg", "spk": "そはら", "ja": "どうしたの？"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "こいつでどうだ！？\n服っていうのとは、ちょっと違うけど！"},
{"id": 24, "kind": "msg", "spk": "そはら", "ja": "エプロン？\nなんで、そんなものまであるの？"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "いろいろと使い道があるんだよ、\nエプロン！"},
{"id": 26, "kind": "msg", "spk": "そはら", "ja": "え！？　お料理のとき使うものでしょ？\nそれにアストレアさん、\n今、下に何も着てないし。"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "全裸で身につけてるのが正しいと、\n俺は思う。"},
{"id": 28, "kind": "msg", "spk": "そはら", "ja": "ダメだよ！トモちゃん！！\nそれは服の代わりにはならないでしょ。\nもっと真面目に考えてよねっ！"},
{"id": 29, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}コンコン……"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "ん？　もしかして、アストレアか？"},
{"id": 31, "kind": "msg", "spk": "アストレア", "ja": "う、うん。"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "なんだよ、気にせず入ってこいよ！"},
{"id": 33, "kind": "msg", "spk": "アストレア", "ja": "そんなこと、\nできるわけないでしょ！？"},
{"id": 34, "kind": "msg", "spk": "そはら", "ja": "そうだよ、トモちゃん！"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "わ、わるかったよ。"},
{"id": 36, "kind": "msg", "spk": "アストレア", "ja": "あの……\nソハラさん、服、ありましたか？"},
{"id": 37, "kind": "msg", "spk": "そはら", "ja": "ごめんなさい、アストレアさん、\nちょっと見当たらないみたいなの。"},
{"id": 38, "kind": "msg", "spk": "アストレア", "ja": "うう……この格好じゃ、\nスガタさんとこへ、\nご飯をもらいにも行けないです。"},
{"id": 39, "kind": "msg", "spk": "アストレア", "ja": "お腹減りました……\nバカのせいで！\nバカがバカなお願いしたせいで！！"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "そんなこと言われてもなぁー。"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "（守形先輩なら、どんな格好してても、\n　ぜんぜん気にしないだろうけど）"},
{"id": 42, "kind": "choice", "spk": "", "ja": "裸エプロンじゃ！"},
{"id": 43, "kind": "choice", "spk": "", "ja": "さすがにコレじゃあな"},
{"id": 44, "kind": "choice", "spk": "", "ja": "服はないけど菓子なら"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "裸エプロンじゃ！\nうひょひょひょ～！"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "いいじゃないか、アストレア、\nこのエプロンをつければ！"},
{"id": 47, "kind": "msg", "spk": "アストレア", "ja": "エプロン……？"},
{"id": 48, "kind": "msg", "spk": "そはら", "ja": "ちょっと、トモちゃん！？"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "大丈夫だって、前から見れば、\nちゃんと体が隠れてるんだから！"},
{"id": 50, "kind": "msg", "spk": "そはら", "ja": "後ろからはどうなるの！？"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "ほぼ全裸！"},
{"id": 52, "kind": "msg", "spk": "アストレア", "ja": "そんなの、ダメー！\n恥ずかしいじゃないの！！\nバカ！　バーカ！"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "待て、アストレア！\nいいか、よく聞くんだ！"},
{"id": 54, "kind": "msg", "spk": "アストレア", "ja": "な、なに？"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "さらに、横から見ると、\n見えそうで見えなくて、\nでもやっぱり見えるという……"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "裸エプロンには、ものすごい魅力が\nいっぱいなんだぞ！！"},
{"id": 57, "kind": "msg", "spk": "アストレア", "ja": "そ、そんな恥ずかしい魅力、\nいらないわよ！！"},
{"id": 58, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}スパーン！！"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "ぐはっ！！"},
{"id": 60, "kind": "msg", "spk": "そはら", "ja": "トモちゃんのエッチ！"},
{"id": 61, "kind": "msg", "spk": "そはら", "ja": "そんなの着たって、\nアストレアさんが困ってることの\n解決にはならないでしょ！？"},
{"id": 62, "kind": "msg", "spk": "アストレア", "ja": "うう……\nもういいです、ソハラさん。"},
{"id": 63, "kind": "msg", "spk": "アストレア", "ja": "ソイツから服を借りようなんて、\n私が間違ってました。"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "イテテ……"},
{"id": 65, "kind": "msg", "spk": "アストレア", "ja": "ううぅ……バーカ！！"},
{"id": 66, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}タタタタ……"},
{"id": 67, "kind": "msg", "spk": "そはら", "ja": "アストレアさん！？"},
{"id": 68, "kind": "msg", "spk": "智樹", "ja": "なんだ、アストレアのやつ、\n帰っちまったのか？"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "ちぇっ、いいアイディアだと、\n思ったんだけどなー。"},
{"id": 70, "kind": "msg", "spk": "そはら", "ja": "この……\nトモちゃんの、バカーーー！！"},
{"id": 71, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}ズゴババババ……ッ！！"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "うぎゃああああぁぁぁぁ～～～！？"},
{"id": 73, "kind": "msg", "spk": "智樹", "ja": "とはいえ、まじめな話……\nエプロンじゃなあ？"},
{"id": 74, "kind": "msg", "spk": "そはら", "ja": "うん……ごめんね、アストレアさん。\nお役に立てなくって。"},
{"id": 75, "kind": "msg", "spk": "アストレア", "ja": "ううん……いいんです、ソハラさん。"},
{"id": 76, "kind": "msg", "spk": "アストレア", "ja": "これというのも……\n悪いのは、ぜんぶ、ソイツだから。"},
{"id": 77, "kind": "msg", "spk": "智樹", "ja": "お、俺！？"},
{"id": 78, "kind": "msg", "spk": "そはら", "ja": "そうだよね。\nトモちゃんが、変なこと\n考えるからいけないんだよ。"},
{"id": 79, "kind": "msg", "spk": "智樹", "ja": "そんなこと言われてもなー……"},
{"id": 80, "kind": "msg", "spk": "そはら", "ja": "仕方ないから、アストレアさんには、\n何か食べる物を渡しておくね。"},
{"id": 81, "kind": "msg", "spk": "智樹", "ja": "ああ、わかった。"},
{"id": 82, "kind": "msg", "spk": "智樹", "ja": "アストレア、食べる物がなかったら、\nいつでもウチに来ていいんだからな？\nなんとかするからさ。"},
{"id": 83, "kind": "msg", "spk": "アストレア", "ja": "……うん。"},
{"id": 84, "kind": "msg", "spk": "智樹", "ja": "まぁ、エプロンだけじゃ、\n意味ないもんな。"},
{"id": 85, "kind": "msg", "spk": "智樹", "ja": "あ、そうだ。\n服はないんだけどさ……"},
{"id": 86, "kind": "msg", "spk": "アストレア", "ja": "なに？"},
{"id": 87, "kind": "msg", "spk": "智樹", "ja": "たしか、このへんに……\nああ、あった。"},
{"id": 88, "kind": "msg", "spk": "そはら", "ja": "お菓子？"},
{"id": 89, "kind": "msg", "spk": "智樹", "ja": "ああ、そんなに多くないけどさ。\nアストレア、扉を\nちょっとだけ開けるぞ？"},
{"id": 90, "kind": "msg", "spk": "アストレア", "ja": "………………うん。\nちょっとだけね。"},
{"id": 91, "kind": "msg", "spk": "智樹", "ja": "ほら、これ食べてくれよ。"},
{"id": 92, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}ガサガサ……"},
{"id": 93, "kind": "msg", "spk": "アストレア", "ja": "わぁ、お菓子だ！\nいいの！？"},
{"id": 94, "kind": "msg", "spk": "智樹", "ja": "ウチも買い物ができなくて、\nろくなもんないんだ。\nかんべんしてくれよな、アストレア。"},
{"id": 95, "kind": "msg", "spk": "アストレア", "ja": "……うん。"},
{"id": 96, "kind": "msg", "spk": "アストレア", "ja": "あの……ありがと……"},
{"id": 97, "kind": "msg", "spk": "智樹", "ja": "え、なんだって？"},
{"id": 98, "kind": "msg", "spk": "アストレア", "ja": "その……バ、バーカ！！"},
{"id": 99, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}タタタタ……"},
{"id": 100, "kind": "msg", "spk": "そはら", "ja": "あ、アストレアさん\n行っちゃった！？"},
{"id": 101, "kind": "msg", "spk": "智樹", "ja": "そうみたいだな。\nまぁ、また来るだろ。"}
]}
