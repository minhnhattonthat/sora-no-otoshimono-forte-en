{"file": "_Data/Script/Chara/Chapter02/32/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ん？　あれは？"},
{"id": 1, "kind": "msg", "spk": "そはら", "ja": "～～～♪"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "おーい、そはらー。"},
{"id": 3, "kind": "msg", "spk": "そはら", "ja": "あ、トモちゃん。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "なにしてんだ、\nこんなとこで？"},
{"id": 5, "kind": "msg", "spk": "そはら", "ja": "ん～、また散歩かな。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "またか？\nいいかげん、疲れないか？"},
{"id": 7, "kind": "msg", "spk": "そはら", "ja": "ちょっとは疲れたかも。\nでも、帰りまでじっとしてるのが、\nもったいなくて。"},
{"id": 8, "kind": "msg", "spk": "そはら", "ja": "花火とかキャンプファイアーとか\nスッゴく楽しかったから。"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "さっきも、そんなこと言ってたな。"},
{"id": 10, "kind": "msg", "spk": "そはら", "ja": "あはは……昨日はホントに\nすっごく楽しかったもん。\nじっとしてられないくらい。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "まーな。楽しかったよなぁ。"},
{"id": 12, "kind": "msg", "spk": "そはら", "ja": "夏の思い出ってやつかな。"},
{"id": 13, "kind": "msg", "spk": "そはら", "ja": "このまま帰っちゃうのが、\nもったいないくらいだね。"},
{"id": 14, "kind": "choice", "spk": "", "ja": "また来年も来ればいいじゃん"},
{"id": 15, "kind": "choice", "spk": "", "ja": "俺は早く帰りたいけどなー"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "また来年も来ればいいじゃん。"},
{"id": 17, "kind": "msg", "spk": "そはら", "ja": "え？"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "来年も……再来年だって来れるだろ？"},
{"id": 19, "kind": "msg", "spk": "そはら", "ja": "あはっ、そうだね！\nトモちゃん、また来ようね。"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "おう！"},
{"id": 21, "kind": "msg", "spk": "そはら", "ja": "えへへ……\n来年も来れたらうれしいな。"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "そんときは、肉も食いたいな！\n焚き火で串とか焼きたいぜ。"},
{"id": 23, "kind": "msg", "spk": "そはら", "ja": "それも楽しそうだね。"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "肉とか大量に買い込んでさ。\nみんなで焼いたら楽しいぞ。"},
{"id": 25, "kind": "msg", "spk": "そはら", "ja": "うん。そうだね。"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "一番喜びそうなのは、\nアストレアだけどな！"},
{"id": 27, "kind": "msg", "spk": "そはら", "ja": "あははっ、そうだね！"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "もちろん、魚を釣って、\nそれ焼くのもいいな！"},
{"id": 29, "kind": "msg", "spk": "そはら", "ja": "朝の焼き魚、\nおいしかったもんね。"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "カレーもそうだけど、\nなんで外で食う食事って、あんなに\nうまいんだろうな？"},
{"id": 31, "kind": "msg", "spk": "そはら", "ja": "うーん、景色がいいから？\n外で食べる開放感とか？"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "開放感か……"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "じゃぁ全裸で食えば、\nもっと飯がうまくなるんじゃないか！？"},
{"id": 34, "kind": "msg", "spk": "そはら", "ja": "トモちゃん……"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "はい？"},
{"id": 36, "kind": "msg", "spk": "そはら", "ja": "ダメだからね？"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "……は、はい。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "（今度、家で試してみよう！\n　いや、むしろ外で！？）"},
{"id": 39, "kind": "msg", "spk": "そはら", "ja": "私は……\nまた花火がやりたいなぁ。"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "花火もいいな。"},
{"id": 41, "kind": "msg", "spk": "そはら", "ja": "でも、トモちゃんが、またねずみ花火で\nイタズラしそうだけど……"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "フッフッフ。"},
{"id": 43, "kind": "msg", "spk": "そはら", "ja": "やっぱり、またやる気なんでしょ！？\nまったくもう！"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "はっはっはっはっ！"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "俺は早く帰りたいけどなー。"},
{"id": 46, "kind": "msg", "spk": "そはら", "ja": "えっ、なんで…？"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "甘いな、そはら。"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "確かに山でのキャンプは楽しい。\nだが、ひとつ肝心なところが\n抜けてるんだ！"},
{"id": 49, "kind": "msg", "spk": "そはら", "ja": "肝心なところ？\nたとえば、なにが？"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "フッ……\nそんなの決まってるだろ。"},
{"id": 51, "kind": "msg", "spk": "そはら", "ja": "……？"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "山に足りないもの！\nそれは……！"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "露・出・度・だ！！"},
{"id": 54, "kind": "msg", "spk": "そはら", "ja": "…………。\n………………はい？"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "だ・か・ら・！\n露出度だよ！　露出度！\n山には圧倒的に肌色が足りない！"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "山では服を脱ぐ必要がないしな。"},
{"id": 57, "kind": "msg", "spk": "そはら", "ja": "うん、そうだけど……。"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "だからさぁ、山は違うんだよ。\nここは登山家たちの戦場だよ。\n俺のフィールドじゃねぇんだよ。"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "そう！　夏といえば、水着！　海！\nプール！　こぼれるおっぱい！\nはみ出るお尻！"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "俺たちのドリームランドは、\n海にあるんだ！"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "海にはロマンが詰まってる！\n男のロマンがな！"},
{"id": 62, "kind": "msg", "spk": "そはら", "ja": "ふーん……"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "まぁ、プールでもいいんだけどな。"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "やっぱり、行くなら、海かプールだよ。\n夏なんだからさ。\nそうだろ？"},
{"id": 65, "kind": "msg", "spk": "そはら", "ja": "えーと……。"},
{"id": 66, "kind": "msg", "spk": "そはら", "ja": "とりあえず、今の私は、\nトモちゃんにガッカリしてるかな……。"}
]}
