{"file": "_Data/Script/Chara/Chapter01/30/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ん？\nよお、イカロスじゃないか。"},
{"id": 1, "kind": "msg", "spk": "イカロス", "ja": "あ、マスター……"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "違うだろイカロス。\n今は先生だろ。"},
{"id": 3, "kind": "msg", "spk": "イカロス", "ja": "はい……先生。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "オホン、\nそれでは、イカロス君\nなにをしておるのかね？"},
{"id": 5, "kind": "msg", "spk": "イカロス", "ja": "今日は……愛について調べています。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "愛？　うーん、愛か……"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "それで、こんなに\n恋愛とかの本が積んであるんだな。"},
{"id": 8, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 9, "kind": "msg", "spk": "イカロス", "ja": "愛に関係しそうな本を\nチェックしています。"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "いっぱいあるな～。\n何冊くらいあるんだ？"},
{"id": 11, "kind": "msg", "spk": "イカロス", "ja": "……ひとまず１０００冊ほど。"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "ひとまずで読む量じゃないだろ！"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "え～っと、なになに……\n恋愛小説に、恋愛ノウハウ、\nこれは哲学書か？"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "こんな難しそうな本、\n図書室にあることすら\n知らなかったぜ。"},
{"id": 15, "kind": "msg", "spk": "イカロス", "ja": "……図書室にはさまざまなデータが\nあり、愛についての資料も豊富です。"},
{"id": 16, "kind": "msg", "spk": "イカロス", "ja": "しかし、あまりに多様なデータがあり\nすぎ、かえってわからなくなって\nしまいます……"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "たしかに、ものすごく多いよな。"},
{"id": 18, "kind": "msg", "spk": "イカロス", "ja": "愛とは……なんでしょう……"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "うーん{16}{15}"},
{"id": 20, "kind": "choice", "spk": "", "ja": "がんばって説明してみる"},
{"id": 21, "kind": "choice", "spk": "", "ja": "エロいことだよ"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "よし、俺も今は先生だ！\nがんばって説明してみるぜ！"},
{"id": 23, "kind": "msg", "spk": "イカロス", "ja": "はい……おねがいします、先生。"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "愛とは、まず男と女でだな！"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "いや待てよ、父親と息子の場合は\nどうなんだ！？"},
{"id": 26, "kind": "msg", "spk": "イカロス", "ja": "父親と息子の間にも\n愛情があるのですか……？"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "それも愛だな！　親子愛だ！！"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "うぬぬぬぬ……"},
{"id": 29, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "つまり、人と人とのだな！"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "待てよ、植物や動物に向けた愛情も\nあるよな……！？"},
{"id": 32, "kind": "msg", "spk": "イカロス", "ja": "私も……スイカやひよこに向けた\n愛もあるのですか？"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "そ、それも愛だよな！！"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "うおおおぉぉぉ～～～！\n難しい！！"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "生きてるものどうしなら、\n愛が芽生えることもある！"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "ん？　待てよ……\n道具や故郷とかも、\n愛するって言うよな……？"},
{"id": 37, "kind": "msg", "spk": "イカロス", "ja": "生きていないものにも、\n愛は向けられるのですね……"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "うおぉぉぉ～～～！！\nそのとおりだ！！"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "ぐぐぐ……\nどうやって説明したらいいんだ……"},
{"id": 40, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "ん？\nイカロス、なんか嬉しそうだな？"},
{"id": 42, "kind": "msg", "spk": "イカロス", "ja": "はい……マスターと、\nお話ができるのが。"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "えっ、そ、そんなことが、嬉しいのか？\nそうか……\nあ、俺は先生だからな？"},
{"id": 44, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "エロいことだよ！"},
{"id": 46, "kind": "msg", "spk": "イカロス", "ja": "エロいこと……ですか？\n図書室にエッチな本はありませんが……"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "あ～、そうだろうな……"},
{"id": 48, "kind": "msg", "spk": "イカロス", "ja": "愛を学ぶのに……\n図書室は役に立たないのでしょうか？"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "どうだろうな？\nまぁ、エロ本がないから、\n俺は使わないけど！"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "待てよ……\n先生なんだから、図書室にエロ本を\n入れることもできるに違いない！"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "俺の選んだスペシャルなエロ本を\n置いてやるぜ、くっくっくっ。"},
{"id": 52, "kind": "msg", "spk": "イカロス", "ja": "………………"}
]}
