{"file": "_Data/Script/Chara/Chapter01/13/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "うお、なんか黒服の\nいかつい集団がいるぞ。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "あれ？　その中心にいるのは……"},
{"id": 2, "kind": "msg", "spk": "美香子", "ja": "あら、桜井くんじゃないの～。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "あ、ども、会長。"},
{"id": 4, "kind": "msg", "spk": "美香子", "ja": "こんなところで会うなんて、\n奇遇ね～。"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "そうですね。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "会長はなにやってるんですか？\n周りの黒服の人たちが、なんか\n大きな箱を持ってますけど。"},
{"id": 7, "kind": "msg", "spk": "美香子", "ja": "そろそろ夏祭りの準備をしないと\nいけないでしょ～。\n打ち合わせしてたのよ～。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "ああ、なるほど。"},
{"id": 9, "kind": "msg", "spk": "美香子", "ja": "この大きな箱は、\n催し物のための道具なのよ～。"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "催し物って、何ですか？"},
{"id": 11, "kind": "msg", "spk": "美香子", "ja": "あら～、知りたいの桜井くん？\n試してみる～？"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "いや……\nやめときます。\n夏祭りの楽しみにしとくッス。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "（また酷い目に遭わされないよう、\n　気をつけねば！）"},
{"id": 14, "kind": "msg", "spk": "美香子", "ja": "ほんと、楽しみね～。"},
{"id": 15, "kind": "msg", "spk": "美香子", "ja": "会長、今年は素敵な柄の浴衣を\n新しく用意してるのよ～。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "ほう、浴衣ですか……"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "（うへへ、ついつい妄想が膨らむぜ！）"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "（新しい浴衣……いつもよりはしゃいで\n　疲れちゃう会長……\n　そんな会長をマッサージ……！）"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "うへ……うへへ……"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "いいんですよ、会長、もっと\nモミモミしても……"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "むしろ、モミモミだけじゃ\nなくってですね……"},
{"id": 22, "kind": "msg", "spk": "美香子", "ja": "あら～？\n桜井くん、なにを考えてるのかしら～？"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "ハッ！？\nああ、いや！"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "（妄想してるのがバレたか！？）"},
{"id": 25, "kind": "choice", "spk": "", "ja": "逃げる"},
{"id": 26, "kind": "choice", "spk": "", "ja": "祭り楽しみ、とごまかす"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "（逃げるしかない！\n　俺の勘が、生命の危機だと\n　叫んでやがる！）"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "サイナラー！"},
{"id": 29, "kind": "msg", "spk": "美香子", "ja": "あら～？"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "うおおおぉぉぉぉ～～～！！\n猛ダッシュだぜー！"},
{"id": 31, "kind": "msg", "spk": "美香子", "ja": "桜井くんてば～。\n逃げるなんて、後でおしおきだわ～。"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "夏祭り楽しみッスね！"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "（なんとか、妄想してたことを\n　ごまかさなくては！）"},
{"id": 34, "kind": "msg", "spk": "美香子", "ja": "そうね～。楽しみだわ～。\n桜井くん、ちょっと試してみる？"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "えっ！？"},
{"id": 36, "kind": "msg", "spk": "美香子", "ja": "会長、うまくやれるか、\nわからないから、\n試してみたかったのよ～。"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "（まさか妄想と同じことを\n　試させてくれるってのか！？）"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "本当ッスか！？"},
{"id": 39, "kind": "msg", "spk": "美香子", "ja": "本当よ～。"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "（うおおおぉぉぉ！？\n　まさかの展開！\n　この手で、会長にさわれるとは！！）"},
{"id": 41, "kind": "msg", "spk": "美香子", "ja": "じゃあ、用意して～。"},
{"id": 42, "kind": "name", "spk": "熊", "ja": "黒服"},
{"id": 43, "kind": "msg", "spk": "黒服", "ja": "オッス！　わかりました！"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "オ、オヤオヤ～？"},
{"id": 45, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ガシャン！"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "なんで、俺は箱の中にある道具に、\nセットされてるんでしょうか？"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "新しい浴衣は？\n疲れちゃったわ～って言う会長は！？"},
{"id": 48, "kind": "msg", "spk": "美香子", "ja": "桜井くんが、何を言っているのか、\n会長、わからないわ～。"},
{"id": 49, "kind": "msg", "spk": "美香子", "ja": "今年の夏祭りの催し物は、\n人間打ち上げ花火よ～。"},
{"id": 50, "kind": "msg", "spk": "美香子", "ja": "花火と人間大砲をミックスした\n画期的な遊びなの。"},
{"id": 51, "kind": "msg", "spk": "美香子", "ja": "すごく楽しそうでしょ～？"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "楽しいわけねえだろ！？"},
{"id": 53, "kind": "msg", "spk": "美香子", "ja": "点火～！"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "ギャアアァァァァァ～～～！？"},
{"id": 55, "kind": "msg", "spk": "", "ja": "　\n{1F}{15}どーーーーーん！"},
{"id": 56, "kind": "msg", "spk": "美香子", "ja": "たーまやー。"},
{"id": 57, "kind": "msg", "spk": "美香子", "ja": "……単発だといまいちね～？\n桜井くん、連発なんてどう～？"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "絶対に嫌だぁ～！！"}
]}
