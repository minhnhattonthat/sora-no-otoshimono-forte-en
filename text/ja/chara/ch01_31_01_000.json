{"file": "_Data/Script/Chara/Chapter01/31/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ん～ふんふん～。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "廊下、歩きやすいな～。\nみんなが脇に寄ってくれるからな。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "わっはっはっ！\n先生様のお通りだぞー！"},
{"id": 3, "kind": "msg", "spk": "そはら", "ja": "先生！"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "ん？　どうしたんだ、そはら？"},
{"id": 5, "kind": "msg", "spk": "そはら", "ja": "えっ！？"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "おっと！\nオホン、オホン！\nどうしたんだね、見月くん。"},
{"id": 7, "kind": "msg", "spk": "そはら", "ja": "授業でわからないところがあったので、\n教えてもらおうと思いまして。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "なんで俺に？"},
{"id": 9, "kind": "msg", "spk": "そはら", "ja": "え？　だって先生の授業ですし……"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "おっと、オホン！\nそうだったな。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "どれ、見せてみなさい。"},
{"id": 12, "kind": "msg", "spk": "そはら", "ja": "はい。ここなんですけど……"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "ふむふむ……"},
{"id": 14, "kind": "msg", "spk": "そはら", "ja": "これが、こうなるって授業で\n言ってたんですけど、\n意味がわからなくて。"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "ああ、なるほどな。\nそこは、アレだ……"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "（やべえ。\n　ぜんぜんわからねえ！！）"},
{"id": 17, "kind": "msg", "spk": "そはら", "ja": "どうしたんですか、先生？"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "え～っと、待てよ。\nどう説明しようか考えてるんだ。"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "問題は解けてるんだぞ。\nほんとにな、スラスラとな。\n先生だからな。"},
{"id": 20, "kind": "msg", "spk": "そはら", "ja": "はい。"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "（うう、期待に満ちた目で……）"},
{"id": 22, "kind": "choice", "spk": "", "ja": "この場で教える"},
{"id": 23, "kind": "choice", "spk": "", "ja": "個人授業を行う"},
{"id": 24, "kind": "choice", "spk": "", "ja": "時間かかるから放課後に"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "あ～、ここは、ほら、\nこうでいいんじゃないか？"},
{"id": 26, "kind": "msg", "spk": "そはら", "ja": "え？　こうですか……？"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "う、うむ。\nあとは、ほら、\nこの数字を持ってきてさ。"},
{"id": 28, "kind": "msg", "spk": "そはら", "ja": "ええ！？\nそれだと答えが変わっちゃいますよ！？"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "あ、そうか。"},
{"id": 30, "kind": "msg", "spk": "そはら", "ja": "先生、ひどい……\n私、まじめに質問してるのに……"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "うっ！？\nいや、今のは、ちょっとしたミスでな！"},
{"id": 32, "kind": "msg", "spk": "そはら", "ja": "……もう、いいです……。"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "あ～あ、行っちゃった。\n俺が勉強を教えるなんて無理だったか。"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "よしよし、じゃあ、こっちの\n空き教室に来なさい。\nじっくりたっぷり教えてやろう。"},
{"id": 35, "kind": "msg", "spk": "そはら", "ja": "はい、先生。"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "うひょひょひょ！"},
{"id": 37, "kind": "msg", "spk": "そはら", "ja": "（……なんか、笑い方が、\n　トモちゃんに似てるような？）"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "オホン！\nじゃあ、教えてやるからな！"},
{"id": 39, "kind": "msg", "spk": "そはら", "ja": "はい、先生。\nおねがいします！"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "おっと、手がすべった！"},
{"id": 41, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}もにゅん！　もにゅん！"},
{"id": 42, "kind": "msg", "spk": "そはら", "ja": "キャーーー！？"},
{"id": 43, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}スパーン！"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "ごはっ！？"},
{"id": 45, "kind": "msg", "spk": "そはら", "ja": "ハッ！？"},
{"id": 46, "kind": "msg", "spk": "そはら", "ja": "す、すみません！\nなんか触り方が、すっごくトモちゃん\nぽかったから、つい……"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "あががが……\nいや、こちらこそ手が滑ってしまって\nすまなかったね。"},
{"id": 48, "kind": "msg", "spk": "そはら", "ja": "は、はい……先生。"},
{"id": 49, "kind": "msg", "spk": "そはら", "ja": "あの……\nちゃんと教えてくださいね？"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "う、うむ！\nもちろんだとも！"},
{"id": 51, "kind": "msg", "spk": "そはら", "ja": "それで、この部分なんですけど……"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "ああ、そこはな。\nうん、難しいな。"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "おっと、また手が滑った！"},
{"id": 54, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}もにゅん！　もにゅん！"},
{"id": 55, "kind": "msg", "spk": "そはら", "ja": "キャーーー！？"},
{"id": 56, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}スパーン！"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "ウギャーーー！？"},
{"id": 58, "kind": "msg", "spk": "そはら", "ja": "トモちゃん、いいかげんに……！"},
{"id": 59, "kind": "msg", "spk": "そはら", "ja": "（ハッ！いつもの調子で……。\n　先生なのに……）"},
{"id": 60, "kind": "msg", "spk": "そはら", "ja": "す、すみません！\nつい触り方がトモちゃんぽくて……"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "うごごごご……"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "うーむ。\nこれは時間がかかるから……\n放課後、職員室に来なさい。"},
{"id": 63, "kind": "msg", "spk": "そはら", "ja": "あ、はい。\nわかりました！"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "それにしても、そは……\nいや、見月くんは\n意外と勉強熱心だったんだな。"},
{"id": 65, "kind": "msg", "spk": "そはら", "ja": "いえ、そんな。\n今日はトモちゃんが、\nお休みみたいだから……"},
{"id": 66, "kind": "msg", "spk": "そはら", "ja": "ちゃんと勉強しておいて、\n後で教えてあげようと思って。"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "（そはら……）"},
{"id": 68, "kind": "msg", "spk": "智樹", "ja": "あー、うむ。\nその桜井も喜ぶんじゃないか？"},
{"id": 69, "kind": "msg", "spk": "そはら", "ja": "はい、ありがとうございます！\n放課後、職員室まで行きますね！"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "ああ、そうしなさい。"},
{"id": 71, "kind": "msg", "spk": "智樹", "ja": "（そこには本物の先生がいて、\n　ちゃんと教えてくれるだろうからな）"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "（……カードの効果が切れたら、\n　そはらに教えてもらうかな）"}
]}
