{"file": "_Data/Script/Chara/Chapter00/51/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "（アストレア、\n　まだこのへんにいるのかな？）"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "（ついつい、気になって\n　様子を見にきちまったよ……）"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "えーっと、たしか、この辺りの森に\nいるはずなんだけど……"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "おーい、アストレアー！！"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "………………"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "アストレアー！！\n腹、減ってないかー？"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "………………"},
{"id": 7, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ガサガサ！"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "お、そんなとこに隠れてたのか？"},
{"id": 9, "kind": "msg", "spk": "アストレア", "ja": "な、なにしにきたのよ？"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "調子はどうだ、アストレア？"},
{"id": 11, "kind": "msg", "spk": "アストレア", "ja": "みじめよ！\nぜんぶアンタのせいでしょ！？"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "そう言うなよ、べつに俺がアストレアの\n服を脱がせて空に飛ばしたわけじゃ\nないだろ？"},
{"id": 13, "kind": "msg", "spk": "アストレア", "ja": "そりゃ、そうだけど……"},
{"id": 14, "kind": "msg", "spk": "アストレア", "ja": "アンタが、あんなバカなこと\n考えなければ、よかったのよ！"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "そんなこと言ってもなー。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "アストレアだったら、どんなこと\n考えてたんだ？"},
{"id": 17, "kind": "msg", "spk": "アストレア", "ja": "そうねえ……？"},
{"id": 18, "kind": "msg", "spk": "アストレア", "ja": "町中に食べ物が溢れかえって、\n消えませんように！！"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "……おまえ、それが実現してたら、\n大変なことになってるぞ？"},
{"id": 20, "kind": "msg", "spk": "アストレア", "ja": "なんでよ、みんな嬉しいでしょ！？\nバカじゃないの！？"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "いや、食べ物なんて、食べたいときに\n必要なだけあるのが一番だろ。"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "町中に溢れてたら、\n道を歩くのだって大変だ。"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "数日もしたら、そこらじゅうで腐って\n大変なことになるぞ？"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "しかも、消えないって、\nおまえ町を壊滅させる気か……？"},
{"id": 25, "kind": "msg", "spk": "アストレア", "ja": "あ、いや……\nちょっと、お願いしすぎたかも？"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "難しいんだよ、願いってのはさ。"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "俺もカードを使って、\n何度も失敗してるからなあ。"},
{"id": 28, "kind": "msg", "spk": "アストレア", "ja": "ふーん。"},
{"id": 29, "kind": "msg", "spk": "アストレア", "ja": "それで、アンタは\nなにしにきたの？"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "いや、たいしたことじゃ\nないんだけどさ……"},
{"id": 31, "kind": "choice", "spk": "", "ja": "ほら、メシだぞ"},
{"id": 32, "kind": "choice", "spk": "", "ja": "食事しに来た"},
{"id": 33, "kind": "choice", "spk": "", "ja": "様子を見に来ただけ"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "ほら……メシだぞ、アストレア。"},
{"id": 35, "kind": "msg", "spk": "アストレア", "ja": "うっ！？　見せびらかしながら、\n食べようっての！？"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "そんなことしないって。"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "えーっと……\n近くに置けば、手が届くかな。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "はいよ。"},
{"id": 39, "kind": "msg", "spk": "アストレア", "ja": "お弁当……\nアンタのぶんは？"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "もちろんあるから、心配すんな。"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "一緒に食べようぜ！"},
{"id": 42, "kind": "msg", "spk": "アストレア", "ja": "う、うん……"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "いただきまーす！！"},
{"id": 44, "kind": "msg", "spk": "アストレア", "ja": "はむっ。"},
{"id": 45, "kind": "msg", "spk": "アストレア", "ja": "あ……おいしい。"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "さすが、イカロスの作った\nサンドイッチだな！"},
{"id": 47, "kind": "msg", "spk": "アストレア", "ja": "そっか、イカロス先輩が\n作ってくれたんだ。"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "……アストレア。"},
{"id": 49, "kind": "msg", "spk": "アストレア", "ja": "はぐはぐはぐ……\nんふぁんに？"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "悪いけど、もうすこし\n辛抱してくれよな……"},
{"id": 51, "kind": "msg", "spk": "アストレア", "ja": "………………"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "服、着られるようになったら、\nいっぱいごはん食べさせてやるから、\nみんなで食事しような。"},
{"id": 53, "kind": "msg", "spk": "アストレア", "ja": "………………うん。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "そろそろ、弁当でも\n食べようかと思ってさ。"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "なんせ、ハイキング気分で\n登ってきたから、\n腹が減っちまったよ。"},
{"id": 56, "kind": "msg", "spk": "アストレア", "ja": "あ……ああ……\nご、ごはん。"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "まぁ、イカロスが作った\nサンドイッチだけどな。"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "ん？\nどうしたんだ、アストレア？\n欲しかったらやるぞ。"},
{"id": 59, "kind": "msg", "spk": "アストレア", "ja": "ほ、ほんと！？"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "ああ……取りに来いよ。"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "その草むらから出てきて、\n弁当を取りに来いよな。\nうへへへへ……"},
{"id": 62, "kind": "msg", "spk": "アストレア", "ja": "くっ……出るに出れないっ！"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "うへへへへ……"},
{"id": 64, "kind": "msg", "spk": "アストレア", "ja": "な、な、なぁ～～～！？"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "もぐもぐ、ああ、うめー。"},
{"id": 66, "kind": "msg", "spk": "アストレア", "ja": "こ、この卑怯者ー！！\n許せない！！"},
{"id": 67, "kind": "msg", "spk": "アストレア", "ja": "アンタなんか、\nこうしてやるんだから！！"},
{"id": 68, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ビュン！"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "うおっ！？\n木の枝が飛んできた！？"},
{"id": 70, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ビュン！"},
{"id": 71, "kind": "msg", "spk": "智樹", "ja": "今度は、石が！？\n危ないだろ、投げるなよ！"},
{"id": 72, "kind": "msg", "spk": "アストレア", "ja": "このバカ！　バカ！"},
{"id": 73, "kind": "msg", "spk": "智樹", "ja": "ちょっ、やめ……あぶな……！？"},
{"id": 74, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}すこーん！"},
{"id": 75, "kind": "msg", "spk": "智樹", "ja": "痛ぇ～～～～～！？"},
{"id": 76, "kind": "msg", "spk": "アストレア", "ja": "次はもっと大きな石を\n当てるんだから！"},
{"id": 77, "kind": "msg", "spk": "智樹", "ja": "や、やばい！\n逃げよう！"},
{"id": 78, "kind": "msg", "spk": "アストレア", "ja": "二度と来るな、\nバーーーカ！！"},
{"id": 79, "kind": "msg", "spk": "智樹", "ja": "様子を見にきただけだな。"},
{"id": 80, "kind": "msg", "spk": "アストレア", "ja": "なあ……！？"},
{"id": 81, "kind": "msg", "spk": "智樹", "ja": "いや～、森のなかで全裸で生活だろ？\nどんな感じかと思って見に来たんだよ。"},
{"id": 82, "kind": "msg", "spk": "アストレア", "ja": "ア、ア、アンタの\nせいでしょうが～～～！？"},
{"id": 83, "kind": "msg", "spk": "智樹", "ja": "俺がアストレアを全裸にした\nわけじゃないぞ？"},
{"id": 84, "kind": "msg", "spk": "アストレア", "ja": "そ、そうだけど……\nでもアンタのせいなの！"},
{"id": 85, "kind": "msg", "spk": "智樹", "ja": "そうかよ……わかったよ。"},
{"id": 86, "kind": "msg", "spk": "アストレア", "ja": "少しは反省してよね……"},
{"id": 87, "kind": "msg", "spk": "智樹", "ja": "（うーん、何もできないのに、\n　様子だけ見に来ても、\n　意味なかったか）"},
{"id": 88, "kind": "msg", "spk": "智樹", "ja": "悪かったな、アストレア。\n次はなんか持ってくるよ。"},
{"id": 89, "kind": "msg", "spk": "アストレア", "ja": "うう……\nごはんがいい。"},
{"id": 90, "kind": "msg", "spk": "智樹", "ja": "ああ、わかったよ。\nなんか食べられる物、持ってくる。"}
]}
