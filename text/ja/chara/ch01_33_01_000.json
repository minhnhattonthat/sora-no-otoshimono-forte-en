{"file": "_Data/Script/Chara/Chapter01/33/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ん？\nアストレアじゃないか、\nなにやってんだ？"},
{"id": 1, "kind": "msg", "spk": "アストレア", "ja": "あ、センセイ、こんにちは！"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "お？　おお……\nそうだったな。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "（俺、先生だったな。\n　慣れないから、すぐ忘れちゃうぜ）"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "オホン！\nなにをやっているのかね？"},
{"id": 5, "kind": "msg", "spk": "アストレア", "ja": "種、もらったんで、\n埋めるところです！"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "種？"},
{"id": 7, "kind": "msg", "spk": "アストレア", "ja": "はい、これです。\nタマネギみたいなの。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "これ、球根じゃねえか？"},
{"id": 9, "kind": "msg", "spk": "アストレア", "ja": "え……\n種じゃないんですか、センセイ？"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "ああ、いや。\n種みたいなもんだぞ。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "植えれば植物が育つだろ。"},
{"id": 12, "kind": "msg", "spk": "アストレア", "ja": "あー、よかった！\nじゃあ、埋めますね。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "ああ。"},
{"id": 14, "kind": "msg", "spk": "アストレア", "ja": "穴をほって……\nこんなもんかな～？"},
{"id": 15, "kind": "msg", "spk": "アストレア", "ja": "種を入れて、と。"},
{"id": 16, "kind": "msg", "spk": "アストレア", "ja": "埋めて……\nあとは水をやります！"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "ところで、なんで球根なんて\n植えてるんだ？"},
{"id": 18, "kind": "msg", "spk": "アストレア", "ja": "水やれば、育つらしいです！"},
{"id": 19, "kind": "msg", "spk": "アストレア", "ja": "植物を育てると、\n食べることができるんですよ！"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "ああ、なるほど。\n育てて食べるのか。"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "（学校の花壇で、食べ物とか\n　育てていいのか？）"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "（まぁ、いいか。\n　そんな人が、他にもいるもんな）"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "それで、何を植えたんだ？"},
{"id": 24, "kind": "msg", "spk": "アストレア", "ja": "チューリップです！"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "なに！？"},
{"id": 26, "kind": "msg", "spk": "アストレア", "ja": "センセイは、チューリップを\n知らないんですか？"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "あ、いや……\n知ってるけどな。"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "（食べられないじゃねぇか！）"},
{"id": 29, "kind": "msg", "spk": "アストレア", "ja": "いっぱい水を飲んでねー。"},
{"id": 30, "kind": "msg", "spk": "アストレア", "ja": "早く育たないかな～。"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "（……どうするかなあ？）"},
{"id": 32, "kind": "choice", "spk": "", "ja": "水やりすぎるとダメだ"},
{"id": 33, "kind": "choice", "spk": "", "ja": "食べられないぞ"},
{"id": 34, "kind": "choice", "spk": "", "ja": "がんばれ"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "いいか、アストレア。\n水をやりすぎてもダメなんだぞ。"},
{"id": 36, "kind": "msg", "spk": "アストレア", "ja": "えっ、そうなんですか！？"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "ああ、アストレアだって、\n水浸しの家には住めないだろ？"},
{"id": 38, "kind": "msg", "spk": "アストレア", "ja": "そうですね！\nさすが、センセイです！"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "うむ。\n土を湿らせる程度にだな。"},
{"id": 40, "kind": "msg", "spk": "アストレア", "ja": "はい！　わかりました！"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "（あとで、近くに食べられる植物も\n　植えておいてやるか……）"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "チューリップって、食べられないぞ？"},
{"id": 43, "kind": "msg", "spk": "アストレア", "ja": "え？"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "知らなかったのか？"},
{"id": 45, "kind": "msg", "spk": "アストレア", "ja": "がーん！\n食べられないんだ……。"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "まあ、チューリップは観賞用かな。\nキレイだからさ。"},
{"id": 47, "kind": "msg", "spk": "アストレア", "ja": "そ、そんな……"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "どうすんだ、それ。\nもう育てるのやめるか？"},
{"id": 49, "kind": "msg", "spk": "アストレア", "ja": "うっ……"},
{"id": 50, "kind": "msg", "spk": "アストレア", "ja": "水、やらないと、どうなりますかね？"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "そりゃ、枯れるだろ。"},
{"id": 52, "kind": "msg", "spk": "アストレア", "ja": "なら……ちゃんと、お水あげます。"},
{"id": 53, "kind": "msg", "spk": "アストレア", "ja": "お腹が減ったり、喉が渇いたりするの\nかわいそうですから。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "そっか……\nがんばれよ。"},
{"id": 55, "kind": "msg", "spk": "アストレア", "ja": "……うん。"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "あー、そうか。\nまぁ、がんばれよ。"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "（チューリップは食べられないけどな）"},
{"id": 58, "kind": "msg", "spk": "アストレア", "ja": "はい、がんばります！"},
{"id": 59, "kind": "msg", "spk": "アストレア", "ja": "センセイ、チューリップって、\n美味しいですか！？"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "うっ……"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "いや、先生は、食べたことないから\nよくわからないな。"},
{"id": 62, "kind": "msg", "spk": "アストレア", "ja": "そうなんですか！\n早く育たないかなー。"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "あー、なんだ……\nアストレア……"},
{"id": 64, "kind": "msg", "spk": "アストレア", "ja": "はい、なんですか、センセイ！？"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "桜井が、またメシを食わせてやるから\n家に来い、と言ってたぞ。"},
{"id": 66, "kind": "msg", "spk": "アストレア", "ja": "えっ、本当ですか！？\nわーい！\nやったー！！"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "メシが、そんな嬉しいか？"},
{"id": 68, "kind": "msg", "spk": "アストレア", "ja": "はい！"},
{"id": 69, "kind": "msg", "spk": "アストレア", "ja": "もう今日、行っちゃおうかなー。"}
]}
