{"file": "_Data/Script/Chara/Chapter03/53/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ん？　よお、そはら。\nどこ行くんだ？"},
{"id": 1, "kind": "msg", "spk": "そはら", "ja": "あ、これから、岩場のほうへ\n行ってみようかと思って。"},
{"id": 2, "kind": "msg", "spk": "そはら", "ja": "よかったら、\nトモちゃんも、行ってみる？"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "そうだな。\n離れるなら１人じゃ危ないし。\n一緒に行こうぜ。"},
{"id": 4, "kind": "msg", "spk": "そはら", "ja": "うん、ありがとう。"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "それにしても、\nなんで岩場なんだ？"},
{"id": 6, "kind": "msg", "spk": "そはら", "ja": "守形先輩が、景色が綺麗な\n岩場があるって教えてくれたの。"},
{"id": 7, "kind": "msg", "spk": "そはら", "ja": "せっかく来たんだから、\nいろいろ見たいじゃない？"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "なるほど、それもそうだな。"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "転ばないように気をつけろよ？"},
{"id": 10, "kind": "msg", "spk": "そはら", "ja": "うん、へいき。"},
{"id": 11, "kind": "msg", "spk": "そはら", "ja": "トモちゃん、ここ座れるよ？"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "ああ……"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "お～、海が綺麗だなー。"},
{"id": 14, "kind": "msg", "spk": "そはら", "ja": "ほんとだねー。"},
{"id": 15, "kind": "msg", "spk": "そはら", "ja": "すこし陽が傾いたせいか、\n海の色が変わったね。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "岩場のほうが、浜辺より、\nちょっと高くなってるしな。"},
{"id": 17, "kind": "msg", "spk": "そはら", "ja": "そういうのも関係あるんだね。"},
{"id": 18, "kind": "msg", "spk": "そはら", "ja": "………………"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "………………"},
{"id": 20, "kind": "msg", "spk": "そはら", "ja": "気持ちいい風……"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "ああ、いい風だ……"},
{"id": 22, "kind": "msg", "spk": "そはら", "ja": "ずっと遊んで、\nここまで歩いて、\nちょっと疲れちゃった。"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "そっか……"},
{"id": 24, "kind": "choice", "spk": "", "ja": "飲み物を持ってくる"},
{"id": 25, "kind": "choice", "spk": "", "ja": "前もこんなことがあったな"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "そはら、もうすこし、ここにいるか？"},
{"id": 27, "kind": "msg", "spk": "そはら", "ja": "え？　トモちゃんがイヤでなければ。"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "わかった。\nじゃあ、３分だけ待っててくれ。"},
{"id": 29, "kind": "msg", "spk": "そはら", "ja": "うん？　わかった。"},
{"id": 30, "kind": "msg", "spk": "そはら", "ja": "なんだろ？"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "ほらよ、そはら。"},
{"id": 32, "kind": "msg", "spk": "そはら", "ja": "おかえりトモちゃん。\nあ、飲み物！？"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "疲れたって言ってたからさ、\nオレンジとか飲んだら、\nすこし回復するかと思って。"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "クーラーＢＯＸに入ってたから、\nしっかり冷えてるだろ？"},
{"id": 35, "kind": "msg", "spk": "そはら", "ja": "うん、トモちゃん……ありがとう。\nうれしい。"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "そっか。よかった。"},
{"id": 37, "kind": "msg", "spk": "そはら", "ja": "………………"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "ん？　どうした、飲まないのか？"},
{"id": 39, "kind": "msg", "spk": "そはら", "ja": "ううん、もちろん、もらうよ。"},
{"id": 40, "kind": "msg", "spk": "そはら", "ja": "ただ、今日は、\n来てよかったなって思って。"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "ああ、バーベキューも美味かったしな。"},
{"id": 42, "kind": "msg", "spk": "そはら", "ja": "それもあるけど……"},
{"id": 43, "kind": "msg", "spk": "そはら", "ja": "トモちゃんと一緒にこうやって……"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "ん？"},
{"id": 45, "kind": "msg", "spk": "そはら", "ja": "ううん、なんでもない。"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "なんだよ、そはら？"},
{"id": 47, "kind": "msg", "spk": "そはら", "ja": "なんでもなーいの！"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "（前もこんなことがあったな……）"},
{"id": 49, "kind": "msg", "spk": "そはら", "ja": "トモちゃん、前にも、こんなふうに\n２人で海を見てたことがあったよね。"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "ああ、俺も同じこと考えてた。\n会長や守形先輩に騙されて、\n大変だったよなー。"},
{"id": 51, "kind": "msg", "spk": "そはら", "ja": "南の島で２人きりになっちゃってね。\nあのとき、言ったこと……覚えてる？"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "そ、そりゃ、まあ……"},
{"id": 53, "kind": "msg", "spk": "そはら", "ja": "そっか……"},
{"id": 54, "kind": "msg", "spk": "そはら", "ja": "…………"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "（そ、そはらが、いつもと、\n　ちょっと雰囲気が違ってる！？）"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "（なんだこれ……なんかちょっと\n　変な空気になってきたぞ……）"},
{"id": 57, "kind": "msg", "spk": "そはら", "ja": "トモ……ちゃん……"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "そ、そはら……"},
{"id": 59, "kind": "msg", "spk": "イカロス", "ja": "マスター……顔が真っ赤です。"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "おわっ！？"},
{"id": 61, "kind": "msg", "spk": "そはら", "ja": "イカロスさん！？\nきゃ～～～！？"},
{"id": 62, "kind": "msg", "spk": "", "ja": "　\n{1F}{1A}どん！"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "うわっ！？"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "（そはらに突き飛ばされた～～～！？）"},
{"id": 65, "kind": "msg", "spk": "そはら", "ja": "やだ！　トモちゃん、大丈夫！？"},
{"id": 66, "kind": "msg", "spk": "智樹", "ja": "なんで、いきなり突き飛ばすんだよ！？"},
{"id": 67, "kind": "msg", "spk": "そはら", "ja": "ごめん……\nなんか、びっくりしちゃって……"},
{"id": 68, "kind": "msg", "spk": "智樹", "ja": "イカロスが来ただけだろ。\n俺のほうが、びっくりだよ！"},
{"id": 69, "kind": "msg", "spk": "そはら", "ja": "ごめんなさーい！！"},
{"id": 70, "kind": "msg", "spk": "イカロス", "ja": "………………"}
]}
