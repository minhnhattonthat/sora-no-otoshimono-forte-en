{"file": "_Data/Script/Chara/Chapter02/71/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "守形", "ja": "智樹。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "はい。\nなにか用ですか、守形先輩？"},
{"id": 2, "kind": "msg", "spk": "守形", "ja": "たいしたことではないんだが\n気になっていることがあってな。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "なんですか？"},
{"id": 4, "kind": "msg", "spk": "守形", "ja": "先程のテントでのことだが……"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "（ゲッ……）"},
{"id": 6, "kind": "msg", "spk": "守形", "ja": "智樹が積極的に男の体に\n触れようとするなど、\n何か理由があるんじゃないのか？"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "えーと……"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "（理由はバッチリあるんですけど……\n　言ったら命がピンチだ！）"},
{"id": 9, "kind": "choice", "spk": "", "ja": "日頃のお礼ですよ！"},
{"id": 10, "kind": "choice", "spk": "", "ja": "守形先輩の体に興味が！"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "まぁ、たいした理由じゃないですよ。\nお世話になってる先輩に、\nお礼がしたくて。"},
{"id": 12, "kind": "msg", "spk": "守形", "ja": "ほう？"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "（やっぱり、不自然だったか？）"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "（そりゃ、世話にはなってるけど……\n　実験で飛ばされたり、\n　家で飯を出したり）"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "（こっちもお世話してるよな！？）"},
{"id": 16, "kind": "msg", "spk": "守形", "ja": "………………。"},
{"id": 17, "kind": "msg", "spk": "守形", "ja": "まぁ、いい。"},
{"id": 18, "kind": "msg", "spk": "守形", "ja": "必要になったら、俺に言えよ？"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "うーん、事情があることを\n察してくれたみたいだな。"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "前々から守形先輩の体に\n興味があったんですよ！！"},
{"id": 21, "kind": "msg", "spk": "守形", "ja": "ほう。"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "（やばい……無理があったか！？）"},
{"id": 23, "kind": "msg", "spk": "守形", "ja": "智樹の気持ちはわかった。"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "え？　いや、受け入れられても……"},
{"id": 25, "kind": "msg", "spk": "守形", "ja": "新大陸を発見するために\n俺のような肉体が必要だと\n理解したのだな。"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "えっ、いや、それは……"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "（もちろん違いますけどね！）"},
{"id": 28, "kind": "msg", "spk": "守形", "ja": "部長として、部員の向上心は\nおおいに歓迎だ。"},
{"id": 29, "kind": "msg", "spk": "守形", "ja": "なにサバイバル生活をしていれば、\n自然と身につく。"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "あ、いや……\n俺はそういうのは……"},
{"id": 31, "kind": "msg", "spk": "守形", "ja": "うむ、家があるしな。"},
{"id": 32, "kind": "msg", "spk": "守形", "ja": "では、俺が護身術を教えてやろう。\nまずは体で味わうのが一番だ。"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "ちょ……先輩！？\nえ？　うっ、ギャアアア～～～！！"}
]}
