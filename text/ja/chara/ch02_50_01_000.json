{"file": "_Data/Script/Chara/Chapter02/50/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "よう、イカロス。\nまだここにいたのか。"},
{"id": 1, "kind": "msg", "spk": "イカロス", "ja": "あ……マスター。"},
{"id": 2, "kind": "msg", "spk": "イカロス", "ja": "なにかご用でしょうか……？"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "もうすぐ帰る時間だから、\nそれだけ伝えとこうと思ってな。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "スイカも忘れるなよ？"},
{"id": 5, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "それだけだ。\n時間になったら、\nまた呼びに来るからな。"},
{"id": 7, "kind": "msg", "spk": "イカロス", "ja": "あ、マスター。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "ん？\nなにか用があるのか？"},
{"id": 9, "kind": "msg", "spk": "イカロス", "ja": "……はい。"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "イカロスが用事なんて、珍しいな。\nどうした？"},
{"id": 11, "kind": "msg", "spk": "イカロス", "ja": "……マスターは……みなさんの\n体を、触っているのですか……？"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "ブッ！！"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "……誰に聞いた？"},
{"id": 14, "kind": "msg", "spk": "イカロス", "ja": "会長さんに……"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "ぐぐぐぐぐ……\nあの人は、余計なことばっかり！"},
{"id": 16, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "俺がみんなの体を触ってるとして、\nなにを聞きたいんだ？"},
{"id": 18, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 19, "kind": "msg", "spk": "イカロス", "ja": "もしよろしければ……\n私も、マスターのお手伝いを\nさせてください。"},
{"id": 20, "kind": "msg", "spk": "イカロス", "ja": "マスターのお役に立てるなら……\n私にも、させて欲しいです……"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "おおっ！　マジか！"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "（でも、会長が許してくれるわけ\n　ないよなあ？）"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "（だって、事情を話したら\n　ダメなんだから）"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "（イカロスに手助けしてもらえたら\n　すっげえ楽になるだろうけど）"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "う～ん、悪いな、イカロス。\n手伝いはいいや。"},
{"id": 26, "kind": "msg", "spk": "イカロス", "ja": "……そうですか。"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "いろいろと事情があってさ。\n俺がひとりでやらないと\nダメなんだよ。"},
{"id": 28, "kind": "msg", "spk": "イカロス", "ja": "はい……。"},
{"id": 29, "kind": "msg", "spk": "イカロス", "ja": "まだ、続けるのですか？"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "そうだな……\nそはらとか、アストレアとか。"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "もう警戒されてるから、\n難題なんだよなー。\nアストレアはバカだからいいけど。"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "つーわけで、イカロスは\nスイカでもなでててくれよな。\n俺は大丈夫だから！"},
{"id": 33, "kind": "msg", "spk": "イカロス", "ja": "……あの。"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "ん？　まだなにかあるのか？"},
{"id": 35, "kind": "msg", "spk": "イカロス", "ja": "はい……あの……"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "ん？"},
{"id": 37, "kind": "msg", "spk": "イカロス", "ja": "その……"},
{"id": 38, "kind": "msg", "spk": "イカロス", "ja": "……"},
{"id": 39, "kind": "msg", "spk": "イカロス", "ja": "…………"},
{"id": 40, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "どーした？"},
{"id": 42, "kind": "msg", "spk": "イカロス", "ja": "マスター……"},
{"id": 43, "kind": "msg", "spk": "イカロス", "ja": "あの………私は……"},
{"id": 44, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "（いつにも増して、\n　ボーっとしてるな）"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "いくら遊びに来てるからって、\nあんまり気を抜きすぎるなよ？\nははは。"},
{"id": 47, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "まぁ、そのへんも\nイカロスらしいけどな。"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "（イカロスのやつ。\n　妙にしょんぼりしてるな……）"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "そんなに、俺の手伝いが\nしたかったのか？"},
{"id": 51, "kind": "msg", "spk": "イカロス", "ja": "はい。"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "悪いけど、理由があってな。"},
{"id": 53, "kind": "msg", "spk": "イカロス", "ja": "……はい。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "イカロス、ありがとな。"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "気持ちだけもらっとく。\n次に何かあったときには\n手伝ってくれ。"},
{"id": 56, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"}
]}
