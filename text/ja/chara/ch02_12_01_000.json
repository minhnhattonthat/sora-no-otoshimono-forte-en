{"file": "_Data/Script/Chara/Chapter02/12/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "美香子", "ja": "桜井く～ん。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "うわっ、会長。"},
{"id": 2, "kind": "msg", "spk": "美香子", "ja": "あら～？\n悲鳴なんてあげて……\n会長、傷ついちゃうわ～。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "すんません……。\nなにか用ですか？"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "ん？\nなにキョロキョロしてるんですか？"},
{"id": 5, "kind": "msg", "spk": "美香子", "ja": "人に聞かれたら、困るでしょ～？"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "え……？"},
{"id": 7, "kind": "msg", "spk": "美香子", "ja": "ほら、テントの中入って～。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "（おいおい、そはらや守形先輩たちにも\n　聞かせられない話ってなんだ？）"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "（ま……まさか愛の告白！？）"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "（いや、あり得ないだろ……\n　会長みたいな非常識な危ない人に\n　告白されても困るしなー）"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "（でも、会長って美人だし……\n　おっぱいも大きいし……\n　うぇっへっへ）"},
{"id": 12, "kind": "msg", "spk": "美香子", "ja": "桜井く～ん、聞いてるかしら～？"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "は、はい。"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "（くっそ～、変に緊張するぜ）"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "それで、なんの話ですか？"},
{"id": 16, "kind": "msg", "spk": "美香子", "ja": "桜井くんのことが、ずっと\n気になってるのよ～。"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "うへぃ！？"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "（うおおぉ！？\n　まさか！？　まさかなのか！？）"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "俺、会長の性格とかはちょっとアレ\nですけど、おっぱい大きいんで\nオッケーです！！"},
{"id": 20, "kind": "msg", "spk": "美香子", "ja": "桜井くん？\nなにを言ってるのかしら～。\n会長、わからないわ～。"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "あれ？"},
{"id": 22, "kind": "msg", "spk": "美香子", "ja": "会長が聞きたかったのは～、\n宝探しのことよ～？"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "な、なんだぁ。"},
{"id": 24, "kind": "msg", "spk": "美香子", "ja": "順調なのかしら～？"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "えーと……"},
{"id": 26, "kind": "choice", "spk": "", "ja": "順調です"},
{"id": 27, "kind": "choice", "spk": "", "ja": "いやぁ、あんまり"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "順調ですよー、バッチリです！"},
{"id": 29, "kind": "msg", "spk": "美香子", "ja": "あら～、そうなの～。\nそれはよかったわぁ。"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "どうもです。"},
{"id": 31, "kind": "msg", "spk": "美香子", "ja": "桜井くんがやる気を出してくれて\n会長、うれしいわ～。\nその調子で頑張ってね～。"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "ははは……頑張ります。"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "（やる気があるわけじゃないけど、\n　やらないと銃で撃たれるからなー）"},
{"id": 34, "kind": "msg", "spk": "美香子", "ja": "会長、楽しみだわ～。\n桜井くん、どんな苦労をして\n身もだえするかしら～。"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "………………"},
{"id": 36, "kind": "msg", "spk": "美香子", "ja": "頑張ってくれたら、\n素敵な『ご褒美』をあげるわね～。"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "ご褒美？"},
{"id": 38, "kind": "msg", "spk": "美香子", "ja": "とっても素敵なものを\n用意してるわ～。"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "えっ、なんなんですか？"},
{"id": 40, "kind": "msg", "spk": "美香子", "ja": "ナイショよ～。\n知らないほうが気になって、\nやる気が出るでしょ～？"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "う、うーん。"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "教えてもらったほうが、\nやる気が出るかもしれませんよ？"},
{"id": 43, "kind": "msg", "spk": "美香子", "ja": "あら～、そ～お？"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "はい。"},
{"id": 45, "kind": "msg", "spk": "美香子", "ja": "そうね～。"},
{"id": 46, "kind": "msg", "spk": "美香子", "ja": "じゃあ、ヒントだけあげるわ～。"},
{"id": 47, "kind": "msg", "spk": "美香子", "ja": "ヒントは、『桜井くんが\nとっても大好きなもの』よ～。"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "俺が大好きなもの？\nあんまりヒントにならないんじゃ……"},
{"id": 49, "kind": "msg", "spk": "美香子", "ja": "会長、秘密にしておきたいわ～。"},
{"id": 50, "kind": "msg", "spk": "美香子", "ja": "宝探し、頑張ってね～。"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "いやぁ、あんまり。\nやる気ないですね！"},
{"id": 52, "kind": "msg", "spk": "美香子", "ja": "あら～、そうなの～？"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "ん？\n会長、なにを……？"},
{"id": 54, "kind": "msg", "spk": "美香子", "ja": "桜井くん、会長が用意した遊びは、\n楽しめないのね～？"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "だって、会長がムリヤリに……"},
{"id": 56, "kind": "msg", "spk": "美香子", "ja": "桜井くん……"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "はい？"},
{"id": 58, "kind": "msg", "spk": "美香子", "ja": "会長、ストレスがたまると、\nついつい手が出ちゃうのよ～。"},
{"id": 59, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ジャキッ"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "手が出るって……銃にですか！？"},
{"id": 61, "kind": "msg", "spk": "美香子", "ja": "安心してね～。"},
{"id": 62, "kind": "msg", "spk": "美香子", "ja": "急所は外すから～。"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "そういう問題じゃねえだろ！？"},
{"id": 64, "kind": "msg", "spk": "美香子", "ja": "桜井くんなら死なないわ～。"},
{"id": 65, "kind": "msg", "spk": "", "ja": "　\n{1F}{11}バキュン！　バキューン！"},
{"id": 66, "kind": "msg", "spk": "智樹", "ja": "ギャアアアアアアアアアアアア！！"},
{"id": 67, "kind": "msg", "spk": "美香子", "ja": "これに懲りたら、ちゃんと\n真剣にやるのよ～？\nわかった～？"},
{"id": 68, "kind": "msg", "spk": "智樹", "ja": "は……はい……\nガク。"}
]}
