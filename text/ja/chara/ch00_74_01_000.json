{"file": "_Data/Script/Chara/Chapter00/74/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "おや、会長じゃないスか、\nどうしたんですか？"},
{"id": 1, "kind": "msg", "spk": "美香子", "ja": "あら、桜井くん。丁度よかったわ。\nこっちに服が一着、\n飛んでこなかったかしら～？"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "えっ！？\n服が飛んで行っちゃったんですか！？"},
{"id": 3, "kind": "msg", "spk": "美香子", "ja": "そうなのよ～。\n他の服は従順なのに、１枚だけ。\nいけない子だわ～。"},
{"id": 4, "kind": "msg", "spk": "美香子", "ja": "調……しつけの最中に、\n飛び出すなんてね～。"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "そいつは、大変ですね……。\n俺も手伝いますよ。"},
{"id": 6, "kind": "msg", "spk": "美香子", "ja": "そう～、助かるわ～。\nあっちに飛んでいったと思うのよ～。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "山のほうか……"},
{"id": 8, "kind": "msg", "spk": "守形", "ja": "ふむ……なんだ、この服は？"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "あ、あれですか！？"},
{"id": 10, "kind": "msg", "spk": "美香子", "ja": "守形くん！？"},
{"id": 11, "kind": "msg", "spk": "守形", "ja": "美香子か……\nこの寝間着は、おまえのか？"},
{"id": 12, "kind": "msg", "spk": "美香子", "ja": "ええ、そうなのよ～。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "うおっ、すげえ、スケスケの……"},
{"id": 14, "kind": "msg", "spk": "美香子", "ja": "あら～、なにかしら、桜井くん。\n着てるところ、見たいとか？"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "あ、いや……"},
{"id": 16, "kind": "msg", "spk": "美香子", "ja": "それは、会長と一緒に寝る人にしか\nみせられないわ～。"},
{"id": 17, "kind": "msg", "spk": "守形", "ja": "美香子、返しておくぞ。"},
{"id": 18, "kind": "msg", "spk": "美香子", "ja": "守形くん、ありがとう～。"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "（スケスケの寝間着がへばりついても、\n　顔色ひとつ変えない守形先輩も\n　すげえけど……）"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "（そんな寝間着を手渡されても、\n　ぜんぜん動じない会長も、\n　普通じゃないよなー）"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "あ、でも、どうして会長の寝間着が、\n守形先輩のところに来たんですかね？"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "イカロスに通訳を頼んでみます？"},
{"id": 23, "kind": "msg", "spk": "美香子", "ja": "その必要はないわ～。\nきっと偶然よ～。"},
{"id": 24, "kind": "msg", "spk": "美香子", "ja": "桜井くん、守形くん、ごきげんよう～。"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "あ、はい……"},
{"id": 26, "kind": "msg", "spk": "守形", "ja": "うむ。"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "なんだったんですかね？"},
{"id": 28, "kind": "msg", "spk": "守形", "ja": "……さあな。"}
]}
