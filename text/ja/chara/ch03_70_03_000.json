{"file": "_Data/Script/Chara/Chapter03/70/03_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "どうですか、先輩、\nメロンは冷えましたか？"},
{"id": 1, "kind": "msg", "spk": "守形", "ja": "うむ。\n十分に冷えただろう。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "よーし！\nメロン割り、再開だ！"},
{"id": 3, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 4, "kind": "msg", "spk": "そはら", "ja": "イカロスさん、やってみたら？"},
{"id": 5, "kind": "msg", "spk": "イカロス", "ja": "…………はい。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "よし、じゃあ、イカロスの番な\nいいか、メロンを割るんだぞ？"},
{"id": 7, "kind": "msg", "spk": "イカロス", "ja": "わかりました、マスター。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "自分では見ないようにして、\nみんなの声を頼りにして歩いて、\n叩くんだ。"},
{"id": 9, "kind": "msg", "spk": "イカロス", "ja": "はい……\nこうですか？"},
{"id": 10, "kind": "msg", "spk": "ニンフ", "ja": "はい、アルファー、棒よ。"},
{"id": 11, "kind": "msg", "spk": "イカロス", "ja": "ニンフ、どこ？"},
{"id": 12, "kind": "msg", "spk": "ニンフ", "ja": "ちょっとまってね。\n今、手に持たせてあげるわ。"},
{"id": 13, "kind": "msg", "spk": "イカロス", "ja": "ありがとうニンフ。\nマスター、準備出来ました。\nいつでも大丈夫です……"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "よし、はじめるぞ～。"},
{"id": 15, "kind": "msg", "spk": "美香子", "ja": "桜井くん、ちょっといいかしら～？"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "なんですか？"},
{"id": 17, "kind": "msg", "spk": "美香子", "ja": "メロンの近くから呼んであげたら～？\n声のするほうに歩くほうが\nわかりやすいんじゃないかしら～？"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "ああ、なるほど。\nそうしますか！"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "こっちだ、イカロス！\nこっちだぞー！"},
{"id": 20, "kind": "msg", "spk": "イカロス", "ja": "マスターの呼ぶ声が聞こえます。\nそちらに行けばいいのですね。"},
{"id": 21, "kind": "msg", "spk": "そはら", "ja": "イカロスさん、もうちょい右ー！"},
{"id": 22, "kind": "msg", "spk": "ニンフ", "ja": "ねえ、スガタ、\n座標を言ってもいいの？"},
{"id": 23, "kind": "msg", "spk": "守形", "ja": "それは、やめておいたほうが\nいいんじゃないか？"},
{"id": 24, "kind": "msg", "spk": "ニンフ", "ja": "まどろっこしいわねー。"},
{"id": 25, "kind": "msg", "spk": "アストレア", "ja": "イカロス先輩、左です！"},
{"id": 26, "kind": "msg", "spk": "アストレア", "ja": "あれ、右？\nどっちがどっちでしたっけ！？"},
{"id": 27, "kind": "msg", "spk": "美香子", "ja": "近付いてきたわ～。"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "いいぞ、イカロス！"},
{"id": 29, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 30, "kind": "msg", "spk": "美香子", "ja": "桜井く～ん？"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "はい？"},
{"id": 32, "kind": "msg", "spk": "美香子", "ja": "えい。"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "（猿ぐつわ！？\n　うぐっ……声が出せない！！）"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "（会長、な、何をする気……！）"},
{"id": 35, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}どしゃ～～～！"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "（なんじゃこれは～～～！？\n　メロンのすぐそばに、\n　埋められちまった！？）"},
{"id": 37, "kind": "msg", "spk": "美香子", "ja": "桜井くん、いいわ～。\nとっても楽しくなってきたわ～。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "（楽しくねえ～～～！！）"},
{"id": 39, "kind": "msg", "spk": "イカロス", "ja": "マスター……\nメロン、近いですか？\n……もう叩けますか？"},
{"id": 40, "kind": "msg", "spk": "美香子", "ja": "ええ、すぐ目の前よ～。"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "（ま、待て……イカロス！\n　俺はメロンじゃない！）"},
{"id": 42, "kind": "msg", "spk": "イカロス", "ja": "……叩きます！"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "（うぎゃ～～～～～！？）"},
{"id": 44, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}グシャッ！"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "やっぱり、メロンは潰れるよなー。"},
{"id": 46, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 47, "kind": "msg", "spk": "そはら", "ja": "でも、美味しいね。"},
{"id": 48, "kind": "msg", "spk": "アストレア", "ja": "甘～い！"},
{"id": 49, "kind": "msg", "spk": "ニンフ", "ja": "ほんとねー。\nよく冷えてるし。"},
{"id": 50, "kind": "msg", "spk": "美香子", "ja": "楽しかったわね、守形くん。"},
{"id": 51, "kind": "msg", "spk": "守形", "ja": "……そうだな。"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "（潰れたのがメロンのほうで助かった。\n　頭、叩かれるかと思ったよ……）"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "イカロス、よく正確に\nメロンだけ叩けたな。ほめてやるぞ！"},
{"id": 54, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。\nありがとうございます……。"}
]}
