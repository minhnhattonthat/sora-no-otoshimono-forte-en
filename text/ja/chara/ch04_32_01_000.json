{"file": "_Data/Script/Chara/Chapter04/32/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "はあ……。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "俺の心は今、あの雲のようだ。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "妄想という名の果てしない空を、\nふわふわとあてもなく漂う雲……。"},
{"id": 3, "kind": "msg", "spk": "イカロス", "ja": "マスター。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "あぁイカロス……妄想ってやつは、\n奥が深いね。"},
{"id": 5, "kind": "msg", "spk": "イカロス", "ja": "そうなのですか。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "ああ。俺はカードの力を手に入れてから\nわずかの間に、多くのことを学んだよ。"},
{"id": 7, "kind": "msg", "spk": "イカロス", "ja": "……マスターのお役に立てたのなら、\nよかったです。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "だけどまだまださ。"},
{"id": 9, "kind": "msg", "spk": "イカロス", "ja": "？"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "まだまだ俺は、カードの力を使い\nこなせていない。"},
{"id": 11, "kind": "msg", "spk": "イカロス", "ja": "マスター……。"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "修行が足りないんだよ、俺は……。"},
{"id": 13, "kind": "msg", "spk": "イカロス", "ja": "…………。"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "（だってなぁ～、せっかく自由に妄想を\n　ふくらませられるのにさ）"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "（イマイチ盛り上がらないことや、\n　思い通りになかなかならないことが\n　あるんだもんなぁ）"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "（いつでも、どこでも、\n　バッチリ妄想できれば、\n　好きなときに発散し放題！！）"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "（そうすればこの先、エロには困らない\n　だろうなぁ……）"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "（カードの効果が切れるまでに、\n　なんとか自力で妄想できるように\n　ならないかな～）"},
{"id": 19, "kind": "msg", "spk": "イカロス", "ja": "マスター。"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "ん？"},
{"id": 21, "kind": "msg", "spk": "イカロス", "ja": "何か、私にお手伝いできることは\nありますか？"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "手伝い？"},
{"id": 23, "kind": "msg", "spk": "イカロス", "ja": "はい。"},
{"id": 24, "kind": "msg", "spk": "イカロス", "ja": "マスターが何か悩んでいらっしゃる\nようなので……。"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "ん～……まぁそうなんだけどさ。\nでもイカロスにはなぁ。"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "（できれば俺の妄想を研ぎ澄ます\n　ために、誰か練習台が欲しい\n　ところだけど）"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "（笑顔１つ浮かべるのにも苦労してる\n　イカロスに、俺の妄想を刺激する\n　ような真似はなぁ……）"},
{"id": 28, "kind": "msg", "spk": "イカロス", "ja": "私では、無理なのでしょうか……？"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "あ、いや、そういうわけじゃなくてさ。"},
{"id": 30, "kind": "msg", "spk": "イカロス", "ja": "ではなんなりとお命じください、\nマスター。"},
{"id": 31, "kind": "choice", "spk": "", "ja": "なら、俺を挑発してみろ！"},
{"id": 32, "kind": "choice", "spk": "", "ja": "命令するのは好きじゃない"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "よしわかった！　そこまで言うなら\n俺のことを挑発してみるがいい！！"},
{"id": 34, "kind": "msg", "spk": "イカロス", "ja": "挑発、ですか？"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "そうだ！！"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "（イカロスが俺の役に立ちたいって\n　言うんだ。なら、その想いを受け\n　止めてやろうじゃないか）"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "（それに相手は未確認生物……\n　本当なら、俺はあいつらにエロさ\n　なんて感じないはず）"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "（だけど、エロのないところに\n　新たなエロを見出してこそ、\n　真のエロ道！！）"},
{"id": 39, "kind": "msg", "spk": "イカロス", "ja": "では、いきます。"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "おう！　どんとこい！！"},
{"id": 41, "kind": "msg", "spk": "イカロス", "ja": "にーちゃんええどきょう\nしとるやないけー。"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "……は？"},
{"id": 43, "kind": "msg", "spk": "イカロス", "ja": "ちょっとこうしゃうらまで\nかおかしーや。"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "って、なんじゃそりゃー！！\n違うだろ！！　挑発っていえば、\nうっふんとかあっはんとか！！"},
{"id": 45, "kind": "msg", "spk": "イカロス", "ja": "挑発とはこうするものだと、先日\n会長さんから教わりましたが……。"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "あの人の挑発は違う挑発だ！！"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "ん～、あんまそういう、命令とか\n好きじゃないんだよなぁ。"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "お前はお前の好きなように、\n思ったことをやればいいんだし。"},
{"id": 49, "kind": "msg", "spk": "イカロス", "ja": "私の……思ったこと。"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "ああ。なんかしたいと思ったら、\nそのまんましてくれればいいよ。"},
{"id": 51, "kind": "msg", "spk": "イカロス", "ja": "……わかりました。"},
{"id": 52, "kind": "msg", "spk": "イカロス", "ja": "マスター、ご飯にしますか？"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "……は？"},
{"id": 54, "kind": "msg", "spk": "イカロス", "ja": "それともお風呂にしますか？"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "いきなり何言ってるんだ、って……。"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "（ご飯にする？→お風呂にする？\n　→それともワ・タ・シ♪）"},
{"id": 57, "kind": "msg", "spk": "？？？", "ja": "……呼んだ？"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "ぬぉっ！？\n俺が……まさか、イカロスに反応させ\nられるとはっ……！？"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "新妻の新婚さんプレイとは、\nやるなイカロス……！！"},
{"id": 60, "kind": "msg", "spk": "イカロス", "ja": "？"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "い、いいから続けてくれたまへ。"},
{"id": 62, "kind": "msg", "spk": "イカロス", "ja": "はい。"},
{"id": 63, "kind": "msg", "spk": "イカロス", "ja": "マスター、ご飯にしますか？\nそれともお風呂にしますか？"},
{"id": 64, "kind": "msg", "spk": "イカロス", "ja": "それとも……。"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "ごくり。"},
{"id": 66, "kind": "msg", "spk": "イカロス", "ja": "それともスイカにしますか？"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "なんでやねーん！！"},
{"id": 68, "kind": "msg", "spk": "イカロス", "ja": "ニンフが見ていたテレビでやっていた\nものですから……。"},
{"id": 69, "kind": "msg", "spk": "イカロス", "ja": "男性は、そういう言葉を喜ぶのだと、\n学習しました。"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "まぁ、途中まではよかったよ、\n途中までは。"},
{"id": 71, "kind": "msg", "spk": "イカロス", "ja": "……。"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "ま～無理するな。\nお前のその“気持ち”は\n嬉しかったからさ。"},
{"id": 73, "kind": "msg", "spk": "イカロス", "ja": "気持ち、ですか？"},
{"id": 74, "kind": "msg", "spk": "智樹", "ja": "そ、気持ち。\n俺のこと気遣ってくれたんだろ。"},
{"id": 75, "kind": "msg", "spk": "イカロス", "ja": "……はい。"},
{"id": 76, "kind": "msg", "spk": "智樹", "ja": "その気持ちが、嬉しいよ。"},
{"id": 77, "kind": "msg", "spk": "イカロス", "ja": "これが、気持ち……。"}
]}
