{"file": "_Data/Script/Chara/Chapter01/32/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "お、会長だ。"},
{"id": 1, "kind": "msg", "spk": "美香子", "ja": "あら、何か用かしら、先生～？"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "いや、べつに……"},
{"id": 3, "kind": "msg", "spk": "美香子", "ja": "そうなの～。\nじゃあ、失礼するわ～。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "（あ、待てよ。\n　くくく……\n　いいこと思いついたぜ！）"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "ちょっと待ちなさい、オホン！"},
{"id": 6, "kind": "msg", "spk": "美香子", "ja": "あら～？\nやっぱり用事があるのかしら～？"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "うむ！\nオホン、今からミニテストを行う！"},
{"id": 8, "kind": "msg", "spk": "美香子", "ja": "今は休み時間よ～？\nしかも、こんな廊下で？"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "教育に時間も場所も関係ないのだ！"},
{"id": 10, "kind": "msg", "spk": "美香子", "ja": "あら、そうなの～？\nおかしな先生だわ～。"},
{"id": 11, "kind": "msg", "spk": "美香子", "ja": "それで、なにをするのかしら～？"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "道徳のテストを行う！！"},
{"id": 13, "kind": "msg", "spk": "美香子", "ja": "……ッ！？"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "（くっくっくっ……\n　会長は道徳が苦手だからな）"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "（いつも酷い目に遭わされてるから\n　軽いお返しだぜ！）"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "ん～、どうするのかね？\n降参かね？"},
{"id": 17, "kind": "msg", "spk": "美香子", "ja": "いいわよ、道徳のミニテストくらい、\nいくらでも受けてあげるわ～。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "くっくっくっ……\nでは、いくぞ！"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "電車で老人に席を譲らない人がいます！\nどうしますか！？"},
{"id": 20, "kind": "msg", "spk": "美香子", "ja": "皆殺し。"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "ブーーー！"},
{"id": 22, "kind": "msg", "spk": "美香子", "ja": "あら～、どこか間違ったかしら？"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "ぜんぜんダメだ！\nじゃあ、次の問題だぞ！"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "暴力を振るっている人がいます！"},
{"id": 25, "kind": "msg", "spk": "美香子", "ja": "被害者を助けるわ～。"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "おお、その通りだ！\n正解だ！"},
{"id": 27, "kind": "msg", "spk": "美香子", "ja": "そして、暴力を振るっていたほうを\nそれ以上の暴力で八つ裂きよ～。"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "やっぱり、不正解だ！！\nやりすぎだろ！？\nそこまでやっちゃダメだろ！？"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "二問とも不正解だ！\nぜんぜんダメだ！\nじゃあ、次の問題だぞ？"},
{"id": 30, "kind": "choice", "spk": "", "ja": "人を叩くのは！？"},
{"id": 31, "kind": "choice", "spk": "", "ja": "目の前に桜井智樹がいます"},
{"id": 32, "kind": "choice", "spk": "", "ja": "やっぱりやめとく"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "人を叩くのは{16}{15}\n良いことか、悪いことか！？"},
{"id": 34, "kind": "msg", "spk": "美香子", "ja": "楽しいことだわ～。"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "ブブーーー！！\n不正解！"},
{"id": 36, "kind": "msg", "spk": "美香子", "ja": "そんなことないわ～。\n試してみましょうか？"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "は？\n試すって、どうやって？"},
{"id": 38, "kind": "msg", "spk": "美香子", "ja": "やっぱり、実験してみるのが\n一番だと思うのよね～。"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "ちょっ……そのバット\nどこから出したんですか……！？"},
{"id": 40, "kind": "msg", "spk": "美香子", "ja": "うふふふ……"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "ば、バットはボールを\n打ちかえすものであって、\nまして人に向かって振るものでは……"},
{"id": 42, "kind": "msg", "spk": "美香子", "ja": "いくわよ～！"},
{"id": 43, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ブンッ！！"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "うおっ！？"},
{"id": 45, "kind": "msg", "spk": "美香子", "ja": "なんて、冗談よ～？"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "は、ははは……"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "（し、死ぬかと思った……）"},
{"id": 48, "kind": "msg", "spk": "美香子", "ja": "桜井くんならホームランにしたわ～。\nあの悲鳴を思い出すだけで、快感ね～。"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "目の前に桜井智樹がいます。"},
{"id": 50, "kind": "msg", "spk": "美香子", "ja": "極刑よ～。"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "なんでだよ！\nなんでいきなり極刑になるんだよ！"},
{"id": 52, "kind": "msg", "spk": "美香子", "ja": "だって、桜井くんなんでしょ～？"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "ああ……そうだけど。"},
{"id": 54, "kind": "msg", "spk": "美香子", "ja": "それなら、極刑にするのが、\n正解だと思うわ～。"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "いやいや、ぜんぜんダメだから！\nそれ不正解だから！"},
{"id": 56, "kind": "msg", "spk": "美香子", "ja": "極刑よ～。"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "ダメだっての！"},
{"id": 58, "kind": "msg", "spk": "美香子", "ja": "ダメなの～？\n仕方ないわね～。"},
{"id": 59, "kind": "msg", "spk": "美香子", "ja": "じゃあ、死刑にするわ～。"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "同じだろ！？\n不正解だーーー！！"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "あ、いや……\nやっぱり、やめておこう。"},
{"id": 62, "kind": "msg", "spk": "美香子", "ja": "あら～？　どうしたのかしら～？"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "（なんだか、すごく嫌な予感がする。\n　ここまでにしておこう）"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "時間がないのでな。\n今日は、ここまでにする。"},
{"id": 65, "kind": "msg", "spk": "美香子", "ja": "そうなの？　残念だわ～。\nいろいろ用意してたのに～。"},
{"id": 66, "kind": "msg", "spk": "美香子", "ja": "たとえば、こんなバットとか～。"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "なんで、バットを\n用意してあるんだ！？"},
{"id": 68, "kind": "msg", "spk": "美香子", "ja": "こんなものが必要な\nテスト問題が来るんじゃないかって\n予想してたのよ～。"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "（問題を出してたら……\n　どうなってたんだ！？）"}
]}
