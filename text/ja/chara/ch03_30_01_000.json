{"file": "_Data/Script/Chara/Chapter03/30/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "アストレア", "ja": "次は何を焼こうかな～？"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "このでかい肉を焼こうぜ！"},
{"id": 2, "kind": "msg", "spk": "アストレア", "ja": "お肉ほしいですー！　お肉ー！"},
{"id": 3, "kind": "msg", "spk": "そはら", "ja": "トモちゃん、アストレアさん、\n野菜も食べないとダメだよ？"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "それもそうだな。\nんじゃ、野菜を焼くか。"},
{"id": 5, "kind": "msg", "spk": "アストレア", "ja": "えー！？\nお肉がいいよー！！\nお肉！　お肉ー！！"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "ああ、もう、わかったよ。\nじゃあ、好きなもの焼けよ。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "コンロもでかいし、野菜と肉を置いても\n大丈夫だろ。"},
{"id": 8, "kind": "msg", "spk": "アストレア", "ja": "なんでも、好きなもの焼いていいの？"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "ああ、その代わり乗せすぎるなよ？\nなにか１つにしとけ。"},
{"id": 10, "kind": "msg", "spk": "アストレア", "ja": "わかった！\nじゃあ、一番大きいの\n乗せちゃおうかな。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "ああ、好きなの焼いておけ。"},
{"id": 12, "kind": "msg", "spk": "アストレア", "ja": "わーい！"},
{"id": 13, "kind": "msg", "spk": "美香子", "ja": "あら、そんなの焼いちゃうなんて、\n楽しそうね～。"},
{"id": 14, "kind": "msg", "spk": "アストレア", "ja": "えへへ、ししょうも食べますか？"},
{"id": 15, "kind": "msg", "spk": "美香子", "ja": "会長は、離れてるわ～。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "ん？\nんんん～！？"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "おい、アストレア！？\nなんで缶詰を焼いてるんだ！？"},
{"id": 18, "kind": "msg", "spk": "アストレア", "ja": "これが一番大きくて\n美味しそうだったから！"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "どんどん膨らんでるじゃねえか！"},
{"id": 20, "kind": "msg", "spk": "アストレア", "ja": "大きいほうが嬉しいじゃない。\nなに言ってるの？"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "このままじゃ、やばいぞ……"},
{"id": 22, "kind": "choice", "spk": "", "ja": "危ないのでやめさせる"},
{"id": 23, "kind": "choice", "spk": "", "ja": "缶詰をすぐどける"},
{"id": 24, "kind": "choice", "spk": "", "ja": "開けてやる"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "バカなこと言ってないで、\nさっさとやめろって！\n危ないだろ！"},
{"id": 26, "kind": "msg", "spk": "アストレア", "ja": "バカって言ったほうが、\nバカなんだからね！\nバーカ！"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "バーカ、バーカ！"},
{"id": 28, "kind": "msg", "spk": "アストレア", "ja": "バーカ、バーカ！"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "って、んなこと言ってる場合じゃねえ！"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "はやくどかさないと、\n大変なことになるぞ！？"},
{"id": 31, "kind": "msg", "spk": "アストレア", "ja": "そうなの？　もう、わかったわよ。"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "あ、バカ、素手でつかむやつがあるか！"},
{"id": 33, "kind": "msg", "spk": "アストレア", "ja": "熱～～～ッ！？"},
{"id": 34, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}ぽ～～～い！"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "ぶわっ！？\nこっちに投げたら……ッ！？"},
{"id": 36, "kind": "msg", "spk": "", "ja": "　\n{1F}{14}ジューーーーーッ！"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "ギャアアアアアァァァ～～～！！"},
{"id": 38, "kind": "msg", "spk": "そはら", "ja": "きゃー！？\nトモちゃーん！？"},
{"id": 39, "kind": "msg", "spk": "アストレア", "ja": "あれ……？"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "てい！"},
{"id": 41, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}ぽ～～～い！"},
{"id": 42, "kind": "msg", "spk": "アストレア", "ja": "あっ、なにすんのよ！？"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "バカか！\nあやうく、爆発するところだろうが！？"},
{"id": 44, "kind": "msg", "spk": "アストレア", "ja": "ぷすす。\nそんなわけ、ないでしょ？\n缶詰が爆発するなんて。"},
{"id": 45, "kind": "msg", "spk": "そはら", "ja": "アストレアさん、缶詰を熱しすぎると、\n爆発することもあるんだよ？"},
{"id": 46, "kind": "msg", "spk": "アストレア", "ja": "え……そうなんですか？"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "危ないから、もうやるなよ？"},
{"id": 48, "kind": "msg", "spk": "アストレア", "ja": "う、うん……\nご、ごめんなさい……"},
{"id": 49, "kind": "msg", "spk": "アストレア", "ja": "あの……えっと……\nあ……"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "ん？　なんだ？\nはっきり言えよ。"},
{"id": 51, "kind": "msg", "spk": "アストレア", "ja": "だから……あ……あり……"},
{"id": 52, "kind": "msg", "spk": "アストレア", "ja": "バ、バカって言ったのよ！"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "なにー！？"},
{"id": 54, "kind": "msg", "spk": "アストレア", "ja": "さーて次は\nお肉を焼こう～っと！"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "ひょいっと。"},
{"id": 56, "kind": "msg", "spk": "アストレア", "ja": "なんでどけるのよ！？\n好きなもの焼いていいって\n言ったのに！"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "このままじゃ食べられないだろ。"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "アストレアだって缶詰は\n開けなきゃ食べられないことは\n知ってるよな？"},
{"id": 59, "kind": "msg", "spk": "アストレア", "ja": "え……そりゃ、まあ……"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "焼けて熱くなった缶詰、\n誰が開けるんだよ。"},
{"id": 61, "kind": "msg", "spk": "アストレア", "ja": "そっか……"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "海水でいったん冷まして、\n蓋を開けて……"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "って、缶切りが\nなかったんだったな……。"},
{"id": 64, "kind": "msg", "spk": "アストレア", "ja": "むぅ～～～\nわかった！\n私、開けてみる！"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "え？　どうすんだよ？\n言っとくけど、\nあのなんとか剣じゃ中身まで……"},
{"id": 66, "kind": "msg", "spk": "智樹", "ja": "って、あれ？\nこのセリフ前にも言ったような……？"},
{"id": 67, "kind": "msg", "spk": "アストレア", "ja": "手で！！"},
{"id": 68, "kind": "msg", "spk": "智樹", "ja": "オヤオヤ～？\nこの流れは……"},
{"id": 69, "kind": "msg", "spk": "アストレア", "ja": "はぁぁぁぁぁぁぁ～～～～～！！"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "お、おい、アストレア、\nストップ！　ストップ！！"},
{"id": 71, "kind": "msg", "spk": "アストレア", "ja": "やぁぁぁぁぁぁぁ～～～～～！！"},
{"id": 72, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}パーンッ！！"},
{"id": 73, "kind": "msg", "spk": "アストレア", "ja": "はきゃ～～～～～！？"},
{"id": 74, "kind": "msg", "spk": "智樹", "ja": "あ～あ、やっちまった……。"},
{"id": 75, "kind": "msg", "spk": "アストレア", "ja": "うぇ～～～～～、べちゃべちゃする～。"},
{"id": 76, "kind": "msg", "spk": "智樹", "ja": "しかも、またパイナップルかよ！\nなんで焼こうと思ったんだ？\nチョイス間違えてるだろっ！？"},
{"id": 77, "kind": "msg", "spk": "アストレア", "ja": "はむっはむっはむっ。\nパイナップル、おいしーです！"},
{"id": 78, "kind": "msg", "spk": "智樹", "ja": "……聞いちゃいねえ。"},
{"id": 79, "kind": "msg", "spk": "智樹", "ja": "（それにしても\n　またシロップの液まみれの\n　エロい姿しやがって……）"},
{"id": 80, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}カチッ！"},
{"id": 81, "kind": "msg", "spk": "智樹", "ja": "あ……。\nここも再現されるんですね？"},
{"id": 82, "kind": "msg", "spk": "智樹", "ja": "って、冷静に言ってる場合じゃない！\nどうする！？　みんないるし\nここで爆発するわけには……"},
{"id": 83, "kind": "msg", "spk": "智樹", "ja": "どうする？　どうする！？"},
{"id": 84, "kind": "msg", "spk": "智樹", "ja": "そうだ！　海だぁーーーっ！！"},
{"id": 85, "kind": "msg", "spk": "", "ja": "　\n{1F}{15}バッシャーーン！"},
{"id": 86, "kind": "msg", "spk": "", "ja": "　\n{1F}{12}ちゅどーーーーーん！！"},
{"id": 87, "kind": "msg", "spk": "智樹", "ja": "ぎゃはぁぁぁ～～～！！"},
{"id": 88, "kind": "msg", "spk": "ニンフ", "ja": "トモキ、海に飛び込んだと思ったら\nまた爆発して……。\nまったく……、懲りないわねぇ？"},
{"id": 89, "kind": "msg", "spk": "イカロス", "ja": "マスター……\n大丈夫でしょうか？"},
{"id": 90, "kind": "msg", "spk": "アストレア", "ja": "はむっはむっはむっ。\nパイナップル、おいし～～！"},
{"id": 91, "kind": "msg", "spk": "美香子", "ja": "ちなみに缶詰を開けずに加熱すると\n本当に破裂しちゃったりするから\nよい子は絶対にマネしちゃダメよ～？"}
]}
