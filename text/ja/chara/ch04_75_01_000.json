{"file": "_Data/Script/Chara/Chapter04/75/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "アストレア", "ja": "お腹空いた。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "いきなりだなおい。"},
{"id": 2, "kind": "msg", "spk": "アストレア", "ja": "お腹空いたの～！"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "はいはい。学食でパンでも買ってこい。"},
{"id": 4, "kind": "msg", "spk": "アストレア", "ja": "お小遣いは？"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "は？"},
{"id": 6, "kind": "msg", "spk": "アストレア", "ja": "イカロス先輩とニンフ先輩みたいに、\n私にもお小遣いちょうだい！\nそしたら買ってくる。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "いや、いつもいつも２人に\nお小遣いをやってるわけじゃ\nないんだけど。"},
{"id": 8, "kind": "msg", "spk": "アストレア", "ja": "ちょーだい！"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "いやだからな{16}{17}。"},
{"id": 10, "kind": "msg", "spk": "アストレア", "ja": "ちょーだい！！"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "あーもうっ。\n……あ、そうだ。\n試しに聞くけどな。"},
{"id": 12, "kind": "msg", "spk": "アストレア", "ja": "うん？"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "１００円玉５個と、１０００円札１枚。\nさてどっちの方がパンを多く買える？"},
{"id": 14, "kind": "msg", "spk": "アストレア", "ja": "え？　そ、そんなの決まってるわ。"},
{"id": 15, "kind": "msg", "spk": "アストレア", "ja": "えーっと……えっと……。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "…………。"},
{"id": 17, "kind": "msg", "spk": "アストレア", "ja": "うーん、ううーん……。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "…………。"},
{"id": 19, "kind": "msg", "spk": "アストレア", "ja": "わかった！！\n５個あるから\n１００円玉の方が多く買える！！"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "……ふう。\nいつか一緒に、\n買い物行ってやるから。"},
{"id": 21, "kind": "msg", "spk": "アストレア", "ja": "なんでよ～～～っ！！"}
]}
