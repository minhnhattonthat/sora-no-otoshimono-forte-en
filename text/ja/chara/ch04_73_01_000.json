{"file": "_Data/Script/Chara/Chapter04/73/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "はぁぁ……。"},
{"id": 1, "kind": "msg", "spk": "イカロス", "ja": "お疲れですか、マスター？"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "あー……まぁな。\n今日だけでも色々あったし。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "お前らが来てからずっと、\n毎日こんな調子だし。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "俺は、平和が一番って、\nそう思っていたんだけどなぁ……。"},
{"id": 5, "kind": "msg", "spk": "イカロス", "ja": "……。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "（そう、ただちょっと……\n　たまに女子更衣室が覗ければそれで、\n　俺は幸せだったのに！）"},
{"id": 7, "kind": "msg", "spk": "イカロス", "ja": "マスター。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "ん、どうした？\n急に座り込んで。"},
{"id": 9, "kind": "msg", "spk": "イカロス", "ja": "こちらへ来てください。"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "こちらって、お前一体何を……。"},
{"id": 11, "kind": "choice", "spk": "", "ja": "素直に近づく"},
{"id": 12, "kind": "choice", "spk": "", "ja": "何かの罠か？"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "まぁいいけど……。\nこ、こうか？"},
{"id": 14, "kind": "msg", "spk": "イカロス", "ja": "はい。そのまま横になってください。"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "え……っと。うん。"},
{"id": 16, "kind": "msg", "spk": "イカロス", "ja": "ん……。"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "わ！？　イカロス？\n何を急に{16}{17}。"},
{"id": 18, "kind": "msg", "spk": "イカロス", "ja": "……これで、いかがでしょう？"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "（ん？　寝転がされて……この、\n　頭に当たる感触……\n　イカロスの、ふともも？）"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "（……俺は今、イカロスに\n　膝枕してもらっている！？）"},
{"id": 21, "kind": "msg", "spk": "イカロス", "ja": "……いかがでしょうか？"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "いかが、って。\n急にどうしたんだよ、お前。\nこんなことして。"},
{"id": 23, "kind": "msg", "spk": "イカロス", "ja": "男性はこうして眠るのが一番の癒やし\nだと、ニンフが観ていたテレビで\n言っていました。"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "まーたそんなのばっかり見て。"},
{"id": 25, "kind": "msg", "spk": "イカロス", "ja": "お嫌ですか？"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "……。"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "……まぁ、\nたまになら、別に。"},
{"id": 28, "kind": "msg", "spk": "イカロス", "ja": "はい。"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "だ、誰かに見られたら恥ずかしいから、\nすぐ起こせよ？"},
{"id": 30, "kind": "msg", "spk": "イカロス", "ja": "はい。"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "ったく……。"},
{"id": 32, "kind": "msg", "spk": "イカロス", "ja": "……。"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "はっ！？\nまさか、何かの罠か？"},
{"id": 34, "kind": "msg", "spk": "イカロス", "ja": "え？"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "そはらか？　いや会長の差し金か？"},
{"id": 36, "kind": "msg", "spk": "イカロス", "ja": "？"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "イカロスに色仕掛けをさせて、\n影からこっそり見てるとか\nじゃないのか！？"},
{"id": 38, "kind": "msg", "spk": "イカロス", "ja": "いえ。あの……。"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "あああ！\n俺のささやかな平和は、こうして\n踏みにじられていくんだぁ～～～！！"},
{"id": 40, "kind": "msg", "spk": "イカロス", "ja": "……。"}
]}
