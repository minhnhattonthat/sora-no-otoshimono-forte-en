{"file": "_Data/Script/Chara/Chapter02/74/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "イカロス", "ja": "……"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "よっ、イカロス。\nなにを見てるんだ？"},
{"id": 2, "kind": "msg", "spk": "イカロス", "ja": "あ……マスター。"},
{"id": 3, "kind": "msg", "spk": "イカロス", "ja": "川で……これを拾いました。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "パンツじゃねぇか！？"},
{"id": 5, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "なぜ川からパンツが……？"},
{"id": 7, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "うーん、洗濯物が流されてきたのか……\nそれとも、他にキャンプしてる人が\n上のほうにいるとか？"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "（いや、そのパンツ……\n　見覚えがあるぞ？）"},
{"id": 10, "kind": "msg", "spk": "イカロス", "ja": "……"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "なにしてんだよ、イカロス？"},
{"id": 12, "kind": "msg", "spk": "イカロス", "ja": "……合体。"},
{"id": 13, "kind": "msg", "spk": "", "ja": "　\n{1F}{1A}スポッ"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "なぜスイカにパンツを\nはかせてるんだ！？"},
{"id": 15, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "おい、イカロス！？"},
{"id": 17, "kind": "msg", "spk": "イカロス", "ja": "マスター……です。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "ちっげええええええええ！！！"},
{"id": 19, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "そうじゃない！\n間違ってるぞ、イカロス！"},
{"id": 21, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "パンツは、はかせるもんじゃねえ！\nかぶるもんだ！"},
{"id": 23, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 24, "kind": "msg", "spk": "アストレア", "ja": "あっ、イカロスせんぱ～い！"},
{"id": 25, "kind": "msg", "spk": "イカロス", "ja": "……アストレア。"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "どうしたんだよ、そんなに慌てて？"},
{"id": 27, "kind": "msg", "spk": "アストレア", "ja": "そ、それ、私のです！\n川に流されちゃって。"},
{"id": 28, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 29, "kind": "msg", "spk": "アストレア", "ja": "ありがとうございますー！！"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "なにをどうしたら\nパンツを川に流されるんだ！？"},
{"id": 31, "kind": "msg", "spk": "アストレア", "ja": "うっ……"},
{"id": 32, "kind": "msg", "spk": "アストレア", "ja": "川で滑って転んで、\n濡れたから干してたら、\n飛んじゃって……"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "ぶははははは～～～～！！"},
{"id": 34, "kind": "msg", "spk": "アストレア", "ja": "く～～～。\nううぅ……めちゃくちゃ濡れてる……"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "そりゃ、川を流れてきたんだから、\n当然だろ！"},
{"id": 36, "kind": "msg", "spk": "アストレア", "ja": "がまんして、はいておこ。"},
{"id": 37, "kind": "msg", "spk": "イカロス", "ja": "……違うわ。アストレア。"},
{"id": 38, "kind": "msg", "spk": "アストレア", "ja": "なにがですか、イカロス先輩？？"},
{"id": 39, "kind": "msg", "spk": "イカロス", "ja": "パンツは、はくものじゃない……。\nかぶるものよ。"},
{"id": 40, "kind": "msg", "spk": "アストレア", "ja": "え？　イ、イカロス先輩？"},
{"id": 41, "kind": "msg", "spk": "イカロス", "ja": "さあ……"},
{"id": 42, "kind": "msg", "spk": "アストレア", "ja": "あの、ちょっと……怖！\n待ってください！\nかぶるって、なんで！？"},
{"id": 43, "kind": "msg", "spk": "アストレア", "ja": "イヤッ、イヤァーーー！！\n濡れてるの頭に！？"},
{"id": 44, "kind": "msg", "spk": "アストレア", "ja": "キャアアアーーー！？"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "……学習したな、イカロス。"}
]}
