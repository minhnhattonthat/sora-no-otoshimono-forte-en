{"file": "_Data/Script/Chara/Chapter03/13/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "美香子", "ja": "桜井く～ん？"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "ん？　なんスか、会長？"},
{"id": 2, "kind": "msg", "spk": "美香子", "ja": "会長、ちょっとした\nお願いがあるのよね～。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "俺にできることなら、\nかまわないですけど。"},
{"id": 4, "kind": "msg", "spk": "美香子", "ja": "大丈夫よ、\nたいしたことじゃないわ～。"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "はぁ……"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "（会長にはいつも酷い目に遭わされ\n　てるから気をつけないとな）"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "何するんです？"},
{"id": 8, "kind": "msg", "spk": "美香子", "ja": "会長、砂遊びをやってみたいな～\nと思って～。"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "ああ、ビーチで砂遊びって\n定番ですよね。"},
{"id": 10, "kind": "msg", "spk": "美香子", "ja": "そうよね、\n一緒に遊んでくれるかしら～？"},
{"id": 11, "kind": "choice", "spk": "", "ja": "断る"},
{"id": 12, "kind": "choice", "spk": "", "ja": "逃げる"},
{"id": 13, "kind": "choice", "spk": "", "ja": "一緒に遊ぶ"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "やめときます。"},
{"id": 15, "kind": "msg", "spk": "美香子", "ja": "あら、どうしてなの～？"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "なんか、すげえ嫌な予感がするので。"},
{"id": 17, "kind": "msg", "spk": "美香子", "ja": "それなら、すぐに\n逃げるべきだったわね～。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "え？"},
{"id": 19, "kind": "msg", "spk": "美香子", "ja": "桜井く～ん、一歩後ろよ～。"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "え？"},
{"id": 21, "kind": "msg", "spk": "美香子", "ja": "えいっ！"},
{"id": 22, "kind": "msg", "spk": "", "ja": "　\n{1F}{1A}ドン！"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "わっ！？\nなんで押すんですか……！？"},
{"id": 24, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}ずしゃーーー！"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "ぶわ～～～！？\n落とし穴！？\n浜辺に落とし穴が！？"},
{"id": 26, "kind": "msg", "spk": "美香子", "ja": "会長、砂に埋められて動けない～って\nいうの試してみたかったの～。"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "うぐぐぐ……\nああ、たしかに動けませんよ！\nもう試せたでしょ、出してください！"},
{"id": 28, "kind": "msg", "spk": "美香子", "ja": "あら、だめよ～。\nこのまま満ち潮になるまで待たなきゃ。"},
{"id": 29, "kind": "msg", "spk": "美香子", "ja": "命の危険が迫らないと、\n本当に動けないかわからないでしょ～？"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "わかるだろ！\n動けるなら、とっくに逃げてるだろ！"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "って、波がきた！？"},
{"id": 32, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ザパーン！"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "うぎゃ～～～がぼがぼがぼ……！？"},
{"id": 34, "kind": "msg", "spk": "美香子", "ja": "桜井くんの悲鳴って、いいわ～。"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "なんか、やばい！！"},
{"id": 36, "kind": "msg", "spk": "美香子", "ja": "あら～？\nどうして逃げるのかしら～？"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "どう考えても、まともな遊びとは\n思えないからですよ！！"},
{"id": 38, "kind": "msg", "spk": "美香子", "ja": "……残念だわ～。"},
{"id": 39, "kind": "msg", "spk": "美香子", "ja": "そっちの落とし穴は、\n深く掘り過ぎちゃったのよ～。"},
{"id": 40, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}ずしゃーーー！"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "ぎゃあああ～～～～～～！？"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "どこまで落ちていくんだーーー！？"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "マジで深いぞーーー！？\nどうやって出るんだーーー！？"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "まあ、いいッスよ。"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "んで、砂遊びって、\nなにやるんですか？"},
{"id": 46, "kind": "msg", "spk": "美香子", "ja": "じゃあ、そこに寝てくれるかしら？"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "はあ？\nわかりました……\n何すんですか？"},
{"id": 48, "kind": "msg", "spk": "美香子", "ja": "気持ちいいことよ～。"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "（ね、寝転んで、気持ちいいこと！？）"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "（気持ちいい遊びって、なんだ～！？）"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "準備完了です、会長！！"},
{"id": 52, "kind": "msg", "spk": "美香子", "ja": "寝てるところに、\n砂をかけていくわね～。"},
{"id": 53, "kind": "msg", "spk": "美香子", "ja": "さらさらさら～。\nさらさらさら～。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "おお……たしかに、\nこれは気持ちいいかも。"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "こそばゆい感じが、たまらん……\nうへへ。"},
{"id": 56, "kind": "msg", "spk": "美香子", "ja": "桜井くんて、そういうとこが\n楽しくていいわね～。"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "うへへ……"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "ん？　なんか、ちょっと体が\n重たいというか……"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "あれ？　動けなくないですか？"},
{"id": 60, "kind": "msg", "spk": "美香子", "ja": "そうね～。砂って重たいから、\nたくさん乗ると\n動けなくなるらしいわ～。"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "ちょっ！？\nあれ、なんか波がきますよ！？"},
{"id": 62, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ザパーン！"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "うぎゃ～～～がぼがぼがぼ……！？"},
{"id": 64, "kind": "msg", "spk": "美香子", "ja": "桜井くん、楽しんでるかしら～？"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "ぺっぺっ！\n楽しいわけないでしょうが！！"},
{"id": 66, "kind": "msg", "spk": "美香子", "ja": "会長、すっごく楽しいわ～。"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "出せ！　この砂をどけろー！"},
{"id": 68, "kind": "msg", "spk": "智樹", "ja": "うおっ、また波がきたー！？"},
{"id": 69, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ザパーン！"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "がぼがぼがぼがぼ～～～！？"},
{"id": 71, "kind": "msg", "spk": "美香子", "ja": "……うっとりしちゃうわ～。\n砂遊びって楽しいのね～。"}
]}
