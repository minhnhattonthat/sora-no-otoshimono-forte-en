{"file": "_Data/Script/Chara/Chapter01/10/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "よお、アストレア、\nなにやってんだ？"},
{"id": 1, "kind": "msg", "spk": "アストレア", "ja": "うっ……\nべつに、私がなにしてたって\nいいでしょ！"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "そりゃ、そうだけどさ……\nなんだよ、そのプリント？"},
{"id": 3, "kind": "msg", "spk": "アストレア", "ja": "べ、勉強してるの！"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "へー、放課後に居残りして勉強かよ。\nすごいじゃないか。"},
{"id": 5, "kind": "msg", "spk": "アストレア", "ja": "そ、そうかな？　えへへ……"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "ああ、すげえ立派だよ。"},
{"id": 7, "kind": "msg", "spk": "アストレア", "ja": "うん、うん！"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "なんてな。\n前のテストが\n３０点以下だったせいだろ？"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "うははは！\nバーカ、バーカ！"},
{"id": 10, "kind": "msg", "spk": "アストレア", "ja": "ぐぐぐ～～～ッ！\nアンタはどうだったのよ！？"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "俺は３１点だった！"},
{"id": 12, "kind": "msg", "spk": "アストレア", "ja": "同じようなものじゃない！\nアンタもプリントやりなさいよ！"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "フッ……甘いな、アストレア。\nたかが１点だが……\nその１点は、あまりに重たい。"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "放課後に自由を満喫できるか……\n居残りでプリントやるか……\nそのくらい重い１点なんだよ！"},
{"id": 15, "kind": "msg", "spk": "アストレア", "ja": "うううぅ～～～！\nくやしー！！"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "んで、プリントは進んでるのか？\nどれどれ？"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "なんだこれ、数学っていうより、\n算数？"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "小学生の問題じゃねえか。\nどれどれ？"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "１＋１＝ごじゅう"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "なんだこれ！？"},
{"id": 21, "kind": "msg", "spk": "アストレア", "ja": "あれ？　ちがってた？"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "（うぉ……！？\n　小学生レベルの問題さえ\n　解けないのか、こいつ！？）"},
{"id": 23, "kind": "msg", "spk": "アストレア", "ja": "えーっと……\n次の問題は……"},
{"id": 24, "kind": "msg", "spk": "アストレア", "ja": "ううぅ……\n３バツ４って……\nどういうこと！？"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "（掛けるだよ！　バツじゃねえよ！\n　それは、掛け算だ！）"},
{"id": 26, "kind": "msg", "spk": "アストレア", "ja": "うう～、むずかしいよ～。"},
{"id": 27, "kind": "choice", "spk": "", "ja": "教える"},
{"id": 28, "kind": "choice", "spk": "", "ja": "放っておく"},
{"id": 29, "kind": "choice", "spk": "", "ja": "応援する"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "はぁ……\nしょうがねえな。"},
{"id": 31, "kind": "msg", "spk": "アストレア", "ja": "な、なによ！？"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "教えてやるよ。\n俺でも小学校レベルの問題なら\n解けるしな。"},
{"id": 33, "kind": "msg", "spk": "アストレア", "ja": "い、い、いらないわよ、そんなの！\nアンタに教えてもらう必要なんて\nないんだから！"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "いいから、聞けって。"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "これ、３掛ける４って読むんだよ。\n３が４つあったら、\nいくつになるかって意味。"},
{"id": 36, "kind": "msg", "spk": "アストレア", "ja": "えっ、えっ！？"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "ほら、教科書に九九の表があるから、\n見ろっての。"},
{"id": 38, "kind": "msg", "spk": "アストレア", "ja": "知ってるわよ、バーカ！"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "横が３で、縦が４のとこを見ると、\nほら１２って書いてあるだろ？"},
{"id": 40, "kind": "msg", "spk": "アストレア", "ja": "なるほど……　わかった！\n答えは、１２！！"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "おう、ひとつ解けたな！"},
{"id": 42, "kind": "msg", "spk": "アストレア", "ja": "やったーーー！！"},
{"id": 43, "kind": "msg", "spk": "アストレア", "ja": "ハッ！"},
{"id": 44, "kind": "msg", "spk": "アストレア", "ja": "わ、わかってたんだからね！\nバーカ！"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "はは……まだ１問だろ？\nどんどん解いていこうぜ。"},
{"id": 46, "kind": "msg", "spk": "アストレア", "ja": "う、うん！"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "まぁ、俺には関係ないしなー。"},
{"id": 48, "kind": "msg", "spk": "アストレア", "ja": "く～～～～～ッ！"},
{"id": 49, "kind": "msg", "spk": "アストレア", "ja": "３１点なんて、\n３０点みたいなもんじゃない！\n一緒にプリント、やっていきなさいよ！"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "なぁ……　アストレアは、\nぎりぎり３０点だったのか？"},
{"id": 51, "kind": "msg", "spk": "アストレア", "ja": "え……"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "ん？"},
{"id": 53, "kind": "msg", "spk": "アストレア", "ja": "さ……"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "んん？"},
{"id": 55, "kind": "msg", "spk": "アストレア", "ja": "さん、てん……"},
{"id": 56, "kind": "msg", "spk": "アストレア", "ja": "ああ、もう！\n３点よ！"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "ぶははは！！\nバーカ！　バーカ！"},
{"id": 58, "kind": "msg", "spk": "アストレア", "ja": "名前、書いたら、３点くれたのよ！！"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "ば……"},
{"id": 60, "kind": "msg", "spk": "智樹", "ja": "そ、そうか……\nがんばれ……よな？"},
{"id": 61, "kind": "msg", "spk": "アストレア", "ja": "しゅーん……"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "手伝うわけにはいかないけど、\n応援くらいはしてやるか。"},
{"id": 63, "kind": "msg", "spk": "アストレア", "ja": "応援？"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "フレー！　フレー！\nアストレア！"},
{"id": 65, "kind": "msg", "spk": "アストレア", "ja": "え、え？"},
{"id": 66, "kind": "msg", "spk": "智樹", "ja": "がんばれ、アストレア！\nおまえなら、できる！"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "俺は信じてるぜ、\nがんばれば、こんな問題\nなんでもないってな！"},
{"id": 68, "kind": "msg", "spk": "アストレア", "ja": "そ、そうかな？"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "ああ、弱気になるなよ、\nアストレア！"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "大切なのは努力と根性と気合いだ！\nやればできる！\nそういうもんだ！"},
{"id": 71, "kind": "msg", "spk": "アストレア", "ja": "う、うん！"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "全力でやってみろ！\n細かいことは、気にするな！\n考えるな、感じるんだ！"},
{"id": 73, "kind": "msg", "spk": "智樹", "ja": "叫べーーー！！"},
{"id": 74, "kind": "msg", "spk": "アストレア", "ja": "てやぁぁぁ～～～！！"},
{"id": 75, "kind": "msg", "spk": "アストレア", "ja": "ハッ！　テヤッ！！"},
{"id": 76, "kind": "msg", "spk": "智樹", "ja": "うお！？\nなんて力強く答えを書くんだ！！\nこ、これなら……"},
{"id": 77, "kind": "msg", "spk": "アストレア", "ja": "できた！！"},
{"id": 78, "kind": "msg", "spk": "アストレア", "ja": "『わ　か　り　ま　せ　ん　！』"},
{"id": 79, "kind": "msg", "spk": "智樹", "ja": "ぜんぜんダメじゃねえか！！"}
]}
