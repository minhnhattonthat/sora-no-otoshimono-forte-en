{"file": "_Data/Script/Chara/Chapter01/53/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "お、会長だ。"},
{"id": 1, "kind": "msg", "spk": "美香子", "ja": "あら～、先生、何かご用かしら～？\n今、ちょっと忙しいのだけど～。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "何かやってるんスか……ああ、いや、\nやってるのかね？"},
{"id": 3, "kind": "msg", "spk": "美香子", "ja": "桜井くんを捜してるの～。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "ほ、ほう……？"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "（だ、だいじょうぶだ！\n　ジャミングは完璧！\n　俺は先生！　先生に見えてる！）"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "桜井に、なにか用事かね？"},
{"id": 7, "kind": "msg", "spk": "美香子", "ja": "たいしたことじゃないのだけれど～。\nまた催し物を考えてるのよ～。"},
{"id": 8, "kind": "msg", "spk": "美香子", "ja": "障害物競走なんて、どうかしら～？"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "ああ、学校のイベントか。\nそのくらいなら、いいんじゃないか？"},
{"id": 10, "kind": "msg", "spk": "美香子", "ja": "命懸けの障害物競走よ～。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "ブフッ！？"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "なんで、俺が障害物競走に、\n命を懸けなきゃいけないんだよ！？"},
{"id": 13, "kind": "msg", "spk": "美香子", "ja": "あら～、\n先生は参加しなくてもいいのよ～？\n止めはしないけど～。"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "ハッ！\nそうだったな。\n先生は参加しなくていいんだ。"},
{"id": 15, "kind": "msg", "spk": "美香子", "ja": "そうなのよね～。\n参加したがるのは、\n桜井くんくらいかしら～？"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "（しねえよ！\n　絶対に参加しねえよ！）"},
{"id": 17, "kind": "msg", "spk": "美香子", "ja": "火の輪くぐりとか～、\n高さ３０メートルの平均台渡りとか～。"},
{"id": 18, "kind": "choice", "spk": "", "ja": "絶対ダメだ！"},
{"id": 19, "kind": "choice", "spk": "", "ja": "いいんじゃないか？"},
{"id": 20, "kind": "choice", "spk": "", "ja": "代案を出す"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "絶対ダメだ！\nそんな危ないこと、\nやっていいわけないだろ！？"},
{"id": 22, "kind": "msg", "spk": "美香子", "ja": "あら～、会長のやることに\n反対するなんて……"},
{"id": 23, "kind": "msg", "spk": "美香子", "ja": "そんな先生がいるなんて、\n意外だわ～"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "ダメなものは、ダメだ！"},
{"id": 25, "kind": "msg", "spk": "美香子", "ja": "桜井くん～？"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "（ギクッ！）"},
{"id": 27, "kind": "msg", "spk": "美香子", "ja": "今、ギクッて音がしたわ～。"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "聞こえるわけないだろ！？"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "（やばい……このままじゃ、\n　バレる！？）"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "い、いいか！\nダメだからな、命懸けとか、\n絶対に禁止だからな！"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "それじゃ、俺はこれで！"},
{"id": 32, "kind": "msg", "spk": "美香子", "ja": "桜井くん？　桜井くんなの～？"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "（ダメだ！\n　どう答えてもバレる気がする！！\n　逃げるしかねえ！！）"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "いいんじゃないか？"},
{"id": 35, "kind": "msg", "spk": "美香子", "ja": "あら、そうかしら～。"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "ああ、面白いと思うぞ、その\n障害物競走。"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "（ま、俺が参加しなければいいだけの\n　話だしな！）"},
{"id": 38, "kind": "msg", "spk": "美香子", "ja": "そうなの～？\nん～、ありきたりだったかしら～？"},
{"id": 39, "kind": "msg", "spk": "美香子", "ja": "なんか、飽きちゃったわ。\n別の催し物を考えようかしら～。"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "ほ……"},
{"id": 41, "kind": "msg", "spk": "美香子", "ja": "もっと凄惨で逃げようのない\n催し物のほうが、楽しいわよね～。"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "（考えが悪い方に進んだ！？）"},
{"id": 43, "kind": "msg", "spk": "美香子", "ja": "会長、がんばるわ～。"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "（がんばらないでくれー！！）"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "（このままでは、酷い目に\n　遭わされてしまう……）"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "（よし、別の案を出してみよう！）"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "じゃあ、こういうのはどうだ？\nパン食い競争とか。"},
{"id": 48, "kind": "msg", "spk": "美香子", "ja": "あら～、パン食い競争も楽しそうね～？"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "だろ！？"},
{"id": 50, "kind": "msg", "spk": "美香子", "ja": "ええ、楽しそうよ～。"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "安全だしな！"},
{"id": 52, "kind": "msg", "spk": "美香子", "ja": "そうね～。\nパンの６個のうち１個は毒入りね～。"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "ロシアンルーレットかよ！？"},
{"id": 54, "kind": "msg", "spk": "美香子", "ja": "６個、完食しないと\nゴールは認めないわ～。"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "絶対に毒を食べるじゃねえか！！"},
{"id": 56, "kind": "msg", "spk": "美香子", "ja": "じゃあ、１２個に増やすわ～。"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "そもそも、食えねえよ！\nつーか、競争でもなんでもないだろ！？"},
{"id": 58, "kind": "msg", "spk": "美香子", "ja": "桜井くんなら、きっと喜んで\n参加してくれるわ～。"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "（絶対に参加しないっての！！）"},
{"id": 60, "kind": "msg", "spk": "美香子", "ja": "優勝者には、美少女たちとの混浴温泉が\n待ってるなんて、どうかしら～？"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "む。……それは名案だな！\n桜井なら、きっと喜んで\n参加するに違いない。"},
{"id": 62, "kind": "msg", "spk": "美香子", "ja": "でも、実は全部に毒をいれておくわ～。\n確実にいい悲鳴が聞けるように～。"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "（やっぱり、どうやっても、\n　酷い目にあわされるのか……）"}
]}
