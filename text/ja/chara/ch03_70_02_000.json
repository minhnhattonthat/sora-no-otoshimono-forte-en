{"file": "_Data/Script/Chara/Chapter03/70/02_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "そういや、スイカ割り……じゃなかった\nメロン割りやるって話してたろ？"},
{"id": 1, "kind": "msg", "spk": "イカロス", "ja": "はい……。"},
{"id": 2, "kind": "msg", "spk": "ニンフ", "ja": "そう言えばそんな話もしてたわね。\nところで、用意ってできたの？"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "あぁ、バッチリさ！\n手ごろな棒を探しておいたぞ！"},
{"id": 4, "kind": "msg", "spk": "美香子", "ja": "メロンも、\nもう、届いてるわよ～。"},
{"id": 5, "kind": "msg", "spk": "そはら", "ja": "なに？\nメロンを割るの？"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "おう、スイカを割るのは、\nイカロスにも悪いしな。"},
{"id": 7, "kind": "msg", "spk": "そはら", "ja": "そうだね……イカロスさん\nあんなにスイカを大事にしてるもんね。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "というわけで、さっそくやろうぜ！"},
{"id": 9, "kind": "msg", "spk": "アストレア", "ja": "メロン、美味しそうですね。\nじゅるり。"},
{"id": 10, "kind": "msg", "spk": "美香子", "ja": "アストレアちゃん、\nまだ食べちゃダメよ～？"},
{"id": 11, "kind": "msg", "spk": "守形", "ja": "メロンを置くのは……この辺でいいか。\nシートの上に置けば、形は崩れても\n食べられるだろう。"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "はい！\nそんじゃ、一番、智樹いきます！"},
{"id": 13, "kind": "msg", "spk": "イカロス", "ja": "マスター……がんばってください。"},
{"id": 14, "kind": "msg", "spk": "ニンフ", "ja": "お手並み拝見ね。"},
{"id": 15, "kind": "msg", "spk": "美香子", "ja": "楽しみだわ～。"},
{"id": 16, "kind": "msg", "spk": "アストレア", "ja": "次、私ね！　私もやりたい！"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "ああ、俺が失敗したらな！\nま、俺が失敗するわけないけどな。"},
{"id": 18, "kind": "msg", "spk": "アストレア", "ja": "むー。"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "さあ、準備完了だぜ！\nメロンはどっちだ！？"},
{"id": 20, "kind": "msg", "spk": "美香子", "ja": "まっすぐよ～。\nひたすら、まっすぐだわ～。"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "おう！"},
{"id": 22, "kind": "msg", "spk": "そはら", "ja": "え？　え？　そっちじゃ……"},
{"id": 23, "kind": "msg", "spk": "アストレア", "ja": "もっと、前、前！"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "おう！"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "（オ、オヤオヤ～？\n　なんか、海に入って\n　るんですけど……？）"},
{"id": 26, "kind": "msg", "spk": "美香子", "ja": "そのまま、まっすぐよ～。"},
{"id": 27, "kind": "msg", "spk": "そはら", "ja": "トモちゃん、そっちは……"},
{"id": 28, "kind": "msg", "spk": "アストレア", "ja": "前、前～！"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "お、おう……ごぼごぼごぼ……"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "そんなわけあるか～～～！！"},
{"id": 31, "kind": "msg", "spk": "美香子", "ja": "目隠しを取ったら、\nダメじゃないの～。"},
{"id": 32, "kind": "msg", "spk": "アストレア", "ja": "ぷすす！　アンタの負けー！"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "おかしいだろ！？\nなんで海に向かって、\nまっすぐなんだよ！？"},
{"id": 34, "kind": "msg", "spk": "美香子", "ja": "沈むまで行くなんて思わなかったわ～。\nメロン割りって楽しいわね～。"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "メロンのほうへ行かせなきゃ\nダメだろ！？"},
{"id": 36, "kind": "msg", "spk": "そはら", "ja": "トモちゃん、ごめんね。\nどう声をかけていいか、わからなくて。"},
{"id": 37, "kind": "msg", "spk": "ニンフ", "ja": "声かけなきゃ\nいけなかったの？"},
{"id": 38, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "ううむ。"},
{"id": 40, "kind": "msg", "spk": "アストレア", "ja": "次は私の番ね！\n目を閉じてればいいんでしょ？"},
{"id": 41, "kind": "msg", "spk": "アストレア", "ja": "これで、よし！"},
{"id": 42, "kind": "msg", "spk": "アストレア", "ja": "ぷすす、アンタより私のほうが、\nすごいってとこを見せてあげるわ！"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "………………"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "（おりゃ、変な顔！）"},
{"id": 45, "kind": "msg", "spk": "アストレア", "ja": "ぷっ、なにやってんのよ！？"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "おまえ、見えてるじゃねえか！"},
{"id": 47, "kind": "msg", "spk": "アストレア", "ja": "ハッ、しまった！"},
{"id": 48, "kind": "msg", "spk": "ニンフ", "ja": "デルタは失格ね。"},
{"id": 49, "kind": "msg", "spk": "イカロス", "ja": "うん…………"},
{"id": 50, "kind": "msg", "spk": "アストレア", "ja": "え、そんな……ニンフ先輩。\nイカロス先輩まで！？"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "おまえも、負けだ！"},
{"id": 52, "kind": "msg", "spk": "アストレア", "ja": "うわ～～～ん！"},
{"id": 53, "kind": "msg", "spk": "守形", "ja": "智樹、メロンがぬるくなった。\n続きは冷やしてからだ。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "あー、そうッスね。"}
]}
