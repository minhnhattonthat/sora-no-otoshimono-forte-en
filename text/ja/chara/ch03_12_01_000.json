{"file": "_Data/Script/Chara/Chapter03/12/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ん？　守形先輩、なにやってんすか？\nじっと水中を見て。"},
{"id": 1, "kind": "msg", "spk": "守形", "ja": "ああ、思ったよりも\n魚がいるようなので、\n捕っておこうかと思ってな。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "え……昼メシは\nバーベキューやるんですよね？"},
{"id": 3, "kind": "msg", "spk": "守形", "ja": "ああ、これは俺の夕飯だ。"},
{"id": 4, "kind": "msg", "spk": "守形", "ja": "明るいうちに夜のぶんを\n捕っておかないとな。"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "相変わらず、サバイバルな\nテント暮らしなんスね。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "でも、魚を釣るにしても、\n釣り竿とか持ってきてましたっけ？"},
{"id": 7, "kind": "msg", "spk": "守形", "ja": "これだけ水が澄んでいれば、\n釣り竿の必要はあるまい。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "たしかに、底が見えるくらい水は\nキレイですけど……\nなんか関係あるんですか？"},
{"id": 9, "kind": "msg", "spk": "守形", "ja": "興味があるなら見ていくか？"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "はい。"},
{"id": 11, "kind": "msg", "spk": "守形", "ja": "………………"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "（先輩、水辺の浅いところに立って、\n　じっとしてる……）"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "先輩、なにしてるんですか？"},
{"id": 14, "kind": "msg", "spk": "守形", "ja": "今から、見せてやろう。\n静かにしていろよ？"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "あ、はい……"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "………………"},
{"id": 17, "kind": "msg", "spk": "守形", "ja": "………………"},
{"id": 18, "kind": "msg", "spk": "守形", "ja": "ハッ！！"},
{"id": 19, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}バシャッ！"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "素手で魚を捕った！？\nすげー！！　熊みたいだ！！"},
{"id": 21, "kind": "msg", "spk": "", "ja": "　\n{1F}{10}びちびちびちびちびちびち！"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "すごいっス、先輩！\nまさか、道具を使わずに\n魚を捕るなんて、初めて見ましたよ！"},
{"id": 23, "kind": "msg", "spk": "守形", "ja": "熊がやっていたので、\n試してみたのだが、\n意外とできるものだな。"},
{"id": 24, "kind": "msg", "spk": "守形", "ja": "熊は腕力があるので、\n水ごと叩くような感じでいいが……"},
{"id": 25, "kind": "msg", "spk": "守形", "ja": "人間だと腕力が足りないので、\n手刀をまっすぐに突き入れ、\n引っこ抜くような感じでな。"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "……普通の人には、\nそれも無理だと思いますけど。"},
{"id": 27, "kind": "msg", "spk": "守形", "ja": "そうか？\nコツをつかめば、やれると思うぞ。\n智樹もやってみるか？"},
{"id": 28, "kind": "choice", "spk": "", "ja": "やってみます！"},
{"id": 29, "kind": "choice", "spk": "", "ja": "むしろ勝負だ！"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "先輩みたいには出来ないとは\n思うっスけど、\n面白そうなんでやってみます！"},
{"id": 31, "kind": "msg", "spk": "守形", "ja": "そうか。\nでは、ゆっくりと静かに水のなかへ\n入ってくるといい。"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "はい……\nそーっと……"},
{"id": 33, "kind": "msg", "spk": "守形", "ja": "水のなかに立ったら、じっと待つ。\n動かなければ、魚は気にしなくなり、\nやがて目の前にやってくる。"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "はい……"},
{"id": 35, "kind": "msg", "spk": "守形", "ja": "手の届く場所に魚がきたら、\n素早く突き入れるんだ。"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "あ、近付いてきましたよ、先輩！"},
{"id": 37, "kind": "msg", "spk": "守形", "ja": "焦らず、騒がず、\nじっくり待って。"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "（うーむ、けっこう大変だぞ、これ）"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "（来た！！）"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "てや！"},
{"id": 41, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}バシャ！"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "ありゃ……\n逃げられました。"},
{"id": 43, "kind": "msg", "spk": "守形", "ja": "そのようだな。\n難しかったか？"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "いや、まだまだ！"},
{"id": 45, "kind": "msg", "spk": "守形", "ja": "いい心意気だ、智樹。\nよし、俺もいっしょに捕るとするか。"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "やっぱり普通の人間には……\n無理だっ！！"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "それに比べて\n先輩は大分捕りましたね……"},
{"id": 48, "kind": "msg", "spk": "守形", "ja": "ああ、夕飯のぶんは確保できた。"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "すげーなー。"},
{"id": 50, "kind": "msg", "spk": "守形", "ja": "慣れれば、なんとかなる。"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "俺には道具なしでは無理ッス。\n結局、捕れなかったし……\n先輩が普通じゃないだけですから！"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "むしろ勝負ですよ、守形先輩！\nどちらが多く捕れるかのね！"},
{"id": 53, "kind": "msg", "spk": "守形", "ja": "ほぅ……\n面白い、いいだろう。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "俺も水のなかに入って……と。"},
{"id": 55, "kind": "msg", "spk": "守形", "ja": "こんな捕り方は初めてだろう。\n何度か練習しておくか？"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "べつに平気ですよ。\nじゃんじゃん捕りましょう！"},
{"id": 57, "kind": "msg", "spk": "守形", "ja": "では、時間を決めて、\nそのあいだに多く捕れたほうの\n勝ちとするか。"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "ウッス！！"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "いくぜ、そりゃ！！"},
{"id": 60, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}バシャ！"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "逃げられた！？"},
{"id": 62, "kind": "msg", "spk": "守形", "ja": "どうした、智樹……？"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "あ、いや……\n今のは、練習っス！"},
{"id": 64, "kind": "msg", "spk": "守形", "ja": "そうか。\n手加減はしないぞ？"},
{"id": 65, "kind": "msg", "spk": "守形", "ja": "ハッ！！"},
{"id": 66, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}バシャ！"},
{"id": 67, "kind": "msg", "spk": "守形", "ja": "そら、一匹目だ。"},
{"id": 68, "kind": "msg", "spk": "智樹", "ja": "すげー。\nマジで素手で魚を捕れてるよ……\nくそ、負けてられねえ！"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "くっそ～、１匹も捕れなかった！！"},
{"id": 70, "kind": "msg", "spk": "守形", "ja": "ふむ……大漁だな。\n夕飯だけでなく、\n保存食にもできそうだ。"},
{"id": 71, "kind": "msg", "spk": "智樹", "ja": "チクショー！！"},
{"id": 72, "kind": "msg", "spk": "智樹", "ja": "なんで、素手なんかで魚が捕れるんだ！\nやっぱり、アンタおかしいよ！"},
{"id": 73, "kind": "msg", "spk": "守形", "ja": "そうか？"},
{"id": 74, "kind": "msg", "spk": "守形", "ja": "さて……血抜きをしておくか。"},
{"id": 75, "kind": "msg", "spk": "智樹", "ja": "血抜き？"},
{"id": 76, "kind": "msg", "spk": "守形", "ja": "魚というのは、捕ってすぐに血を抜いて\nおくと、鮮度が保たれるんだ。"},
{"id": 77, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ザシュ！"},
{"id": 78, "kind": "msg", "spk": "智樹", "ja": "うお……！？\n血！　魚の血が！"},
{"id": 79, "kind": "msg", "spk": "守形", "ja": "初めて見ると、驚くかもしれんな。\n慣れれば、何でもないことだ。"},
{"id": 80, "kind": "msg", "spk": "守形", "ja": "やってみるか、智樹？\nなんなら、勝負でもいいぞ。"},
{"id": 81, "kind": "msg", "spk": "智樹", "ja": "いや、もう勝負はいいっス。"},
{"id": 82, "kind": "msg", "spk": "守形", "ja": "負けっ放しで帰るか……"},
{"id": 83, "kind": "msg", "spk": "智樹", "ja": "うっ！？"},
{"id": 84, "kind": "msg", "spk": "智樹", "ja": "ええい！！　わかりましたよ！\nナイフ、貸してください！"},
{"id": 85, "kind": "msg", "spk": "守形", "ja": "うむ。"},
{"id": 86, "kind": "msg", "spk": "智樹", "ja": "この角度ッスか！？"},
{"id": 87, "kind": "msg", "spk": "守形", "ja": "ああ。"},
{"id": 88, "kind": "msg", "spk": "智樹", "ja": "そりゃ！"},
{"id": 89, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ザシュ！"},
{"id": 90, "kind": "msg", "spk": "守形", "ja": "よくできたな。\n智樹もテント暮らしが\nできそうじゃないか。"},
{"id": 91, "kind": "msg", "spk": "智樹", "ja": "いえ、俺は一般人ですから！"},
{"id": 92, "kind": "msg", "spk": "智樹", "ja": "（守形先輩、いつもと変わらない\n　表情だけど……もしかして、\n　俺、褒められたのか？）"}
]}
