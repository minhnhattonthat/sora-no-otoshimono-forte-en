{"file": "_Data/Script/Chara/Chapter03/71/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "ニンフ", "ja": "んん～、おいしー。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "ん？　なに食べてるんだ、ニンフ？"},
{"id": 2, "kind": "msg", "spk": "ニンフ", "ja": "暑いからアイスキャンディーを\n作ったのよ。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "は？　作った？\nどうやって？"},
{"id": 4, "kind": "msg", "spk": "ニンフ", "ja": "このカードを使ったのよ。"},
{"id": 5, "kind": "msg", "spk": "ニンフ", "ja": "周囲の成分から、\n特定の物質を生成する\nシナプスの機器よ。"},
{"id": 6, "kind": "msg", "spk": "ニンフ", "ja": "これは、アイスキャンディーを\n作ることができるわ。"},
{"id": 7, "kind": "msg", "spk": "ニンフ", "ja": "前に、桜の花びらでおまんじゅうを\n作ったことがあったでしょう？\nあれと似たようなものね。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "おお、スゲーな！"},
{"id": 9, "kind": "msg", "spk": "ニンフ", "ja": "トモキも食べたい？"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "おう！\n男だって甘い物は別腹だぜ！"},
{"id": 11, "kind": "msg", "spk": "ニンフ", "ja": "それじゃ、トモキに貸してあげるわ。\nまだ使うんだから大事につかってよね。"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "いいのか！？\nありがとな、ニンフ！"},
{"id": 13, "kind": "msg", "spk": "ニンフ", "ja": "あ、うん。\nエヘヘ……"}
]}
