{"file": "_Data/Script/Chara/Chapter00/73/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ん？　なにやってんだ、ニンフ？"},
{"id": 1, "kind": "msg", "spk": "ニンフ", "ja": "ひゃっ！？"},
{"id": 2, "kind": "msg", "spk": "ニンフ", "ja": "ト、トモキ、どうしたのよ！？"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "いや、暇だからＴＶでも見ようかと\n思って来たんだけど……"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "今、胸とかもんでなかったか？"},
{"id": 5, "kind": "msg", "spk": "ニンフ", "ja": "そんなことしてるわけないでしょ！？\n運動してたのよ！！"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "ん？　なになに？\nバストアップ体操～？"},
{"id": 7, "kind": "msg", "spk": "ニンフ", "ja": "ちょっ！？\n人が見てる雑誌、勝手に見ないでよ！！"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "そんな努力をしてたのか…"},
{"id": 9, "kind": "choice", "spk": "", "ja": "がんばれよ"},
{"id": 10, "kind": "choice", "spk": "", "ja": "手伝う"},
{"id": 11, "kind": "choice", "spk": "", "ja": "意味あるのか？"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "ま……がんばれよ。"},
{"id": 13, "kind": "msg", "spk": "ニンフ", "ja": "なっ……！？\nなによ、その哀れみを込めた視線は！？"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "いや、そんなもの込めてないって。"},
{"id": 15, "kind": "msg", "spk": "ニンフ", "ja": "くう～～～！\nなんか、くやしー！"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "よ～し、俺が手伝ってやろう！"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "もむのか！？　もむのか～！？"},
{"id": 18, "kind": "msg", "spk": "ニンフ", "ja": "バカなこと言わないで、トモキ！！"},
{"id": 19, "kind": "msg", "spk": "ニンフ", "ja": "誰が触らせるもんですか、\nあっちいけーーー！！"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "わわ、怒るなって、冗談だよ！"},
{"id": 21, "kind": "msg", "spk": "ニンフ", "ja": "私だって、べつに本気じゃないわよ！\nちょっと試してみただけよ！\nもう、ほっといてちょうだい！！"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "ちぇー。"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "意味あるのか？\nそれ人間用の運動だろ？"},
{"id": 24, "kind": "msg", "spk": "ニンフ", "ja": "わ、わかってるわよ！！"},
{"id": 25, "kind": "msg", "spk": "ニンフ", "ja": "でも、少しくらい、なんか……\n効果あるかもしれないでしょ！？"},
{"id": 26, "kind": "msg", "spk": "ニンフ", "ja": "ないとは言い切れないでしょ！？"},
{"id": 27, "kind": "msg", "spk": "ニンフ", "ja": "つまり、知的好奇心ってことよ！！"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "………………"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "ああ、知的好奇心ね。\nそうか、知的好奇心か。"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "俺がおっぱいをもみたいのも、\n知的好奇心だな。"},
{"id": 31, "kind": "msg", "spk": "ニンフ", "ja": "トモキのは、エッチなだけよ！"}
]}
