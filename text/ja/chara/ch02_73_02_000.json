{"file": "_Data/Script/Chara/Chapter02/73/02_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "そういや、守形先輩に預かった小袋、\nなにが入ってんだ？"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "勝手に見たらマズイよな。\nイカロスに届けて、見せてもらうか。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "イカロスは……川原かな？\nどうせスイカに水をかけてるだろうし。"},
{"id": 3, "kind": "msg", "spk": "イカロス", "ja": "……"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "おーい、イカロスー。"},
{"id": 5, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "よっ。\nなにやってたんだ？"},
{"id": 7, "kind": "msg", "spk": "イカロス", "ja": "……スイカに……水を。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "はは、やっぱりな。"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "ほら、これ。\n守形先輩が渡してくれってさ。\nなにか頼んでたんだろ？"},
{"id": 10, "kind": "msg", "spk": "イカロス", "ja": "はい……。\nありがとうございます。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "おう。\nそれ何なんだ？"},
{"id": 12, "kind": "msg", "spk": "イカロス", "ja": "これは……種です。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "種？"},
{"id": 14, "kind": "msg", "spk": "イカロス", "ja": "『ジャンボスイカ』の種……です。"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "あー、なるほどな！"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "イカロスは、ホントに\nスイカが好きだよな。"},
{"id": 17, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "『ジャンボスイカ』か。\nどれくらい大きいんだろ？"},
{"id": 19, "kind": "msg", "spk": "イカロス", "ja": "……普通のスイカの２倍以上\nらしいです……"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "そりゃすげえな！"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "２倍ともなると\n食べごたえがありそうだなー！"},
{"id": 22, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "あ、いや！　食わないって！"},
{"id": 24, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "まあ、そんだけ大きかったら、\nなでごたえもあるだろうし……"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "大きく育つといいな！"},
{"id": 27, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"}
]}
