{"file": "_Data/Script/Chara/Chapter01/51/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ふんふんふ～ん♪"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "（次は、何して遊ぶかなー？）"},
{"id": 2, "kind": "msg", "spk": "守形", "ja": "おや？　ごきげんのようだな。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "ハッ！？\nオ、オホン！\nなにか用かね、守形くん。"},
{"id": 4, "kind": "msg", "spk": "守形", "ja": "ふむ。しっかりと先生に見えるな。"},
{"id": 5, "kind": "msg", "spk": "守形", "ja": "そのジャミングは、\nカードの効果なのか、智樹？"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "うぎゃー！？"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "（めちゃめちゃバレてる！？）"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "な、な、なにを言っておるのかな？"},
{"id": 9, "kind": "msg", "spk": "守形", "ja": "その様子だと、ずいぶんと\nいろいろやっているようだが……"},
{"id": 10, "kind": "msg", "spk": "守形", "ja": "いいのか？\n俺の推測が確かならば、\nそれは認識を……"},
{"id": 11, "kind": "msg", "spk": "イカロス", "ja": "マスターが……困っています。"},
{"id": 12, "kind": "msg", "spk": "守形", "ja": "イカロス……！？"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "おお、イカロスか！\nいいところに！"},
{"id": 14, "kind": "msg", "spk": "守形", "ja": "ふむ。\nイカロス、この智樹にかかっている\nジャミングのことだが……"},
{"id": 15, "kind": "msg", "spk": "イカロス", "ja": "先生です。"},
{"id": 16, "kind": "msg", "spk": "守形", "ja": "ん？"},
{"id": 17, "kind": "msg", "spk": "イカロス", "ja": "今のマスターは、先生です。"},
{"id": 18, "kind": "msg", "spk": "守形", "ja": "なるほど。\nそういうことか。"},
{"id": 19, "kind": "msg", "spk": "守形", "ja": "だとすると、効果時間は……\nふむふむ。"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "（やばい！\n　守形先輩には正体がバレバレだ！）"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "（俺のやってきたことが、\n　ぜんぶバラされたら……）"},
{"id": 22, "kind": "choice", "spk": "", "ja": "イカロスを連れて逃げる"},
{"id": 23, "kind": "choice", "spk": "", "ja": "守形先輩の気を逸らす"},
{"id": 24, "kind": "choice", "spk": "", "ja": "１人で逃げる"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "イカロス、こっちに来い！"},
{"id": 26, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 27, "kind": "msg", "spk": "守形", "ja": "どこに行くつもりだ、智樹？"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "違う！　私は、先生だ！\n智樹などではなーい！"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "（うおおぉぉ～～～！！\n　逃げる！　逃げまくる！）"},
{"id": 30, "kind": "msg", "spk": "イカロス", "ja": "マスター……どちらへ？"},
{"id": 31, "kind": "msg", "spk": "守形", "ja": "そうだぞ、智樹。\nどこへ行くつもりだ？"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "ぎゃあああ～～～！！"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "こっちだ！"},
{"id": 34, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 35, "kind": "msg", "spk": "守形", "ja": "そのジャミングについての質問だが……"},
{"id": 36, "kind": "msg", "spk": "イカロス", "ja": "はい……守形先輩。\nなんでしょうか？"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "答えなくていい！"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "イカロス、空だ！"},
{"id": 39, "kind": "msg", "spk": "守形", "ja": "ふむ……\nこっちへ来たと思ったが……\n見失ったか。"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "ぜえぜえ、たすかった……"},
{"id": 41, "kind": "msg", "spk": "イカロス", "ja": "マスター……守形先輩のお話を\n聞かなくてよかったのでしょうか？"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "まだまだ、先生ジャミングで\n楽しむんだ！"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "守形先輩にだって、\n今の俺は止められないぜー！！"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "（先輩の気を逸らそう！\n　えーっと……どんなことをすれば……\n　そうだ、あの話題を振れば！）"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "新大陸の話をしよう！"},
{"id": 46, "kind": "msg", "spk": "守形", "ja": "むっ、新大陸だと！？"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "新大陸っていうのは、\n誰も見たことないから\n新大陸なんですよね！？"},
{"id": 48, "kind": "msg", "spk": "守形", "ja": "うむ、その通りだ、智樹！"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "（よし、今のうちだ。\n　イカロス、戻れ！）"},
{"id": 50, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "（イカロス、戻るんだ！）"},
{"id": 52, "kind": "msg", "spk": "守形", "ja": "そもそも、新大陸とは！"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "は、はい。"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "（くっ……\n　イカロスには、はっきり言わないと\n　伝わらないか！？）"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "（しかし、イカロスに話しかけたら、\n　守形先輩の気を逸らした\n　意味がない！）"},
{"id": 56, "kind": "msg", "spk": "イカロス", "ja": "………………"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "（イカロス、\n　今は戻ってくれ～～～！）"},
{"id": 58, "kind": "msg", "spk": "智樹", "ja": "あばよ！！"},
{"id": 59, "kind": "msg", "spk": "イカロス", "ja": "あ……マスターが……"},
{"id": 60, "kind": "msg", "spk": "守形", "ja": "智樹！？　どこへ行く！！"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "俺は先生だ！\n智樹じゃない！\n先生なんだーーー！！"},
{"id": 62, "kind": "msg", "spk": "守形", "ja": "待て、智樹、\nこのままだと……"},
{"id": 63, "kind": "msg", "spk": "守形", "ja": "……ふむ、行ってしまったか。"},
{"id": 64, "kind": "msg", "spk": "イカロス", "ja": "……マスター、大丈夫でしょうか？"},
{"id": 65, "kind": "msg", "spk": "守形", "ja": "仕方あるまい。"},
{"id": 66, "kind": "msg", "spk": "守形", "ja": "それより、イカロス。\nあのジャミングの効果について\n聞きたいのだが？"},
{"id": 67, "kind": "msg", "spk": "イカロス", "ja": "はい……守形先輩。\nなんでしょうか？"}
]}
