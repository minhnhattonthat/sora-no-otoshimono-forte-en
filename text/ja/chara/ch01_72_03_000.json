{"file": "_Data/Script/Chara/Chapter01/72/03_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "イカロス", "ja": "マスター……お待ちしておりました。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "いや、なんとなく、\nまた話したくなってさ。"},
{"id": 2, "kind": "msg", "spk": "イカロス", "ja": "嬉しいです……"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "俺が寝てるときのイカロスと\nニンフの話を聞いたんだよな。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "アストレアが何やってるかは、\n知ってるか？"},
{"id": 5, "kind": "msg", "spk": "イカロス", "ja": "……はい。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "あいつもエンジェロイドだから、\n眠らないんだよな。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "アストレアは、夜、何やってんだ？"},
{"id": 8, "kind": "msg", "spk": "イカロス", "ja": "ときどき、夜食を食べに来ます。"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "そうだったのか！？"},
{"id": 10, "kind": "msg", "spk": "イカロス", "ja": "はい……マスターが\n来たら食べさせてやれ、と\n言っていたので……"},
{"id": 11, "kind": "msg", "spk": "イカロス", "ja": "私が用意していますが、\nいけなかったでしょうか？"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "いや、いいんじゃないか？"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "（最近、スパゲッティだの\n　オムライスだのの夢を見ると\n　思ったら……）"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "（イカロスが作ったもののニオイが\n　ただよってきてたのか？）"},
{"id": 15, "kind": "msg", "spk": "イカロス", "ja": "そして、アストレアが\n寝ているマスターに\nイタズラしようとするので……"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "なに！？"},
{"id": 17, "kind": "msg", "spk": "イカロス", "ja": "私が止めています。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "そ、そうか。助かる。"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "アストレアのやつめ……"},
{"id": 20, "kind": "choice", "spk": "", "ja": "やり返す！"},
{"id": 21, "kind": "choice", "spk": "", "ja": "仕方ないやつだ"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "よし、今夜から罠を仕掛けるぞ！"},
{"id": 23, "kind": "msg", "spk": "イカロス", "ja": "罠ですか？"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "くっくっくっ……\nトリモチを置いておくとかな！"},
{"id": 25, "kind": "msg", "spk": "イカロス", "ja": "はい……\nトリモチですね、マスター。"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "おう！"},
{"id": 27, "kind": "msg", "spk": "イカロス", "ja": "……マスターが寝たら、\n周囲にトリモチを置いておきます。"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "おう！"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "……ん？\n俺、起きたとき、どうすんだ？"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "やれやれ、仕方ないやつだな。"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "ま、今度は俺が起きてるときに\n遊びに来いって言っておいて\nくれよな。"},
{"id": 32, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "あと、これからも夜食、\n作ってやってくれ。"},
{"id": 34, "kind": "msg", "spk": "イカロス", "ja": "はい……わかりました。"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "さて、そろそろ行くか。"},
{"id": 36, "kind": "msg", "spk": "イカロス", "ja": "あの、マスター。"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "ん？"},
{"id": 38, "kind": "msg", "spk": "イカロス", "ja": "ありがとうございます。"}
]}
