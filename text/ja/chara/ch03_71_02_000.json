{"file": "_Data/Script/Chara/Chapter03/71/02_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "アストレア", "ja": "あ～、暑ぅ～。\nなんか冷たい物、ほしい～"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "ダレてんな、アストレア……"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "そういや、ニンフから\nアイスキャンディーを作る\n機器を借りたんだよな。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "アストレア、\nアイス食べるか？"},
{"id": 4, "kind": "msg", "spk": "アストレア", "ja": "ほ、ほしいー！"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "んじゃ、使ってみるか。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "おおっ、こんな簡単にできるのか。\nすげぇな、この機器。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "ほれ。"},
{"id": 8, "kind": "msg", "spk": "アストレア", "ja": "いただきまーーーす！\nぱっくん。"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "あ……おまえ、\nそんないっぺんに食べたら……"},
{"id": 10, "kind": "msg", "spk": "アストレア", "ja": "うっ……！？"},
{"id": 11, "kind": "msg", "spk": "アストレア", "ja": "痛～～～～～頭、キーンって！？"},
{"id": 12, "kind": "msg", "spk": "アストレア", "ja": "頭、割れる～～～！？"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "冷たい物、いっきに\n食べるからだぞ……？"},
{"id": 14, "kind": "msg", "spk": "アストレア", "ja": "だ、だって……\nおいしそうだったし……"},
{"id": 15, "kind": "msg", "spk": "アストレア", "ja": "ううぅぅ～～～。"},
{"id": 16, "kind": "msg", "spk": "アストレア", "ja": "でも、美味しかった。"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "じゃあ、もっと食べるか？"},
{"id": 18, "kind": "msg", "spk": "アストレア", "ja": "うん！"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "ほら。"},
{"id": 20, "kind": "msg", "spk": "アストレア", "ja": "いただきまーす！\nぱく。"},
{"id": 21, "kind": "msg", "spk": "アストレア", "ja": "頭、痛ぁぁぁ～～～！！"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "いっぺんに食べたら\n痛くなるって覚えろよ！"}
]}
