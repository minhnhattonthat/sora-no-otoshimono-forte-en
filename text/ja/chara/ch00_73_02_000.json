{"file": "_Data/Script/Chara/Chapter00/73/02_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ん？　イカロスが雑誌を見てる……？"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "それは、前にニンフが見てた\nバストアップ体操の本！？"},
{"id": 2, "kind": "msg", "spk": "イカロス", "ja": "あ……マスター、何かご用でしょうか？"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "イカロス、そのサイズでも、\nバストアップ体操に興味あるのか！？\nどんだけ大きくする気だよ！？"},
{"id": 4, "kind": "msg", "spk": "イカロス", "ja": "ニンフが置きっぱなしにしたので、\n見ていたのですが……"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "（ニンフのやつ、もう飽きたのか……）"},
{"id": 6, "kind": "msg", "spk": "イカロス", "ja": "胸が大きいと、何か良いことが\nあるのでしょうか？"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "え？　そ、それは……"},
{"id": 8, "kind": "choice", "spk": "", "ja": "大きいほうがイイだろ！"},
{"id": 9, "kind": "choice", "spk": "", "ja": "気にしない"},
{"id": 10, "kind": "choice", "spk": "", "ja": "小さいほうがいいな"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "大きいほうがイイだろ！"},
{"id": 12, "kind": "msg", "spk": "イカロス", "ja": "……そうなのですか？"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "昔から、大は小を兼ねるとも言うし、\n大きいことは素晴らしいことなんだぞ！"},
{"id": 14, "kind": "msg", "spk": "イカロス", "ja": "大きいほうが……素晴らしい。"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "いや、なんでもない。忘れてくれ。"},
{"id": 16, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "気にしないぞ、俺は。"},
{"id": 18, "kind": "msg", "spk": "イカロス", "ja": "そうなのですか？\nでは、なぜこのような雑誌が\nあるのでしょうか？"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "世の中には、気にする人もいるんだ。"},
{"id": 20, "kind": "msg", "spk": "イカロス", "ja": "なるほど……\n世の中には、色々な人がいます。"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "はは……まったくだな。"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "俺は、小さいほうがいいなー。"},
{"id": 23, "kind": "msg", "spk": "イカロス", "ja": "そうなのですか……"},
{"id": 24, "kind": "msg", "spk": "イカロス", "ja": "あの……マスター……\n私の胸は大きすぎるでしょうか？"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "えっ！？\nああ、いや……\nなんと言ったらいいか……"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "イカロスはイカロスなんだから、\n気にすることないぞ？"},
{"id": 27, "kind": "msg", "spk": "イカロス", "ja": "はい……\nありがとうございます、マスター。"}
]}
