{"file": "_Data/Script/Chara/Chapter00/50/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "ん？　イカロス、なにやってんだ？"},
{"id": 1, "kind": "msg", "spk": "イカロス", "ja": "服を……作っています。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "服って……その倉庫みたいなのがか？\nでっかくて、四角くて、扉があって……"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "俺には、鉄板で出来た物置か倉庫にしか\n見えないんだが。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "むしろ、その巨大な箱が動くなら、\n戦車みたいだよな！"},
{"id": 5, "kind": "msg", "spk": "イカロス", "ja": "……アストレアが服がなくて困ってる\nという話を聞きましたので、\n作ってみました。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "それ、アストレアのための\n服だったのか。"},
{"id": 7, "kind": "msg", "spk": "イカロス", "ja": "はい……服の……代わりです。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "なるほど、クルマや家は飛んで\nいかないもんな。"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "デカイ倉庫みたいな物なら、\n服の仲間にならないってことか！"},
{"id": 10, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "いいアイディアじゃないか！\n町のみんなに教えてやったら\n喜ぶんじゃないか？"},
{"id": 12, "kind": "msg", "spk": "イカロス", "ja": "いえ……アストレアでないと……"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "ん？"},
{"id": 14, "kind": "msg", "spk": "イカロス", "ja": "……重たいですから。"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "おお、そうか！\nこんな倉庫みたいなもの担いで\n歩けるのは、アストレアくらいか！！"},
{"id": 16, "kind": "msg", "spk": "イカロス", "ja": "はい……。"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "それで、もう完成したのか？"},
{"id": 18, "kind": "msg", "spk": "イカロス", "ja": "完成しました……。"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "じゃあ、アストレアに\n届けてやろうぜ。"},
{"id": 20, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 21, "kind": "msg", "spk": "智樹", "ja": "会長が、アストレアの声を聞いたって\n言ってたのは、この辺だよな？"},
{"id": 22, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 23, "kind": "msg", "spk": "イカロス", "ja": "レーダーに反応……あります。\nそこです。"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "ん？"},
{"id": 25, "kind": "msg", "spk": "アストレア", "ja": "しくしくしくしくしく……"},
{"id": 26, "kind": "msg", "spk": "アストレア", "ja": "ごはん、食べたいです～。\n裸じゃ貰いに行けないです～。"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "お、おい、アストレア！"},
{"id": 28, "kind": "msg", "spk": "イカロス", "ja": "……アストレア。"},
{"id": 29, "kind": "msg", "spk": "アストレア", "ja": "ハッ！？　その声はイカロス先輩達！\nもしかして……\n助けにきてくれたんですか！？"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "イカロスが、おまえのために、\n服を作ってくれたぞ。"},
{"id": 31, "kind": "msg", "spk": "イカロス", "ja": "……すこし重たいけど、\nアストレアなら潰れないと思う。"},
{"id": 32, "kind": "msg", "spk": "アストレア", "ja": "ほ、ほ、ほんとですかぁ！？"},
{"id": 33, "kind": "msg", "spk": "イカロス", "ja": "うん……今……渡すから。"},
{"id": 34, "kind": "msg", "spk": "アストレア", "ja": "ありがとうございます！！"},
{"id": 35, "kind": "msg", "spk": "イカロス", "ja": "はい。"},
{"id": 36, "kind": "msg", "spk": "アストレア", "ja": "四角くて大きな……箱！？\n大きな箱が……降ってくる！？"},
{"id": 37, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ぐしゃあ！"},
{"id": 38, "kind": "msg", "spk": "アストレア", "ja": "うぎゃ！！"},
{"id": 39, "kind": "msg", "spk": "イカロス", "ja": "これで大丈夫、アストレア。\n……服とちがって、飛んでいかない……"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "いま、潰れなかったか、アストレア？"},
{"id": 41, "kind": "msg", "spk": "アストレア", "ja": "も、もちろん……\n大丈夫……"},
{"id": 42, "kind": "msg", "spk": "アストレア", "ja": "くぬぬぬ！　これで私も、\n服を着て、歩くことができる！！"},
{"id": 43, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ズズ……"},
{"id": 44, "kind": "msg", "spk": "", "ja": "　\n{1F}{15}ズズズズズズ……"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "おいおい、引きずってる！\n箱を引きずってるぞ！？"},
{"id": 46, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ズルリ！"},
{"id": 47, "kind": "msg", "spk": "アストレア", "ja": "きゃあ！？"},
{"id": 48, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}ぐしゃぁぁぁ！"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "おいおい……転んじまったみたいだぞ？"},
{"id": 50, "kind": "msg", "spk": "イカロス", "ja": "はい……\n転んでも、壊れることなく……\n中も見えません。"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "あ、うん。たしかに壊れてもいないし、\nアストレアがどうなってるかも\n見えないけどな……"},
{"id": 52, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "（うーむ……地味に得意げだ。\n　自信作なのか、アレは）"},
{"id": 54, "kind": "msg", "spk": "アストレア", "ja": "うーうー、お、起き上がれな……い。"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "アストレアのやつ、\n困ってるみたいだな……"},
{"id": 56, "kind": "choice", "spk": "", "ja": "イカロス助けてやれ"},
{"id": 57, "kind": "choice", "spk": "", "ja": "今、助けてやるぞ～！"},
{"id": 58, "kind": "choice", "spk": "", "ja": "いい服だな"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "イカロス、助けてやれ。"},
{"id": 60, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター、どのように\nすればいいでしょうか？"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "とりあえず、あの牢屋みたいに\nなってる服から出してやれ。"},
{"id": 62, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 63, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}ギギギギギ……"},
{"id": 64, "kind": "msg", "spk": "", "ja": "　\n{1F}{17}がしゃーん！"},
{"id": 65, "kind": "msg", "spk": "アストレア", "ja": "た、たすかりました、\nイカロス先輩！"},
{"id": 66, "kind": "msg", "spk": "イカロス", "ja": "よかった……。"},
{"id": 67, "kind": "msg", "spk": "智樹", "ja": "やっぱり、あんな倉庫を服だなんて\nいうのは無理があったな。"},
{"id": 68, "kind": "msg", "spk": "智樹", "ja": "（これは、チャンスなのでは、\n　ありませんか～？）"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "（目の前には、でっかい服。\n　アストレアは、転んで……）"},
{"id": 70, "kind": "msg", "spk": "智樹", "ja": "（服は動かなくなってるけど、\n　あの中には……）"},
{"id": 71, "kind": "msg", "spk": "智樹", "ja": "ぜ、ぜ、全裸のアストレアが！！"},
{"id": 72, "kind": "msg", "spk": "アストレア", "ja": "ひぇ！？"},
{"id": 73, "kind": "msg", "spk": "智樹", "ja": "アストレア、今、いくぞ！！\n助けにいくんだからな、\n勘違いするなよ！？"},
{"id": 74, "kind": "msg", "spk": "智樹", "ja": "こ、この服、どうやって\n中に入るんだ！？"},
{"id": 75, "kind": "msg", "spk": "アストレア", "ja": "きゃ～～～！？\nい、いらないって！\n手助けなんて、いらないから！"},
{"id": 76, "kind": "msg", "spk": "智樹", "ja": "遠慮するな、アストレア～。\n困ってるんだろ？"},
{"id": 77, "kind": "msg", "spk": "智樹", "ja": "ただ、ちょっと手助けするには、\nこの服に入らないといけないって\nだけじゃないか～。"},
{"id": 78, "kind": "msg", "spk": "アストレア", "ja": "よ、よけいなお世話よ！\n入ってきたら、見えちゃうでしょ！？"},
{"id": 79, "kind": "msg", "spk": "智樹", "ja": "そんなこと気にするなよ。\n困ったときは、お互い様だろう～？"},
{"id": 80, "kind": "msg", "spk": "アストレア", "ja": "うぅうあぁぁう～！"},
{"id": 81, "kind": "msg", "spk": "", "ja": "　\n{1F}{14}ギギギ……バタン！"},
{"id": 82, "kind": "msg", "spk": "智樹", "ja": "鉄の服が堅く閉ざされた！？\n周りを歪めて閉じこもりやがった。"},
{"id": 83, "kind": "msg", "spk": "アストレア", "ja": "アンタの手助けなんて必要無いわ！\nもう、あっち行ってよっ！！"},
{"id": 84, "kind": "msg", "spk": "智樹", "ja": "うぐぐぐ……\nせっかく裸が拝めると思ったのに。"},
{"id": 85, "kind": "msg", "spk": "智樹", "ja": "イカロス、いい服だな。"},
{"id": 86, "kind": "msg", "spk": "イカロス", "ja": "……いいのですか？"},
{"id": 87, "kind": "msg", "spk": "智樹", "ja": "あれでアストレアも風雨を\nしのげそうじゃないか。"},
{"id": 88, "kind": "msg", "spk": "イカロス", "ja": "はい……マスター。"},
{"id": 89, "kind": "msg", "spk": "智樹", "ja": "帰るか。"},
{"id": 90, "kind": "msg", "spk": "イカロス", "ja": "はい……"},
{"id": 91, "kind": "msg", "spk": "アストレア", "ja": "うぎぎぎ～～～！！\n起きれないー！"},
{"id": 92, "kind": "msg", "spk": "アストレア", "ja": "ちょっと、こんな状態で\n置いてかないでよ！\n待ってってばーっ！！"}
]}
