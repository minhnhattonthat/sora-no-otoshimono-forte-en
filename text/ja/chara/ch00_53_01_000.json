{"file": "_Data/Script/Chara/Chapter00/53/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "美香子", "ja": "あら、いいところで会ったわ～。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "か、会長……。\nあっ！急用を思い出した！\n家に帰らなきゃならないんだった！"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "じゃあ、俺は、そういうことで……"},
{"id": 3, "kind": "msg", "spk": "美香子", "ja": "あら～、桜井くん、\nどういう意味かしら～？"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "（会長に関わると、\n　ろくな目に遭わないんですよ！！）"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "あ、これは会長、こんにちは。"},
{"id": 6, "kind": "msg", "spk": "美香子", "ja": "会長、今、暇してるの～。\nよかったら家に寄っていって～。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "え……！？\nはぁ……そうですね。"},
{"id": 8, "kind": "msg", "spk": "美香子", "ja": "服もしっかり調教……しつけが\nできたから、ちゃんとおもてなしが\nできると思うわ～。"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "（やっぱり、調教って言った！？）"},
{"id": 10, "kind": "msg", "spk": "美香子", "ja": "お茶くらい、いいでしょう？\n茶菓子も出すわ～。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "あ、はい……\nまぁ、茶菓子くらいなら。"},
{"id": 12, "kind": "msg", "spk": "美香子", "ja": "いらっしゃ～い。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "お邪魔します。"},
{"id": 14, "kind": "name", "spk": "男子生徒Ｈ", "ja": "黒服"},
{"id": 15, "kind": "msg", "spk": "黒服", "ja": "お帰りなさいませ、お嬢。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "（うっ……あいかわらず、\n　屈強な男たちが全裸か……）"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "（服が飛んでいっちゃったから\n　仕方ないけど……\n　やっぱり、キツイな～）"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "（全裸！？）"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "（いや、そりゃそうだよなー、\n　服、飛んでいっちゃったもんなー）"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "（しかし、筋肉ムキムキの男たちが\n　全裸かよ！　キツイな～）"},
{"id": 21, "kind": "msg", "spk": "美香子", "ja": "桜井くんが、遊びにきてくれたわ～。"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "ど、ど、どもッス。"},
{"id": 23, "kind": "name", "spk": "男子生徒Ｈ", "ja": "黒服"},
{"id": 24, "kind": "msg", "spk": "黒服", "ja": "いらっしゃいませ、お客人。"},
{"id": 25, "kind": "msg", "spk": "", "ja": "（※見苦しいので全裸の黒服は\n　画面に表示できません）"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "うえっぷ。"},
{"id": 27, "kind": "msg", "spk": "美香子", "ja": "そんな硬くならなくても\n大丈夫よ～。"},
{"id": 28, "kind": "msg", "spk": "美香子", "ja": "こちらの客間でリラックスして\n待ってて～。\nすぐお茶を持ってくるわ～。"},
{"id": 29, "kind": "msg", "spk": "智樹", "ja": "あ、はい……"},
{"id": 30, "kind": "msg", "spk": "美香子", "ja": "あ、忘れてたわ～。"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "はっ！？"},
{"id": 32, "kind": "msg", "spk": "美香子", "ja": "お茶菓子、羊羹とあんみつ、\nどちらが好きかしら～？"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "そんなのあるんスか……"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "（店がのきなみ閉まってるのに、\n　どうやって買ったんだ……？）"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "じゃあ、あんみつで。"},
{"id": 36, "kind": "msg", "spk": "美香子", "ja": "は～い。"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "（セレブな豪邸で、美人の会長と\n　２人きりのお茶か……）"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "（しかも、今は貴重な\n　あんみつだなんて……\n　すっげえ幸せな気分！！）"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "（……のはずなんだけど、\n　庭を見るとなぁ）"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "（全裸のいかつい男たちが、\n　武器を持ってうろついてる姿は、\n　寒気がするぜ……）"},
{"id": 41, "kind": "msg", "spk": "美香子", "ja": "お待たせ～。"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "あ、ありがとうございます！"},
{"id": 43, "kind": "msg", "spk": "美香子", "ja": "ん……\nお茶が美味しいわ～。"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "はぐはぐ……\nあんみつ、美味いです！"},
{"id": 45, "kind": "msg", "spk": "美香子", "ja": "よかった～。"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "いやー、これ買っておいたんですか？\n店なんかやってないのに。"},
{"id": 47, "kind": "msg", "spk": "美香子", "ja": "隣町まで行けば、\n買い物はできるのよ～。"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "あ、そうか。"},
{"id": 49, "kind": "msg", "spk": "美香子", "ja": "他に聞きたいことは、あるかしら～？"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "そうですね……"},
{"id": 51, "kind": "choice", "spk": "", "ja": "脱いだほうがいいですかね？"},
{"id": 52, "kind": "choice", "spk": "", "ja": "帰ります"},
{"id": 53, "kind": "choice", "spk": "", "ja": "気にならないんですかね？"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "俺も……\n脱いだほうが、いいですかね！？"},
{"id": 55, "kind": "msg", "spk": "美香子", "ja": "なにを、言って……いるのかしら～？"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "だって、みんな全裸じゃないですか！"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "俺も脱いだほうが、\n平等じゃないですか！？"},
{"id": 58, "kind": "msg", "spk": "美香子", "ja": "そうね～、\nそれもいいんじゃないかしら～？"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "そしたら、会長も脱ぐべきじゃ\nないですかね！？"},
{"id": 60, "kind": "msg", "spk": "美香子", "ja": "あら～、そういうこと？"},
{"id": 61, "kind": "msg", "spk": "智樹", "ja": "はい！！"},
{"id": 62, "kind": "msg", "spk": "美香子", "ja": "そうね……\n桜井くんの言うとおり、\nみんな平等ということで～。"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "おお！！"},
{"id": 64, "kind": "msg", "spk": "美香子", "ja": "桜井くんも、黒服の人たちと\n一緒にしてあげるわ～。"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "オ、オヤオヤ～？"},
{"id": 66, "kind": "msg", "spk": "美香子", "ja": "みんな～、桜井くんも\n仲間にいれてあげてね～。"},
{"id": 67, "kind": "name", "spk": "男子生徒Ｈ", "ja": "黒服"},
{"id": 68, "kind": "msg", "spk": "黒服", "ja": "はい、お嬢！"},
{"id": 69, "kind": "msg", "spk": "智樹", "ja": "か、会長は！？"},
{"id": 70, "kind": "msg", "spk": "美香子", "ja": "もちろん、\n会長は脱がないわ～。"},
{"id": 71, "kind": "name", "spk": "男子生徒Ｈ", "ja": "黒服"},
{"id": 72, "kind": "msg", "spk": "黒服", "ja": "お客人、さあ、\nこっちに来てくんなせえ！"},
{"id": 73, "kind": "msg", "spk": "智樹", "ja": "ぎゃあああぁぁぁ～～～！？"},
{"id": 74, "kind": "msg", "spk": "智樹", "ja": "いや、とくに質問はないんで、\n帰りますよ。"},
{"id": 75, "kind": "msg", "spk": "美香子", "ja": "あら～、まだ早いわよ～。"},
{"id": 76, "kind": "msg", "spk": "美香子", "ja": "それとも、あんみつを食べ終わったら、\nもう会長とは、お話もできないの～？"},
{"id": 77, "kind": "msg", "spk": "智樹", "ja": "（うっ……しまった！）"},
{"id": 78, "kind": "msg", "spk": "智樹", "ja": "いえ、そんなことないですよ。"},
{"id": 79, "kind": "msg", "spk": "美香子", "ja": "会長に、聞きたいことは、\nもうないの？"},
{"id": 80, "kind": "msg", "spk": "智樹", "ja": "はい。会長こそ、俺に聞きたいことは\nありませんか？"},
{"id": 81, "kind": "msg", "spk": "美香子", "ja": "桜井くんに聞きたいこと？"},
{"id": 82, "kind": "msg", "spk": "美香子", "ja": "そうねえ……桜井くんの声は\n聞きたいわね～。"},
{"id": 83, "kind": "msg", "spk": "智樹", "ja": "お、俺の声、好きなんですか？"},
{"id": 84, "kind": "msg", "spk": "美香子", "ja": "桜井くんの悲鳴って、\n気分がスッとするのよね～。"},
{"id": 85, "kind": "msg", "spk": "智樹", "ja": "やっぱ、帰ります。"},
{"id": 86, "kind": "msg", "spk": "美香子", "ja": "あら、ダメよ～。\nいろいろと用意してるんだから～。"},
{"id": 87, "kind": "msg", "spk": "智樹", "ja": "ヒィィィィィ～～～！？"},
{"id": 88, "kind": "msg", "spk": "智樹", "ja": "気にならないんですかね？"},
{"id": 89, "kind": "msg", "spk": "美香子", "ja": "何がかしら～？"},
{"id": 90, "kind": "msg", "spk": "智樹", "ja": "全裸の黒服の人たち。\n会長は気にしてないみたいですけど……"},
{"id": 91, "kind": "msg", "spk": "智樹", "ja": "あちらは、見られて恥ずかしい！\nとか、興奮しちゃう！\nとかないんですかね？"},
{"id": 92, "kind": "msg", "spk": "美香子", "ja": "そういう、ダメな人は、\nおしおきよ～？"},
{"id": 93, "kind": "msg", "spk": "智樹", "ja": "そ、そうなんすか……"},
{"id": 94, "kind": "msg", "spk": "美香子", "ja": "桜井くんだって、海パン１枚だけど、\nべつに変な気分には\nなってないわよね～？"},
{"id": 95, "kind": "msg", "spk": "美香子", "ja": "会長と２人きりで、海パンだけなんて\n格好だけど……\n何とも思ってないでしょう？"},
{"id": 96, "kind": "msg", "spk": "美香子", "ja": "どうなのかしら～？"},
{"id": 97, "kind": "msg", "spk": "智樹", "ja": "あ、いや、それは……"},
{"id": 98, "kind": "msg", "spk": "智樹", "ja": "（や、やばい……なんか、\n　意識してきちまった！？）"},
{"id": 99, "kind": "msg", "spk": "智樹", "ja": "（興奮してきちまってる！！）"},
{"id": 100, "kind": "msg", "spk": "美香子", "ja": "あら～？\n桜井くんにも、おしおきが、\n必要かしら～？"},
{"id": 101, "kind": "msg", "spk": "智樹", "ja": "い、いや、これは……\n違うんですよ！？"},
{"id": 102, "kind": "msg", "spk": "美香子", "ja": "ダメな人は、みんなそう言うわ～。"},
{"id": 103, "kind": "msg", "spk": "智樹", "ja": "ぎゃああああぁぁぁ～～～！？"}
]}
