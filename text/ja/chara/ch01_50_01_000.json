{"file": "_Data/Script/Chara/Chapter01/50/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "（お、そはらが弁当を食べてるぞ）"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "やあ、見月くん、\n美味しそうな弁当だね。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "（ちゃんと先生らしく話さないとな）"},
{"id": 3, "kind": "msg", "spk": "そはら", "ja": "あ、先生、昼休みなのに\n教室へ来るなんて、\nどうかしたんですか？"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "いや、とくに用事はないんだが、\nみんなの様子を見にな。"},
{"id": 5, "kind": "msg", "spk": "そはら", "ja": "そうなんですか。\n珍しいですね。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "うむうむ。"},
{"id": 7, "kind": "msg", "spk": "そはら", "ja": "あの……ホントですか？"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "え？"},
{"id": 9, "kind": "msg", "spk": "そはら", "ja": "いえ、このお弁当、\nホントに美味しそうですか？"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "ああ、そのことか。\nもちろん嘘や冗談じゃないぞ。"},
{"id": 11, "kind": "msg", "spk": "そはら", "ja": "あはは……\nありがとうございます。"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "ん？\nそのきちんとしたお弁当のなかに、\nなにか不明な黒い物体が……なんだ？"},
{"id": 13, "kind": "msg", "spk": "そはら", "ja": "うっ……\nあの、コレだけは、\nちょっと失敗しちゃったというか……"},
{"id": 14, "kind": "msg", "spk": "そはら", "ja": "でも、捨てるのは\nもったいないですから。"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "黒色だから何かと思ったら……\n目玉焼きか！？"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "相変わらず、目玉焼きは苦手なんだな。"},
{"id": 17, "kind": "msg", "spk": "そはら", "ja": "あれ？　どうして先生が、\n私が目玉焼きを作るの苦手なこと\n知ってるんですか？"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "ギクッ！"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "そ、それは、ほら……\n生徒のことだからな！"},
{"id": 20, "kind": "msg", "spk": "そはら", "ja": "………………"},
{"id": 21, "kind": "choice", "spk": "", "ja": "他は自分で作ったのか？"},
{"id": 22, "kind": "choice", "spk": "", "ja": "美味そうだぞ？"},
{"id": 23, "kind": "choice", "spk": "", "ja": "俺が教えてやる！"},
{"id": 24, "kind": "msg", "spk": "智樹", "ja": "目玉焼き以外は、自分で作ったのか？\nよくできてるじゃないか！"},
{"id": 25, "kind": "msg", "spk": "そはら", "ja": "あとは、ぜんぶお母さんです……"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "そ、そうか……"},
{"id": 27, "kind": "msg", "spk": "そはら", "ja": "目玉焼きだけ、私です。"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "う、うん。"},
{"id": 29, "kind": "msg", "spk": "そはら", "ja": "私、ぜんぜん上手く\nならないんですよね。"},
{"id": 30, "kind": "msg", "spk": "そはら", "ja": "いろいろ試してるんですけど……\n何がいけないのかな？"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "（うーん……\n　落ちこませてしまったなぁ）"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "美味そうだぞ？"},
{"id": 33, "kind": "msg", "spk": "そはら", "ja": "目玉焼き以外は、\nお母さんが作ったんです。"},
{"id": 34, "kind": "msg", "spk": "そはら", "ja": "うう……\nなんで上手くできないんだろ？"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "いや、この目玉焼きも\n美味しそうだって。"},
{"id": 36, "kind": "msg", "spk": "そはら", "ja": "でも、先生、目玉焼きだって\nわからなかったんですよね……？"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "あーいや、その、\n桜井が言ってたんだ！"},
{"id": 38, "kind": "msg", "spk": "智樹", "ja": "コゲた目玉焼きも悪くない、\n美味しそうだ、とな！"},
{"id": 39, "kind": "msg", "spk": "そはら", "ja": "トモちゃんが！？\nホントですか！？"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "あ、ああ……\nいいんじゃないか？"},
{"id": 41, "kind": "msg", "spk": "そはら", "ja": "そっか～、トモちゃん、\nこの目玉焼き、嫌いじゃないんだ。\nあはは……"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "（元気づけるつもりで、\n　とんでもないこと\n　言っちまったな）"},
{"id": 43, "kind": "msg", "spk": "智樹", "ja": "よし、目玉焼きの作り方、\n俺が教えてやる！"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "俺、教えるのけっこう得意なんだぞ。\n泳ぎ方だって教えてやったろ？"},
{"id": 45, "kind": "msg", "spk": "そはら", "ja": "え……？　うちのクラスは、\n先生に水泳の授業をしてもらったこと\nないと思うんですけど……"},
{"id": 46, "kind": "msg", "spk": "そはら", "ja": "他のクラスと勘違いしてませんか？"},
{"id": 47, "kind": "msg", "spk": "智樹", "ja": "おっ、おお、そうか。\nそうだったな！"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "（俺は今、先生なんだった！）"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "いや、でも目玉焼きの作り方を\n教えることはできるぞ？"},
{"id": 50, "kind": "msg", "spk": "そはら", "ja": "はい……\nでも自分でがんばりたいので……"},
{"id": 51, "kind": "msg", "spk": "智樹", "ja": "そうか、わかった。\nがんばってな。"},
{"id": 52, "kind": "msg", "spk": "そはら", "ja": "ありがとうございます。"},
{"id": 53, "kind": "msg", "spk": "智樹", "ja": "（先生に見えてるのに、\n　いきなり料理を教えるって\n　言っても無理があったか……）"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "（家庭科の先生に見えてるわけじゃ\n　ないもんなあ）"}
]}
