{"file": "_Data/Script/Chara/Chapter02/52/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "山の中を歩き回ったせいか、\nけっこう足腰にきてんな。"},
{"id": 1, "kind": "msg", "spk": "智樹", "ja": "ちょっと休憩しとくか。\nふぅー。"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "ん？　誰かいるぞ？"},
{"id": 3, "kind": "msg", "spk": "美香子", "ja": "……なのよね～。"},
{"id": 4, "kind": "msg", "spk": "そはら", "ja": "……そうなんですか～。"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "そはらと、会長か。"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "もしかしたら、シールのヒントが\n手に入るかもしれないな。\n近づいてみるか。"},
{"id": 7, "kind": "msg", "spk": "美香子", "ja": "桜井くんがね～。"},
{"id": 8, "kind": "msg", "spk": "そはら", "ja": "そうなんですか？\nへー、トモちゃんが……"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "（おお、俺の話をしてるのか？）"},
{"id": 10, "kind": "msg", "spk": "智樹", "ja": "（でも、もう少し近づかないと\n　ちゃんと聞き取れないな。\n　どうするかなあ？）"},
{"id": 11, "kind": "choice", "spk": "", "ja": "もっと近づく"},
{"id": 12, "kind": "choice", "spk": "", "ja": "いや、これ以上はまずい"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "（当然、前進だ！）"},
{"id": 14, "kind": "msg", "spk": "智樹", "ja": "（こっそり……こっそり……と）"},
{"id": 15, "kind": "msg", "spk": "美香子", "ja": "あら、桜井くんじゃないの～。"},
{"id": 16, "kind": "msg", "spk": "そはら", "ja": "えっ、トモちゃん！？"},
{"id": 17, "kind": "msg", "spk": "智樹", "ja": "バレるの早ーッ！？"},
{"id": 18, "kind": "msg", "spk": "美香子", "ja": "あら～、もしかして、気づかれずに\n近づこうと思ってたのかしら～。"},
{"id": 19, "kind": "msg", "spk": "美香子", "ja": "桜井くんがこそこそし始めたときから、\n気付いてたわよ～？"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "あんたは何者だよ！？"},
{"id": 21, "kind": "msg", "spk": "美香子", "ja": "桜井くん、会長にご用かしら～？\nそれとも見月さんかしら～？"},
{"id": 22, "kind": "msg", "spk": "智樹", "ja": "いや、散歩してただけですよ。"},
{"id": 23, "kind": "msg", "spk": "智樹", "ja": "（盗み聞きしようとしてたのは、\n　たしかだけどな！）"},
{"id": 24, "kind": "msg", "spk": "そはら", "ja": "散歩って、こそこそ草の陰に\n隠れてするものじゃないと思うよ、\nトモちゃん……"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "ぐはっ！？"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "ああ、そうだよ！\n盗み聞きしてましたよ！"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "俺の名前が聞こえたもんでね！"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "そはら、会長と何の話、\nしてたんだ？"},
{"id": 29, "kind": "msg", "spk": "そはら", "ja": "えっ、えっと……"},
{"id": 30, "kind": "msg", "spk": "美香子", "ja": "見月さん、隠さなくても\nいいじゃないの～。"},
{"id": 31, "kind": "msg", "spk": "そはら", "ja": "……トモちゃんが、またエッチなこと\nしてるって、相談してたんだよ。"},
{"id": 32, "kind": "msg", "spk": "智樹", "ja": "うぇい！？"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "（そ、相談されるほどのことか！？）"},
{"id": 34, "kind": "msg", "spk": "そはら", "ja": "……トモちゃんってば、\nずっとエッチなことばかり\nしてるんだから。"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "い、いや！\n今回は違うぞ！？"},
{"id": 36, "kind": "msg", "spk": "そはら", "ja": "今回は？"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "そもそも、全部、か{16}{17}！"},
{"id": 38, "kind": "msg", "spk": "美香子", "ja": "か……？\nあら～、どうしたのかしら、桜井くん？"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "カリフラワー！！"},
{"id": 40, "kind": "msg", "spk": "そはら", "ja": "……え？"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "（ダ、ダメだ。言えないぜ！！）"},
{"id": 42, "kind": "msg", "spk": "智樹", "ja": "と、とにかく信じろよな、そはら！"},
{"id": 43, "kind": "msg", "spk": "そはら", "ja": "うーん、なにか事情があるってこと？"},
{"id": 44, "kind": "msg", "spk": "智樹", "ja": "おう、俺のこと信じて{16}{15}"},
{"id": 45, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ツルッ！"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "ぬぅお！？\n足が滑ったぁー！？"},
{"id": 47, "kind": "msg", "spk": "", "ja": "　\n{1F}{18}ポニョンッ"},
{"id": 48, "kind": "msg", "spk": "そはら", "ja": "きゃあっ！？"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "しまった、とっさに伸ばした手が、\nおっぱいをつかんじまった！！"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "恐るべき、本能！\nやっちまったぜ、反射神経！"},
{"id": 51, "kind": "msg", "spk": "そはら", "ja": "………………トモちゃん。"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "ち、違うんだそはら！\n足が滑って……！"},
{"id": 53, "kind": "msg", "spk": "そはら", "ja": "トモちゃんの、エッチ～～～ッ！"},
{"id": 54, "kind": "msg", "spk": "", "ja": "　\n{1F}{16}ドバキィッ！！"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "ウギャア～～～！！"},
{"id": 56, "kind": "msg", "spk": "美香子", "ja": "桜井くんって……\nホント、会長を楽しませてくれるわ～。"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "（……やばいな！　やめておこう）"},
{"id": 58, "kind": "msg", "spk": "美香子", "ja": "へぇー……胸を……？"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "（胸？）"},
{"id": 60, "kind": "msg", "spk": "そはら", "ja": "……なんです。トモちゃんってば……\n胸を……"},
{"id": 61, "kind": "msg", "spk": "そはら", "ja": "それに……守形先輩とも……\n……なところ触って……！"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "（俺が、守形先輩を触って？\n　胸？）"},
{"id": 63, "kind": "msg", "spk": "智樹", "ja": "（もしかして、みんなの体を\n　触ってまわってる話か……？）"},
{"id": 64, "kind": "msg", "spk": "智樹", "ja": "（たしかに、そう見えてるかもな……）"},
{"id": 65, "kind": "msg", "spk": "智樹", "ja": "（今、顔を出したら、絶対そはらに\n　殺人チョップされそうだな）"},
{"id": 66, "kind": "msg", "spk": "智樹", "ja": "（ここは逃げておくのが正解だぜ！）"},
{"id": 67, "kind": "msg", "spk": "美香子", "ja": "あら～、行っちゃったわね～。"},
{"id": 68, "kind": "msg", "spk": "そはら", "ja": "なにがですか？"},
{"id": 69, "kind": "msg", "spk": "美香子", "ja": "なんでもないわ～。"}
]}
