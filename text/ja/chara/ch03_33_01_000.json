{"file": "_Data/Script/Chara/Chapter03/33/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "そはら", "ja": "トモちゃん、ソーセージも食べる？"},
{"id": 1, "kind": "msg", "spk": "ニンフ", "ja": "トモキ、シイタケも美味しいわよ？"},
{"id": 2, "kind": "msg", "spk": "イカロス", "ja": "マスター……お肉をどうぞ。"},
{"id": 3, "kind": "msg", "spk": "智樹", "ja": "あー、いや……\n皿と飲み物で両手が\nふさがってるからさ。"},
{"id": 4, "kind": "msg", "spk": "そはら", "ja": "あ、じゃあ……はい。\nあーん。"},
{"id": 5, "kind": "msg", "spk": "智樹", "ja": "え……"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "お、おう……\nあむ。"},
{"id": 7, "kind": "msg", "spk": "智樹", "ja": "んぐんぐ……美味いな！"},
{"id": 8, "kind": "msg", "spk": "ニンフ", "ja": "じゃあ、私も！\nほら、トモキ。"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "おう……はぐはぐ。"},
{"id": 10, "kind": "msg", "spk": "イカロス", "ja": "マスター……どうぞ。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "おう！　ぱくん！\nはぐはぐ……"},
{"id": 12, "kind": "msg", "spk": "智樹", "ja": "美味い、美味い。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "うへへ……"},
{"id": 14, "kind": "msg", "spk": "美香子", "ja": "あら～、なんだか楽しそうね～。"},
{"id": 15, "kind": "msg", "spk": "美香子", "ja": "会長も、やってみようかしら～。"},
{"id": 16, "kind": "msg", "spk": "智樹", "ja": "え……"},
{"id": 17, "kind": "msg", "spk": "美香子", "ja": "ほら、桜井くん。\nあ～ん。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "（会長が、こんなことするなんて、\n　罠としか思えないが……）"},
{"id": 19, "kind": "msg", "spk": "智樹", "ja": "（うう……しかし、あの会長が、\n　あ～ん、だなんて！　たまらん！）"},
{"id": 20, "kind": "msg", "spk": "美香子", "ja": "ん～？\nどうしたのかしら～？"},
{"id": 21, "kind": "msg", "spk": "美香子", "ja": "桜井くん、会長からは\n食べてくれないのかしら～？"},
{"id": 22, "kind": "choice", "spk": "", "ja": "食べますとも！"},
{"id": 23, "kind": "choice", "spk": "", "ja": "もういっぱいで……"},
{"id": 24, "kind": "choice", "spk": "", "ja": "むしろ会長をいただきます！"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "食べますとも！"},
{"id": 26, "kind": "msg", "spk": "智樹", "ja": "いただきまーす！　はぐ！"},
{"id": 27, "kind": "msg", "spk": "智樹", "ja": "ウッ！？"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "（裏側に、たっぷり辛子が\n　塗られている！？）"},
{"id": 29, "kind": "msg", "spk": "美香子", "ja": "うれしいわ～。\n激辛なお肉を食べてくれるなんて～。"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "ギャアアアァァァァーーー！？"},
{"id": 31, "kind": "msg", "spk": "智樹", "ja": "めちゃくちゃ辛い！\n水！　水！"},
{"id": 32, "kind": "msg", "spk": "美香子", "ja": "もっと食べてほしいわ～。"},
{"id": 33, "kind": "msg", "spk": "智樹", "ja": "ちょっと、口のなかに……\n肉を押し込んで……！？"},
{"id": 34, "kind": "msg", "spk": "美香子", "ja": "どんどん食べてね～。\nお野菜もあるわ～。"},
{"id": 35, "kind": "msg", "spk": "智樹", "ja": "おごごごごご……！？"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "（肉でおぼれ死ぬ～～～！？）"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "いや、もういっぱいなんで……\nすみませんね、会長。"},
{"id": 38, "kind": "msg", "spk": "美香子", "ja": "そうなの、残念ね～。"},
{"id": 39, "kind": "msg", "spk": "アストレア", "ja": "じゃあ、私がもらいますね、ししょう！"},
{"id": 40, "kind": "msg", "spk": "美香子", "ja": "あら、いいの～？"},
{"id": 41, "kind": "msg", "spk": "アストレア", "ja": "はい！\nいただきます！\nパクン！"},
{"id": 42, "kind": "msg", "spk": "アストレア", "ja": "ウッ！？"},
{"id": 43, "kind": "msg", "spk": "美香子", "ja": "ちょっと辛子が多かったかしら～？"},
{"id": 44, "kind": "msg", "spk": "アストレア", "ja": "からーーーーーい！？"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "（や、やはり罠だったか。\n　恐ろしい……）"},
{"id": 46, "kind": "msg", "spk": "美香子", "ja": "桜井くんも勘が鋭くなったわね～。"},
{"id": 47, "kind": "msg", "spk": "アストレア", "ja": "からーーーーい！\n水！　水くださーい！"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "むしろ会長をいただきます！！"},
{"id": 49, "kind": "msg", "spk": "美香子", "ja": "あら～？\nいつになく積極的ね～？"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "うひょひょひょひょ！"},
{"id": 51, "kind": "msg", "spk": "美香子", "ja": "でも、そんなこと言って\nいいのかしら～？"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "なにがですか？"},
{"id": 53, "kind": "msg", "spk": "そはら", "ja": "ト～モ～ちゃ～ん？"},
{"id": 54, "kind": "msg", "spk": "智樹", "ja": "ハッ！？\nあ、いや……これは……\n会長とスキンシップしようかと……"},
{"id": 55, "kind": "msg", "spk": "", "ja": "　\n{1F}{19}ドゴッ！"},
{"id": 56, "kind": "msg", "spk": "智樹", "ja": "ホブォ！？"},
{"id": 57, "kind": "msg", "spk": "そはら", "ja": "トモちゃんのエッチ！"},
{"id": 58, "kind": "msg", "spk": "美香子", "ja": "やっぱり桜井くんの悲鳴を聞きながら、\n食べるお肉って最高だわ～。"}
]}
