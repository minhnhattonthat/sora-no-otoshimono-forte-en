{"file": "_Data/Script/Chara/Chapter02/53/01_000.dat", "lines": [
{"id": 0, "kind": "msg", "spk": "智樹", "ja": "守形先輩、いますか？"},
{"id": 1, "kind": "msg", "spk": "守形", "ja": "智樹か。なにか用か？"},
{"id": 2, "kind": "msg", "spk": "智樹", "ja": "そろそろ帰る準備をしとかないと\nいけないかなって。"},
{"id": 3, "kind": "msg", "spk": "守形", "ja": "そんなに急ぐことでもないだろうが……\nこれを済ませたら、俺も用意するか。"},
{"id": 4, "kind": "msg", "spk": "智樹", "ja": "なに書いてるんスか？"},
{"id": 5, "kind": "msg", "spk": "守形", "ja": "これか？"},
{"id": 6, "kind": "msg", "spk": "智樹", "ja": "ええ。ノートが２つある\nみたいですけど。\n夏休みの宿題とか？"},
{"id": 7, "kind": "msg", "spk": "守形", "ja": "こちらは今度やる新しい飛行実験の\nための強度計算だ。"},
{"id": 8, "kind": "msg", "spk": "智樹", "ja": "はあ……"},
{"id": 9, "kind": "msg", "spk": "智樹", "ja": "（また俺が飛ぶんじゃ\n　ないだろうな……？）"},
{"id": 10, "kind": "msg", "spk": "守形", "ja": "もう一方は、新大陸発見部の\n活動記録だな。"},
{"id": 11, "kind": "msg", "spk": "智樹", "ja": "へぇー、記録なんて\n付けてるんですか。"},
{"id": 12, "kind": "msg", "spk": "守形", "ja": "研究者や冒険家なら、記録は当然だな。\n俺はそのどちらでもなく、\n新大陸発見部の部長だが。"},
{"id": 13, "kind": "msg", "spk": "智樹", "ja": "それだけ聞くと、\n健全でまともな部活っぽいですね。"},
{"id": 14, "kind": "msg", "spk": "守形", "ja": "元から健全でまともな部活だが？"},
{"id": 15, "kind": "msg", "spk": "智樹", "ja": "先輩に自覚がないのは\nわかってますけどね。"},
{"id": 16, "kind": "msg", "spk": "守形", "ja": "うむ？"},
{"id": 17, "kind": "msg", "spk": "守形", "ja": "まぁ、智樹が納得しているなら\nそれでもいいが。"},
{"id": 18, "kind": "msg", "spk": "智樹", "ja": "その記録って、どんなこと\n書いてるんですか？"},
{"id": 19, "kind": "msg", "spk": "守形", "ja": "興味があるのか？"},
{"id": 20, "kind": "msg", "spk": "智樹", "ja": "あんな奇行ばっかりやってて、\nいったいどんな記録をしてるのかと。"},
{"id": 21, "kind": "msg", "spk": "守形", "ja": "たいしたことは書いていないぞ。\n実験に関しては別のものに\n記録しているしな。"},
{"id": 22, "kind": "msg", "spk": "守形", "ja": "こちらは部活での出来事を\n書いてあるくらいで……。"},
{"id": 23, "kind": "msg", "spk": "守形", "ja": "たとえば、このページには……。"},
{"id": 24, "kind": "msg", "spk": "守形", "ja": "本日、桜井智樹・見月そはらの両名が\n新大陸発見部に入部した。"},
{"id": 25, "kind": "msg", "spk": "智樹", "ja": "（いや、だから、入部した覚えは\n　ないんですけどね）"},
{"id": 26, "kind": "msg", "spk": "守形", "ja": "別のページには……\n飛行実験を実施。智樹が積極的に参加。\nたいへん意欲的だ。"},
{"id": 27, "kind": "msg", "spk": "守形", "ja": "結果は墜落。"},
{"id": 28, "kind": "msg", "spk": "智樹", "ja": "（あれは、むりやりやらせたんで\n　しょうが！！）"},
{"id": 29, "kind": "msg", "spk": "守形", "ja": "智樹と見月には感謝している。"},
{"id": 30, "kind": "msg", "spk": "智樹", "ja": "え？"},
{"id": 31, "kind": "msg", "spk": "守形", "ja": "おまえたち２人が新大陸発見部に\n入ってくれたおかげで、この部活は\nより活動を広げることができた。"},
{"id": 32, "kind": "choice", "spk": "", "ja": "まぁ、入ってませんけどね"},
{"id": 33, "kind": "choice", "spk": "", "ja": "入っとらんわ、こんな部活！"},
{"id": 34, "kind": "msg", "spk": "智樹", "ja": "いや、まぁ、入ってませんけどね。"},
{"id": 35, "kind": "msg", "spk": "守形", "ja": "ふむ……"},
{"id": 36, "kind": "msg", "spk": "智樹", "ja": "俺のモットーは、平和が一番！"},
{"id": 37, "kind": "msg", "spk": "智樹", "ja": "危ないことや怪しいことは、\nやらない主義なんですよ。"},
{"id": 38, "kind": "msg", "spk": "守形", "ja": "……同感だな。\n安全には最大限に配慮すべきだ。"},
{"id": 39, "kind": "msg", "spk": "智樹", "ja": "（最大限に配慮してるなら、\n　手作りグライダーで人を飛ばすな！）"},
{"id": 40, "kind": "msg", "spk": "智樹", "ja": "でも、まぁ……"},
{"id": 41, "kind": "msg", "spk": "智樹", "ja": "守形先輩には、お世話になって\nますから、その辺だけは\n感謝してますけどね。"},
{"id": 42, "kind": "msg", "spk": "守形", "ja": "そうか。"},
{"id": 43, "kind": "msg", "spk": "守形", "ja": "智樹の気持ちはよく分かった。"},
{"id": 44, "kind": "msg", "spk": "守形", "ja": "また、飛行実験に参加してくれ。"},
{"id": 45, "kind": "msg", "spk": "智樹", "ja": "人の話、聞いてましたか！？"},
{"id": 46, "kind": "msg", "spk": "智樹", "ja": "ぜったいに嫌ですよ！\n痛いのも恐いのも！"},
{"id": 47, "kind": "msg", "spk": "守形", "ja": "智樹は新大陸発見部、部員の鏡だな。"},
{"id": 48, "kind": "msg", "spk": "智樹", "ja": "入ってないって！"},
{"id": 49, "kind": "msg", "spk": "智樹", "ja": "入っとらんわ、こんな部活！"},
{"id": 50, "kind": "msg", "spk": "智樹", "ja": "俺は新大陸発見部とは\n無関係ですから！"},
{"id": 51, "kind": "msg", "spk": "守形", "ja": "うむ。"},
{"id": 52, "kind": "msg", "spk": "智樹", "ja": "ホントにわかってるんですか？"},
{"id": 53, "kind": "msg", "spk": "守形", "ja": "当然だろう？"},
{"id": 54, "kind": "msg", "spk": "守形", "ja": "次の飛行実験のパイロットも\n頼むぞ。"},
{"id": 55, "kind": "msg", "spk": "智樹", "ja": "俺の話、聞いてないだろー！？"},
{"id": 56, "kind": "msg", "spk": "守形", "ja": "そうか？"},
{"id": 57, "kind": "msg", "spk": "智樹", "ja": "飛ぶか！"},
{"id": 58, "kind": "msg", "spk": "守形", "ja": "以前のデータをもとに改良してある。\n飛距離は、はるかに伸びるはずだ。"},
{"id": 59, "kind": "msg", "spk": "智樹", "ja": "飛距離が伸びるって、いつかは\n墜落するってことじゃねえか！"},
{"id": 60, "kind": "msg", "spk": "守形", "ja": "うむ。いずれは機体を破損させずに\n着陸できねばな。"},
{"id": 61, "kind": "msg", "spk": "守形", "ja": "有意義な意見だ。"},
{"id": 62, "kind": "msg", "spk": "智樹", "ja": "だから、やらねーーー！！"}
]}
